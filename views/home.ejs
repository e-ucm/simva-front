<%# views/home.ejs %>
 
<% extend('layout_with_menu_and_sse') %>

<div class="card">
	<h1><%= t('home.title', { ns: 'home' }) %></h1>
	<p><%= t('home.welcome.user.text', { ns: 'home', username: user.data.username }) %>
	<p>
		<% if (typeof user !== 'undefined' && user.data.role == 'student') { %>
			<p><%- t('home.welcome.student.text', { ns: 'home' }).replace(/\n/g, '<br><br>') %></p>
		<% } else { %>
			<%- t('home.welcome.teacher.text', { ns: 'home' }).replace(/\n/g, '<br><br>') %>
			<ul>
				<li><%= t('home.github.title', { ns: 'home' }) %>: <a href="https://github.com/e-ucm/simva" target="_blank" rel="noopener noreferrer">https://github.com/e-ucm/simva/</a></li>
				<li><%= t('home.eUCM_Research.title', { ns: 'home' }) %>: <a href="https://e-ucm.es/" target="_blank" rel="noopener noreferrer">https://e-ucm.es/</a></li>
				<li><%= t('home.more_projects.title', { ns: 'home' }) %>: <a href="https://e-ucm.es/" target="_blank" rel="noopener noreferrer">https://github.com/e-ucm/</a></li>
			</ul>
		<% } %>
	</p>
</div>