<%# views/users_login.ejs %>
 
<% extend('layout_logout') %>

<script type="text/javascript">
	document.addEventListener('DOMContentLoaded', () => {
		const iframe = document.getElementById('sso_connect');

		iframe.addEventListener('load', () => {
			try {
				const currentUrl = iframe.contentWindow.location.href;
				// Example: when iframe reaches final SSO callback URL
				window.location.href=currentUrl;
        		console.log('Iframe loaded new URL:', currentUrl);
				//if (currentUrl.includes('/users/openid/return')) {	
				console.log('Detected SSO finished, reloading parent');
				//}
			} catch(e) {
				console.log('Cross-origin, cannot access URL');
			}
		});
	});
</script>

<iframe id="sso_connect" class="content_filled" src="/users/openid" frameBorder="0">
			
</iframe>
<div class="underlay">
	<div class="centered">
		<div class="lds-roller white"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
	</div>
</div>