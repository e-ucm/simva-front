<%# views/groups_list.ejs %>
 
<% extend('layout_with_menu_and_sse') %>

<script type="text/javascript">
	let allGroups = [];
	let allSimlets = [];
	
	$(document).ready(function() {
		const newGeneration = "<%= newGeneration %>" === "true";

		// Load simlets for the dropdown
		Simva.getStudies(function(error, result){
			if(!error){
				allSimlets = result;
				paintSimletOptions(result);
			}
		});

		$(document).on('submit',"#new_group_form", function(event){
			event.preventDefault();
			let form = Utils.getFormData($(this));
			const simlet_id = form.simlet_id;
			
			if(!simlet_id) {
				$("#new_group_form .error").text("Please select a study");
				return false;
			}
			let formData = new FormData();
			formData.append('group_name', form.name);
			formData.append('group_sandbox', Boolean(form.group_sandbox));
			formData.append('group_use_new_generation', newGeneration);

			Simva.addGroup(simlet_id, { group_name : form.name, group_sandbox : Boolean(form.group_sandbox), group_use_new_generation : newGeneration }, function(error, result){
				if(error && error.responseJSON){
					$("#new_group_form .error").text(error.responseJSON.message);
				}else{
					Utils.toggleAddForm('new_group');
					$('#groups_list').html(roller);
					Simva.getGroups(newGeneration, function(error, result){
						if(!error){
							allGroups = result;
							paintGroups(result);
						}
					});
				}
			});

			return false;
		});

		$(document).on('submit',"#edit_group_form", function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit(currentform);
			let formData = new FormData();
			let errorbox = $(this).find('.error');
			if(form.name == form.groupName) {
				errorbox.text("<%= t('name.edit.nochange', { ns : 'groups' }) %>");
				Utils.toggleSubmit(currentform);
			} else {
				formData.append('group_name', form.name);
				Simva.updateGroup(simletid, form.group, { group_name : form.name }, function(error, result){
					if(!error){
						Utils.toggleSubmit(currentform);
						Utils.toggleAddForm('edit_group');
						Simva.getGroups(newGeneration, function(error, result){
							if(!error){
								allGroups = result;
								paintGroups(result);
							}
						});
					}
				});
			}
			return false;
		});

		$('#groups_list').html(roller);
		Simva.getGroups(newGeneration, function(error, result){
			if(!error){
				allGroups = result;
				paintGroups(result);
			}
		});
	});



	let paintGroups = function(groups){
		$('#groups_list').text('');
		if(groups.length > 0){
			for (var i = 0; i < groups.length; i++) {
				$('#groups_list').append(toCard(groups[i]));
			}
		}else{
			$('#groups_list').text('<%= t("zero.message.title", { ns : "groups" }) %>');
		}
	}

	let paintSimletOptions = function(simlets){
		let options = '<option value=""><%= t("new.selectStudy", { ns : "groups" }) %></option>';
		for (var i = 0; i < simlets.length; i++) {
			options += `<option value="${simlets[i].simlet_id}">${simlets[i].simlet_name}</option>`;
		}
		$('#new_group_simlet').html(options);
	}

	let openEditGroupForm = function(groupId, groupName, simletId){
		event.preventDefault();
		event.stopPropagation();
		document.getElementById("edit_group_error").innerHTML = "";
		var inputElement = document.getElementById('edit_group_name');
		inputElement.value = groupName;
		$('#edit_group input[name="group"]').val(groupId);
		$('#edit_group input[name="simlet_id"]').val(simletId);
		$('#edit_group span[class="error"]').val("");
		$('#edit_group input[name="groupName"]').val(groupName);
		Utils.toggleAddForm('edit_group');
	}


	let deleteGroup = function(groupid, groupname, simletId){
		const newGeneration = "<%= newGeneration %>" === "true";
		event.preventDefault();
		event.stopPropagation();
		if(confirm(`<%= t("remove.confirm", { ns : "groups", group : "${groupname}" }) %>`)){
			Simva.deleteGroup(simletId, groupid, function(error, result){
				if(!error){
					Simva.getGroups(newGeneration, function(error, result){
						if(!error){
							allGroups = result;
							paintGroups(result);
						}
					});
				}
			});
		}
	}

	let toCard = function(group){
		const newGeneration = "<%= newGeneration %>" === "true";
		const link = newGeneration ? `/groups/${group.simlet_id}/${group.group_id}` : `/previous-groups/${group.simlet_id}/${group.group_id}`;
		return `<a href="${link}"><div class="selectable card third">
			<input class="yellow" type="button" value="🖍️" onclick="openEditGroupForm('${group.group_id}','${group.group_name}','${group.simlet_id}')">
			<input class="red" type="button" value="X" onclick="deleteGroup('${group.group_id}', '${group.group_name}','${group.simlet_id}')">
			<h1><%= t("single.title", { ns : "groups" }) %>: ${group.group_name}</h1>
			<p><strong><%= t("participants.title", { ns : "groups" }) %>:</strong> ${group.participants.length}</p>
			</div></a>`;
	}
</script>
<% if (newGeneration) { %>
	<h1><%= t("title", { ns : "groups" }) %></h1>
<% } else { %>
	<h1><%= t("deprecated.title", { ns : "groups" }) %> - <%= t("deprecated.message", { ns : "groups" }) %></h1>
<% } %>
<div id="groups_list">
	<div style="width: 100%; text-align: center; padding: 200px;">
		<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
	</div>
</div>
<div id="new_group" class="new_element floating">
	<div class="floater">
		<div class="form">
			<h1><%= t("new.title", { ns : "groups" }) %></h1>
			<form id="new_group_form">
				<input type="text" name="name" placeholder="<%= t('name.placeholder', { ns : 'groups' }) %>" required>
                <select name="simlet_id" id="new_group_simlet" required>
					<option value=""><%= t("new.selectStudy", { ns : "groups" }) %></option>
				</select>
				<input type="submit" value="<%= t('new.title', { ns : 'groups' }) %>">
				<span class="error"></span>
			</form>
		</div>		
	</div>
</div>
<div id="edit_group" class="new_element floating">
	<div class="floater">
		<div class="form">
			<div id="edit_group_tab" class="subform selected" style="display: block;">
				<h2><%= t("name.edit.title", { ns : "groups" }) %></h2>
				<form id="edit_group_form">
					<input hidden type="text" name="group">
					<input hidden type="text" name="simlet_id">
					<input hidden type="text" name="groupName">
					<input type="text" name="name" id="edit_group_name" placeholder="<%= t('name.placeholder', { ns : 'groups' }) %>" required>
					<input type="submit" value="<%= t('name.edit.title', { ns : 'groups' }) %>">
					<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
					<span class="error" id="edit_group_error"></span>
				</form>
			</div>
		</div>
	</div>
</div>
<div class="floating_buttons">
	<a unselectable="on" class="basic" onclick="Utils.toggleAddForm('new_group')">+</a>
</div>
