<%# views/studies_list.ejs %>
 
<% extend('layout_with_menu_and_sse') %>

<h1><%- t('title', { ns : 'SIMLETs' }) %></h1>

<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'SIMLETs' }); %>
<%- include('partials/filtering_pagination_commons', { id:"scheduler", searchBarPlaceholderText: searchBarPlaceholder }) %>

<div id="studies_list" class="simletsCardsList">
</div>

<div id="loader" class="loader">
	<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
</div>

<!-- Template for each card of the studies list -->
<div id="simlet_card_template" style="display: none;">
	<a class="cardColumn">
		<div class="selectable card">
			<h1 class="cardTitle"></h1>
			<p class="cardDescription"> 	</p>
		</div>
	</a>
</div>

<script type="text/javascript">
	const SHOW_AT_ONCE = 9;
	let filteringPaginationData = $("#scheduler_filtering").data();
	let totalResults = 0;

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		filteringPaginationData["showAtOnce"] = SHOW_AT_ONCE;
		filteringPaginationData["updateSearchCallback"] = onSearch;
		filteringPaginationData["loadMoreCallback"] = loadStudyBatch;

		// Updates all the search parameters and calls onSearch
		filteringPaginationData["updateSearch"]();

		// At the same time, asynchronously get all the studies in this section and store
		// them by id for faster access to its parameters when opening the edit menu
		Simva.getSchedulerStudiesCount(function(error, result) {
			if (!error) {
				totalResults = result.count;
			}
		});
	});

	const onSearch = function() {
		$('#studies_list').empty();

		Simva.getSchedulerStudiesCount(filteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				filteringPaginationData["totalResults"] = result.count;
				filteringPaginationData["updateSearchOptions"]();
				
				loadStudyBatch();
			}
		});
	}

	const loadStudyBatch = function() {
		$("#loader").show();
		
		Simva.getSchedulerStudies(filteringPaginationData["searchParams"], function(error, result){
			if (!error) {
				paintStudyBatch(result);
				$("#loader").hide();
			}
		});
	}

	const paintStudyBatch = function(studyBatch) {
		filteringPaginationData = $("#scheduler_filtering").data();

		studyBatch.forEach((study) => {
			fillStudyCard(study);
		});
		
		if (studyBatch.length == 0) {
			// There are no studies in the current section
			if (totalResults == 0) {
				$('#studies_list').text("<%- t('scheduler.noSIMLET.title', { ns : 'SIMLETs' }) %>");
			}
			// There are studies, but none of them matched the search parameters
			else {
				$('#studies_list').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
	}

	const fillStudyCard = function(study) {
		const card = $("#simlet_card_template a").clone();
		card.attr("href", `/scheduler/${study.simlet_id}`);
		card.find(".cardTitle").text(study.simlet_name);
		card.find(".cardDescription").text("<%- t('scheduler.title', { ns : 'SIMLETs' }) %>");

		$('#studies_list').append(card);
	}
	
</script>