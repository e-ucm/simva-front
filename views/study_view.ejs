		$("#generate_study_link").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let errorbox = $(this).find('.error');
			let url=`<%= config.simva.url %>/scheduler/${studyid}`;
			let custom_slug=null;
			let length=null;
			let form = Utils.getFormData($("#generate_study_custom_slug_link_form"));
			if(form.custom_slug != "") {
				custom_slug=form.custom_slug;
			} else {
				form = Utils.getFormData($("#generate_study_link_length_form"));
				if(form.link_length_shlink != "") {
					length=form.link_length_shlink;
				}
			}
			Utils.toggleSubmit(currentform);
			
			Simva.generateShlinkURL(url, "study", `scheduler_${studyid}`, custom_slug, length, (error, result) => {
				if(!error) {
					let shortUrl=result.shortUrl;
					let shlinkData=result;
					shlinkData.domain="<%= config.shlink.apihost %>";
					Simva.updateStudy(study.simlet_id, { shlink: shlinkData }, (error, result) => {
						if(!error) {
							// Copy the text inside the text field
							navigator.clipboard.writeText(shortUrl);
							// Alert Short URL
							alert(shortUrl);
							Utils.toggleSubmit(currentform);
							Utils.toggleAddForm('generate_study_link');
							reloadStudy();
						} else {
							errorbox.text(error);
							Utils.toggleSubmit(currentform);
						}
					})
				} else {
					errorbox.text(error);
					Utils.toggleSubmit(currentform);
				}
			});
			return false;
		});
	});

