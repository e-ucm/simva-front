	// Main Paint functions

	let paintStudy = function(study, participants, tests, allocator, groups, allgroups, platforms){
		$('#study_name').text(study.name);

		if(study.shlink) {
			$('#generate_shlink_url').text("");
			$('#shlink_url_short').text(`<%- t('scheduler.shlink.message', { ns : 'studies', shlink : '${study.shlink.shortUrl}' }) %>`);
			document.getElementById("generate_shlink_url").style.visibility = "hidden";
			document.getElementById("shlink_url").style.visibility = "visible";
			document.getElementById("delete_shlink_url").style.visibility = "visible";
		} else {
			document.getElementById("generate_shlink_url").style.visibility = "visible";
			document.getElementById("shlink_url").style.visibility = "hidden";
			document.getElementById("delete_shlink_url").style.visibility = "hidden";
		}

		paintOwners(study.owners);

		paintActive(study.active);

		paintAllocator(allocator, tests, groups, participants);

		paintGroups(groups);

		paintAddGroup(allgroups);
	
		paintPlatforms(platforms);

		let fullyPaintTest = function(test){
			paintTest(test);

			paintTestActivities(test, test.completeActivities, participants);
			
		}

		$('#tests').empty();
		if(tests.length === 0){
			$('#tests').append("<p><%- t('tests.zero.message', { ns : 'studies' }) %></p>");
		}else{
			for (var i = 0; i < tests.length; i++) {
				fullyPaintTest(tests[i]);
			}
		}
	}

	let paintAddGroup = function(groups){
		$('#group_select').empty('');
		if(groups.length == 0){
			$('#group_select').append("<p><%- t('groups.zero_existing.message', { ns : 'studies' }) %></p>");
		}else{
			for (var i = 0; i < groups.length; i++) {
				$('#group_select').append(addGroupRow(groups[i]));
			}
		}
	}

	let paintActive = function(active){
		$('#active').html('');
		if(active == null || active == "true") {
			$('#active').append('<h2>Active</h2>');
			document.getElementById("activation").value="Achivate"
		} else {
			$('#active').append('<h2>Archived</h2>');
			document.getElementById("activation").value="Activate"
		}
	}

	let setActive = function(){
		if(study.active == null || study.active == "true") { 
			study.active = false;
		} else {
			study.active = true;
		}
		Simva.updateStudy(study, function(error, result){
			if(!error) {
				reloadStudy();
			}
		})
	}

	let paintOwners = function(owners){
		$('#owners').html('');
		for (var i = 0; i < owners.length; i++) {
