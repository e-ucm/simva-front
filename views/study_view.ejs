<!-- SSE -->
<script type="text/javascript">
	if (true)  {
		// Create an instance of SSEClientManager
		Simva.getStudyEventsPresignedUrl('<%= study %>', function(error, result) {
			if (!error) {
				const presignedUrl = result.url;
				const sseClient = new SSEClientManager(presignedUrl);

				// Listen for general messages (default "message" event)
				sseClient.on('message', (data) => {
					console.debug('New message from server:', data);
					// Update UI or process data here
				});

				// Listen for connection open event
				sseClient.on('open', () => {
					console.log('Connection to SSE server established.');
				});

				const resolveParticipantKey = (activityId, data) => {
					const candidates = [data.userId, data.user_id, data.participant_id, data.username, data.user]
						.filter((candidate) => candidate !== undefined && candidate !== null)
						.map((candidate) => String(candidate));

					for (const candidate of candidates) {
						if (
							document.getElementById(`progress_${activityId}_${candidate}`) ||
							document.getElementById(`completion_${activityId}_${candidate}`) ||
							document.getElementById(`result_${activityId}_${candidate}`) ||
							document.getElementById(`init_${activityId}_${candidate}`)
						) {
							return candidate;
						}
					}

					return candidates[0];
				};

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_initialized" from the server
				sseClient.triggerEvent('activity_initialized');
				sseClient.on('activity_initialized', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					if (activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, 0);
					}
					if (activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityResult(activityId, participantKey, "Started");
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_progressed" from the server
				sseClient.triggerEvent('activity_progressed');
				sseClient.on('activity_progressed', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					const val = data.progress ?? data.value;
					if (activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, val);
					}
					if (activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, val);
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_completed" from the server
				sseClient.triggerEvent('activity_completed');
				sseClient.on('activity_completed', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					const status = data.status ?? data.value ?? true;
					if (activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
					}
					if (activityType == "manual") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
					}
					if (activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
						PainterFactory.Painters[activityType].updateActivityResult(activityId, participantKey, "Completed");
					}
					if (activityType == "activity") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status, true);
					}
				});

				sseClient.triggerEvent('ping');
				sseClient.on('ping', (data) => {
					console.debug('ping:', data);
				});

				sseClient.triggerEvent('refresh_auth');
				sseClient.on('refresh_auth', (data) => {
					console.debug('refresh_auth:', data);
					Simva.refreshAuth((error, data) => {
						if (error) {
							console.error(error);
						} else {
							console.debug(data);
						}
					});
				});

				// Close the SSE connection when it's no longer needed
				window.addEventListener('beforeunload', () => {
					if (sseClient) {
						sseClient.closeConnection(); // Call closeConnection method
					}
				});
			}
		});
	}
</script>


<script type="text/javascript">
	// Add the floating class to the content element to add space at the bottom 
	// of the page so the floating button doesnt cover any other element
	$(".content").addClass("floating");
	
	let studyid = "<%= study %>";
	let currentUser = null;
	let study = null;

	// Needs to contain all the sessions from the start to show them as options in the group allocator
	let sessionsById = new Map();	// Defined on reloadStudy or on paintAllocator in the simlet_users partial (whichever loads first)
	
	// Stored to avoid having to retreive them every time the search parameters change 
	// They don't need to contain all the data from the start since they're only neeeded when they're getting painted
	let completeSessionsById = new Map();		// Defined on fillSessionCard in the simlet_sessions partial 
	let	completeActivitiesById = new Map();		// Defined on fillSessionCard in the simlet_sessions partial
	let completeGroupsById = new Map();			// Defined on paintAllocator in the simlet_users partial
	let participantsById = new Map();			// Defined on paintAllocator in the simlet_users partial
	let participantsByUsername = new Map();		// Defined on paintAllocator in the simlet_users partial
	
	// TODO: Declare platforms


	// Menus

	$(document).ready(function() {
		// Set refresh function of the simlet_commons partial
		refreshFunc = reloadStudy;
		
		Simva.getCurrentUser((error, user) => {
			if(!error) {
				currentUser = user;
			} else {
				console.error("Error fetching current user:", error);
				currentUser = null;
				// Optionally, display an error message to the user
				alert("Error fetching user information. Some features may not work properly.");
				//reloadStudy();
			}
		});

		// Create the SIMLET 3-dot button from the template 
		const kebab = $("#kebab_template .kebab-dropdown").clone();
		$(".simletSettings .kebab").append(kebab);
		kebab.find(".icon-edit").click(() => { openStudyForm(studyid) });
		kebab.find(".icon-url").click(() => { openUrlSettingsForm(studyid, study.simlet_name) });
		kebab.find(".icon-download").click(() => { openConfigDownloadForm(studyid, study.simlet_name) });
		kebab.find(".icon-export").click(() => { exportSimlet(studyid) });
		kebab.find(".icon-delete").click(() => { 
			deleteStudy(studyid, study.simlet_name) 
			refreshFunc();
		});

		// Delete the add and import SIMLET tabs from the name/description menu
		$("#add_study_tabs").remove();
		$("#import_study_tab").remove();
	});

	const openStudyForm = function() {
		Utils.toggleAddForm('study_form');

		$('#study_form_error').text("");
		$('#edit_study_id').val(studyid);
		
		$("#study_form_title").text("<%- t('edit.title', { ns : 'SIMLETs' }) %>")
		$("#study_name_desc_submit").val("<%- t('edit.submit', { ns : 'SIMLETs' }) %>")

		$('#prev_study_name').val(study.simlet_name);
		$('#prev_study_description').val(study.simlet_description);
		
		$('#study_name').val(study.simlet_name);
		$('#study_description').val(study.simlet_description);
	}


	// Functionality

	const getSessionFromId = function(testId) {
		if (completeSessionsById.has(testId)) {
			return completeSessionsById.get(testId);
		}
		return null;
	}

	const getActivityFromId = function(activityId) {
		if (completeActivitiesById.has(activityId)) {
			return completeActivitiesById.get(activityId);
		}
		return null;
	}

	const getGroupFromId = function (groupId) {
		if (completeGroupsById.has(groupId)) {
			return completeGroupsById.get(groupId);
		}
		return null;
	}

	const getParticipantFromId = function(participantId) {
		if (participantsById.has(participantId)) {
			return participantsById.get(participantId);
		}
		return null;
	}

	const getLatestCreatedSession = function() {
		const sorted = Array.from(sessionsById.values()).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
		return sorted[0];
	}

	const getLatestUpdatedSession = function() {
		const sorted = Array.from(sessionsById.values()).sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
		return sorted[0];
	}

	
	let reloadStudy = function() {
		// Clear the stored variables in case of deletion/edit, as they were only stored to 
		// avoid retreiving them from the database every time the search parameters change 
		completeSessionsById.clear();
		completeActivitiesById.clear();
		completeGroupsById.clear();
		participantsById.clear();
		participantsByUsername.clear();
		
		// Get the study essential parameters such as the name or its status and paint the different 
		// independent sections of the study asynchronously since the order of execution doesn't matter
		Simva.getStudy(studyid, function(error, result) {
			if (!error) {
				study = result;

				$('#simlet_name').text(study.simlet_name);
				$("#simlet_tags").remove();
				$(".simletTop").after($(renderTags(study)).attr("id", "simlet_tags"));
				
				paintArchived();
				
				// Update all the sessions search parameters and calls its onSearch to paint them
				// No need to paint the activities here as they will be painted when painting the sessions
				// Defined in the simlet_sessions partial
				sessionsFilteringPaginationData["updateSearch"]();

				paintCoordinators();

				// Update all the groups search parameters and calls its onSearch to paint them
				// Defined in the simlet_groups partial
				groupsFilteringPaginationData["updateSearch"]();

				// Try retreiving the sessions and groups before paintAllocator in the simlet_users partial
				// to potentially avoid retreiving them multiple times, since the first paintAllocator calls
				// run asynchronously and practically at the same time 
				if (sessionsById.size < study.sessions.length) {
					Simva.getStudyTests(studyid, function(error, result) {
						if (!error) {
							sessionsById = new Map(
								result.map(obj => [obj.session_id, obj])
							);
						}
					})
				}
			} 
			else {
				console.error(error);
				window.location.href="/simlets";
			}
		});

		// TODO: Store platforms

	}


	// Paint the corresponding archivation button depending of the study status (active/archived) 
	// and activate/deactivate it depending on all the sessions status  
	const paintArchived = async function() {
		const active = !study.simlet_archived;

		let archiveButton = $(".archivationButton");
		let txt = ""
		
		// If the study is active
		if (active == null || active) {
			txt = "<%- t('settings.archive.title', { ns : 'SIMLETs' }) %>"

			// Show the add session/users floating buttons
			$(".basic").show();

			// Set the archive icon to the archive button
			archiveButton.addClass('icon-archive');
			archiveButton.removeClass('icon-dearchive');

			const checkAllSessionsFinished = () => {
				// Check if all sessions are finished
				let allSessionsFinished = true;

				sessionsById.forEach((id, session) => {
																					// Defined in simlet_sessions
					allSessionsFinished = allSessionsFinished && session.session_status == sessionFinishedStatus;
				});

				// If not all sessions are finished, disable the archive button
				if (!allSessionsFinished) {
					archiveButton.addClass('li-disabled').removeAttr('onclick');
				}
				// Otherwise, enable it and set its onclick function to archive the study
				else {
					archiveButton.removeClass('li-disabled').click(() => { 
						if(confirm(`<%- t('archive.confirm', { ns : 'SIMLETs', SIMLET : '${study.simlet_name}' }) %>`)){
							// Defined in the simlet_commons partial
							archiveStudy(studyid, study.simlet_name);
						}
					});
				}
			}

			// If all sessions have already been retreived, call the callback directly
			if (sessionsById.size == study.sessions.length) {
				checkAllSessionsFinished();
			}
			// Otherwise, retreive them from the database, store them, and call the callback once it's done
			else {
				Simva.getStudyTests(studyid, function(error, result) {
					if (!error) {
						sessionsById = new Map(
							result.map(obj => [obj.session_id, obj])
						);
						checkAllSessionsFinished();
					}
				})
			}
		}
		// If the study is archived
		else {
			txt = "<%- t('settings.dearchive.title', { ns : 'SIMLETs' }) %>"

			// Hide the add session/users floating buttons
			$(".basic").hide();

			// TEST: Uncomment to allow dearchivation
			archiveButton.addClass('icon-dearchive');
			archiveButton.removeClass('icon-archive');
			archiveButton.click(() => { 
				Simva.updateStudy(studyid, { simlet_archived: false }, function(error, result) {
					if (!error) {
						refreshFunc();
					}
				});
			});
			
			// TEST: Comment to allow dearchivation
			// archiveButton.hide();
		}

		archiveButton.text(txt);
	}

</script>