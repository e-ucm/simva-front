			let toremove = -1;
			for (var i = 0; i < study.groups.length; i++) {
				if(study.groups[i] === groupid){
					toremove = i;
					break;
				}
			}

			study.groups.splice(i, 1);

			Simva.updateStudy(study, function(error, result){
