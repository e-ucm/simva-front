<script type="text/javascript">
	if(true)  {
		// Create an instance of SSEClientManager
		Simva.getStudyEventsPresignedUrl('<%= study %>', function(error, result){
			if(!error) {
				const presignedUrl = result.url;
				const sseClient = new SSEClientManager(presignedUrl);

				// Listen for general messages (default "message" event)
				sseClient.on('message', (data) => {
					console.debug('New message from server:', data);
					// Update UI or process data here
				});

				// Listen for connection open event
				sseClient.on('open', () => {
					console.log('Connection to SSE server established.');
				});

				const resolveParticipantKey = (activityId, data) => {
					const candidates = [data.userId, data.user_id, data.participant_id, data.username, data.user]
						.filter((candidate) => candidate !== undefined && candidate !== null)
						.map((candidate) => String(candidate));

					for (const candidate of candidates) {
						if (
							document.getElementById(`progress_${activityId}_${candidate}`) ||
							document.getElementById(`completion_${activityId}_${candidate}`) ||
							document.getElementById(`result_${activityId}_${candidate}`) ||
							document.getElementById(`init_${activityId}_${candidate}`)
						) {
							return candidate;
						}
					}

					return candidates[0];
				};

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_initialized" from the server
				sseClient.triggerEvent('activity_initialized');
				sseClient.on('activity_initialized', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					if(activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, 0);
					}
					if(activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityResult(activityId, participantKey, "Started");
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_progressed" from the server
				sseClient.triggerEvent('activity_progressed');
				sseClient.on('activity_progressed', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					const val = data.progress ?? data.value;
					if(activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, val);
					}
					if(activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityProgress(activityId, participantKey, val);
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_completed" from the server
				sseClient.triggerEvent('activity_completed');
				sseClient.on('activity_completed', (data) => {
					const activityType = data.activity_type;
					const activityId = data.activity_id;
					const participantKey = resolveParticipantKey(activityId, data);
					const status = data.status ?? data.value ?? true;
					if(activityType == "gameplay") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
					}
					if(activityType == "manual") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
					}
					if(activityType == "limesurvey") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status);
						PainterFactory.Painters[activityType].updateActivityResult(activityId, participantKey, "Completed");
					}
					if(activityType == "activity") {
						PainterFactory.Painters[activityType].updateActivityCompletion(activityId, participantKey, status, true);
					}
				});

				sseClient.triggerEvent('ping');
				sseClient.on('ping', (data) => {
					console.debug('ping:', data);
				});

				sseClient.triggerEvent('refresh_auth');
				sseClient.on('refresh_auth', (data) => {
					console.debug('refresh_auth:', data);
					Simva.refreshAuth((error, data) => {
						if(error) {
							console.error(error);
						} else {
							console.debug(data);
						}
					});
				});

				// Close the SSE connection when it's no longer needed
				window.addEventListener('beforeunload', () => {
					if (sseClient) {
						sseClient.closeConnection(); // Call closeConnection method
					}
				});
			}
		});
	}
</script>

<!-- TAGS -->
<script type="text/javascript">
	let studyid = "<%= study %>";
	let study = null, participants = null, tests = null, allocator = null, groups = null, platforms = null;
	let availableTags = [];
	let selectedTagsForAdd = [];
	let selectedTagsForEdit = [];
	let originalEditTagIds = [];
	let editingTagByMode = { add: null, edit: null };

	$(document).ready(function() {
		$(document).on('click', function(event){
			if(!$(event.target).closest('.tagPickerArea').length) {
				closeTagDropdown('add');
				closeTagDropdown('edit');
			}
		});
	});
	
	let normalizeTag = function(tag){
		if(!tag) {
			return null;
		}
		return {
			tag_id: Number(tag.tag_id),
			tag_name: tag.tag_name,
			tag_color: tag.tag_color || "#3b82f6"
		};
	}

	let getTagById = function(tagId){
		const normalizedTagId = Number(tagId);
		return availableTags.find((tag) => Number(tag.tag_id) === normalizedTagId) || null;
	}

	let getTagSelectionForMode = function(mode){
		return mode === 'edit' ? selectedTagsForEdit : selectedTagsForAdd;
	}

	let setTagCreatorVisible = function(mode, visible){
		const creatorId = mode === 'edit' ? '#edit_test_tag_creator' : '#add_test_tag_creator';
		if(visible) {
			$(creatorId).show();
		} else {
			$(creatorId).hide();
		}
	}

	let openTagCreator = function(mode){
		closeTagEditor(mode);
		setTagCreatorVisible(mode, true);
		const nameInput = mode === 'edit' ? '#edit_test_new_tag_name' : '#add_test_new_tag_name';
		$(nameInput).trigger('focus');
	}

	let closeTagCreator = function(mode){
		setTagCreatorVisible(mode, false);
	}

	let setTagEditorVisible = function(mode, visible){
		const editorId = mode === 'edit' ? '#edit_test_tag_editor' : '#add_test_tag_editor';
		if(visible) {
			$(editorId).show();
		} else {
			$(editorId).hide();
		}
	}

	let openTagEditor = function(mode, tagId){
		const tag = getTagById(tagId);
		if(!tag) {
			return;
		}

		closeTagCreator(mode);
		editingTagByMode[mode] = Number(tag.tag_id);
		const nameInput = mode === 'edit' ? '#edit_test_edit_tag_name' : '#add_test_edit_tag_name';
		const colorInput = mode === 'edit' ? '#edit_test_edit_tag_color' : '#add_test_edit_tag_color';
		$(nameInput).val(tag.tag_name || '');
		$(colorInput).val(tag.tag_color || '#3b82f6');
		setTagEditorVisible(mode, true);
		$(nameInput).trigger('focus');
	}

	let closeTagEditor = function(mode){
		editingTagByMode[mode] = null;
		setTagEditorVisible(mode, false);
	}

	let saveEditedTag = function(mode){
		const editingTagId = editingTagByMode[mode];
		if(!editingTagId) {
			return;
		}

		const nameInput = mode === 'edit' ? '#edit_test_edit_tag_name' : '#add_test_edit_tag_name';
		const colorInput = mode === 'edit' ? '#edit_test_edit_tag_color' : '#add_test_edit_tag_color';
		const tagName = $(nameInput).val().trim();
		const tagColor = $(colorInput).val();
		const errorBox = getTagErrorBox(mode);
		errorBox.text('');

		if(!tagName) {
			errorBox.text('Tag name is required');
			return;
		}

		Simva.updateTag(editingTagId, { tag_name: tagName, tag_color: tagColor }, function(error){
			if(error) {
				errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}

			closeTagEditor(mode);
			loadAvailableTags(function(loadError){
				if(loadError) {
					errorBox.text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
					return;
				}
				renderSelectedSessionTags(mode);
				openTagDropdown(mode);
			});
		});
	}

	let setTagSelectionForMode = function(mode, tags){
		if(mode === 'edit') {
			selectedTagsForEdit = tags;
		} else {
			selectedTagsForAdd = tags;
		}
	}

	let getTagErrorBox = function(mode){
		const id = mode === 'edit' ? '#edit_test_error' : '#add_test_error';
		return $(id);
	}

	let getTagSearchInputSelector = function(mode){
		return mode === 'edit' ? '#edit_test_tag_search' : '#add_test_tag_search';
	}

	let getTagDropdownSelector = function(mode){
		return mode === 'edit' ? '#edit_test_tag_dropdown' : '#add_test_tag_dropdown';
	}

	let getTagSelectedContainerSelector = function(mode){
		return mode === 'edit' ? '#edit_test_selected_tags' : '#add_test_selected_tags';
	}

	let focusTagSearch = function(mode){
		$(getTagSearchInputSelector(mode)).trigger('focus');
	}

	let filterAvailableTagsBySearch = function(mode){
		const query = $(getTagSearchInputSelector(mode)).val().trim().toLowerCase();
		if(!query) {
			return availableTags;
		}

		return availableTags.filter((tag) => {
			const name = (tag.tag_name || '').toLowerCase();
			return name.includes(query);
		});
	}

	let renderAvailableTagPills = function(mode){
		const selectedTags = getTagSelectionForMode(mode);
		const target = getTagDropdownSelector(mode);
		const container = $(target);
		container.empty();
		const selectedIds = selectedTags.map((tag) => Number(tag.tag_id));
		const filteredTags = filterAvailableTagsBySearch(mode);
		const addableTags = filteredTags.filter((tag) => !selectedIds.includes(Number(tag.tag_id)));

		if(availableTags.length === 0) {
			container.append('<div class="tagDropdownEmpty">No tags yet. Use + to create one.</div>');
			return;
		}

		if(filteredTags.length === 0) {
			container.append('<div class="tagDropdownEmpty">No matches for your search.</div>');
			return;
		}

		if(addableTags.length === 0) {
			container.append('<div class="tagDropdownEmpty">All matching tags are already in this session.</div>');
			return;
		}

		for (let i = 0; i < addableTags.length; i++) {
			const tag = addableTags[i];
			const isSelected = selectedIds.includes(Number(tag.tag_id));
			container.append(`
				<div class="tagDropdownOption">
					<button type="button" class="tagDropdownPick" onclick="toggleSessionTag('${mode}', ${tag.tag_id})">
						<input type="checkbox" ${isSelected ? 'checked' : ''} tabindex="-1" onclick="event.preventDefault();">
						<span class="tagPickerColor" style="background:${tag.tag_color};"></span>
						<span class="tagDropdownLabel">${tag.tag_name}</span>
					</button>
					<button type="button" class="tagDropdownEdit" onclick="openTagEditor('${mode}', ${tag.tag_id})">Edit</button>
				</div>
			`);
		}
	}

	let renderSelectedSessionTags = function(mode){
		const selectedTags = getTagSelectionForMode(mode);
		const container = $(getTagSelectedContainerSelector(mode));
		container.empty();

		for (let i = 0; i < selectedTags.length; i++) {
			const tag = selectedTags[i];
			container.append(`
				<span class="tagSelectedChip">
					<span class="tagPickerColor" style="background:${tag.tag_color};"></span>
					<span class="tagSelectedName">${tag.tag_name}</span>
					<button type="button" class="tagSelectedRemove" onclick="removeSelectedSessionTag('${mode}', ${tag.tag_id})">x</button>
				</span>
			`);
		}

		renderAvailableTagPills(mode);
	}

	let refreshTagSelectors = function(){
		renderSelectedSessionTags('add');
		renderSelectedSessionTags('edit');
	}

	let setTagDropdownVisible = function(mode, visible){
		const dropdown = $(getTagDropdownSelector(mode));
		if(visible) {
			renderAvailableTagPills(mode);
			dropdown.show();
		} else {
			dropdown.hide();
		}
	}

	let openTagDropdown = function(mode){
		setTagDropdownVisible(mode, true);
	}

	let closeTagDropdown = function(mode){
		setTagDropdownVisible(mode, false);
	}

	let onTagSearchInput = function(mode){
		setTagDropdownVisible(mode, true);
	}

	let loadAvailableTags = function(callback){
		Simva.getTags(function(error, tags){
			if(error) {
				if(callback) {
					callback(error);
				}
				return;
			}

			availableTags = (Array.isArray(tags) ? tags : [])
				.map(normalizeTag)
				.filter((tag) => tag !== null)
				.filter((tag, index, arr) => arr.findIndex((current) => Number(current.tag_id) === Number(tag.tag_id)) === index)
				.sort((a, b) => a.tag_name.localeCompare(b.tag_name));

			selectedTagsForAdd = selectedTagsForAdd
				.map((tag) => getTagById(tag.tag_id) || tag)
				.filter((tag, index, arr) => arr.findIndex((current) => current.tag_id === tag.tag_id) === index);

			selectedTagsForEdit = selectedTagsForEdit
				.map((tag) => getTagById(tag.tag_id) || tag)
				.filter((tag, index, arr) => arr.findIndex((current) => current.tag_id === tag.tag_id) === index);

			refreshTagSelectors();

			if(callback) {
				callback(null, availableTags);
			}
		});
	}

	let getCurrentEditSessionId = function(){
		const value = $('#edit_test input[name="test"]').val();
		if(!value) {
			return null;
		}
		return Number(value);
	}

	let addSelectedSessionTag = function(mode, tagId){
		const normalizedTagId = Number(tagId);
		const selectedTags = getTagSelectionForMode(mode);
		if(selectedTags.some((tag) => Number(tag.tag_id) === normalizedTagId)) {
			return;
		}

		const tag = getTagById(normalizedTagId);
		if(!tag) {
			return;
		}

		const commitSelection = function(){
			const currentSelection = getTagSelectionForMode(mode);
			setTagSelectionForMode(mode, [...currentSelection, tag]);
			renderSelectedSessionTags(mode);
		}

		if(mode !== 'edit') {
			commitSelection();
			return;
		}

		const editSessionId = getCurrentEditSessionId();
		if(!editSessionId) {
			commitSelection();
			return;
		}

		const errorBox = getTagErrorBox(mode);
		errorBox.text('');
		Simva.addTagToSession(studyid, editSessionId, normalizedTagId, function(error){
			if(error) {
				errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}

			if(!originalEditTagIds.includes(normalizedTagId)) {
				originalEditTagIds = [...originalEditTagIds, normalizedTagId];
			}

			commitSelection();
		});
	}

	let toggleSessionTag = function(mode, tagId){
		const selectedTags = getTagSelectionForMode(mode);
		const normalizedTagId = Number(tagId);
		const alreadySelected = selectedTags.some((tag) => Number(tag.tag_id) === normalizedTagId);
		if(alreadySelected) {
			setTagSelectionForMode(
				mode,
				selectedTags.filter((tag) => Number(tag.tag_id) !== normalizedTagId)
			);
			renderSelectedSessionTags(mode);
			return;
		}

		addSelectedSessionTag(mode, normalizedTagId);
	}

	let removeSelectedSessionTag = function(mode, tagId){
		Simva.deleteTagFromSession(studyid, Number($(`#${mode}_test_form input[name="test"]`).val()), tagId, function(error){
			if(error) {
				getTagErrorBox(mode).text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			} else {
				const selectedTags = getTagSelectionForMode(mode);
				const normalizedTagId = Number(tagId);
				setTagSelectionForMode(
					mode,
					selectedTags.filter((tag) => Number(tag.tag_id) !== normalizedTagId)
				);
				renderSelectedSessionTags(mode);
			}
		});
		
	}

	let createAndSelectTag = function(mode){
		const nameInput = mode === 'edit' ? '#edit_test_new_tag_name' : '#add_test_new_tag_name';
		const colorInput = mode === 'edit' ? '#edit_test_new_tag_color' : '#add_test_new_tag_color';
		let tagName = $(nameInput).val().trim();
		let tagColor = $(colorInput).val();
		const errorBox = getTagErrorBox(mode);
		errorBox.text('');

		if(!tagName) {
			errorBox.text('Tag name is required');
			return;
		}

		Simva.createTag({ tag_name: tagName, tag_color: tagColor }, function(error, createdTag){
			if(error) {
				errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}

			const created = normalizeTag(createdTag);
			if(created) {
				const selectedTags = getTagSelectionForMode(mode);
				if(!selectedTags.find((tag) => Number(tag.tag_id) === Number(created.tag_id))) {
					setTagSelectionForMode(mode, [...selectedTags, created]);
				}
			}

			$(nameInput).val('');
			$(getTagSearchInputSelector(mode)).val('');
			closeTagCreator(mode);
			loadAvailableTags(function(loadError){
				if(loadError) {
					errorBox.text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
					return;
				}
				renderSelectedSessionTags(mode);
				openTagDropdown(mode);
			});
		});
	}

	let addTagToSessionAsync = function(studyId, testId, tagId){
		return new Promise((resolve, reject) => {
			Simva.addTagToSession(studyId, testId, tagId, function(error, result){
				if(error) {
					reject(error);
					return;
				}
				resolve(result);
			});
		});
	}

	let deleteTagFromSessionAsync = function(studyId, testId, tagId){
		return new Promise((resolve, reject) => {
			Simva.deleteTagFromSession(studyId, testId, tagId, function(error, result){
				if(error) {
					reject(error);
					return;
				}
				resolve(result);
			});
		});
	}

	let syncSessionTags = function(studyId, testId, originalTagIds, targetTagIds, callback){
		const toAdd = targetTagIds.filter((tagId) => !originalTagIds.includes(tagId));
		const toDelete = originalTagIds.filter((tagId) => !targetTagIds.includes(tagId));

		Promise.all([
			...toAdd.map((tagId) => addTagToSessionAsync(studyId, testId, tagId)),
			...toDelete.map((tagId) => deleteTagFromSessionAsync(studyId, testId, tagId))
		])
			.then(() => callback())
			.catch((error) => callback(error));
	}
</script>


<script>
	$(document).ready(function() {
		reloadFunc = reloadStudy;

		const kebab = $("#kebab_template .kebab-dropdown").clone();
		$(".simletSettings .kebab").append(kebab);
		kebab.find(".icon-edit").click(() => { openEditStudyForm(study.simlet_id) });
		kebab.find(".icon-url").click(() => { openUrlSettingsForm(study.simlet_id) });
		kebab.find(".icon-download").click(() => { openConfigDownloadForm(study.simlet_id) });
		kebab.find(".icon-delete").click(() => { 
			deleteStudy(study.simlet_id, study.simlet_name) 
			location.reload();
		});

		$("#add_study_tabs").remove();
		$("#import_study_tab").remove();
		// $(document).on('click', function(event){
		// 	if(!$(event.target).closest('.tagPickerArea').length) {
		// 		closeTagDropdown('add');
		// 		closeTagDropdown('edit');
		// 	}
		// });

		let painters = Object.keys(PainterFactory.Painters);

		Simva.getActivityTypes(function(error, activitytypes){
			for (var i = 0; i < activitytypes.length; i++) {
				if(activitytypes[i].commun && PainterFactory.Painters["activity"]) {
					PainterFactory.Painters["activity"].commun = activitytypes[i].commun;
					PainterFactory.Painters["activity"].communSpecific = activitytypes[i].communSpecific;
				}
				if(PainterFactory.Painters[activitytypes[i].activity_type]){
					PainterFactory.Painters[activitytypes[i].activity_type].setUtils(activitytypes[i].activity_utils);
					PainterFactory.Painters[activitytypes[i].activity_type].simple_name = activitytypes[i].name;
					PainterFactory.Painters[activitytypes[i].activity_type].description = activitytypes[i].description;
					PainterFactory.Painters[activitytypes[i].activity_type].commun = activitytypes[i].commun;
					PainterFactory.Painters[activitytypes[i].activity_type].communSpecific = activitytypes[i].communSpecific;
					PainterFactory.Painters[activitytypes[i].activity_type].specific = activitytypes[i].specific;
					let row = `<option value="${activitytypes[i].activity_type}">${PainterFactory.Painters[activitytypes[i].activity_type].simple_name}</option>`;
					$('#new_activity_form select[name="type"]').append(row);
				}
			}

			$('#new_activity_extras').empty();
			$('#new_activity_extras').append(`${PainterFactory.Painters["gameplay"].description}\n`);
			PainterFactory.Painters["gameplay"].getExtraForm((error, result) => {
				if(!error) {
					$('#new_activity_extras').append(result);
				}
			});

			Simva.getAllocatorTypes(function(error, allocatortypes){
				for (var i = 0; i < allocatortypes.length; i++) {
					if(AllocatorFactory.Painters[allocatortypes[i].allocator_type]){
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].simple_name = allocatortypes[i].name;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].description = allocatortypes[i].description;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].type_translated = allocatortypes[i].type_t;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].add_message = allocatortypes[i].add_message;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].add_error = allocatortypes[i].add_error;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].type_title = allocatortypes[i].type_title;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].participant_title = allocatortypes[i].participant_title;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].test_title = allocatortypes[i].test_title;
						AllocatorFactory.Painters[allocatortypes[i].allocator_type].add_title = allocatortypes[i].add_title;
						let row = `<div class="row"><input type="radio" name="type" id="allocator_${allocatortypes[i].allocator_type}" value="${allocatortypes[i].allocator_type}"><label for="allocator_${allocatortypes[i].allocator_type}"><span class="name">${AllocatorFactory.Painters[allocatortypes[i].allocator_type].simple_name}</span><span class="description">${AllocatorFactory.Painters[allocatortypes[i].allocator_type].description}</span></label></div>`;
						$('#change_allocator_content').append(row);
					}
				}
				reloadStudy();
			});
		});

		$('#new_activity_form select[name="type"]').on('change', function(event){
			$('#new_activity_extras').empty();
			$('#new_activity_extras').append(`${PainterFactory.Painters[$(this).val()].description}\n`);
			PainterFactory.Painters[$(this).val()].getExtraForm((error, result) => {
				if(!error) {
					$('#new_activity_extras').append(result);
				}
			});
		});

		$("#existing_owner_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#existing_owner_form"));
			let errorbox = $(this).find('.error');
			const owners = study.direct_permissions || study.owners || [];

			for (var i = 0; i < owners.length; i++) {
				if(owners[i].username == form.name){
					errorbox.text("<%- t('coordinators.error.already_in', { ns : 'SIMLETs' }) %>");
					return false;
				}
			}
			if(form.permission !== "READ" && form.permission !== "WRITE"){
				errorbox.text("<%- t('coordinators.error.permission', { ns : 'SIMLETs' }) %>");
				return false;
			}

			Simva.getUsers({ username: form.name }, function(error, users){
				if(error){
					errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				const foundUser = Array.isArray(users) ? users[0] : users;
				if(!foundUser || !foundUser.user_id){
					errorbox.text("<%- t('coordinators.error.not_found', { ns : 'SIMLETs' }) %>");
					return;
				}

				Simva.createStudyPermissions(studyid, { user_id: foundUser.user_id, permission: form.permission }, function(createError){
					if(createError && createError.responseJSON){
						errorbox.text(createError.responseJSON.message);
					}else if(createError) {
						errorbox.text(createError.message || createError);
					}else{
						reloadStudy();
						Utils.toggleAddForm('add_owner');
					}
				});
			});

			return false;
		});

		$("#add_group_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#add_group_form"));
			let errorbox = $(this).find('.error');

			if(study.groups.indexOf(form.group) !== -1){
				errorbox.text("<%- t('groups.error.already_in', { ns : 'SIMLETs' }) %>");
			}else{
				Simva.addStudyGroup(studyid, form.group, function(error, result){
					if(error && error.responseJSON){
						errorbox.text(error.responseJSON.message);
					}else{
						Utils.toggleAddForm('add_group');
						reloadStudy();
					}
				});
			}

			return false;
		});

		$("#add_platform_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#add_platform_form"));
			let errorbox = $(this).find('.error');

			let platform = {
				url: form.url,
				name: form.name,
				clientId: form.clientId,
				authenticationEndpoint: form.authenticationEndpoint,
				accesstokenEndpoint: form.accesstokenEndpoint,
				authConfig: { "method": "JWK_SET", "key": form.jkwsUrl },
				studyId: studyid
			}

			Simva.addLtiPlatform(platform, function(error, result){
				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					Utils.toggleAddForm('add_platform');
					reloadStudy();
				}
			});

			return false;
		});

		$("#add_test_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#add_test_form"));
			Utils.toggleSubmit(currentform);
			let errorbox = $('#add_test_error');
			errorbox.text('');
			const selectedTagIds = selectedTagsForAdd.map((tag) => Number(tag.tag_id));

			Simva.addTestToStudy(studyid, { session_name: form.name, session_description: form.description, session_can_be_manually_activated: !!form.can_be_manually_activated }, function(error, result){
				if(error && error.responseJSON){
					Utils.toggleSubmit(currentform);
					errorbox.text(error.responseJSON.message);
				}else if(error){
					Utils.toggleSubmit(currentform);
					errorbox.text(error.message || error);
				}else{
					const newSessionId = result && result.session_id ? Number(result.session_id) : null;
					if(!newSessionId || selectedTagIds.length === 0) {
						Utils.toggleSubmit(currentform);
						selectedTagsForAdd = [];
						renderSelectedSessionTags('add');
						Utils.toggleAddForm('add_test');
						reloadStudy();
						return;
					}

					syncSessionTags(studyid, newSessionId, [], selectedTagIds, function(syncError){
						Utils.toggleSubmit(currentform);
						if(syncError) {
							errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
							return;
						}
						selectedTagsForAdd = [];
						renderSelectedSessionTags('add');
						Utils.toggleAddForm('add_test');
						reloadStudy();
					});
				}
			});

			return false;
		});

		$("#duplicate_test_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#duplicate_test_form"));
			let errorbox = $(this).find('.error');

			Simva.duplicateTestFromStudy(studyid, { session_name: form.name, from: form.test }, function(error, result){
				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					console.log(result);
					Utils.toggleAddForm('duplicate_test');
					reloadStudy();
				}
			});

			return false;
		});

		$("#new_activity_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#new_activity_form"));
			Utils.toggleSubmit(currentform);
			let errorbox = $(this).find('.error');

			PainterFactory.Painters[form.type].extractInformation('#new_activity_form', function(error, activity){
				if(error){
					errorbox.text(error);
				}else{
					Simva.addActivityToTest(studyid, form.test, activity, function(error, result){
						Utils.toggleSubmit(currentform);
						if(error && error.responseJSON){
							errorbox.text(error.responseJSON.message);
						}else{
							Utils.toggleAddForm('add_activity');
							reloadStudy();
						}
					});
				}
			});

			return false;
		});

		$("#edit_activity_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#edit_activity_form"));
			Utils.toggleSubmit(currentform);
			let errorbox = $(this).find('.error');
			let test = tests.filter(item => 
				item.session_id == form.test
			)[0];
			if(!test || !test.completeActivities) {
				errorbox.text("Test or activities not found");
				Utils.toggleSubmit(currentform);
				return false;
			}
			let activities = test.completeActivities;
			let activity = activities.filter(activity => 
				activity.activity_id == form.activity
			)[0];
			if(!activity) {
				errorbox.text("Activity not found");
				Utils.toggleSubmit(currentform);
				return false;
			}
			PainterFactory.Painters[form.type].extractEditInformation('#edit_activity_form', activity, function(error, updatedActivity){
				if(error){
					errorbox.text(error);
				}else{
					if(Object.keys(updatedActivity).length == 0) {
						errorbox.text("<%- t('edit.no_change', { ns : 'SIMLETs' }) %>");
						Utils.toggleSubmit(currentform);
					} else {
						Simva.updateActivity(form.activity, updatedActivity, function(error, result){
							Utils.toggleSubmit(currentform);
							if(error && error.responseJSON){
								errorbox.text(error.responseJSON.message);
							}else{
								Utils.toggleAddForm('edit_activity');
								reloadStudy();
							}
						});
					}
				}
			});
			return false;
		});

		$("#edit_test_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#edit_test_form"));
			Utils.toggleSubmit(currentform);

			console.log(form)
			const testId = form.test;
			const nameChanged = form.prevTestName != form.testName;
			const descriptionChanged = form.prevTestDescription != form.testDescription;
			const selectedTagIds = selectedTagsForEdit.map((tag) => Number(tag.tag_id));
			const tagsChanged = selectedTagIds.length !== originalEditTagIds.length || selectedTagIds.some((tagId) => !originalEditTagIds.includes(tagId));

			if(!nameChanged && !descriptionChanged && !tagsChanged) {
				$('#edit_test_error').text("<%- t('edit.no_change', { ns : 'SIMLETs' }) %>");
				Utils.toggleSubmit(currentform);
			}
			else {
				$('#edit_test_error').text("");
				const finishSync = function() {
					syncSessionTags(studyid, Number(testId), originalEditTagIds, selectedTagIds, function(syncError){
						Utils.toggleSubmit(currentform);
						if(syncError) {
							errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
							return;
						}
						Utils.toggleAddForm('edit_test');
						reloadStudy();
					});
				}

				if(nameChanged || descriptionChanged) {
					Simva.updateTest("<%= study %>", Number(testId), { session_name : form.testName, session_description : form.testDescription }, function(error){
						if(error) {
							Utils.toggleSubmit(currentform);
							errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
							return;
						}
						finishSync();
					});
				} else {
					finishSync();
				}
			}
			return false;
		});
	});


	// TODO
	let downloadSessionData = function(sessionId) {
		console.log("downloading data for session id:", sessionId);
	}

	let toggleAllocatorForm = function(){
		$('#edit_allocator_title').html(AllocatorFactory.Painters[allocator.allocator_type].getFormTitle());
		$('#edit_allocator_content').html(AllocatorFactory.Painters[allocator.allocator_type].getFormContent());
		$('#edit_allocator').toggleClass('shown');
	}

	let toggleTest = function(id) {
		$(`#test_${id}`).find('.activities').toggleClass('collapsed');
		$(`#test_${id}`).find('.expandButton').toggleClass('collapsed');
		$(`#test_${id}`).find('.activityDescription').toggleClass('collapsed');
	}

	let reloadStudy = function(){
		Simva.getStudy(studyid, function(error, result){
			if(!error){
				study = result;

				let tocomplete = 6, done = 0;
				let completed = function(){
					done++

					if(done === tocomplete){
						paintStudy(study, participants, tests, allocator, groups, allgroups, platforms);
					}
				}

				let errorhappened = function(error){
					// paint the errors
				}

				participants = result.participants;
				completed();
				tests = result.completeTests;
				delete result.completeTests;
				completed();
				allocator = result.completeAllocator;
				delete result.completeAllocator;
				completed();
				groups = result.completeGroups;
				delete result.completeGroups;
				completed();
				allgroups = result.allgroups;
				delete result.allgroups;
				completed();
				platforms = [];
				completed();
			} else {
				window.location.href="/simlets";
			}
		});
	}

	// Functionality

	let deleteGroup = function(groupid, groupname){
		if(confirm(`<%- t('groups.delete.confirm', { ns : 'SIMLETs', group : '${groupname}', SIMLET : '${study.simlet_name}' }) %>`)){
			Simva.deleteStudyGroup(study.simlet_id, groupid, function(error, result){
				reloadStudy();
			});
		}
	}

	let deletePlatform = function(platform){
		if(confirm(`<%- t('lti_platform.delete.confirm', { ns : 'SIMLETs', platform : '${platform}', SIMLET : '${study.simlet_name}' }) %>`)){
			Simva.removePlatform(platform, function(error, result){
				reloadStudy();
			});
		}
	}

	let deleteOwner = function(userId, owner){
		if(confirm(`<%- t('coordinators.delete.confirm', { ns : 'SIMLETs', owner : '${owner}', SIMLET : '${study.simlet_name}' }) %>`)){
			Simva.deleteStudyPermissionsForUser(studyid, userId, function(error, result){
				if(!error) {
					reloadStudy();
				}
			});
		}
	}

	let deleteTest = function(testid, testName) {
		if(confirm(`<%- t('sessions.delete.confirm', { ns : 'SIMLETs', session : '${testName}', SIMLET : '${study.simlet_name}' }) %>`)){
			Simva.deleteTest(study.simlet_id, testid, function(error, result){
				reloadStudy();
			});
		}
	}

	let deleteActivity = function(activityid, activityname, testid){
		let test = getTestFromTestId(testid);
		let testName = test && test.session_name ? test.session_name : testid;
		if(confirm(`<%- t('activities.delete.confirm', { ns : 'SIMLETs', activity : '${activityname}', session: '${testName}' , SIMLET : '${study.simlet_name}' }) %>`)){
			Simva.deleteActivity(activityid, function(error, result){
				reloadStudy();
			});
		}
	}

	let openActivityForm = function(test){
		$('#add_activity').toggleClass('shown');
		$('#add_activity input[name="test"]').val(test);
	}

	let openEditActivityForm = function(activityId){
		document.getElementById("edit_activity_error").innerHTML = "";
		let activity= getActivityFromActivityId(activityId);
		var inputElement = document.getElementById('edit_activity_name');
		inputElement.value = activity.activity_name;
		var inputElement = document.getElementById('edit_activity_type');
		inputElement.value = activity.activity_type;
		$('#edit_activity_extras').empty();
		$('#edit_activity_extras').append(`${PainterFactory.Painters[activity.activity_type].description}\n`);
		$('#edit_activity_extras').append(PainterFactory.Painters[activity.activity_type].getEditExtraForm());
		PainterFactory.Painters[activity.activity_type].updateInputEditExtraForm(activity);
		$('#edit_activity input[name="test"]').val(activity.session_id);
		$('#edit_activity span[class="error"]').val("");
		$('#edit_activity input[name="activity"]').val(activity.activity_id);
		$('#edit_activity').toggleClass('shown');
	}

	let openEditDuplicateForm = function(testId){
		document.getElementById("duplicate_test_error").innerHTML = "";
		var inputElement = document.getElementById('duplicate_test_name');
		let test = getTestFromTestId(testId);
		inputElement.value = test.session_name;
		$('#duplicate_test').toggleClass('shown');
		$('#duplicate_test input[name="test"]').val(test.session_id);
		$('#duplicate_test span[class="error"]').val("");
		$('#duplicate_test input[name="testName"]').val(test.session_name);
	}

	let activateTest = function(testId, nextState) {
		let act = false;
		if (nextState == "active") {
			act = true;
		}
		// TODO: Replace activate = true/false for state = active/paused/finished
		else if (nextState == "paused") {
			act = true;
		}

		Simva.activateSession(studyid, testId, { activate: act }, function(error, result) {
			if(!error) {
				reloadStudy();
			}
		})
	}

	let getTestFromTestId = function(testId){
		for(let i=0; i< tests.length; i++) {
			let test=tests[i];
			if(test.session_id == testId) {
				return test;
			}
		}
		return null;
	}

	let getActivityFromActivityId = function(activityId) {
		for(let i=0; i< tests.length; i++) {
			let test=tests[i];
			if(!test.completeActivities) {
				continue;
			}
			for(let j=0; j< test.completeActivities.length; j++) {
				let activity=test.completeActivities[j];
				if(activity.activity_id == activityId) {
					return activity;
				}
			}
		}
		return null;
	}

	let openAddTestForm = function(){
		$('#add_test_error').text('');
		$('#add_test_tags_error').text('');
		closeTagCreator('add');
		closeTagEditor('add');
		closeTagDropdown('add');
		$('#add_test_new_tag_name').val('');
		$(getTagSearchInputSelector('add')).val('');
		selectedTagsForAdd = [];
		renderSelectedSessionTags('add');
		loadAvailableTags(function(loadError){
			if(loadError) {
				$('#add_test_error').text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
				return;
			}
			$('#add_test').toggleClass('shown');
		});
	}

	let openEditTestForm = function(testId){
		let test = getTestFromTestId(testId);

		$('#edit_test_id').val(testId);
		$('#prev_test_name').val(test.session_name);
		$('#prev_test_description').val(test.session_description);
		
		$('#edit_test_error').text("");
		$('#edit_test_name').val(test.session_name);
		$('#edit_test_description').val(test.session_description);
		
		closeTagCreator('edit');
		closeTagEditor('edit');
		closeTagDropdown('edit');
		$('#edit_test_new_tag_name').val('');
		$(getTagSearchInputSelector('edit')).val('');
		const currentTags = Array.isArray(test.tags) ? test.tags.map(normalizeTag).filter((tag) => tag !== null) : [];
		selectedTagsForEdit = currentTags;
		originalEditTagIds = currentTags.map((tag) => Number(tag.tag_id));
		loadAvailableTags(function(loadError){
			if(loadError) {
				$('#edit_test_error').text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
				return;
			}
			renderSelectedSessionTags('edit');

			$('#edit_test').toggleClass('shown');
		});
	}

	let openEditStudyForm = function(){
		$('#study_form_error').text("");
		$('#edit_study_id').val(study.simlet_id);
		
		$("#study_form_title").text("<%- t('edit.submit.title', { ns : 'SIMLETs' }) %>")
		$("#name_desc_submit").val("<%- t('edit.submit.title', { ns : 'SIMLETs' }) %>")

		$("#study_form").toggleClass("shown");

		$('#prev_study_name').val(study.simlet_name);
		$('#prev_study_description').val(study.simlet_description);

		$('#study_name').val(study.simlet_name);
		$('#study_description').val(study.simlet_description);
	}
</script>
	
	


<!-- Main Paint functions -->
<script>
	let paintStudy = function(study, participants, tests, allocator, groups, allgroups, platforms){
		$('#simlet_name').text(study.simlet_name);

		paintOwners(study.direct_permissions);

		paintActive(!study.simlet_archived);

		paintGroups(groups, tests, participants);

		paintAddGroup(allgroups);
	
		paintPlatforms(platforms);

		let fullyPaintTest = function(test){
			const sessionParticipants = Array.isArray(test.completeParticipants)
				? test.completeParticipants
				: [];
			paintTest(test, test.completeActivities, sessionParticipants);
			paintTestActivities(test, test.completeActivities, sessionParticipants);
		}

		$('#tests').empty();
		if(tests.length === 0){
			$('#tests').append("<p><%- t('sessions.zero.message', { ns : 'SIMLETs' }) %></p>");
		}else{
			for (var i = 0; i < tests.length; i++) {
				fullyPaintTest(tests[i]);
			}
		}

		if ($(".sessionTop").length == 1) {
			toggleTest(tests[0].session_id);
		}
	}

	let paintAddGroup = function(groups){
		$('#group_select').empty('');
		if(groups.length == 0){
			$('#group_select').append("<p><%- t('groups.zero_existing.message', { ns : 'SIMLETs' }) %></p>");
		}else{
			for (var i = 0; i < groups.length; i++) {
				$('#group_select').append(addGroupRow(groups[i]));
			}
		}
	}

	let paintActive = function(active) {
		let archiveButton = $(".icon-archive");
		let txt = ""
		if (active == null || active) {
			txt = "<%- t('archive.title', { ns : 'SIMLETs' }) %>"
			$(".basic").show();
			archiveButton.addClass('icon-archive');
			archiveButton.removeClass('icon-dearchive');

			let allSessionsFinished = true;
			study.sessions.forEach(testid => {
				let test = getTestFromTestId(testid);
				if (test != null) {
					// TODO: Remove inactive check when inactive state name changes to finished
					allSessionsFinished = allSessionsFinished && (test.session_status == "finished" || test.session_status == "inactive");
				}
			});
			if (!allSessionsFinished) {
				archiveButton.addClass('li-disabled').removeAttr('onclick');
			}
			else {
				archiveButton.removeClass('li-disabled').attr('onclick', 'toggleArchived()');
			}
		}
		else {
			txt = "<%- t('dearchive.title', { ns : 'SIMLETs' }) %>"
			$(".basic").hide();
			archiveButton.addClass('icon-dearchive');
			archiveButton.removeClass('icon-archive');

			// TEST: Comment to allow dearchivation
			// archiveButton.hide();
		}
		archiveButton.text(txt);
	}

	let toggleArchived = function() {
		archiveStudy();
		// let newActive = !(study.simlet_archived == null || study.simlet_archived);
		// Simva.updateStudy(study.simlet_id, { simlet_archived: newActive }, function(error, result){
		// 	if(!error) {
		// 		reloadStudy();
		// 	}
		// })
	}

	let paintOwners = function(owners){
		$('#owners').html('');
		$('#owners').append("<tr><td><b>Username</b></td><td><b>Permissions</b></td><td></td>");
		
		for (var i = 0; i < owners.length; i++) {
			$('#owners').append(ownerRow(owners[i]));
		}
	}

	let paintGroups = function(groups, tests, participants){
		$('#groups_container').html('');
		if(groups.length == 0){
			$('#groups_container').append("<p><%- t('groups.zero.message', { ns : 'SIMLETs' }) %></p>");
		}else{
			for (var i = 0; i < groups.length; i++) {
				$('#groups_container').append(groupBox(groups[i]));
				paintAllocator(groups[i], tests, groups, participants);
			}
		}
	}

	let paintPlatforms = function(platforms){
		$('#lti_platforms').html('');
		if(platforms.length == 0){
			$('#lti_platforms').append("<p><%- t('lti_platform.zero.message', { ns : 'SIMLETs' }) %></p>");
		}else{
			for (var i = 0; i < platforms.length; i++) {
				$('#lti_platforms').append(platformRow(platforms[i]));
			}
		}
	}

	let paintAllocator = function(group, tests, groups, participants){
		const allocatorType = group.group_allocator_type || 'default';
		if(AllocatorFactory.Painters[allocatorType]) {
			AllocatorFactory.Painters[allocatorType].setTests(tests);
			AllocatorFactory.Painters[allocatorType].setGroups(groups);
			AllocatorFactory.Painters[allocatorType].setStudy(study);
			AllocatorFactory.Painters[allocatorType].setParticipants(participants);
			AllocatorFactory.Painters[allocatorType].paintAllocatorForGroup(group, `#allocator_content_${group.group_id}`);
		} else {
			$(`#allocator_content_${group.group_id}`).html(`<p>Allocator type: ${allocatorType}</p>`);
		}
	}

	let currentGroupIdForAllocator = null;

	let openChangeAllocatorForm = function(groupId, currentAllocatorType) {
		currentGroupIdForAllocator = groupId;
		$('#change_allocator_form input:radio[name=type]').prop('checked', false);
		$(`#allocator_${currentAllocatorType}`).prop('checked', true);
		Utils.toggleAddForm('change_allocator');
	}

	let changeAllocator = function(){
		let type = $('#change_allocator_form input:radio[name=type]:checked').val();

		if(currentGroupIdForAllocator){
			Simva.updateGroup(study.simlet_id, currentGroupIdForAllocator, { group_allocator_type: type }, function(error, result){
				if(error){
					$('#change_allocator_form .error').text(error.responseJSON ? error.responseJSON.message : error.message);
				}else{
					Utils.toggleAddForm('change_allocator');
					reloadStudy();
				}
			});
		}else{
			Utils.toggleAddForm('change_allocator');
		}
	}

	let paintTest = function(test, activities, participants) {
		const date = new Date(test.createdAt);
		const formattedDate = date.toLocaleDateString('en-GB');
		const sessionTags = Array.isArray(test.tags) ? test.tags : [];
		let sessionTagsHtml = '<div class="sessionTagList"><span class="sessionTagEmpty">No tags</span></div>';
		if(sessionTags.length > 0) {
			sessionTagsHtml = '<div class="sessionTagList">';
			for (let i = 0; i < sessionTags.length; i++) {
				const tag = sessionTags[i];
				const tagName = tag && tag.tag_name ? tag.tag_name : 'Tag';
				const tagColor = tag && tag.tag_color ? tag.tag_color : '#3b82f6';
				sessionTagsHtml += `
					<span class="sessionTagChip">
						<span class="sessionTagColor" style="background:${tagColor};"></span>
						<span class="sessionTagName">${tagName}</span>
					</span>
				`;
			}
			sessionTagsHtml += '</div>';
		}
		
		let userCount = participants.length;
		let completeUserCount = 0;
		if (activities.length > 0) {
			if (activities[activities.length - 1].data.completion != null) {
				for (const [key, value] of Object.entries(activities[activities.length - 1].data.completion)) {
					if (value) {
						completeUserCount++;
					}
				}
			}
		}
		let lastActivityCompletion = 0;
		if (userCount > 0) {
			lastActivityCompletion = (completeUserCount / userCount) * 100
		}
		lastActivityCompletion = lastActivityCompletion.toFixed(2);

		let sessionClass = test.session_status;
		// TODO: Remove when inactive state name changes to finished
		if (sessionClass == "inactive") sessionClass = "finished";
		let stateButtons = "";
		let sessionStatusLabel = "";
		if (sessionClass != "active") {
			stateButtons += `
			<li class="kebab-icon icon-activate" onclick="activateTest('${test.session_id}', 'active')">
				<%- t('sessions.activate.title', { ns : 'SIMLETs' }) %>
			</li>
			`
		}
		else if (sessionStatusLabel == "") {
			sessionStatusLabel = `<%- t('sessions.active.title', { ns : 'SIMLETs' }) %>`;
		}
		
		if (test.session_status != "active") {
			stateButtons += `
			<li class="kebab-icon icon-pause" onclick="activateTest('${test.session_id}', 'paused')">
				<%- t('sessions.pause.title', { ns : 'SIMLETs' }) %>
			</li>
			`
		}
		else if (sessionStatusLabel == "") {
			sessionStatusLabel = `<%- t('sessions.paused.title', { ns : 'SIMLETs' }) %>`;
		}
		
		if (sessionClass != "finished") {
			stateButtons += `
			<li class="kebab-icon icon-finish" onclick="activateTest('${test.session_id}', 'finished')">
				<%- t('sessions.finish.title', { ns : 'SIMLETs' }) %>
			</li>
			`
		}
		else if (sessionStatusLabel == "") {
			sessionStatusLabel = `<%- t('sessions.finished.title', { ns : 'SIMLETs' }) %>`;
		}

		let testDiv=`
		<div id="test_${test.session_id}" class="test">
			<div class="sessionTop" >
				<h3>${test.session_name}</h3>
				<div class="sessionStatusLabel ${sessionClass}">${sessionStatusLabel}</div>
				<div class="expandButton" onclick="toggleTest('${test.session_id}')"></div>
				<div class="kebab">
					<ul class="kebab-dropdown">
						<li class="kebab-icon icon-add" onclick="openActivityForm('${test.session_id}')">
							<%- t('activities.add.title', { ns : 'SIMLETs' }) %>
						</li>
						<li class="kebab-icon icon-edit" onclick="openEditTestForm('${test.session_id}')">
							<%- t('sessions.edit.title', { ns : 'SIMLETs' }) %>
						</li>
						<li class="kebab-icon icon-duplicate" onclick="openEditDuplicateForm('${test.session_id}')">
							<%- t('sessions.duplicate.title', { ns : 'SIMLETs' }) %>
						</li>
						${stateButtons}
						<li class="kebab-icon icon-delete" onclick="deleteTest('${test.session_id}', '${test.session_name}')">
							<%- t('sessions.delete.title', { ns : 'SIMLETs' }) %>
						</li>
        			</ul>
				</div>
			</div>
			<div class="activityDescription" style="padding:10px;">${test.session_description}</div>
			<div class="activitySummary">
				<div class="activityInfo">
					<%- t('sessions.creationDate', { ns : 'SIMLETs' }) %>: ${formattedDate}
					<br>
					<%- t('sessions.activityCount', { ns : 'SIMLETs' }) %>: ${test.activities.length} &nbsp; <%- t('sessions.usercount', { ns : 'SIMLETs' }) %>: ${userCount}
					<div style="margin-top: 8px;">${sessionTagsHtml}</div>
				</div>
				<div class="activityProgress progress">
					<div class="done" style="width:${lastActivityCompletion}%"></div>
					<span>
						<%- t('completed.title', { ns : 'activities' }) %>: <done>${lastActivityCompletion}</done>% [ <doneres>${completeUserCount}</doneres>/<total>${userCount}</total> ]
					</span>
				</div>
				<div class="activityDownload">
					<a class="kebab-icon icon-download" onclick="downloadSessionData('${test.session_id}')"><b><%- t('sessions.download', { ns : 'SIMLETs' }) %></b><span></span></a>
				</div>
			</div>
			<div class="activities">
				${roller}
			</div>
		</div>
		`;
		$('#tests').append(testDiv);
		$(".kebab-dropdown").fadeOut(0);
		toggleTest(test.session_id);
	}

	let paintTestActivities = function(test, activities, participants){
		window.participants = participants;
		$(`#test_${test.session_id} .activities`).empty();

		if(activities.length === 0){
			$(`#test_${test.session_id} .activities`).text("<%- t('activities.zero.message', { ns : 'SIMLETs' }) %>");
		}else{
			for (var i = 0; i < activities.length; i++) {
				switch(activities[i].activity_type){
					case 'rageminio':
					case 'miniokafka':
					case 'rageanalytics':
					case 'limesurvey':
					case 'gameplay':
					case 'activity':
					case 'manual':
					case 'ltitool':
					case 'imspackage':
						PainterFactory.Painters[activities[i].activity_type].fullyPaintActivity(activities[i], participants);
						break;
					default:
						ActivityPainter.fullyPaintActivity(activities[i], participants);
						break;
				}
			}
		}
	}


	let ownerRow = function(owner){
		let toret = `<tr><td>${owner.username}</td><td>${owner.permission}</td><td><input class="red" type="button" value="<%- t('coordinators.delete.title', { ns : 'SIMLETs' }) %>"`;
		if(owner.isCurrentUser){
			toret += ' disabled="disabled"';
		}else{
			toret += ` onclick="deleteOwner('${owner.user_id}', '${owner.username}')"`
		}

		toret += '></td></tr>';
		return toret;
	}

	let groupBox = function(group){
		let deleteDisabled = (group.link && group.link.type) ? ' disabled' : '';
		return `<div class="graybox allocator default" id="group_box_${group.group_id}">
			<h3>${group.group_name}</h3>
			<input class="red" type="button" value="<%- t('groups.delete.title', { ns : 'SIMLETs' }) %>" onclick="deleteGroup('${group.group_id}', '${group.group_name}')"${deleteDisabled}>
			<div class="allocator-section">
				<h4><%- t('allocator.title', { ns : 'SIMLETs' }) %></h4>
				<span class="edit"><img src="/icon/gear.png" onclick="openChangeAllocatorForm('${group.group_id}', '${group.group_allocator_type || 'default'}')"></span>
				<div id="allocator_content_${group.group_id}">
				</div>
			</div>
		</div>`;
	}

	let groupRow = function(group){
		let toret = `<tr><td>${group.group_name}</td><td><input class="red" type="button" value="<%- t('groups.delete.title', { ns : 'SIMLETs' }) %>" onclick="deleteGroup('${group.group_id}', '${group.group_name}')" `
		if(group.link && group.link.type){
			toret += ' disabled';
		}
		toret += '></td></tr>';

		return toret;
	}

	let platformRow = function(platform){
		let toret = `<tr><td>${platform.name}</td><td><input class="red" type="button" value="<%- t('lti_platform.delete.title', { ns : 'SIMLETs' }) %>"
		onclick="removePlatform('${platform._id}')"
		></td></tr>`;
		return toret;
	}

	let addGroupRow = function(group){
		return `<option value="${group.group_id}">${group.group_name}</option>`;
	}

	let allocationRow = function(allocation, tests){
		let toret = `<tr><td>${allocation.username}</td><td><select name="test">`;

		if(tests.length > 0){
			for (var i = 0; i < tests.length; i++) {
				if(allocation.test == tests[i].session_id){
					toret += `<option value="${tests[i].session_id}">${tests[i].session_name}</option>`;
				}else{
					toret += `<option value="${tests[i].session_id}" selected>${tests[i].session_name}</option>`;
				}
			}
		}else{
			toret += "<option><%- t('sessions.zero.title', { ns : 'SIMLETs' }) %></option>";
		}
		

		toret += '</select></td></tr>';
		return toret;
	}
</script>
