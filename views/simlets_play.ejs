<% extend('layout_with_menu_and_sse') %>

<h1><%- t('title', { ns : 'SIMLETs' }) %></h1>

<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'SIMLETs' }); %>
<%- include('partials/filtering_pagination_commons', { id:"scheduler", searchBarPlaceholderText: searchBarPlaceholder }) %>

<span id="no_simlets_msg"></span>
<div id="simlets_list" class="simletsCardsList">
</div>

<div id="loader" class="loader">
	<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
</div>

<!-- Template for each card of the SIMLETs list -->
<div id="simlet_card_template" style="display: none;">
	<a class="cardColumn">
		<div class="selectable card">
			<h1 class="cardTitle"></h1>
			<p class="cardDescription"> 	</p>
		</div>
	</a>
</div>

<script type="text/javascript">
	const SHOW_AT_ONCE = 9;
	let filteringPaginationData = $("#scheduler_filtering").data();

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		filteringPaginationData["showAtOnce"] = SHOW_AT_ONCE;
		filteringPaginationData["updateSearchCallback"] = onSearch;
		filteringPaginationData["loadMoreCallback"] = loadSimletBatch;

		// Initially block the bottom reached check and call the updateSearch to 
		// update the initial search parameters and paint the initial results
		filteringPaginationData["checkBottomReached"] = false;
		filteringPaginationData["updateSearch"]();
	});

	/**
	 * When updating any filter parameter, remove all the painted SIMLETs and load a new batch
	 * (called by updateSearch in filtering_pagination_commons)
	 */
	const onSearch = function() {
		$('#simlets_list').empty();

		Simva.getSchedulerSimletsCount(filteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				filteringPaginationData["totalResults"] = result.count;
				filteringPaginationData["updateSearchOptions"]();
				
				loadSimletBatch();
			}
		});
	}

	/**
	 * Load batch of max SHOW_AT_ONCE SIMLETs matching the search parameters and paint them
	 * (called both when updating the search results and when loading the next page of results)
	 */
	const loadSimletBatch = function() {
		$("#loader").show();
		
		Simva.getSchedulerSimlets(filteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				paintSimletBatch(result);
				$("#loader").hide();

				// Once all results have loaded, allow the bottom reached check
				// just in case more results fit on the screen
				filteringPaginationData["checkBottomReached"] = true;
				filteringPaginationData["bottomReached"]();
			}
		});
	}

	/**
	 * Paint the cards for a batch of SIMLETs
	 * @param {Array} batch - Array of objects containing the simlet info
	 */
	const paintSimletBatch = function(batch) {
		filteringPaginationData = $("#scheduler_filtering").data();

		batch.forEach((simlet) => {
			// Add the SIMLET card synchronously to ensure they appear in order
			const card = $("#simlet_card_template a").clone();
			$('#simlets_list').append(card);

			// Then, fill its details asynchronously since the order of execution doesn't matter once the card has been added
			fillSimletCard(simlet, card);
		});
		
		if (batch.length == 0) {
			// There are no SIMLETs in the current section
			if (filteringPaginationData["totalResults"] == 0) {
				$('#no_simlets_msg').text("<%- t('scheduler.noSIMLET.title', { ns : 'SIMLETs' }) %>");
			}
			// There are SIMLETs, but none of them matched the search parameters
			else {
				$('#no_simlets_msg').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
		else {
			$('#no_simlets_msg').text("");
		}
	}

	/**
	 * Fill the SIMLET card info programatically to avoid XSS
	 * @param {object} simlet - object containing simlet info
	 * @param {object} card - jquery object reference of the card element
	 */
	const fillSimletCard = async function(simlet, card) {
		card.attr("href", `/scheduler/${simlet.simlet_id}`);
		card.find(".cardTitle").text(simlet.simlet_name);
		card.find(".cardDescription").text("<%- t('scheduler.title', { ns : 'SIMLETs' }) %>");
	}
	
</script>