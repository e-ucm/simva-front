<%# views/scheduler.ejs %>

<!DOCTYPE html>
<html>
<head>
	<%- include('partials/layout_head_assets') %>
	<%- include('partials/layout_common_script', { includeSimvaBase: true }) %>
	<script type="text/javascript">
		if(true) {
			Simva.getScheduleEventsPresignedUrl('<%= study %>', function(error, result){
				if(!error) {
					const presignedUrl = result.url;
					const sseClient = new SSEClientManager(presignedUrl);
					
					// Listen for general messages (default "message" event)
					sseClient.on('message', (data) => {
						console.debug('New message from server:', data);
					});

					// Listen for connection open event
					sseClient.on('open', () => {
						console.log('Connection to SSE server established.');
					});

					// Handle custom event types from the server (if applicable)
					// Example: You might send events like "activity_initialized" from the server
					sseClient.triggerEvent('activity_initialized');
					sseClient.on('activity_initialized', (data) => {
						console.debug('Activity initialized:', data);
					});

					// Handle custom event types from the server (if applicable)
					// Example: You might send events like "activity_progressed" from the server
					sseClient.triggerEvent('activity_progressed');
					sseClient.on('activity_progressed', (data) => {
						console.debug('Activity progressed:', data);
					});

					// Handle custom event types from the server (if applicable)
					// Example: You might send events like "activity_completed" from the server
					sseClient.triggerEvent('activity_completed');
					sseClient.on('activity_completed', (data) => {
						console.debug('Activity completed:', data);
						// Refresh the page
						location.reload();
					});

					sseClient.triggerEvent('ping');
					sseClient.on('ping', (data) => {
						console.debug('ping:', data);
					});

					sseClient.triggerEvent('refresh_auth');
					sseClient.on('refresh_auth', (data) => {
						console.debug('refresh_auth:', data);
						Simva.refreshAuth((error, data) => {
							if(error) {
								console.error(error);
							} else {
								console.debug(data);
							}
						});
					});

					window.addEventListener('beforeunload', () => {
						if (sseClient) {
							sseClient.closeConnection(); // Call closeConnection method
						}
					});
				}
			});
		}
	</script>
	<script type="text/javascript">
		//
		let studyId = "<%= study %>";
		let username = "<%= user.data.username %>";
		let currentUserId = null;

		var manual = '<body style="background-color: black; color: white; font-family: sans-serif; text-align: center;"><h1>External Activity</h1><p>Ask or listen your teacher for what you have to do on this activity.</p><p>If you are allowed to complete the activity on your own, there should be a "complete activity" button above.</p></body>';

		var completed = '<body style="background-color: black; color: white; font-family: sans-serif; text-align: center;"><h1>Study Completed!</h1><p>Congratulations, you have completed all the activities of the study.</p><p>Ask the teacher if there are more steps to continue.</p></body>';

		let current_activity_id = null;

		let isUserInteracting = {
			isMouseOver: true,
			isWindowFocused: true,
			isDocumentVisible: true,
		};
		let previousState=true;

		let getIframeSrc = function(event) {
 		 	var el = event.target;
  			return eventFromIframe(event) ? el.getAttribute('src') : '';
		}

		function eventFromIframe(event) {
			var el = event.target;
			return el && el.tagName && el.tagName.toLowerCase() == 'iframe';
		}

		$(document).ready(function() {
			getUserToken();
			reloadSchedule();

			document.addEventListener('mouseover', () => {
				isUserInteracting.isMouseOver = true;
				updateUserInteractionState("mouse_over");
			});

			document.addEventListener('mouseout', (event) => {
				if (!event.relatedTarget) {
					isUserInteracting.isMouseOver = false;
					updateUserInteractionState("mouse_out");
				}
			});

			window.addEventListener('focus', () => {
				isUserInteracting.isWindowFocused = true;
				//console.log('Window lost focus.');
				updateUserInteractionState("windows_focus");
			});

			window.addEventListener('blur', () => {
				isUserInteracting.isWindowFocused = false;
				//console.log('Window gained focus.');
				updateUserInteractionState("windows_focus");
			});

			document.addEventListener('visibilitychange', () => {
				isUserInteracting.isDocumentVisible = document.visibilityState === 'visible';
				//console.log(`Document is ${isUserInteracting.isDocumentVisible ? 'visible' : 'hidden'}.`);
				updateUserInteractionState("change_tab");
			});

			window.addEventListener('beforeunload', () => {
				if(current_activity_id != null) {
					console.log("Suspended");
					Simva.setActivitySuspend(current_activity_id, currentUserId, true, "unload_page", function() {
						console.log("Suspended in Simva");
					});
				}
			});
		});

		// Function to update the user interaction state and notify the server if changed
		let suspendTimeout = null;
		let SUSPEND_DELAY_MS = 15000; // 15 seconds
		let lastSuspendReason = null;

		let updateUserInteractionState = function(reason) {
			const isInteracting = isUserInteractingFunc();
			if (isInteracting !== previousState) {
				console.log(`User is ${isInteracting ? 'interacting' : 'not interacting'} with the page.`);
				if (current_activity_id != null) {
					if (!isInteracting) {
						// User stopped interacting: start suspend timer
						if (suspendTimeout) clearTimeout(suspendTimeout);
						lastSuspendReason = reason;
						suspendTimeout = setTimeout(function() {
							// Only send suspend if still not interacting
							if (!isUserInteractingFunc()) {
								Simva.setActivitySuspend(current_activity_id, currentUserId, true, lastSuspendReason, function() {
									console.log("OK in Simva (delayed suspend)");
									previousState=false;
								});
							}
							clearTimeout(suspendTimeout);
							suspendTimeout = null;
						}, SUSPEND_DELAY_MS);
					} else {
						// User resumed interaction: cancel suspend timer and unsuspend immediately
						if (suspendTimeout) {
							clearTimeout(suspendTimeout);
							suspendTimeout = null;
						} else {
							Simva.setActivitySuspend(current_activity_id, currentUserId, false, reason, function() {
								console.log("OK in Simva (unsuspend)");
								previousState=true;
							});
						}
						
					}
				}
			}
		}

		// Example function to check if the user is actively interacting
		let isUserInteractingFunc = function() {
			return Object.values(isUserInteracting).every(state => state);
		}

		let getUserToken = function(){
			Simva.getCurrentUser(function(error, result) {
				if(!error) {
					currentUserId = result.user_id ?? currentUserId;
					if(result.token) {
						document.getElementById('username').innerText = result.token;
					} else {
						document.getElementById('username').innerText = result.username;
					}
				}
			})
		}
		
		let avoid_refreshing = false;
		let reloadSchedule = function(){
			Simva.getStudySchedule(studyId, function(error, result){
				if(error){ 
						$("#complete_activity").hide();
						$('.underlay').hide();
						$('#activity_content').hide(10, function(){
							$('#activity_content').attr('src', 'about:blank');
							paintCurrentActivity('Error');
							let errorMessage = error.responseJSON?.message || error.responseJSON?.error || error.statusText || error.message || 'Unknown error';
							let errorHtml = `<html><body style="display:flex;justify-content:center;align-items:center;height:100vh;margin:0;font-family:sans-serif;"><p style="color:red;font-size:24px;text-align:center;">${errorMessage}</p></body></html>`;
							document.getElementById('activity_content').src = `data:text/html;charset=utf-8,${encodeURIComponent(errorHtml)}`;
							$('#activity_content').show();
							console.log('showing');
						});
						avoid_refreshing=false;
				} else {
					if(!current_activity_id || current_activity_id !== result.next){
						current_activity_id = result.next;

						if(!result.next){
							if(!avoid_refreshing){
								avoid_refreshing = true;
								$("#complete_activity").hide();
								$('#activity_content').hide(10, function(){
									$('#activity_content').attr('src', 'about:blank');
									paintCurrentActivity('Completed');
									document.getElementById('activity_content').src = `data:text/html;charset=utf-8,${escape(completed)}`;
									$('#activity_content').show();
									console.log('showing');
								});
							}
							return;
						}

						avoid_refreshing = false;

						if(!error){
							let activity = result.activities[result.next];
							Simva.isActivityOpenable(activity.activity_id, function(error, result){
								if(!error){
									if(activity.manual_user_managed){
										$("#complete_activity").show();
									}else{
										$("#complete_activity").hide();
									}
								}
								if(result.openable){
									Simva.getActivityTarget(activity.activity_id, function(error, result){
										if (error) {
											console.error("Error getting the URL of the activity target:", error);
											return;
										}
										try {
											console.log("Activity target URL:", result);
											Simva.getCurrentUser(function(error, user){
												if(!error) {
													console.log("Current user:", user);
													$('#activity_content').attr('src', result[user.user_id]);
												}
											});
										} catch (error) {
											console.error("Error getting source:", error);
											return;
										}
									});
								}else{
									$('#activity_content').hide(10, function(){
										$('#activity_content').attr('src', 'about:blank');
										document.getElementById('activity_content').src = `data:text/html;charset=utf-8,${escape(manual)}`;
										$('#activity_content').show();
										console.log('showing');
									});
								}
							});
							paintCurrentActivity(activity.activity_name);
						}
					}
				}
				
			});
		}

		let paintCurrentActivity = function(name){
			$("#current_activity_name").text(name);
		}

		let completeActivity = function(){
			Simva.setActivityCompletion(current_activity_id, currentUserId, true, function(){
				reloadSchedule();
			});
		}
	</script>
</head>
<body class="black">
	<%- include('partials/header_authenticated', { isScheduler: true }) %>

	<iframe id="activity_content" frameBorder="0">
		
	</iframe>
	<div class="underlay">
		<div class="centered">
			<div class="lds-roller white"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
		</div>
	</div>
</body>
</html>