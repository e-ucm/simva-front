<div id="iframe_floating" class="iframe_floating new_element floating">
	<div class="iframe_backdrop"></div>
	<div class="floater">
		<button class="iframe_floating_close" aria-label="Close">&times;</button>
		<div class="iframe_content">
		</div>
	</div>
</div>

<script>
	$(document).ready(function () {
		$('#iframe_floating .iframe_floating_close').on('click', function (e) {
			Utils.hideIframeFloating($(e).attr("id"));
		});
		
		// Click on backdrop closes modal
		//$('#iframe_floating .iframe_backdrop').on('click', function () {
		//	Utils.hideIframeFloating();
		//});
		//
		
		$(document).on('keydown', function(e) {
			// Only process the escape press if the current iframe can be closed (the x button is visible)
			if (e.key === 'Escape') {
				const currentIframe = $(".iframe_floating:visible").first();
				if (currentIframe.find(".iframe_floating_close").is(":visible")) {
					Utils.hideIframeFloating(currentIframe.attr("id"));
				}

			}
		});
	});
</script>