<script type="text/javascript">
	<% if (typeof includeTMonApi !== 'undefined' && includeTMonApi) { %>
		Simva.setTMonURL("<%= config.tmon.url %>");
		Simva.setTMonFile("<%= config.tmon.file %>");
		Simva.setAPIURL("<%= config.api.url %>");
	<% } %>

	<% if (typeof includeSimvaBase !== 'undefined' && includeSimvaBase) { %>
		Simva.setSSOURL("<%= config.sso.url %>");
		Simva.setSSOREALM("<%= config.sso.realm %>");
		Simva.setURL("<%= config.simva.url %>");
	<% } %>

	var roller = '<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>';

	<% if (typeof includeUserToken !== 'undefined' && includeUserToken) { %>
		let getUserToken = function() {
			Simva.getCurrentUser(function(error, result) {
				if(!error) {
					if(result.token) {
						document.getElementById('username').innerText = result.token;
						document.getElementById('account_username').removeAttribute('href');
					} else {
						document.getElementById('username').innerText = result.username;
					}
				}
			});
		};
		getUserToken();
	<% } %>

	<% if (typeof includeSSE !== 'undefined' && includeSSE) { %>
		Simva.getEventsPresignedUrl(function(error, result){
			if(!error) {
				const presignedUrl = result.url;
				const sseClient = new SSEClientManager(presignedUrl);

				sseClient.on('message', (data) => {
					console.debug('New message from server:', data);
				});

				sseClient.on('open', () => {
					console.log('Connection to SSE server established.');
				});

				sseClient.triggerEvent('ping');
				sseClient.on('ping', (data) => {
					console.debug('ping:', data);
				});

				window.addEventListener('beforeunload', () => {
					if (sseClient) {
						sseClient.closeConnection();
					}
				});
			}
		});
	<% } %>

</script>
