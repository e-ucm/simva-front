
<div class="users">
    <div class="card coordinators">
        <div class="groupTop">
            <h2><%- t('coordinators.title', { ns : 'groups' }) %></h2>
            <div class="expandButton" onclick="toggleOwners()"></div>
            <img src="../icon/add.png" title="<%- t('coordinators.add.title', { ns : 'groups' }) %>" onclick="openOwnerForm()" 
                style="cursor: pointer; width: 15px; height: 15px; margin-left:5px;">
        </div>
        <table class="owners" id="owners">
            <thead>
                <th>Username</th>
                <th>Permissions</th>
                <th></th>
            </thead>
            <tbody>
                
            </tbody>
        </table>
    </div>

    <div id="group_template" style="display: none;">
        <div class="test">
            <div class="groupTop">
                <h3 class="groupTitle">		</h3>
                <div class="expandButton"></div>
                <div class="kebab">
                    <ul class="kebab-dropdown">
                        <li class="kebab-icon icon-edit">
                            <%- t('settings.edit.title', { ns : 'groups' }) %>
                        </li>
                        <li class="kebab-icon icon-add">
                            <%- t('settings.add.title', { ns : 'groups' }) %>
                        </li>
                        <li class="kebab-icon icon-gear">
                            <%- t('settings.allocator.title', { ns : 'groups' }) %>
                        </li>
						<li class="kebab-icon icon-download">
							<%- t('settings.download.title', { ns : 'groups' }) %>
						</li>
						<li class="kebab-icon icon-export">
							<%- t('settings.export.title', { ns : 'groups' }) %>
						</li>
                        <li class="kebab-icon icon-delete">
                            <%- t('settings.delete.title', { ns : 'groups' }) %>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="allocatorContent">
            </div>
            <div class="participants_container">
                <table class="participants">
                    <thead>
                        <th>Username</th>
                        <th>isToken</th>
                        <th>Token</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th></th>
                    </thead>
                    <tbody>
                
                    </tbody>
                </table>
            </div>
        </div>
    </div>

	<div class="card groups">
		<div class="top">
			<h2><%- t('title', { ns : 'groups' }) %></h2>
		</div>
		<div id="groups_container">
            
		</div>
	</div>
</div>

<div id="add_owner" class="new_element floating">
	<div class="floater">
		<div class="form">
            <h2><%- t('coordinators.add.title', { ns : 'groups' }) %></h2>
            <br>
            <form id="existing_owner_form">
                <input type="text" id="owner_name" name="name" placeholder="<%- t('coordinators.placeholder', { ns : 'groups' }) %>" required>
                <br><br>
                <select name="permission" required>
                    <option value="">Select Permission</option>
                    <option value="READ">Read</option>
                    <option value="WRITE">Write</option>
                </select>
                <br><br>
                <input type="submit" value="<%- t('coordinators.add.title', { ns : 'groups' }) %>">
                <span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
                <br><br>
                <span class="error"></span>
            </form>
        </div>
    </div>
</div>

<div id ="group_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form">
			<div class="tabs" id="add_group_tabs">
				<span id="group_name_desc_tab_button" class="tab selected" onclick="changeTab(this, 'group_form_menu','group_name_desc_tab')"><%- t('add.tab', { ns : 'groups' }) %></span>
				<span class="tab" onclick="changeTab(this, 'group_form_menu','import_group_tab')"><%- t('import.tab', { ns : 'groups' }) %></span>
			</div>
			<div id="group_name_desc_tab" class="subform selected" style="display: block;">
				<h1 id="group_form_title">  </h1>
				<form id="group_form">
					<input hidden type="text" name="editingGroupId" id="edit_group_id">
					<input hidden type="text" name="prevGroupName" id="prev_group_name">
					<h3><%- t('name.title', { ns : 'groups' }) %></h3>
					<input type="text" name="groupName" id="group_name" placeholder="<%- t('name.placeholder', { ns : 'groups' }) %>" required>
					<br><br>
					<input type="submit" id="group_submit" value="">
				</form>
				<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
				<br>
				<span class="error" id="group_form_error"></span>
			</div>
			<div id="import_group_tab" class="subform" style="display: none;">
				<form id="import_group_form_modal">
					<h3><%- t('name.title', { ns : 'groups' }) %></h3>
					<input type="text" name="groupName" id="import_group_name_modal" placeholder="<%- t('name.placeholder', { ns : 'groups' }) %>" required>
					<br><br>
					<h3><%- t('import.input', { ns : 'groups' }) %></h3>
					<input type="file" name="jsonFile" accept=".json" required>
					<br><br>
					<input type="submit" value="<%- t('import.submit', { ns : 'groups' }) %>">
				</form>
				<span class="error" id="import_group_error_modal"></span>
			</div>
		</div>
	</div>
</div>

<div id="change_allocator" class="new_element floating">
    <div class="floater">
        <div class="form">
            <h2><%- t('allocator.change.title', { ns : 'groups' }) %></h2>
            <form id="change_allocator_form">
                <div id="change_allocator_content">
                </div>
                <input type="button" value="<%- t('allocator.change.submit', { ns : 'groups' }) %>" onclick="changeAllocator()">
                <span class="error"></span>
            </form>
        </div>
    </div>
</div>

