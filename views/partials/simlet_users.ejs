<div class="floating_buttons users">
	<a unselectable="on" class="basic" onclick="openGroupForm()" style="display: none;">+</a>
</div>


<script>

	let currentGroupIdForAllocator = null;
	
	const groupDataIdKey = "groupId"
	const groupDataNameKey = "groupName"
	const groupDataAllocatorKey = "groupAllocator"
	const userDataIdKey = "userId"
	const userDataNameKey = "userName"
	
	
	// Menus
	
	$(document).ready(function() {
		
		// Import group from modal tab
		$('#import_group_form_modal').on('submit', function(event) {
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit(currentform);
			let errorbox = $('#import_group_error_modal');
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				var reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						raw = raw.substr(raw.indexOf(',') + 1);
						var newGroup = raw;
						Simva.importGroup(studyid, {file: newGroup, group_name: form.groupName}, function(importError, result) {
							Utils.toggleSubmit(currentform);
							if (importError) {
								errorbox.text(importError.responseJSON ? importError.responseJSON.message : importError.message || importError);
								return;
							} else {
								$("#group_form_menu").removeClass("shown");
								//reloadStudy();
							}
						});
					} catch (parseError) {
						console.error('Import error:', parseError);
						Utils.toggleSubmit(currentform);
						errorbox.text("<%- t('import.error.invalid_file', { ns : 'groups' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			} else {
				errorbox.text("<%- t('import.upload.error', { ns : 'groups' }) %>");
				Utils.toggleSubmit(currentform);
			}
			return false;
		});

		$("#group_form").on('submit', function(event) {
			let errorbox = $('#group_form_error');
			let currentform = this;
			let form = Utils.getFormData($("#group_form"));
			Utils.toggleSubmit(currentform);
			
			// Creating new group
			if (form.editingGroupId == null || form.editingGroupId == "") { 
				// TEST
				form.group_sandbox = false;
				let newGeneration = true;

				Simva.addGroup(studyid, { group_name : form.groupName, group_sandbox : Boolean(form.group_sandbox), group_use_new_generation : newGeneration }, function(error, result) {
					if (error && error.responseJSON) {
						Utils.toggleSubmit(currentform);
						errorbox.text(error.responseJSON.message);
					}
					else {
						Utils.toggleSubmit(currentform);
						Utils.toggleAddForm('group_form_menu');
						reloadStudy();
					}
				});
			}
			// Editing group
			else {
				const groupId = form.editingGroupId;

				const nameChanged = form.prevGroupName != form.groupName;
				if (!nameChanged) {
					errorbox.text("<%- t('edit.no_changes.message', { ns : 'SIMLETs' }) %>");
					Utils.toggleSubmit(currentform);
				}
				else {
					errorbox.text("");
					Simva.updateGroup(studyid, form.editingGroupId, { group_name : form.groupName }, function(error, result) {
						if (!error) {
							Utils.toggleSubmit(currentform);
							Utils.toggleAddForm('group_form_menu');
							reloadStudy();
						}
					});
				}
			}
			return false;
		});
		
		$("#existing_owner_form").on('submit', function(event) {
			event.preventDefault();
			let form = Utils.getFormData($("#existing_owner_form"));
			let errorbox = $(this).find('.error');
			const owners = study.direct_permissions || study.owners || [];

			for (var i = 0; i < owners.length; i++) {
				if (owners[i].username == form.name) {
					errorbox.text("<%- t('coordinators.error.already_in', { ns : 'groups' }) %>");
					return false;
				}
			}
			if (form.permission !== "READ" && form.permission !== "WRITE") {
				errorbox.text("<%- t('coordinators.error.permission', { ns : 'groups' }) %>");
				return false;
			}

			Simva.getUsers({ username: form.name }, function(error, users) {
				if (error) {
					errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				const foundUser = Array.isArray(users) ? users[0] : users;
				if (!foundUser || !foundUser.user_id) {
					errorbox.text("<%- t('coordinators.error.not_found', { ns : 'groups' }) %>");
					return;
				}

				Simva.createStudyPermissions(studyid, { user_id: foundUser.user_id, permission: form.permission }, function(createError) {
					if (createError && createError.responseJSON) {
						errorbox.text(createError.responseJSON.message);
					} else if (createError) {
						errorbox.text(createError.message || createError);
					} else {
						reloadStudy();
						Utils.toggleAddForm('add_owner');
					}
				});
			});

			return false;
		});

		// $("#add_group_form").on('submit', function(event) {
		// 	event.preventDefault();
		// 	let form = Utils.getFormData($("#add_group_form"));
		// 	let errorbox = $(this).find('.error');

		// 	if (study.groups.indexOf(form.group) !== -1) {
		// 		errorbox.text("<%- t('groups.error.already_in', { ns : 'SIMLETs' }) %>");
		// 	} else {
		// 		Simva.addStudyGroup(studyid, form.group, function(error, result) {
		// 			if (error && error.responseJSON) {
		// 				errorbox.text(error.responseJSON.message);
		// 			} else {
		// 				Utils.toggleAddForm('add_group');
		// 				reloadStudy();
		// 			}
		// 		});
		// 	}

		// 	return false;
		// });

		$("#add_platform_form").on('submit', function(event) {
			event.preventDefault();
			let form = Utils.getFormData($("#add_platform_form"));
			let errorbox = $(this).find('.error');

			let platform = {
				url: form.url,
				name: form.name,
				clientId: form.clientId,
				authenticationEndpoint: form.authenticationEndpoint,
				accesstokenEndpoint: form.accesstokenEndpoint,
				authConfig: { "method": "JWK_SET", "key": form.jkwsUrl },
				studyId: studyid
			}

			Simva.addLtiPlatform(platform, function(error, result) {
				if (error && error.responseJSON) {
					errorbox.text(error.responseJSON.message);
				} else {
					Utils.toggleAddForm('add_platform');
					reloadStudy();
				}
			});

			return false;
		});

	});

    //TEST
	//changeTab(this, 'study_tabs','users_tab')
	
    const toggleOwners = function() {
		$(".card.coordinators").find('.expandButton').toggleClass('collapsed');
		$(".card.coordinators").find('.owners').toggleClass('collapsed');
	}

    const toggleGroup = function(groupId) {
        $(`#group_box_${groupId}`).find('.participants_container').toggleClass('collapsed');
		$(`#group_box_${groupId}`).find('.expandButton').toggleClass('collapsed');
    }
	
	// Reset tab state when opening modal
	const openGroupForm = function(groupId) {
		$("#group_form_menu").addClass("shown");
		// Default to add tab
		$("#add_group_tabs .tab").removeClass("selected");
		$("#group_name_desc_tab_button").addClass("selected");
		$("#group_name_desc_tab").show();
		$("#import_group_tab").hide();
		$('#edit_group_id').val(groupId || "");
		$('#group_name').val("");
		$('#prev_group_name').val("");
		$('#group_form_error').text("");
		$('#import_group_name_modal').val("");
		$('#import_group_error_modal').text("");
		// Fill fields for edit mode
		if (groupId == null) {
			$("#group_form_title").text("<%- t('add.title', { ns : 'groups' }) %>");
			$("#group_submit").val("<%- t('add.submit', { ns : 'groups' }) %>");
		} else {
			var group = getGroupFromGroupId(groupId);
			$("#group_form_title").text("<%- t('edit.title', { ns : 'groups' }) %>");
			$("#group_submit").val("<%- t('edit.submit', { ns : 'groups' }) %>");
			if (group) {
				$('#prev_group_name').val(group.group_name);
				$('#group_name').val(group.group_name);
			}
		}
	}

	const exportGroup = function(groupId, groupName) {
		Simva.exportGroup(studyid, groupId, true, function(error, result) {
			if (!error) {
				const content = JSON.stringify(result, null, 2);
				const filename = `simlet-group-${groupName || groupId}-export.json`;
				Utils.download(filename, content);
			} else {
				alert(error.responseJSON ? error.responseJSON.message : (error.message || error));
			}
		});
	}

	const openOwnerForm = function() {
		$("#add_owner").toggleClass("shown");
		$("#owner_name").val("");
	}
    
	
	let openChangeAllocatorForm = function(groupId, currentAllocatorType) {
		currentGroupIdForAllocator = groupId;
		$('#change_allocator_form input:radio[name=type]').prop('checked', false);
		$(`#allocator_${currentAllocatorType}`).prop('checked', true);
		Utils.toggleAddForm('change_allocator');
	}

	let toggleAllocatorForm = function() {
		$('#edit_allocator_title').html(AllocatorFactory.Painters[allocator.allocator_type].getFormTitle());
		$('#edit_allocator_content').html(AllocatorFactory.Painters[allocator.allocator_type].getFormContent());
		$('#edit_allocator').toggleClass('shown');
	}


	// Groups buttons shared listeners

    $(document).on('click', "#groups_container .groupTop .expandButton", function(e) {
		const data = $(this).closest(".test").data();
		toggleGroup(data[groupDataIdKey]);
	});

	$(document).on('click', ".groupTop .icon-edit", function(e) {
		const data = $(this).closest(".test").data();
		openGroupForm(data[groupDataIdKey]);
	});

	$(document).on('click', ".groupTop .icon-gear", function(e) {
		const data = $(this).closest(".test").data();
		openChangeAllocatorForm(data[groupDataIdKey], data[groupDataAllocatorKey]);
	});

	$(document).on('click', ".groupTop .icon-export", function(e) {
		const data = $(this).closest(".test").data();
		exportGroup(data[groupDataIdKey], data[groupDataNameKey]);
	});

	$(document).on('click', ".groupTop .icon-download", function(e) {
		const data = $(this).closest(".test").data();
		const group = getGroupFromGroupId(data[groupDataIdKey]);
		
		let usernames = [];
		if (group != null) {
			study.participants.forEach(function(participant) {
				if (group.participants.includes(participant.user_id)) {
					usernames.push(participant.username)
				}
			});
		}

		$("#printable_group_name").text(`<%- t('print_table.title', { ns : 'groups' }) %> ${data[groupDataNameKey]}`);
		clearTableBody($("#printable_table"));

		let rows = "";
		for (let i = 0; i < usernames.length; i++) {
			rows += `
				<tr>
					<td>${i + 1}</td>
					<td></td>
					<td>${usernames[i]}</td><td>${usernames[i]}</td><td>${usernames[i]}</td><td>${usernames[i]}</td>
				</tr>
			`
		}
		$("#printable_table").append(rows);

		window.print();
	});

	$(document).on('click', ".groupTop .icon-delete", function(e) {
		const data = $(this).closest(".test").data();
		deleteGroup(data[groupDataIdKey], data[groupDataNameKey]);
	});

	$(document).on('click', ".participants .red", function(e) {
		const groupData = $(this).closest(".test").data();
		const userData = $(this).closest("tr").data();
		console.log(groupData, userData)
		deleteParticipant(userData[userDataIdKey], userData[userDataNameKey], groupData[groupDataIdKey], groupData[groupDataNameKey], true)
	});

	
	// Functionality
    
	let deleteOwner = function(userId, owner) {
		if (confirm(`<%- t('coordinators.delete.confirm', { ns : 'groups', owner : '${owner}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.deleteStudyPermissionsForUser(studyid, userId, function(error, result) {
				if (!error) {
					reloadStudy();
				}
			});
		}
	}

	let deleteGroup = function(groupid, groupname) {
		if (confirm(`<%- t('groups.delete.confirm', { ns : 'groups', group : '${groupname}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.deleteStudyGroup(studyid, groupid, function(error, result) {
				reloadStudy();
			});
		}
	}

	let deleteParticipant = function(participant_id, participant, group_id, group, removeKeycloak=false){
		if(confirm(`<%- t('participants.remove.confirm', { ns: 'groups',  participant : '${participant}', group : '${group}' }) %>`)) {
			Simva.deleteGroupParticipants(studyid, group_id, participant_id, removeKeycloak, function(error, result){
				if(!error){
					reloadStudy();
				}
			});
		}
	}
	
	let deletePlatform = function(platform) {
		if (confirm(`<%- t('lti_platform.delete.confirm', { ns : 'groups', platform : '${platform}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.removePlatform(platform, function(error, result) {
				reloadStudy();
			});
		}
	}

	let changeAllocator = function() {
		let type = $('#change_allocator_form input:radio[name=type]:checked').val();

		if (currentGroupIdForAllocator) {
			Simva.updateGroup(studyid, currentGroupIdForAllocator, { group_allocator_type: type }, function(error, result) {
				if (error) {
					$('#change_allocator_form .error').text(error.responseJSON ? error.responseJSON.message : error.message);
				} else {
					Utils.toggleAddForm('change_allocator');
					reloadStudy();
				}
			});
		} else {
			Utils.toggleAddForm('change_allocator');
		}
	}

    function setTesterForSession(sessionId) {
		const simletId = studyid;
		const userId = currentUser.user_id;

		// 1. Find or create a group for the current user
		Simva.getStudyGroups(simletId, function(err, groups) {
			if (err) {
				alert('Error fetching groups: ' + (err.responseJSON ? err.responseJSON.message : err.message));
				return;
			}
			let myGroup = groups.find(g => g.group_sandbox === true && g.group_owner_user_id === userId);
			const afterGroupReady = (group) => {
				// 2. Add user as participant if not already
				Simva.getGroupParticipants(simletId, group.group_id, function(err, participants) {
					if (err) {
						alert('Error fetching group participants: ' + (err.responseJSON ? err.responseJSON.message : err.message));
						return;
					}
					let alreadyParticipant = participants.some(p => p.user_id === userId);
					const afterParticipantReady = () => {
						// 3. Allocate/move user to selected session
						Simva.allocateToSession(simletId, group.group_id, sessionId, {}, function(err) {
							if (err) {
								alert('Error allocating to session: ' + (err.responseJSON ? err.responseJSON.message : err.message));
							} else {
								$.toast({ heading: 'Tester set', text: 'You are now a tester in this session.', position: 'top-right', icon: 'success', stack: false });
								reloadStudy();
							}
						});
					}
					if (!alreadyParticipant) {
						Simva.addGroupParticipant(simletId, group.group_id, userId, function(err) {
							if (err) {
								alert('Error adding yourself as participant: ' + (err.responseJSON ? err.responseJSON.message : err.message));
							} else {
								afterParticipantReady();
							}
						});
					} else {
						afterParticipantReady();
					}
				});
			}
			if (myGroup) {
				afterGroupReady(myGroup);
			} else {
				// Create a new group for the user
				Simva.addGroup(simletId, { group_name: 'Tester ' + userId, group_use_new_generation: false, group_sandbox : true }, function(err, group) {
					if (err) {
						alert('Error creating group: ' + (err.responseJSON ? err.responseJSON.message : err.message));
					} else {
						afterGroupReady(group);
					}
				});
			}
		});
	}

	// Remove current user as tester (participant) from the session
	function unsetTesterForSession(sessionId) {
		// Find the group and participant for the current user in this session
		const test = getTestFromTestId(sessionId);
		if (!test || !Array.isArray(test.completeParticipants)) {
			alert("Error: Session or participants not found.");
			return;
		}
		// Try to find the participant object for the current user
		const userKeys = PainterFactory.Painters['activity'].getParticipantKeys(currentUser);
		const participant = test.completeParticipants.find(p => {
			const keys = PainterFactory.Painters['activity'].getParticipantKeys(p);
			return userKeys.some(key => keys.includes(key));
		});
		if (!participant) {
			alert("Error: You are not a participant in this session.");
			return;
		}
		// Remove from the group (assume group_id is present on participant)
		const groupId = participant.group_id || participant.groupid || participant.group || (test.completeGroups && test.completeGroups[0] && test.completeGroups[0].group_id);
		if (!groupId) {
			alert("Error: Group ID not found for your participant record.");
			return;
		}
		Simva.deleteGroupParticipants(study.simlet_id, groupId, participant.participant_id || participant.id || participant.user_id, false, function(msg) {
			if (msg.status !== 200) {
				alert("Error removing yourself as tester: " + (msg.responseJSON ? JSON.stringify(msg.responseJSON.message) : JSON.stringify(msg.message) || JSON.stringify(msg)));
			} else {
				reloadStudy();
			}
		});
	}
	
	// Render

	let paintAddGroup = function(groups) {
		$('#group_select').empty('');
		if (groups.length == 0) {
			$('#group_select').append("<p><%- t('groups.zero_existing.message', { ns : 'SIMLETs' }) %></p>");
		} 
		else {
			for (var i = 0; i < groups.length; i++) {
				$('#group_select').append(addGroupRow(groups[i]));
			}
		}
	}

	const clearTableBody = function(table) {
		if (table.jquery != null) {
			table.find("tbody tr").remove();
		}
	}
	
	let paintOwners = function(owners) {
		clearTableBody($("#owners"));

		for (var i = 0; i < owners.length; i++) {
			$('#owners').append(createOwnerRow(owners[i]));
		}
	}

	let createOwnerRow = function(owner) {
		let toret = `<tr><td>${owner.username}</td><td>${owner.permission}</td><td><input class="red" type="button" value="<%- t('coordinators.delete.title', { ns : 'groups' }) %>"`;
		if (owner.isCurrentUser) {
			toret += ' disabled="disabled"';
		} else {
			toret += ` onclick="deleteOwner('${owner.user_id}', '${owner.username}')"`
		}

		toret += '></td></tr>';
		return toret;
	}


	let paintGroups = function(groups, tests, participants) {
		$('#groups_container').html('');
		if (groups.length == 0) {
			$('#groups_container').append("<p><%- t('zero.message.title', { ns : 'groups' }) %></p>");
		} 
        else {
			for (var i = 0; i < groups.length; i++) {
				addGroupBox(groups[i])
				paintAllocator(groups[i], tests, groups, participants);
			}
            if (groups.length == 1) {
			    toggleGroup(groups[0].group_id);
            }
		}
	}

	// Add group programatically to avoid XSS
	
	let addGroupBox = function(group) {
		// let deleteDisabled = (group.link && group.link.type) ? ' disabled' : '';
		// let box = `<div class="graybox allocator default" id="group_box_${group.group_id}">
		// 	<h3>${group.group_name}</h3>
		// 	<input class="red" type="button" value="<%- t('groups.delete.title', { ns : 'groups' }) %>" onclick="deleteGroup('${group.group_id}', '${group.group_name}')"${deleteDisabled}>
		// 	<div class="allocator-section">
		// 		<h4><%- t('allocator.title', { ns : 'groups' }) %></h4>
		// 		<span class="edit"><img src="/icon/gear.png" onclick="openChangeAllocatorForm('${group.group_id}', '${group.group_allocator_type || 'default'}')"></span>
		// 		<div id="allocator_content_${group.group_id}">
		// 		</div>
		// 	</div>
		// </div>`;

		const box = $("#group_template .test").clone();
		box.attr("id", `group_box_${group.group_id}`);
		box.data(groupDataIdKey, group.group_id);
		box.data(groupDataNameKey, group.group_name);
		box.data(groupDataAllocatorKey, (group.group_allocator_type || 'default'));

		box.find(".allocatorContent").attr("id", `allocator_content_${group.group_id}`);

		box.find(".groupTitle").text(group.group_name);
		const table = box.find(".participants");
        
		if (group.participants.length == 0) {
			table.remove();
			box.find(".participants_container").append("<p><%- t('participants.errormessage.zeroInGroup.title', { ns : 'groups' }) %></p>")
		}
		else {
			study.participants.forEach(function(participant) {
				if (group.participants.includes(participant.user_id)) {
					let newRow = $(`
						<tr>
							<td>${participant.username}</td>
							<td>${participant.isToken}</td>
							<td>${participant.token}</td>
							<td><a href="${participant.email}">${participant.email}</a></td>
							<td>${participant.role}</td>
							<td><input class="red" type="button" value="<%- t('participant.delete', { ns : 'groups' }) %>"></td>
						</tr>
					`);
					table.append(newRow);
					newRow.data(userDataIdKey, participant.user_id);
					newRow.data(userDataNameKey, participant.username);
				}
			});
		}
		
		box.find(".kebab-dropdown").fadeOut(0);
		$('#groups_container').append(box);
        toggleGroup(group.group_id);
	}

	let groupRow = function(group) {
		let toret = `<tr><td>${group.group_name}</td><td><input class="red" type="button" value="<%- t('groups.delete.title', { ns : 'groups' }) %>" onclick="deleteGroup('${group.group_id}', '${group.group_name}')" `
		if (group.link && group.link.type) {
			toret += ' disabled';
		}
		toret += '></td></tr>';

		return toret;
	}

	let addGroupRow = function(group) {
		return `<option value="${group.group_id}">${group.group_name}</option>`;
	}

	let paintAllocator = function(group, tests, groups, participants) {
		const allocatorType = group.group_allocator_type || 'default';
		if (AllocatorFactory.Painters[allocatorType]) {
			AllocatorFactory.Painters[allocatorType].setTests(tests);
			AllocatorFactory.Painters[allocatorType].setGroups(groups);
			AllocatorFactory.Painters[allocatorType].setStudy(study);
			AllocatorFactory.Painters[allocatorType].setParticipants(participants);
			AllocatorFactory.Painters[allocatorType].paintAllocatorForGroup(group, `#allocator_content_${group.group_id}`);
		} 
        else {
			$(`#allocator_content_${group.group_id}`).html(`<p>Allocator type: ${allocatorType}</p>`);
		}
	}


	let platformRow = function(platform) {
		let toret = `<tr><td>${platform.name}</td><td><input class="red" type="button" value="<%- t('lti_platform.delete.title', { ns : 'groups' }) %>"
		onclick="removePlatform('${platform._id}')"
		></td></tr>`;
		return toret;
	}

	let allocationRow = function(allocation, tests){
		let toret = `<tr><td>${allocation.username}</td><td><select name="test">`;

		if (tests.length > 0) {
			for (var i = 0; i < tests.length; i++) {
				if (allocation.test == tests[i].session_id) {
					toret += `<option value="${tests[i].session_id}">${tests[i].session_name}</option>`;
				} else {
					toret += `<option value="${tests[i].session_id}" selected>${tests[i].session_name}</option>`;
				}
			}
		} else {
			toret += "<option><%- t('no_session_assigned.title', { ns : 'groups' }) %></option>";
		}

		toret += '</select></td></tr>';
		return toret;
	}

    


	let paintPlatforms = function(platforms) {
		$('#lti_platforms').html('');
		if (platforms.length == 0) {
			$('#lti_platforms').append("<p><%- t('lti_platform.zero.message', { ns : 'groups' }) %></p>");
		} else {
			for (var i = 0; i < platforms.length; i++) {
				$('#lti_platforms').append(platformRow(platforms[i]));
			}
		}
	}

</script>

