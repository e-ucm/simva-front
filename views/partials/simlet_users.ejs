
<!-- Section where all users will be painted -->
<div class="users">
	<!-- Coordinators table -->
    <div class="card coordinators">
        <div class="groupTop">
			<div class="tooltipLine">
	            <h2><%- t('coordinators.title', { ns : 'groups' }) %></h2>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('coordinator.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
            <div class="expandButton" onclick="toggleCoordinators()"></div>
        </div>
        <table class="owners" id="coordinators">
            <thead>
                <th><%- t('coordinators.table.username.title', { ns : 'groups' }) %></th>
                <th><%- t('coordinators.table.permissions.title', { ns : 'groups' }) %></th>
                <th></th>
            </thead>
            <tbody>
                
            </tbody>
        </table>
    </div>

	<!-- Template for each row of the coordinators table -->
	<div id="coordinator_template" style="display: none;">
		<!-- tr needs to be contained inside a table, otherwise the 
		browser will delete it and won't be able to be cloned -->
		<table>
			<tr>
				<td class="username">-</td>
				<td class="permissions">-</td>
				<td><input class="red" type="button" value="<%- t('coordinators.delete.title', { ns : 'groups' }) %>"></td>
			</tr>
		</table>
	</div>

    
	<div class="card groups">
		<div class="top groupTop">
			<div class="tooltipLine">
				<h2><%- t('groups.title', { ns : 'groups' }) %></h2>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('group.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
		</div>
		
		<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'groups' }); %>
		<%- include('filtering_pagination_commons', { id:"groups", searchBarPlaceholderText: searchBarPlaceholder }) %>

		<!-- Container for all the groups cards -->
		<span id="no_groups_msg"></span>
		<div id="groups">
            
		</div>

		<div id="groups_loader" class="loader" style="margin-bottom: 20px;">
			<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
		</div>
	</div>

	<!-- Template for each element of the groups list -->
	<div id="group_template" style="display: none;">
        <div class="test">
            <div class="groupTop">
                <h2 class="groupTitle">		</h2>
                <div class="expandButton"></div>
                <div class="kebab">
                    <ul class="kebab-dropdown">
                        <li class="text-with-icon icon-edit" title="<%- t('groups.settings.groups.edit.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.groups.edit.title', { ns : 'groups' }) %>
                        </li>
                        <li class="text-with-icon icon-add" title="<%- t('groups.settings.add.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.add.title', { ns : 'groups' }) %>
                        </li>
                        <li class="text-with-icon icon-gear" title="<%- t('groups.settings.allocator.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.allocator.title', { ns : 'groups' }) %>
						<li class="text-with-icon icon-download" title="<%- t('groups.settings.print.title', { ns : 'groups' }) %>">
							<%- t('groups.settings.print.title', { ns : 'groups' }) %>
                        </li>
                        </li>
						<li class="text-with-icon icon-export" title="<%- t('groups.settings.export.title', { ns : 'groups' }) %>">
							<%- t('groups.settings.export.title', { ns : 'groups' }) %>
						</li>
                        <li class="text-with-icon icon-delete" title="<%- t('groups.settings.delete.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.delete.title', { ns : 'groups' }) %>
                        </li>
                    </ul>
                </div>
            </div>
			<div class="deprecated_generation">
				<p><%- t('deprecated.message', { ns : 'groups' }) %></p>
            </div>
            <div class="allocatorContent">
            </div>
			<strong><%- t('participants.title', { ns : 'groups' }) %>:</strong><span  class="groupParticipantsCount">-</span>
			<div class="tooltipLine participantsTitle" style="margin-top: 15px; margin-bottom: 15px;">
				<h3><%- t('participants.title', { ns : 'groups' }) %></h3>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('participant.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>

			<span class="no_participants_msg"></span>
            <div class="participants_container">
                <table class="participants">
                    <thead>
                        <th><%- t('participants.table.username.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.token.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.email.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.role.title', { ns : 'groups' }) %></th>
                        <th></th>
                    </thead>
                    <tbody>
                
                    </tbody>
                </table>
            </div>
        </div>
    </div>

	<!-- Template for each row of the participants table -->
	<div id="participant_template" style="display: none;">
		<!-- tr needs to be contained inside a table, otherwise the 
		browser will delete it and won't be able to be cloned -->
		<table>
			<tr>
				<td class="username">	</td>
				<td class="token">	</td>
				<td><a class="email">	</a></td>
				<td class="role">	</td>
				<td><input class="red" type="button" value="<%- t('participant.delete.title', { ns : 'groups' }) %>"></td>
			</tr>
		</table>
	</div>

</div>

<!-- Add/edit groups/Add coordinator menu -->
<div id ="users_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="group_form">
			<h1 id="users_form_title">  </h1>
			<div class="tabs" id="add_group_tabs">
				<span id="group_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'group_form','group_name_desc_tab')"><%- t('groups.add.new.tab', { ns : 'groups' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'group_form','import_group_tab')"><%- t('groups.import.tab', { ns : 'groups' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'group_form','coordinators_tab')"><%- t('coordinators.add.title', { ns : 'groups' }) %></span>
			</div>

			<!-- Create/edit group -->
			<div id="group_name_desc_tab" class="subform selected">
				<form id="group_form">
					<input hidden type="text" name="editingGroupId" id="edit_group_id">
					<input hidden type="text" name="prevGroupName" id="prev_group_name">
					<h3><%- t('groups.name.title', { ns : 'groups' }) %></h3>
					<input type="text" class="name_field" name="groupName" id="group_name" placeholder="<%- t('groups.name.placeholder', { ns : 'groups' }) %>" required>
					<!-- TEST -->
					<!-- <h3><%- t('deprecated.title', { ns : 'groups' }) %></h3> -->
					<!-- <input type="checkbox" name="group_use_deprecated_generation" id="group_use_deprecated_generation" title="<%- t('deprecated.tooltip', { ns : 'groups' }) %>"><label for="group_use_deprecated_generation" ><%- t('deprecated.title', { ns : 'groups' }) %></label> -->
					<!-- <br><br> -->
					<input type="submit" id="group_submit" value="<%- t('groups.add.new.submit', { ns : 'groups' }) %>">
				</form>
			</div>

			<!-- Import group -->
			<div id="import_group_tab" class="subform" style="display: none;">
				<form id="import_group_form_modal">
					<h3><%- t('groups.name.title', { ns : 'groups' }) %></h3>
					<input type="text" class="name_field" name="groupName" id="import_group_name_modal" placeholder="<%- t('groups.name.placeholder', { ns : 'groups' }) %>" required>
					<h3><%- t('groups.import.input', { ns : 'groups' }) %></h3>
					<input type="file" name="jsonFile" accept=".json" required>
					<input type="submit" value="<%- t('groups.import.submit', { ns : 'groups' }) %>">
				</form>
			</div>

			<!-- Add coordinator -->
			<div id="coordinators_tab" class="subform">
				<form id="existing_coordinator_form">
					<h3><%- t('coordinators.name.title', { ns : 'groups' }) %></h3>
					<input type="text" class="name_field" id="coordinator_name" name="name" placeholder="<%- t('coordinators.name.placeholder', { ns : 'groups' }) %>" required>
					<div class="tooltipLine">
						<h3><%- t('coordinators.permission.title', { ns : 'groups' }) %></h3>
						<div class="tooltip">
							&#x1F6C8;
							<span class="tooltiptext">
								<%= t('coordinator.description', { ns : 'about' }) %>
							</span>
						</div>
					</div>
					<select name="permission" required>
						<option value=""><%- t('coordinators.permission.placeholder', { ns : 'groups' }) %></option>
						<option value="READ"><%- t('coordinators.permissions.read', { ns : 'groups' }) %></option>
						<option value="WRITE"><%- t('coordinators.permissions.write', { ns : 'groups' }) %></option>
					</select>
					<input type="submit" value="<%- t('coordinators.add.title', { ns : 'groups' }) %>">
				</form>
			</div>
			
			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="users_error"></span>
		</div>
	</div>
</div>

<!-- Add participants menu -->
<div id="add_participant" class="new_element floating">
	<div class="floater">
		<div class="form" id="add_participant_form">
			<h1><%= t('groups.settings.add.title' , { ns : 'groups' }) %></h1>
			<div class="tabs">
				<span id="existing_participant_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'add_participant_form','existing_participant_tab')"><%= t('participants.add.existing.tab' , { ns : 'groups' }) %></span>
				<!-- <span class="tab" onclick="Utils.changeTab(this, 'add_participant_form','new_participant_tab')"><%= t('participants.add.new.tab' , { ns : 'groups' }) %></span> -->
				<span id="add_batch_tab_button" class="tab" onclick="Utils.changeTab(this, 'add_participant_form','batch_participant_tab')"><%= t('participants.add.batch.tab' , { ns : 'groups' }) %></span>
			</div>

			<!-- Add existing participants -->
			<div id="existing_participant_tab" class="subform selected">
				<form id="existing_participant_form">
					<br>
					<textarea type="text" name="name" style="max-height: 10rem; " placeholder="<%- t('participants.username.placeholder.batch', { ns : 'groups' }) %>" required></textarea>
					<input type="submit" value="<%= t('participants.add.existing.submit' , { ns : 'groups' }) %>">
				</form>
			</div>

			<!-- Add new participant -->
			<div id="new_participant_tab" class="subform" style="display: none;">
				<form id="new_participant_form">
					<br>
					<input type="text" class="name_field" name="username" placeholder="<%= t('participants.username.placeholder', { ns : 'groups' }) %>" value="" required>
					<br>
					<input type="email" class="name_field" name="email" placeholder="<%= t('participants.add.new.email.placeholder', { ns : 'groups' }) %>" value="" required>
					<br>
					<input type="password" class="name_field" name="password" placeholder="<%= t('participants.add.new.password.placeholder', { ns : 'groups' }) %>" required>
					<br>
					<div class="role_selector">
						<input id="teacher_role" type="radio" name="role" value="teacher"><label for="teacher_role"><%= t('teacher' , { ns : 'roles' }) %></label>
						<input id="student_role" type="radio" name="role" value="student" checked><label for="student_role"><%= t('student' , { ns : 'roles' }) %></label>
					</div>

					<input type="submit" value="<%= t('participants.add.new.groups.add.new.submit' , { ns : 'groups' }) %>">
				</form>
			</div>

			<!-- Add batch of tokens -->
			<div id="batch_participant_tab" class="subform" style="display: none;">
				<form id="batch_participant_form">
					<p><%= t('participants.add.batch.number.title' , { ns : 'groups' }) %></p>
					<input type="number" step="1" min='1' max="100" name="amount" value="1">
					<p><%= t('participants.add.batch.algorithFormat' , { ns : 'groups' }) %></p>
					<select name="algorithm">
						<option value="letters"><%= t('participants.add.batch.algorithFormat.letters' , { ns : 'groups' }) %></option>
						<option value="alphanumeric"><%= t('participants.add.batch.algorithFormat.alphanumeric' , { ns : 'groups' }) %></option>
						<option value="base58"><%= t('participants.add.batch.algorithFormat.base58' , { ns : 'groups' }) %></option>
					</select>
					<p><%= t('participants.add.batch.length.title' , { ns : 'groups' }) %></p>
					<input type="number" step="1" min='4' max="10" name="length" value="4">
					<input type="submit" value="<%= t('participants.add.batch.tab' , { ns : 'groups' }) %>">
				</form>
			</div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="participants_error"></span>

		</div>
	</div>
</div>

