
<div class="users">
    <div class="card coordinators">
        <div class="groupTop">
			<div class="tooltipLine">
	            <h2><%- t('coordinators.title', { ns : 'groups' }) %></h2>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('coordinator.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
            <div class="expandButton" onclick="toggleOwners()"></div>
        </div>
        <table class="owners" id="coordinators">
            <thead>
                <th><%- t('coordinators.table.username.title', { ns : 'groups' }) %></th>
                <th><%- t('coordinators.table.permissions.title', { ns : 'groups' }) %></th>
                <th></th>
            </thead>
            <tbody>
                
            </tbody>
        </table>
    </div>

	<!-- Template for each row of the coordinators table -->
	<div id="coordinator_template" style="display: none;">
		<!-- tr needs to be contained inside a table, otherwise the 
		browser will delete it and won't be able to be cloned -->
		<table>
			<tr>
				<td class="username"> </td>
				<td class="permissions"> </td>
				<td><input class="red" type="button" value="<%- t('coordinators.delete.title', { ns : 'groups' }) %>"></td>
			</tr>
		</table>
	</div>

    
	<div class="card groups">
		<div class="top">
			<div class="tooltipLine">
				<h2><%- t('groups.title', { ns : 'groups' }) %></h2>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('group.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
		</div>
		<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'groups' }); %>
		<%- include('filtering_pagination_commons', { id:"groups", searchBarPlaceholderText: searchBarPlaceholder }) %>
		<div id="groups_container">
            
		</div>

		<div id="groups_loader" class="loader">
			<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
		</div>
	</div>

	<!-- Template for each element of the groups list -->
	<div id="group_template" style="display: none;">
        <div class="test">
            <div class="groupTop">
                <h3 class="groupTitle">		</h3>
                <div class="expandButton"></div>
                <div class="kebab">
                    <ul class="kebab-dropdown">
                        <li class="kebab-icon icon-edit" title="<%- t('groups.settings.groups.edit.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.groups.edit.title', { ns : 'groups' }) %>
                        </li>
                        <li class="kebab-icon icon-add" title="<%- t('groups.settings.add.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.add.title', { ns : 'groups' }) %>
                        </li>
                        <li class="kebab-icon icon-gear" title="<%- t('groups.settings.allocator.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.allocator.title', { ns : 'groups' }) %>
						<li class="kebab-icon icon-download" title="<%- t('groups.settings.print.title', { ns : 'groups' }) %>">
							<%- t('groups.settings.print.title', { ns : 'groups' }) %>
                        </li>
                        </li>
						<li class="kebab-icon icon-export" title="<%- t('groups.settings.export.title', { ns : 'groups' }) %>">
							<%- t('groups.settings.export.title', { ns : 'groups' }) %>
						</li>
                        <li class="kebab-icon icon-delete" title="<%- t('groups.settings.delete.title', { ns : 'groups' }) %>">
                            <%- t('groups.settings.delete.title', { ns : 'groups' }) %>
                        </li>
                    </ul>
                </div>
            </div>
			<div class="deprecated_generation">
            </div>
            <div class="allocatorContent">
            </div>
			<strong class="groupParticipantsCount"><%- t('participants.title', { ns : 'groups' }) %>: 	</strong>
			<div class="tooltipLine participantsTitle" style="margin-top: 15px;">
				<h3><%- t('participants.title', { ns : 'groups' }) %></h3>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('participant.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
            <div class="participants_container">
                <table class="participants">
                    <thead>
                        <th><%- t('participants.table.username.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.isToken.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.token.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.email.title', { ns : 'groups' }) %></th>
                        <th><%- t('participants.table.role.title', { ns : 'groups' }) %></th>
                        <th></th>
                    </thead>
                    <tbody>
                
                    </tbody>
                </table>
            </div>
        </div>
    </div>

	<!-- Template for each row of the participants table -->
	<div id="participant_template" style="display: none;">
		<!-- tr needs to be contained inside a table, otherwise the 
		browser will delete it and won't be able to be cloned -->
		<table>
			<tr>
				<td class="username">	</td>
				<td class="isToken">	</td>
				<td class="token">	</td>
				<td><a class="email">	</a></td>
				<td class="role">	</td>
				<td><input class="red" type="button" value="<%- t('participant.delete.title', { ns : 'groups' }) %>"></td>
			</tr>
		</table>
	</div>

</div>


<div id ="users_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="group_form">
			<h1 id="users_form_title">  </h1>
			<div class="tabs" id="add_group_tabs">
				<span id="group_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'group_form','group_name_desc_tab')"><%- t('groups.add.new.tab', { ns : 'groups' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'group_form','import_group_tab')"><%- t('groups.import.tab', { ns : 'groups' }) %></span>
				<span id="owners_tab_button" class="tab" onclick="Utils.changeTab(this, 'group_form','owner_tab')"><%- t('coordinators.add.title', { ns : 'groups' }) %></span>
			</div>

			<div id="group_name_desc_tab" class="subform selected">
