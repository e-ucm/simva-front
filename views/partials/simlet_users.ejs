<!-- Add group floating button -->
<div class="floating_buttons">
    <div unselectable="on" class="basic" onclick="openAddUsersForm()">
		<img src="../icon/group.png" style="filter: brightness(0) saturate(100%);">
		<span>+</span>
	</div>
</div>

<!-- Template for each row of the group printable table -->
<div id="participant_printable_template" style="display: none;">
	<!-- tr needs to be contained inside a table, otherwise the 
	browser will delete it and won't be able to be cloned -->
	<table>
		<tr>
			<td class="index"> </td>
			<td></td>
			<td class="username">	</td><td class="username">	</td><td class="username">	</td><td class="username">	</td>
		</tr>
	</table>
</div>


<script>
	// Id of the group that opened the edit group menu
	let editingGroupId = null;
	
	// Ids for the data-* attributes of each group card
	const GROUP_DATA_ID_KEY = "groupId"
	const GROUP_DATA_NAME_KEY = "groupName"
	const GROUP_DATA_ALLOCATOR_KEY = "groupAllocator"
	
	// Ids for the data-* attributes of each participant row
	const USER_DATA_ID_KEY = "userId"
	const USER_DATA_NAME_KEY = "userName"
	
	
	// Menus
	
	$(document).ready(function() {
		// When submitting the add owner form
		$(document).on('submit', "#existing_owner_form", function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $('#users_error');
			const owners = simlet.direct_permissions || simlet.owners || [];

			owners.forEach((owner) => {
				if (owner.username == form.name) {
					errorbox.text("<%- t('coordinators.error.already_in', { ns : 'groups' }) %>");
					return false;
				}
			});
			if (form.permission !== "READ" && form.permission !== "WRITE") {
				// TODO: add localization
				errorbox.text("<%- t('coordinators.error.permission', { ns : 'groups' }) %>");
				return false;
			}

			Simva.getUser(form.name, function(error, users) {
				if (error) {
					errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				const foundUser = Array.isArray(users) ? users[0] : users;
				if (!foundUser || !foundUser.user_id) {
					// TODO: other error showing in this case instead of this one
					errorbox.text("<%- t('coordinators.error.not_found', { ns : 'groups' }) %>");
					return;
				}

				Simva.createSimletPermissions(simletId, { user_id: foundUser.user_id, permission: form.permission }, function(createError) {
					if (createError && createError.responseJSON) {
						errorbox.text(createError.responseJSON.message);
					} else if (createError) {
						errorbox.text(createError.message || createError);
					} else {
						Utils.toggleFormInFloating('users_form_menu');
						reloadSimlet();
					}
				});
			});

			return false;
		});
		

		// When submitting the import group from
		$(document).on('submit', '#import_group_form_modal', function(event) {
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			let errorbox = $('#import_group_error_modal');
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				let reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						raw = raw.substr(raw.indexOf(',') + 1);
						const newGroup = raw;
						Simva.importGroup(simletId, {file: newGroup, group_name: form.groupName}, function(importError, result) {
							Utils.toggleSubmit();
							if (importError) {
								errorbox.text(importError.responseJSON ? importError.responseJSON.message : importError.message || importError);
								return;
							} else {
								Utils.toggleFormInFloating('users_form_menu');
								reloadSimlet();
							}
						});
					} catch (parseError) {
						console.error('Import error:', parseError);
						Utils.toggleSubmit();
						// TODO: add localization
						errorbox.text("<%- t('groups.import.error.invalid_file', { ns : 'groups' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			} else {
				errorbox.text("<%- t('groups.import.upload.error', { ns : 'groups' }) %>");
				Utils.toggleSubmit();
			}
			return false;
		});

		// When submitting the create/edit group form
		$(document).on('submit', "#group_form", function(event) {
			let errorbox = $('#users_error');
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			
			// Creating new group
			if (form.editingGroupId == null || form.editingGroupId == "") { 
				let newGeneration = !Boolean(form.group_use_deprecated_generation);

				Simva.addGroup(simletId, { group_name : form.groupName, group_sandbox : false, group_use_new_generation : newGeneration }, function(error, result) {
					if (error && error.responseJSON) {
						Utils.toggleSubmit();
						errorbox.text(error.responseJSON.message);
					}
					else {
						// Automatically allocate group to latest created session
						let session = getLatestCreatedSession();
						if (session && session.session_id) {
							Simva.allocateToSession(simletId, result.group_id, session.session_id, {}, function(error, result){
								if(!error){
									console.log(result)
								}
							});
						}	

						// Fake a wait time and open the add participants form in the batch tab
						setTimeout(() => {	
							Utils.toggleSubmit();
							Utils.toggleFormInFloating('users_form_menu');
							openParticipantForm(result.group_id);
							Utils.changeTab($('#add_batch_tab_button'), 'add_participant_form','batch_participant_tab');
							reloadSimlet();
						}, 500);
					}
				});
			}
			// Editing group
			else {
				const groupId = form.editingGroupId;

				const nameChanged = form.prevGroupName != form.groupName;
				if (!nameChanged) {
					errorbox.text("<%- t('groups.edit.no_changes.message', { ns : 'groups' }) %>");
					Utils.toggleSubmit();
				}
				else {
					errorbox.text("");
					Simva.updateGroup(simletId, form.editingGroupId, { group_name : form.groupName }, function(error, result) {
						if (!error) {
							Utils.toggleSubmit();
							Utils.toggleFormInFloating('users_form_menu');
							reloadSimlet();
						}
					});
				}
			}
			return false;
		});
		

		// When submitting the add existing user as participant form
		$(document).on('submit', "#existing_participant_form", function(event){
			let currentform = this;
			let form = Utils.getFormData($(this));
			let errorbox = $("#participants_error");
			let errorText = "";

			// Get all users in the group and store them by username
			const group = getGroupFromId(editingGroupId);
			let groupParticipants = new Map();
			if (group != null) {
				groupParticipants = new Map(
					group.completeParticipants.map(obj => [obj.username, obj])
				);
			}
			else {
				return false;
			}

			// Remove all the white spaces from the text area and split all the usernames by commas
			const noWhitespaces = form.name.replaceAll(/\s/g, '');
			const usernames = noWhitespaces.split(",");
			
			let foundUsers = new Map();
			let completed = 0;
			let added = 0;

			// Callback to wait for all the addGroupParticipant calls to finish
			const addUsersComplete = () => {
				completed++;
				if (completed == usernames.length) {
					// If all users have been correctly added, close the form and reload the SIMLET
					if (added == usernames.length) {
						Utils.toggleSubmit();
						Utils.toggleFormInFloating('add_participant');
						reloadSimlet();
					}
					// Otherwise, don't close the form to show the error
					else {
						Utils.toggleSubmit();

						// If some users have been added, add an extra message asking for 
						// manual refreshing (to allow the user to see the error message)
						if (added > 0) {
							errorText += `<%- t("participants.errormessage.reloadManually", { ns : "groups" }) %> <br> `
						}
						errorbox.html(errorText);
						return false;
					}
				}
			}

			// Callback to wait for all the getUser calls to finish
			const checkUserComplete = () => {
				completed++;
				if (completed == usernames.length) {
					// If all users can be added, iterate over them and try adding them 
					if (foundUsers.size == usernames.length) {
						completed = 0;
						errorText = "";
						
						Utils.toggleSubmit();
						foundUsers.forEach((user, username) => {
							Simva.addGroupParticipant(simletId, editingGroupId, user.user_id, function(addError){
								// If there are any erorrs, add them to the error message
							    if(addError && addError.responseJSON) {
									errorText += `${addError.responseJSON.message} <br> `
							    }
								else if(addError) {
									errorText += `${(addError.message || addError)} <br> ` 
							    }
								// Otherwise, increase the added users count
								else{
							        added++;
							    }
								addUsersComplete();
							});
						});
					}
					// Otherwise, don't add any user and show all the error messages
					else {
						errorbox.html(errorText);
						return false;
					}
				}
			}
  			
			// Try adding all the usernames
			usernames.forEach((username) => {
				// If any participant is already in the group, add each user to the error message 
				if (groupParticipants.has(username)) {
					errorText += `<%- t("participants.errormessage.alreadyInGroup", { ns : "groups", group : "${group.group_name}", participant : "${username}" }) %> <br> `;
					checkUserComplete();
				}
				// Otherwise, try to fetch an user from the database with said username
				else {
					Simva.getUser(username, function(error, result) {
						// If there's no user with that username, add if to the error message
						if (error) {
							errorText += `${(error.responseJSON ? error.responseJSON.message : error.message || error)} <br> ` 
						}
						else {
							const foundUser = Array.isArray(result) ? result[0] : result;
                			if(!foundUser || !foundUser.user_id){
								errorText += `<%- t("participants.errormessage.alreadyInGroup", { ns : "groups", participant : "${username}" }) %> <br> `
							}
							// If there's a user with that username, add it to the found users
							else {
								foundUsers.set(username, foundUser)
							}
						}
						checkUserComplete();
					});
				}
			})
			
			return false;
		});

