	}


	// Render

	const clearTableBody = function(table) {
		if (table.jquery != null) {
			table.find("tbody").empty();
		}
	}
	

	const paintCoordinators = function() {
		Simva.getStudyPermissions(studyid, function(error, result) {
			if (!error) {
				clearTableBody($("#coordinators"));

				result.forEach((coordinator) => {
					// Add the coordinator row synchronously to ensure they appear in order
					const row = $("#coordinator_template tr").clone()
					$('#coordinators').append(row);

					// Then, fill its details asynchronously since the order of execution doesn't matter once the row has been added
					fillCoordinatorRow(coordinator, row);
				});

				// Block coordinator addition/deletion when SIMLET is archived
				if (study.simlet_archived) {
					$('.coordinators').find(".groupTop").find("img").hide();
					$('.coordinators').find(".red").prop("disabled", true);
				}
			}
		});
	}

	// Set coordinator row parameters programatically to avoid XSS
	const fillCoordinatorRow = async function(coordinator, row) {
		row.data(userDataIdKey, coordinator.user_id);
		row.data(userDataNameKey, coordinator.username);
		
		// Determine the permissions text
		let permissions = `<%- t('coordinators.permissions.full', { ns : 'groups' }) %>`
		if (coordinator.permission.toLowerCase() === "read") {
			permissions = `<%- t('coordinators.permissions.read', { ns : 'groups' }) %>`
		}
		else if (coordinator.permission.toLowerCase() === "write") {
			permissions = `<%- t('coordinators.permissions.write', { ns : 'groups' }) %>`
		}
		
		row.find(".username").text(coordinator.username);
		row.find(".permissions").text(permissions);

		// Block the delete button if the added coordinator is the same as the current user or if it has full permissions
		if (coordinator.isCurrentUser || coordinator.permission.toLowerCase() === "full") {
			row.find(".red").prop("disabled", true);
		}
	}

	
	const GROUPS_SHOW_AT_ONCE = 5;
	let groupsFilteringPaginationData = $("#groups_filtering").data();

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		groupsFilteringPaginationData["showAtOnce"] = GROUPS_SHOW_AT_ONCE;
		groupsFilteringPaginationData["updateSearchCallback"] = onGroupSearch;
		groupsFilteringPaginationData["checkLoadMore"] = () => {
			return $("#users_tab").is(".selected");
		};
		groupsFilteringPaginationData["loadMoreCallback"] = loadGroupBatch;
	});

	// When updating any filter parameter, remove all the groups studies and load a new batch
	// (called by updateSearch in filtering_pagination_commons)
	const onGroupSearch = function() {
		$('#groups_container').empty();

		// Recalculate the total count of matching results
		Simva.getStudyGroupsCount(studyid, groupsFilteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				groupsFilteringPaginationData["totalResults"] = result.count;
				groupsFilteringPaginationData["updateSearchOptions"]();
				loadGroupBatch();
			}
		});
	}

	// Load batch of max GROUPS_SHOW_AT_ONCE groups matching the search parameters and paint them 
	// Gets called both when updating the search results and when loading the next page of results
	const loadGroupBatch = function() {
		$("#groups_loader").show();
		
		// TODO: Filter out sandbox groups?
		Simva.getStudyGroups(studyid, groupsFilteringPaginationData["searchParams"], function(error, result){
			if (!error) {
				paintGroupBatch(result);
				$("#groups_loader").hide();
			}
		});
	}
	
	const paintGroupBatch = function(groupBatch) {
		groupBatch.forEach((group) => {
			// Add the group card synchronously to ensure they appear in order
			const card = $("#group_template .test").clone();
			$('#groups_container').append(card);
			card.find(".kebab-dropdown").fadeOut(0);

			card.attr("id", `group_box_${group.group_id}`);
			card.data(groupDataIdKey, group.group_id);
			card.data(groupDataNameKey, group.group_name);
			card.data(groupDataAllocatorKey, (group.group_allocator_type || 'default'));
			card.find(".allocatorContent").attr("id", `allocator_content_${group.group_id}`);

			// Then, fill its details asynchronously since the order of execution doesn't matter once the card has been added
			fillGroupCard(group, card);
			paintAllocator(group);
		});
		
		// No results
		if (groupBatch.length == 0) {
			// No groups
			if (study.groups.length == 0) {
				$('#groups_container').append("<p><%- t('groups.no_groups.message', { ns : 'groups' }) %></p>");
			}
			// There are groups, but none of them matched the search parameters
			else {
				$('#groups_container').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
		// There's only one result
		else if (groupBatch.length == 1) {
			// Automatically expand the card to show its activities
			toggleGroup(groupBatch[0].group_id);
		}

		// Block user addition/deletion of all groups cards when SIMLET is archived
		if (study.simlet_archived) {
			$(".groupTop").find(".kebab-dropdown").find(".icon-delete").hide();
			$(".groupTop").find(".kebab-dropdown").find(".icon-add").hide();
			$(".groupTop").find(".kebab-dropdown").find(".icon-gear").hide();
			$('.participants').find(".red").prop("disabled", true);
		}
	}
	
	// Set group card parameters programatically to avoid XSS
	let fillGroupCard = async function(group, card) {
		card.find(".groupTitle").text(group.group_name);
		card.find(".groupParticipantsCount").after(group.participants.length);

		if(Boolean(group.group_use_new_generation)) {
			card.find(".deprecated_generation").remove();
		} else {
			card.find(".deprecated_generation").html("<p><%- t('deprecated.message', { ns : 'groups' }) %></p>");
		}

		const table = card.find(".participants");
		// If there are no users, the entire table for this group (which just has content in the header) is replaced by a message
		if (group.participants.length == 0) {
			table.remove();
			card.find(".participants_container").append("<p><%- t('participants.no_users.message', { ns : 'groups' }) %></p>")
		}
		else {
			// Callback to fill the table with the users info 
			// (called after retreiving the complete group info from either the previously stored groups info or from the database)
			const fillCompleteFields = function(completeGroup) {
				completeGroup.completeParticipants.forEach(function(participant) {
					participantsById.set(participant.user_id, participant)
					participantsByUsername.set(participant.username, participant)

					const row = $("#participant_template tr").clone()
					row.data(userDataIdKey, participant.user_id);
					row.data(userDataNameKey, participant.username);
					table.append(row);

					let role = participant.role === "teacher" ? `<%- t('teacher', { ns : 'roles' }) %>` : `<%- t('student', { ns : 'roles' }) %>`
					let isToken = participant.isToken ? `<%- t('participants.isToken.true', { ns : 'groups' }) %>` : `<%- t('participants.isToken.false', { ns : 'groups' }) %>`
					let token = participant.token == null ? "-" : participant.token
					
					row.find(".username").text(participant.username);
					row.find(".isToken").text(isToken);
					row.find(".token").text(token);
					row.find(".email").attr("href", participant.email);
					row.find(".email").text(participant.email);
					row.find(".role").text(role);
				});
			}

			// Get the complete group info and fill the card fields that depend on that info
			if (completeGroupsById.has(group.group_id)) {
				fillCompleteFields(completeGroupsById.get(group.group_id));
			}
			// If the complete info hasn't been stored yet, retreive it and store it for faster access
			else {
				Simva.getGroup(studyid, group.group_id, function(error, result) {
					if(!error) {
						completeGroupsById.set(group.group_id, result);
						fillCompleteFields(result);
					}
				});
			}
		}
		
        toggleGroup(group.group_id);
	}


	let paintAllocator = async function(group) {
		let completed = 0;

		const onLoadComplete = () => {
			completed++;
			if (completed == 2) {
				const allocatorType = group.group_allocator_type || 'default';
				if (AllocatorFactory.Painters[allocatorType]) {
					AllocatorFactory.Painters[allocatorType].setTests(Array.from(sessionsById.values()));
					AllocatorFactory.Painters[allocatorType].setGroups(Array.from(groupsById.values()));
					AllocatorFactory.Painters[allocatorType].setStudy(study);
					AllocatorFactory.Painters[allocatorType].setParticipants(group);
					AllocatorFactory.Painters[allocatorType].paintAllocatorForGroup(group, `#allocator_content_${group.group_id}`);
				} 
				else {
					$(`#allocator_content_${group.group_id}`).html(`<p><%- t('allocator.type.title', { ns : 'SIMLETs' }) %>: ${allocatorType}</p>`);
				}
			}
		}
		
		// If all sessions have already been retreived, call the callback directly
		if (sessionsById.size == study.sessions.length) {
			onLoadComplete();
		}
		else {
			Simva.getStudyTests(studyid, function(error, result) {
				if (!error) {
					sessionsById = new Map(
						result.map(obj => [obj.session_id, obj])
					);
					onLoadComplete();
				}
			})
		}

		// Same for the groups
		if (groupsById.size == study.groups.length) {
			onLoadComplete();
		}
		// Otherwise, retreive them from the database, store them, and call the callback once it's done
		else {
			Simva.getStudyGroups(studyid, function(error, result) {
				if (!error) {
					groupsById = new Map(
						result.map(obj => [obj.group_id, obj])
					);
					onLoadComplete();
				}
			})
		}

		
	}

	
	// TODO: TEST
	let paintPlatforms = function(platforms) {
		$('#lti_platforms').html('');
		if (platforms.length == 0) {
			$('#lti_platforms').append("<p><%- t('lti_platform.zero.message', { ns : 'groups' }) %></p>");
		} else {
			for (var i = 0; i < platforms.length; i++) {
				$('#lti_platforms').append(platformRow(platforms[i]));
			}
		}
	}
	
	let platformRow = function(platform) {
		let toret = `<tr><td>${platform.name}</td><td><input class="red" type="button" value="<%- t('lti_platform.delete.title', { ns : 'groups' }) %>"
		onclick="removePlatform('${platform._id}')"
		></td></tr>`;
		return toret;
	}

