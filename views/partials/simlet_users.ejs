<div class="floating_buttons">
    <div unselectable="on" class="basic" onclick="openGroupForm()">
		<img src="../icon/group.png" style="filter: brightness(0) saturate(100%);">
		<span>+</span>
	</div>
</div>


<script>
	let editingGroupId = null;
	
	const groupDataIdKey = "groupId"
	const groupDataNameKey = "groupName"
	const groupDataAllocatorKey = "groupAllocator"
	const userDataIdKey = "userId"
	const userDataNameKey = "userName"
	
	
	// Menus
	
	$(document).ready(function() {
		// Add owner
		$(document).on('submit', "#existing_owner_form", function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $(this).find('.error');
			const owners = study.direct_permissions || study.owners || [];

			for (var i = 0; i < owners.length; i++) {
				if (owners[i].username == form.name) {
					errorbox.text("<%- t('coordinators.error.already_in', { ns : 'groups' }) %>");
					return false;
				}
			}
			if (form.permission !== "READ" && form.permission !== "WRITE") {
				// TODO: add localization
				errorbox.text("<%- t('coordinators.error.permission', { ns : 'groups' }) %>");
				return false;
			}

			Simva.getUsers({ username: form.name }, function(error, users) {
				if (error) {
					errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				const foundUser = Array.isArray(users) ? users[0] : users;
				if (!foundUser || !foundUser.user_id) {
					// TODO: other error showing in this case instead of this one
					errorbox.text("<%- t('coordinators.error.not_found', { ns : 'groups' }) %>");
					return;
				}

				Simva.createStudyPermissions(studyid, { user_id: foundUser.user_id, permission: form.permission }, function(createError) {
					if (createError && createError.responseJSON) {
						errorbox.text(createError.responseJSON.message);
					} else if (createError) {
						errorbox.text(createError.message || createError);
					} else {
						Utils.toggleAddForm('add_owner');
						reloadStudy();
					}
				});
			});

			return false;
		});
		

		// Import group from modal tab
		$(document).on('submit', '#import_group_form_modal', function(event) {
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit(currentform);
			let errorbox = $('#import_group_error_modal');
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				var reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						raw = raw.substr(raw.indexOf(',') + 1);
						var newGroup = raw;
						Simva.importGroup(studyid, {file: newGroup, group_name: form.groupName}, function(importError, result) {
							Utils.toggleSubmit(currentform);
							if (importError) {
								errorbox.text(importError.responseJSON ? importError.responseJSON.message : importError.message || importError);
								return;
							} else {
								$("#group_form_menu").removeClass("shown");
								reloadStudy();
							}
						});
					} catch (parseError) {
						console.error('Import error:', parseError);
						Utils.toggleSubmit(currentform);
						// TODO: add localization
						errorbox.text("<%- t('groups.import.error.invalid_file', { ns : 'groups' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
				Utils.toggleAddForm('group_form_menu');
			} else {
				errorbox.text("<%- t('groups.import.upload.error', { ns : 'groups' }) %>");
				Utils.toggleSubmit(currentform);
			}
			return false;
		});

		// Create/edit group
		$(document).on('submit', "#group_form", function(event) {
			let errorbox = $('#group_form_error');
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit(currentform);
			
			// Creating new group
			if (form.editingGroupId == null || form.editingGroupId == "") { 
				let newGeneration = !Boolean(form.group_use_deprecated_generation);
				Simva.addGroup(studyid, { group_name : form.groupName, group_sandbox : false, group_use_new_generation : newGeneration }, function(error, result) {
					if (error && error.responseJSON) {
						Utils.toggleSubmit(currentform);
						errorbox.text(error.responseJSON.message);
					}
					else {
						// Fake a wait time and open the add participants form in the batch tab
						setTimeout(() => {	
							Utils.toggleSubmit(currentform);
							Utils.toggleAddForm('group_form_menu');
							openParticipantForm(result.group_id);
							Utils.changeTab($('#add_batch_tab_button'), 'add_participant_form','batch_participant_tab');
							// reloadStudy();
						}, 500);
					}
				});
			}
			// Editing group
			else {
				const groupId = form.editingGroupId;

				const nameChanged = form.prevGroupName != form.groupName;
				if (!nameChanged) {
					errorbox.text("<%- t('groups.edit.no_changes.message', { ns : 'groups' }) %>");
					Utils.toggleSubmit(currentform);
				}
				else {
					errorbox.text("");
					Simva.updateGroup(studyid, form.editingGroupId, { group_name : form.groupName }, function(error, result) {
						if (!error) {
							Utils.toggleSubmit(currentform);
							Utils.toggleAddForm('group_form_menu');
							reloadStudy();
						}
					});
				}
			}
			return false;
		});
		

		// Add existing user as participant
		$(document).on('submit', "#existing_participant_form", function(event){
			let group = getGroupFromGroupId(editingGroupId);
			let form = Utils.getFormData($(this));
			let errorbox = $(this).find('.error');

			// Do nothing if participant is already on the group and show error 
			study.participants.forEach(function(participant) {
				if (participant.group_id == editingGroupId && participant.username == form.name) {
					errorbox.text(`<%- t("participants.errormessage.alreadyInGroup", { ns : "groups", group : "${group.group_name}", participant : "${form.name}" }) %>`); 
					return false;
				}
			});

			Simva.getUsers({ username: form.name }, function(error, users){
                if(error){
                    errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
                    return;
                }

                const foundUser = Array.isArray(users) ? users[0] : users;
                if(!foundUser || !foundUser.user_id){
                    errorbox.text("User not found");
                    return;
                } else {
                    Simva.addGroupParticipant(studyid, editingGroupId, foundUser.user_id, function(addError){
                        if(addError && addError.responseJSON){
                            errorbox.text(addError.responseJSON.message);
                        }else if(addError) {
                            errorbox.text(addError.message || addError);
                        }else{
                            Utils.toggleAddForm('add_participant');
                            reloadStudy();
                        }
                    });
                }
            });
			
			return false;
		});

		// Create and add new participant
		$(document).on('submit', "#new_participant_form", function(event){
			let form = Utils.getFormData($(this));
			let errorbox = $(this).find('.error');

			Simva.register(studyid, editingGroupId, form.username.toLowerCase(), form.email, form.password, form.role, function(error, result){
				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					Utils.toggleAddForm('add_participant');
					reloadStudy();
				}
			});

			return false;
		});

		// Generate and add a batch of new users as participant 
		$(document).on('submit', "#batch_participant_form", function(event){
			let currentform = this;
			Utils.toggleSubmit(currentform);
			let form = Utils.getFormData($(this));
			let errorbox = $(this).find('.error');

			Simva.generateAndRegister(studyid, editingGroupId, form.algorithm, form.length, form.amount, (error, generated) => {
				if(!error) { 
					Utils.toggleAddForm('add_participant');
					reloadStudy();
				}
			});
			return false;
		});

		// TODO
		// Platform
		$(document).on('submit', "#add_platform_form", function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $(this).find('.error');

			let platform = {
				url: form.url,
				name: form.name,
				clientId: form.clientId,
				authenticationEndpoint: form.authenticationEndpoint,
				accesstokenEndpoint: form.accesstokenEndpoint,
				authConfig: { "method": "JWK_SET", "key": form.jkwsUrl },
				studyId: studyid
			}

			Simva.addLtiPlatform(platform, function(error, result) {
				if (error && error.responseJSON) {
					errorbox.text(error.responseJSON.message);
				} else {
					Utils.toggleAddForm('add_platform');
					reloadStudy();
				}
			});

			return false;
		});

	});

    //TEST
	// Utils.changeTab(this, 'study_tabs','users_tab')
	
    const toggleOwners = function() {
		$(".card.coordinators").find('.expandButton').toggleClass('collapsed');
		$(".card.coordinators").find('.owners').toggleClass('collapsed');
	}

    const toggleGroup = function(groupId) {
        $(`#group_box_${groupId}`).find('.participants_container').toggleClass('collapsed');
		$(`#group_box_${groupId}`).find('.expandButton').toggleClass('collapsed');
    }
	
	const openGroupForm = function(groupId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#group_name_desc_tab_button'), 'group_form','group_name_desc_tab');
		Utils.toggleAddForm("group_form_menu");

		// Reset tab state when opening modal
		$("#group_name_desc_tab").show();
		$("#import_group_tab").hide();
		$('#edit_group_id').val(groupId || "");
		$('#group_name').val("");
		$('#prev_group_name').val("");
		$('#group_form_error').text("");
		$('#import_group_name_modal').val("");
		$('#import_group_error_modal').text("");

		// Creating new group
		if (groupId == null) {
			$("#group_form_title").text("<%- t('groups.add.title', { ns : 'groups' }) %>");
		} 
		// Editing group
		else {
			var group = getGroupFromGroupId(groupId);
			$("#add_group_tabs").hide();
			$("#group_form_title").text("<%- t('groups.edit.title', { ns : 'groups' }) %>");
			$("#group_submit").val("<%- t('groups.edit.submit', { ns : 'groups' }) %>");
			if (group) {
				$('#prev_group_name').val(group.group_name);
				$('#group_name').val(group.group_name);
			}
		}
	}

	const openParticipantForm = function(groupId) {
		editingGroupId = groupId;
		// Always open form in the add existing participant tab
		Utils.changeTab($('#existing_participant_tab_button'), 'add_participant_form','existing_participant_tab');
		Utils.toggleAddForm("add_participant");
	}

	
	const openOwnerForm = function() {
		Utils.toggleAddForm('add_owner');
		$("#owner_name").val("");
	}
    
	
	let openChangeAllocatorForm = function(groupId, currentAllocatorType) {
		editingGroupId = groupId;
		let currentGroup=groups.find(g => g.group_id == groupId);
		console.log("Current group for allocator change:", currentGroup.group_allocator_type);
		let form = $('#change_allocator_form');
		Utils.toggleAddForm('change_allocator');
		$('#change_allocator_form input:radio[name=type]').prop('checked', false);
		$(`#allocator_${currentGroup.group_allocator_type}`).prop('checked', true);
	}

	// Groups buttons shared listeners

    $(document).on('click', "#groups_container .groupTop .expandButton", function(e) {
		const data = $(this).closest(".test").data();
		toggleGroup(data[groupDataIdKey]);
	});

	$(document).on('click', ".groupTop .icon-edit", function(e) {
		const data = $(this).closest(".test").data();
		openGroupForm(data[groupDataIdKey]);
	});

	$(document).on('click', ".groupTop .icon-add", function(e) {
		const data = $(this).closest(".test").data();
		openParticipantForm(data[groupDataIdKey]);
	});
	
	$(document).on('click', ".groupTop .icon-gear", function(e) {
		const data = $(this).closest(".test").data();
		openChangeAllocatorForm(data[groupDataIdKey]);
	});

	$(document).on('click', ".groupTop .icon-export", function(e) {
		const data = $(this).closest(".test").data();
		exportGroup(data[groupDataIdKey], data[groupDataNameKey]);
	});

	$(document).on('click', ".groupTop .icon-download", function(e) {
		const data = $(this).closest(".test").data();
		const group = getGroupFromGroupId(data[groupDataIdKey]);
		
		let usernames = [];
		if (group != null) {
			study.participants.forEach(function(participant) {
				if (group.participants.includes(participant.user_id)) {
					usernames.push(participant.username)
				}
			});
		}

		$("#printable_group_name").text(`<%- t('print_table.title', { ns : 'groups' }) %> ${data[groupDataNameKey]}`);
		clearTableBody($("#printable_table"));

		let rows = "";
		for (let i = 0; i < usernames.length; i++) {
			rows += `
				<tr>
					<td>${i + 1}</td>
					<td></td>
					<td>${usernames[i]}</td><td>${usernames[i]}</td><td>${usernames[i]}</td><td>${usernames[i]}</td>
				</tr>
			`
		}
		$("#printable_table").append(rows);

		window.print();
	});

	$(document).on('click', ".groupTop .icon-delete", function(e) {
		const data = $(this).closest(".test").data();
		deleteGroup(data[groupDataIdKey], data[groupDataNameKey]);
	});

	$(document).on('click', ".participants .red", function(e) {
		const groupData = $(this).closest(".test").data();
		const userData = $(this).closest("tr").data();
		deleteParticipant(userData[userDataIdKey], userData[userDataNameKey], groupData[groupDataIdKey], groupData[groupDataNameKey])
	});

	
	// Functionality
    
	let deleteOwner = function(userId, owner) {
		if (confirm(`<%- t('coordinators.delete.confirm', { ns : 'groups', coordinator : '${owner}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.deleteStudyPermissionsForUser(studyid, userId, function(response) {
				if (response.status === 200) {
					reloadStudy();
				}
			});
		}
	}

	const exportGroup = function(groupId, groupName) {
		Simva.exportGroup(studyid, groupId, true, function(error, result) {
			if (!error) {
				const content = JSON.stringify(result, null, 2);
				const filename = `simlet-group-${groupName}-export.json`;
				Utils.download(filename, content);
			} else {
				alert(error.responseJSON ? error.responseJSON.message : (error.message || error));
			}
		});
	}

	let deleteGroup = function(groupid, groupname) {
		if (confirm(`<%- t('groups.delete.confirm', { ns : 'groups', group : '${groupname}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.deleteStudyGroup(studyid, groupid, function(response) {
				if (response.status === 200) {
					reloadStudy();
				}
			});
		}
	}

	let deleteParticipant = function(participant_id, participant, group_id, group){
		if(confirm(`<%- t('participants.delete.confirm', { ns : 'groups',  participant : '${participant}', group : '${group}' }) %>`)) {
			// A participant will only be removed from keycloak if it's been generated as a token
			Simva.deleteGroupParticipants(studyid, group_id, participant_id, getParticipantFromParticipantId(participant_id).isToken, function(response) {
				if (response.status === 200) {
					reloadStudy();
				}
			});
		}
	}
	
	let deletePlatform = function(platform) {
		if (confirm(`<%- t('lti_platform.delete.confirm', { ns : 'groups', platform : '${platform}', SIMLET : '${study.simlet_name}' }) %>`)) {
			Simva.removePlatform(platform, function(error, result) {
				if(!error){
					reloadStudy();
				}
			});
		}
	}

	let changeAllocator = function() {
		let type = $('#change_allocator_form input:radio[name=type]:checked').val();

		if (editingGroupId) {
			Simva.updateGroup(studyid, editingGroupId, { group_allocator_type: type }, function(error, result) {
				if (error) {
					$('#change_allocator_form .error').text(error.responseJSON ? error.responseJSON.message : error.message);
				} else {
					Utils.toggleAddForm('change_allocator');
					reloadStudy();
				}
			});
		} else {
			Utils.toggleAddForm('change_allocator');
		}
	}


	// Render

	const clearTableBody = function(table) {
		if (table.jquery != null) {
			table.find("tbody tr").remove();
		}
	}
	
	let paintOwners = function(owners) {
		clearTableBody($("#owners"));

		for (var i = 0; i < owners.length; i++) {
			$('#owners tbody').append(createOwnerRow(owners[i]));
		}

		// Block owner addition/deletion when SIMLET is archived
		if (study.simlet_archived) {
			$('.coordinators').find(".groupTop").find("img").hide();
			$('.coordinators').find(".red").attr("disabled", "disabled");
		}
	}

	let createOwnerRow = function(owner) {
		let permissions = `<%- t('coordinators.permissions.full', { ns : 'groups' }) %>`
		if (owner.permission.toLowerCase() === "read") {
			permissions = `<%- t('coordinators.permissions.read', { ns : 'groups' }) %>`
		}
		else if (owner.permission.toLowerCase() === "write") {
			permissions = `<%- t('coordinators.permissions.write', { ns : 'groups' }) %>`
		}

		let toret = `
			<tr>
				<td>${owner.username}</td>
				<td>${permissions}</td>
				<td><input class="red" type="button" value="<%- t('coordinators.delete.title', { ns : 'groups' }) %>"
		`;
		if (owner.isCurrentUser || owner.permission.toLowerCase() === "full") {
			toret += ' disabled="disabled"';
		} else {
			toret += ` onclick="deleteOwner('${owner.user_id}', '${owner.username}')"`
		}

		toret += '></td></tr>';
		return toret;
	}


	let paintGroups = function(groups, tests, participants) {
		$('#groups_container').html('');
		
		let painted = 0;
		if (groups.length > 0) {
			for (var i = 0; i < groups.length; i++) {
				if(Boolean(groups[i].group_sandbox)) {
					continue;
				}
				addGroupBox(groups[i])
				paintAllocator(groups[i], tests, groups, participants);
				painted++;
			}
            if (groups.length == 1 && painted > 0) {
			    toggleGroup(groups[0].group_id);
            }
		} 
        
		// If there are no groups painted (either because there are none or all of them are sandbox), add the message
		if (painted == 0) {
			$('#groups_container').append("<p><%- t('groups.no_groups.message', { ns : 'groups' }) %></p>");
		}
		
		// Block user addition/deletion when SIMLET is archived
		if (study.simlet_archived) {
			$(".groupTop").find(".kebab-dropdown").find(".icon-delete").hide();
			$(".groupTop").find(".kebab-dropdown").find(".icon-add").hide();
			$(".groupTop").find(".kebab-dropdown").find(".icon-gear").hide();
			$('.participants').find(".red").attr("disabled", "disabled");
		}
	}

	// Add group programatically to avoid XSS
	let addGroupBox = function(group) {
		const box = $("#group_template .test").clone();
		box.attr("id", `group_box_${group.group_id}`);
		box.data(groupDataIdKey, group.group_id);
		box.data(groupDataNameKey, group.group_name);
		box.data(groupDataAllocatorKey, (group.group_allocator_type || 'default'));

		box.find(".allocatorContent").attr("id", `allocator_content_${group.group_id}`);

		box.find(".groupTitle").text(group.group_name);
		if(Boolean(group.group_use_new_generation)) {
			box.find(".deprecated_generation").remove();
		} else {
			box.find(".deprecated_generation").html("<p><%- t('deprecated.message', { ns : 'groups' }) %></p>");
		}
		const table = box.find(".participants");
        
		if (group.participants.length == 0) {
			table.remove();
			box.find(".participants_container").append("<p><%- t('participants.no_users.message', { ns : 'groups' }) %></p>")
		}
		else {
			// console.log(study.participants, group.participants)
			study.participants.forEach(function(participant) {
				if (group.participants.includes(participant.user_id) && participant.group_id == group.group_id) {
					let role = participant.role === "teacher" ? `<%- t('teacher', { ns : 'roles' }) %>` : `<%- t('student', { ns : 'roles' }) %>`
					let isToken = participant.isToken ? `<%- t('participants.isToken.true', { ns : 'groups' }) %>` : `<%- t('participants.isToken.false', { ns : 'groups' }) %>`
					let token = participant.token == null ? "-" : participant.token
					let newRow = $(`
						<tr>
							<td>${participant.username}</td>
							<td>${isToken}</td>
							<td>${token}</td>
							<td><a href="${participant.email}">${participant.email}</a></td>
							<td>${role}</td>
							<td><input class="red" type="button" value="<%- t('participant.delete.title', { ns : 'groups' }) %>"></td>
						</tr>
					`);
					table.append(newRow);
					newRow.data(userDataIdKey, participant.user_id);
					newRow.data(userDataNameKey, participant.username);
				}
			});
		}
		
		box.find(".kebab-dropdown").fadeOut(0);
		$('#groups_container').append(box);
        toggleGroup(group.group_id);
	}


	let paintAllocator = function(group, tests, groups, participants) {
		const allocatorType = group.group_allocator_type || 'default';
		if (AllocatorFactory.Painters[allocatorType]) {
			AllocatorFactory.Painters[allocatorType].setTests(tests);
			AllocatorFactory.Painters[allocatorType].setGroups(groups);
			AllocatorFactory.Painters[allocatorType].setStudy(study);
			AllocatorFactory.Painters[allocatorType].setParticipants(participants);
			AllocatorFactory.Painters[allocatorType].paintAllocatorForGroup(group, `#allocator_content_${group.group_id}`);
		} 
        else {
			$(`#allocator_content_${group.group_id}`).html(`<p><%- t('allocator.type.title', { ns : 'SIMLETs' }) %>: ${allocatorType}</p>`);
		}
	}

	
	// TODO: TEST
	let paintPlatforms = function(platforms) {
		$('#lti_platforms').html('');
		if (platforms.length == 0) {
			$('#lti_platforms').append("<p><%- t('lti_platform.zero.message', { ns : 'groups' }) %></p>");
		} else {
			for (var i = 0; i < platforms.length; i++) {
				$('#lti_platforms').append(platformRow(platforms[i]));
			}
		}
	}
	
	let platformRow = function(platform) {
		let toret = `<tr><td>${platform.name}</td><td><input class="red" type="button" value="<%- t('lti_platform.delete.title', { ns : 'groups' }) %>"
		onclick="removePlatform('${platform._id}')"
		></td></tr>`;
		return toret;
	}

</script>

