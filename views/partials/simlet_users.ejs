	const getCurrentAllocation = function(groupId, participantId = null) {
		const group = getGroupFromId(groupId) || getSandboxGroupFromId(groupId);
		if (group != null) {
			const painter = getAllocatorPainterByType(group.group_allocator_type || 'default');
			if (painter != null) {
				const participant = (participantId == null) ? null : getParticipantFromId(participantId);
				return painter.getCurrentAllocation(group, participant);
			}
		}
		return null;
	}

	const allocateToSession = function(groupId, sessionId, participantId = null) {
		// Determine the current session the group/participant is allocated to
		let prevSessionId = getCurrentAllocation(groupId, participantId);

		let participantInfo = participantId == null ? { } : { participant_id: participantId };
		Simva.allocateToSession(simletId, groupId, sessionId, participantInfo, function(error, result) {
			if (!error) {
				// Update both the previous and the current session users
				if (prevSessionId != null) {
					onSessionUsersChange(prevSessionId);
				}
				onSessionUsersChange(sessionId);
				
				$.toast({
					heading: "<%= t('allocator.add.message', { ns : 'groups' }) %>",
					position: 'top-right',
					icon: 'success',
					stack: false
				});
			}
			else {
				$.toast({
					heading: "<%= t('allocator.add.error', { ns : 'groups' }) %>",
					text: error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			}
		});
	}

	const allocateToLatestSession = function(groupId, participantId = null) {
		let session = getLatestCreatedSession();
		if (session != null && session.session_status != SESSION_FINISHED_STATUS) {
			// Update the group/participant dropdown
			if (participantId == null) {
				$(`#group_${groupId} select`).val(session.session_id);
			}
			else {
				$(`#allocation_${groupId}_${participantId}`).val(session.session_id);
			}

			// Allocate the participant
			allocateToSession(groupId, session.session_id, participantId);
		}
	}
	

