	/**
	 * Fill the coordinators table
	 */
	const paintCoordinators = function() {
		Simva.getSimletDirectPermissions(simletId, function(error, result) {
			if (!error) {
				clearTableBody($("#coordinators"));

				result.forEach((coordinator) => {
					// Add the coordinator row synchronously to ensure they appear in order
					const row = $("#coordinator_template tr").clone()
					$('#coordinators').append(row);

					// Then, fill its details asynchronously since the order of execution doesn't matter once the row has been added
					fillCoordinatorRow(coordinator, row);
				});

				// Block coordinator addition/deletion when SIMLET is archived
				paintCoordinatorsArchived();
			}
		});
	}

	/**
	 * Fill the coordinator row info programatically to avoid XSS
	 * @param {object} coordinator - object containing the coordinator info
	 * @param {object} row - jquery object reference of the row element
	 */
	const fillCoordinatorRow = async function(coordinator, row) {
		row.data(USER_DATA_ID_KEY, coordinator.user_id);
		row.data(USER_DATA_NAME_KEY, coordinator.username);
		
		// Determine the permissions text
		let permissions = `<%- t('coordinators.permissions.full', { ns : 'groups' }) %>`
		if (coordinator.permission.toLowerCase() === "read") {
			permissions = `<%- t('coordinators.permissions.read', { ns : 'groups' }) %>`
		}
		else if (coordinator.permission.toLowerCase() === "write") {
			permissions = `<%- t('coordinators.permissions.write', { ns : 'groups' }) %>`
		}
		
		row.find(".username").text(coordinator.username);
		row.find(".permissions").text(permissions);

		// Block the delete button if the added coordinator is the same as the current user or if it has full permissions
		if (coordinator.isCurrentUser || coordinator.permission.toLowerCase() === "full") {
			row.find(".red").prop("disabled", true);
		}
	}

	
	const GROUPS_SHOW_AT_ONCE = 5;
	let groupsFilteringPaginationData = $("#groups_filtering").data();

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		groupsFilteringPaginationData["showAtOnce"] = GROUPS_SHOW_AT_ONCE;
		groupsFilteringPaginationData["updateSearchCallback"] = onGroupSearch;
		groupsFilteringPaginationData["checkLoadMore"] = () => {
			return $("#users_tab").is(".selected");
		};
		groupsFilteringPaginationData["loadMoreCallback"] = loadGroupBatch;
		groupsFilteringPaginationData["searchParams"].sandbox = false;
	});

	// When updating any filter parameter, remove all the groups studies and load a new batch
	// (called by updateSearch in filtering_pagination_commons)
	const onGroupSearch = function() {
		$('#groups').empty();

		// Recalculate the total count of matching results
		Simva.getSimletGroupsCount(simletId, groupsFilteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				groupsFilteringPaginationData["totalResults"] = result.count;
				groupsFilteringPaginationData["updateSearchOptions"]();
				loadGroupBatch();
			}
		});
	}

	/**
	 * Load batch of max GROUPS_SHOW_AT_ONCE groups matching the search parameters and paint them 
	 * (called both when updating the search results and when loading the next page of results)
	 */
	const loadGroupBatch = function() {
		$("#groups_loader").show();
		
		// Get only the sandbox groups and remove them from the SIMLET groups list to correctly display the no groups message
		Simva.getSimletGroups(simletId, { sandbox: true }, function(error, result) {
			result.forEach((group) => {
				const index = simlet.groups.indexOf(group.group_id);
				if (index > -1) {
					simlet.groups.splice(index, 1);
				}
			});
			
			// Then, get only the non sandbox groups and paint them
			Simva.getSimletGroups(simletId, groupsFilteringPaginationData["searchParams"], function(error, result) {
				if (!error) {
					paintGroupBatch(result);
					$("#groups_loader").hide();

					// Once all results have loaded, allow the bottom reached check
					// just in case more results fit on the screen
					groupsFilteringPaginationData["checkBottomReached"] = true;
					groupsFilteringPaginationData["bottomReached"]();
				}
			});
		});

	}
	
	/**
	 * Paint the cards for a batch of groups
	 * @param {Array} batch - Array of objects containing the groups info
	 */
	const paintGroupBatch = function(batch) {
		batch.forEach((group) => {
			// Provisionally store the incomplete info (which will be replaced later)  
			completeGroupsById.set(group.group_id, group);
			
			const elemId = `group_${group.group_id}`;
			let card = $(`#${elemId}`);
			
			// If the group card is not already painted, add it synchronously to ensure it appears in order
			if (card.length == 0) {
				card = $("#group_template .test").clone();
				$('#groups').append(card);
				card.find(".kebab-dropdown").hide();

				card.attr("id", `group_${group.group_id}`);
				card.data(GROUP_DATA_ID_KEY, group.group_id);
				card.data(GROUP_DATA_NAME_KEY, group.group_name);
				card.data(GROUP_DATA_ALLOCATOR_KEY, (group.group_allocator_type || 'default'));
				card.find(".allocatorContent").attr("id", `allocator_content_${group.group_id}`);

				toggleGroup(group.group_id);
			}

			// Then, update and fill the card info asynchronously since the order of execution doesn't matter once it's been added
			Simva.getGroup(simletId, group.group_id, (error, result) => {
				if(!error) {
					completeGroupsById.set(group.group_id, result);
					fillGroupCard(result, card);
				}
			});
		});
		
		paintNoGroupsMessage();
		
		// If there's only one result, automatically expand the card to show its participants
		if (batch.length > 0 && simlet.groups.length == 1) {
			toggleGroup(batch[0].group_id);
		}

		// Block group/user addition/deletion/allocation of all groups cards when SIMLET is archived
		paintGroupsArchived();
	}
	
	/**
	 * Fill the group card info programatically to avoid XSS
	 * @param {object} group - object containing the group info
	 * @param {object} card - jquery object reference of the card element
	 */
	const fillGroupCard = async function(group, card) {
		card.find(".groupTitle").text(group.group_name);
		card.find(".groupParticipantsCount").text(group.participants.length);

		if(Boolean(group.group_use_new_generation)) {
			card.find(".deprecated_generation").hide();
		} 
		else {
			card.find(".deprecated_generation").show();
		}
		
		const table = card.find(".participants");
		
		// If there are no participants, hide the table and show a message
		if (group.participants.length == 0) {
			table.hide();
			card.find(".no_participants_msg").text("<%- t('participants.no_users.message', { ns : 'groups' }) %>");
		}
		// Otherwise, show it and fill it with the participants info
		else {
			table.show();
			card.find(".no_participants_msg").text("");
			
			clearTableBody(table);
			table.find("[class]").remove();
			group.completeParticipants.forEach((participant) => {
				participantsById.set(participant.user_id, participant);
				participantsByUsername.set(participant.username, participant);

				const row = $("#participant_template tr").clone();
				row.attr("id", `group_${group.group_id}_participant_${participant.user_id}`);
				row.data(USER_DATA_ID_KEY, participant.user_id);
				row.data(USER_DATA_NAME_KEY, participant.username);
				table.append(row);

				let role = participant.role === "teacher" ? `<%- t('teacher', { ns : 'roles' }) %>` : `<%- t('student', { ns : 'roles' }) %>`
				let token = participant.token == null ? "-" : participant.token
				
				row.find(".username").text(participant.username);
				row.find(".token").text(token);
				row.find(".email").attr("href", participant.email);
				row.find(".email").text(participant.email);
				row.find(".role").text(role);
			});
		}
		
		// Paint/repaint the allocator once all the participants have been added
		card.find(".allocatorContent").empty();
		paintAllocator(group);

		// Block user deletion when SIMLET is archived
		paintParticipantsArchived();
	}


	/**
	 * Paint the allocator info on the group card
	 * @param {object} group - object containing the group info
	 */
	const paintAllocator = async function(group) {
		const onLoadComplete = () => {
			const painter = getAllocatorPainterByType(group.group_allocator_type || 'default');
			if (painter != null) {
				painter.paintInGroup(group);
			}
		}
		
		// If all sessions have already been fetched, call the callback directly
		if (sessionsById.size == simlet.sessions.length) {
			onLoadComplete();
		}
		// Otherwise, fetch them from the database, store them, and call the callback once it's done
		else {
			Simva.getSimletSessions(simletId, function(error, result) {
				if (!error) {
					sessionsById = new Map(
						result.map(obj => [obj.session_id, obj])
					);
					onLoadComplete();
				}
			})
		}

		paintAllocatorsArchived();
	}

	const paintNoGroupsMessage = function() {
		// No results
		if (groupsFilteringPaginationData["totalResults"] == 0) {
			// No groups
			if (simlet.groups.length == 0) {
				$('#no_groups_msg').text("<%- t('groups.no_groups.message', { ns : 'groups' }) %>");
			}
			// There are groups, but none of them matched the search parameters
			else {
				$('#no_groups_msg').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
		else {
			$('#no_groups_msg').text("");
		}
	}


	// Functions to call to avoid reloading the whole view when updating info of any session 

	const onCoordinatorsChanged = function() {
		paintCoordinators();
	}
	
	const onCreateOrEditGroup = function(newGroupInfo) {
		const isNew = getGroupFromId(newGroupInfo.group_id) == null;

		// Update the basic SIMLET info without repainting everything to get the new group
		updateSimletInfo(false, () => {
			// Paint/repaint the group card (which also updates the completeGroupsById)
			paintGroupBatch([newGroupInfo]);
			
			// If the group is new, update the searching parameters and move the card to the correct order
			if (isNew) {
				groupsFilteringPaginationData["totalResults"]++;
				groupsFilteringPaginationData["updateSearchOptions"]();
			}

			// Determine sort order callback
			let sortOrder = (a, b) => a.group_id - b.group_id;
			// From lower to higher
			if (groupsFilteringPaginationData["searchParams"].order.toLowerCase() == "asc") {
				if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "id") {
					sortOrder = (a, b) => a.group_id - b.group_id;
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "name") {
					sortOrder = (a, b) => a.group_name.localeCompare(b.group_name);
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "createdAt") {
					sortOrder = (a, b) => a.createdAt - b.createdAt;
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "updatedAt") {
					sortOrder = (a, b) => a.updatedAt - b.updatedAt;
				} 
			}
			// From higher to lower
			else {
				if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "id") {
					sortOrder = (a, b) => b.group_id - a.group_id;
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "name") {
					sortOrder = (a, b) => b.group_name.localeCompare(a.session_name);
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "createdAt") {
					sortOrder = (a, b) => b.createdAt - a.createdAt;
				}
				else if (groupsFilteringPaginationData["searchParams"].orderBy.toLowerCase() == "updatedAt") {
					sortOrder = (a, b) => b.updatedAt - a.updatedAt;
				} 
			}
		
			// Sort completeGroupsById and get an array of only the sorted ids
			const sorted = Array.from(completeGroupsById.values()).sort(sortOrder);
			const sortedIds = sorted.map(obj => obj.group_id);

			// Determine what position will take the new card 
			const cardPosition = sortedIds.indexOf(newGroupInfo.group_id);
			const currentMaxVisible = groupsFilteringPaginationData["searchParams"].limit;

			// If the card should be visible after being added
			if (cardPosition < currentMaxVisible) {
				// If all the cards that should be visible are painted, remove the last one
				if ($("#groups").children().length == currentMaxVisible) {
					$("#groups").children().last().remove();
				}
				
				// Automatically allocate the group to latest created group
				allocateToLatestSession(newGroupInfo.group_id);

				// If the new card should take the first place, move it before the first card of the list
				if (cardPosition == 0) {
					$("#groups").children().first().before($(`#group_${newGroupInfo.group_id}`));
				}
				// Otherwise, move it after the card that goes before 
				else if (cardPosition < currentMaxVisible) {
					const prevId = sortedIds[cardPosition - 1];
					$(`#group_${prevId}`).after($(`#group_${newGroupInfo.group_id}`));
				}
			}
			else {
				$(`#group_${newGroupInfo.group_id}`).remove();
			}
		});
	}

	const onDeleteGroup = function(groupId) {
		// Determine all the sessions that will get affected by the group deletion
		let affectedSessions = new Set();
		const group = completeGroupsById.get(groupId);
		if (group != null && group.allocations != null) {
			Object.keys(group.allocations).forEach((sessionId) => {
				affectedSessions.add(sessionId);
			});
		}
		
		// Delete the group from the stored groups
		if (completeGroupsById.delete(groupId)) {
			// Update the pagination parameters
			groupsFilteringPaginationData["totalResults"]--;
			groupsFilteringPaginationData["updateSearchOptions"]();

			updateSimletInfo(false, () => {
				// If the group card was painted, remove it and potentially paint the one that will take the free space or the no group message
				const card = $(`#group_${groupId}`);
				if (card.length > 0) {
					card.remove();
				}

			});
			
			// If the group card was painted, remove it and update the pagination parameters
			const card = $(`#group_${groupId}`);
			if (card.length > 0) {
				card.remove();
				
				const currentMaxVisible = groupsFilteringPaginationData["searchParams"].limit;

				// If there could be more cards painted after removing the session AND there are at least enough total results to fill the maximum, 
				// load a new batch of sessions (the page will be the same as the current one, but the already painted sessions will be omitted and 
				// only the new ones will be added to the page)
				if ($("#groups").find(".test").length < currentMaxVisible && groupsFilteringPaginationData["totalResults"] >= currentMaxVisible) {
					loadGroupBatch();
				}
				// Otherwise, the already existing cards will just move to take the removed one position

				paintNoGroupsMessage();
			}

			// Update all the affected sessions
			affectedSessions.forEach((sessionId) => {
				onSessionUsersChange(sessionId);
			});
		}
	}
	
	const onGroupUsersChange = function(groupId, participantsIds) {
		// Get all the sessions affected by the user change and update them
		let affectedSessions = new Set();
		participantsIds.forEach((participantId) => {
			$(`#group_${groupId}_participant_${participantId}`).remove();
			const affectedSession = getCurrentAllocation(groupId, participantId);
			if (affectedSession != null) {
				affectedSessions.add(affectedSession);
			}
		});

		// Update the group where the users have changed
		const group = getGroupFromId(groupId); 
		if (group != null) {
			onCreateOrEditGroup(group);
		}
		
		affectedSessions.forEach((sessionId) => {
			onSessionUsersChange(sessionId);
		});
	}
	
	const onCreateParticipants = function(addMethod, groupId, creationResult) {
		let participantsInfo = new Set();

		const registerAndAdd = () => {
			participantsInfo.forEach((participant) => {
				participantsById.set(participant.user_id, participant);
				participantsByUsername.set(participant.username, participant);
			});
			onGroupUsersChange(groupId, Array.from(participantsInfo).map(obj => obj.user_id));
		}
		
		// If adding by existing usernames, the creationResult returns an array with the users info
		if (addMethod == ADD_METHOD_EXISTING) {
			participantsInfo = new Set(creationResult);
			registerAndAdd();
		}
		// If adding a new user, the creationResult returns an object with the created user info
		else if (addMethod == ADD_METHOD_NEW) {
			participantsInfo.push(creationResult);
			registerAndAdd();
		}
		// If adding a batch of users, the creationResult returns an array with the created usernames
		else if (addMethod == ADD_METHOD_BATCH) {
			let newParticipants = [];
			let completed = 0;

			// Callback to call each time an user id gets fetched
			const allParticipantsFetched = () => {
				completed++;
				if (completed >= creationResult.length) {
					registerAndAdd();
				}
			}

			// Get the complete user info from each participant username 
			creationResult.forEach((username) => {
				Simva.getUser(username, (error, result) => {
					if (!error) {
						newParticipants.push(result);
					}
					allParticipantsFetched();
				});
			})
		}
	}

	const onDeleteParticipant = function(groupId, participantId) {
		onGroupUsersChange(groupId, [participantId]);
	}
	
	const onChangeGroupAllocator = function(newGroupInfo) {
		onCreateOrEditGroup(newGroupInfo);
	}

	// Iterate over all dropdowns of the groups/participants allocators to update its options (in case of session creation/deletion/name change)
	const allocatorsOnSessionsChanged = function(sessionId) {
		$("#groups .test select").each(function() {
			const dropdown = $(this);
			dropdown.empty();

			// Add all sessions to the dropdown
			sessionsById.forEach((session, sessionId) => {
				dropdown.append($("<option>", {
					value: sessionId,
					text: session.session_name,
				}));
			});

			// Determine the session the group/participant is currently allocated to
			const data = dropdown.closest(".test").data();
			const userData = dropdown.closest("tr").data();
			const participantId = (userData == null) ? null : userData[USER_DATA_ID_KEY]; 
			const currentAllocation = getCurrentAllocation(data[GROUP_DATA_ID_KEY], participantId);

			// If the session exists, select it in the dropdown 
			if (sessionsById.has(currentAllocation)) {
				dropdown.val(currentAllocation);
			}
			// Otherwise, allocate the group/participant to the latest created session
			else {
				allocateToLatestSession(data[GROUP_DATA_ID_KEY], participantId);
			}
		});
	}


