<%# views/partials/simlet_sessions.ejs %>

<!-- Elements of the sessions tab in the SIMLET view (not including the activities) -->

<% 
	const FILTERING_PAGINATION_ID = "sessions_filtering"
	const SEARCH_BAR_PLACEHOLDER = t('sessions.search_bar.placeholder', { ns : 'sessions' }); 
	let nestedPartialsResources = partialsResources;
%>
<!-- Section where all sessions will be painted -->
<div class="card">
	<div class="top">
		<div class="tooltipLine">
			<h2><%= t('sessions.title', { ns : 'sessions' }) %></h2>
			<div class="tooltip">
				&#x1F6C8;
				<span class="tooltiptext">
					<%= t('about.session.description', { ns : 'about' }) %>
				</span>
			</div>
		</div>
	</div>

	<%- include('filtering_pagination_commons', { id: FILTERING_PAGINATION_ID, partialsResources: nestedPartialsResources, searchBarPlaceholderText: SEARCH_BAR_PLACEHOLDER }) %>

	<!-- Container for all the session cards -->
	<span id="no_sessions_msg"></span>
	<div id="sessions" class="tests">
		
	</div>

	<div id="sessions_loader" class="loader" style="margin-bottom: 20px;"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></div>
	
</div>

<!-- Template for each element of the sessions list -->
<div id="session_template" style="display: none;">
	<div class="test">
		<div class="sessionTop" >
			<h2 class="sessionTitle">-</h2>
			<div class="tooltipLine">
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('sessions.status.description', { ns : 'sessions' }) %>
						<ul>
							<li><%= t('sessions.status.active.description', { ns : 'sessions' }) %></li>
							<li><%= t('sessions.status.paused.description', { ns : 'sessions' }) %></li>
							<li><%= t('sessions.status.finished.description', { ns : 'sessions' }) %></li>
						</ul>
					</span>
				</div>
				<div class="sessionStatusLabel">	</div>
			</div>
			<div class="expandButton"></div>
			<div class="kebab">
				<ul class="kebab-dropdown">
                    <li class="text-with-icon icon-edit"><%= t('sessions.kebab.edit.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-add"><%= t('sessions.kebab.add_activity.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-export"><%= t('sessions.kebab.export.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-activate"><%= t('sessions.kebab.activate.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-pause"><%= t('sessions.kebab.pause.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-finish"><%= t('sessions.kebab.finish.title', { ns : 'sessions' }) %></li>
					<li class="text-with-icon icon-tester"><%= t('sessions.kebab.set_tester.title', { ns : 'sessions' }) %></li>
					<li class="text-with-icon icon-reset-tester"><%= t('sessions.kebab.reset_tester.title', { ns : 'sessions' }) %></li>
					<li class="text-with-icon icon-untester"><%= t('sessions.kebab.unset_tester.title', { ns : 'sessions' }) %></li>
					<li class="text-with-icon icon-show"><%= t('sessions.kebab.hide_inactive_participants.title', { ns : 'sessions' }) %></li>
					<li class="text-with-icon icon-hide"><%= t('sessions.kebab.show_inactive_participants.title', { ns : 'sessions' }) %></li>
                    <li class="text-with-icon icon-delete"><%= t('sessions.kebab.delete.title', { ns : 'sessions' }) %></li>
                </ul>
            </div>
        </div>
        <div class="sessionDescription">	 </div>
        <div class="sessionSummary">
            <div class="sessionInfo">
                <strong><%= t('info.created_at', { ns : 'commons' }) %>: </strong><span class="sessionCreateDate">-</span>
                <br>
                <strong><%= t('activities.title', { ns : 'activities' }) %>: </strong><span class="sessionActivities">-</span>  
					&nbsp; 
				<strong><%= t('participants.title', { ns : 'groups' }) %>: </strong><span class="sessionUsers">-</span>
            </div>
            <div class="sessionProgress progress">
                <div class="done">	</div>
                <span>
                    <%= t('activities.table.completed.title', { ns : 'activities' }) %>: 
                    <done class="completionPercentage">		</done>% [ <doneres class="completedUsers">		</doneres> / <total class="completedTotalUsers">		</total> ]
                </span>
            </div>
			<div>
				<div class="text-with-icon icon-download sessionDownload" title="<%= t('sessions.download.description', { ns : 'sessions' }) %>" style="margin-bottom: 10px;">
					<b><%= t('sessions.download.title', { ns : 'sessions' }) %></b>
				</div>
				<div class="text-with-icon icon-play sessionTestLauch" title="<%= t('scheduler.play_as_tester.description', { ns : 'sessions' }) %>" style="margin-top: 10px;">
					<b><%= t('scheduler.title', { ns : 'SIMLETs' }) %></b>
				</div>
			</div>
        </div>
        <div class="sessionTags" style="margin-top: 8px;">	</div>
		<div class="tooltipLine activitiesTitle" style="margin-bottom: 10px;">
			<h3><%= t('activities.title', { ns : 'activities' }) %></h3>
			<div class="tooltip">
				&#x1F6C8;
				<span class="tooltiptext">
					<p><%= t('about.activity.description', { ns : 'about' }) %></p>
					<p><%= t('about.session_management.dashboard.description', { ns : 'about' }) %></p>
				</span>
			</div>
		</div>
        <div class="activities">
		</div>
		<div class="loader activities_loader" style="margin-bottom: 20px;"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></div>
    </div>
</div>

<!-- Add/edit session menu -->
<div id ="session_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="session_form">
			<h1 id="session_form_title">	</h1>
			<div class="tabs" id="add_session_tabs">
				<span id="session_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'session_form','session_name_desc_tab')"><%= t('sessions.new.tab', { ns : 'sessions' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'session_form','import_session_tab')"><%= t('sessions.import.tab', { ns : 'sessions' }) %></span>
			</div>

			<!-- Create/edit session -->
			<div id="session_name_desc_tab" class="subform selected">
				<form id="session_form">
					<input hidden type="text" name="editingSessionId" id="edit_session_id">
					<input hidden type="text" name="prevSessionName" id="prev_session_name">
					<input hidden type="text" name="prevSessionDescription" id="prev_session_description">

					<h3><%= t('forms.name.title', { ns : 'commons' }) %></h3>
					<input class="session_form_name name_field" type="text" name="sessionName" id="session_name" placeholder="<%= t('sessions.name.placeholder', { ns : 'sessions' }) %>" required>

					<h3 id="session_description_label"><%= t('forms.description.title', { ns : 'commons' }) %></h3>
					<textarea class="description_field" type="text" name="sessionDescription" id="session_description" placeholder="<%= t('sessions.description.placeholder', { ns : 'sessions' }) %>"></textarea>
					
					<h3 id="session_status_title"><%= t('sessions.status.title', { ns : 'sessions' }) %></h3>
					<select id="session_status_selector" name="sessionStatus">
						<option value="active"><%= t('sessions.status.active.title', { ns : 'sessions' }) %></option>
						<option value="inactive"><%= t('sessions.status.paused.title', { ns : 'sessions' }) %></option>
					</select>
					
					<h3 style="margin-top:15px;"><%= t('filters.tags.title', { ns : 'commons' }) %></h3>
					<div style="display: flex; gap: 10px; align-items: center;" >
						<%- include('dropdowns/tags_multi_select_dropdown', { partialsResources: nestedPartialsResources }) %>
						<button type="button" class="tagPlusButton" onclick="openTagForm()" title="<%= t('tags.create.title', { ns : 'sessions' }) %>">+</button>
					</div>
					<div id="session_tag_form" class="tagForm" style="display:none;">
						<input hidden type="text" id="edit_tag_id">
						<input hidden type="text" id="prev_tag_name">
						<input hidden type="color" id="prev_tag_color">
						
						<input type="text" class="tag_name_field" id="tag_name_field" placeholder="<%= t('tags.name.placeholder', { ns : 'sessions' }) %>" style="flex: 1;">
						<input type="color" id="tag_color_field" value="#3b82f6" style="width: 44px; padding: 0;">
						<button type="button" id="tag_create_button" onclick="createAndSelectTag()"><%= t('tags.create.title', { ns : 'sessions' }) %></button>
						<button type="button" id="tag_edit_button" onclick="editTag()"><%= t('tags.edit.title', { ns : 'sessions' }) %></button>
						<button type="button" onclick="closeTagForm()"><%= t('tags.cancel.title', { ns : 'sessions' }) %></button>
					</div>
					<span class="error" id="session_tags_error"></span>

					<!--
					<div id="can_be_manually_activated" >
						<h3><%= t('can_be_manually_activated', { ns : 'sessions' }) %></h3>
						<input type="checkbox" name="can_be_manually_activated" checked>
					</div>
					-->
					<br>
					<input type="submit" id="session_submit" value="">
				</form>
			</div>

			<!-- Import session -->
			<div id="import_session_tab" class="subform" style="display: none;">
				<form id="import_session_form">
					<h3 class="session_form_name"><%= t('forms.name.title', { ns : 'commons' }) %></h3>
					<input class="import_session_form_name name_field" type="text" name="sessionName" id="import_session_name" placeholder="<%= t('sessions.name.placeholder', { ns : 'sessions' }) %>" required>
					<h3><%= t('sessions.import.input', { ns : 'sessions' }) %></h3>
					<input type="file" name="jsonFile" accept=".json" required>
					<input type="submit" id="import_session_submit" value="<%= t('sessions.import.submit', { ns : 'sessions' }) %>">
				</form>
			</div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="session_form_error"></span>
		</div>
	</div>
</div>

<!-- Add session floating button -->
<div class="floating_buttons">
    <div unselectable="on" class="basic" onclick="openSessionForm()">
		<img src="../images/icons/study.png">
		<span>+</span>
	</div>
</div>


<script type="text/javascript">
	// Values of the sessions status on the database
    const SESSION_ACTIVE_STATUS = "active";
    const SESSION_PAUSED_STATUS = "inactive";
    const SESSION_FINISHED_STATUS = "terminated";

	// Ids for the data-* attributes of each session card
	const SESSION_DATA_ID_KEY = "sessionId"
	const SESSION_DATA_NAME_KEY = "sessionName"
	
	// Id of the session that opened the download session data menu
	let downloadSessionId = null;
	let currentUserTesterSessionId = null;
	
    // Menus

    $(document).ready(function() {
		
		// When submitting the import session form
		$(document).on('submit','#import_session_form', function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $('#session_form_error');
			errorbox.text("");
			Utils.toggleSubmit();

			// Only process the input if a file has been uploaded
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				const reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						// Always extract base64 payload from data URL
						raw = raw.substr(raw.indexOf(',') + 1);
						const newTest = raw;
						Simva.importSession(simletId, {file: newTest, session_name: form.sessionName}, function(error, result) {
							Utils.toggleSubmit();
							if (error) {
								errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
								return false;
							}
							Utils.toggleFormInFloating();
							onCreateOrEditSession(result);
						});
					} catch (parseError) {
						Utils.toggleSubmit();
						console.error('Import error:', parseError);
						errorbox.text("<%- t('sessions.import.error.invalid_file', { ns : 'sessions' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
						return false;
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			}
			// If no file has been uploaded (shouldn't happen unless the html gets altered since the file field has the required attribute)
			else {
				Utils.toggleSubmit();
				errorbox.text("<%- t('forms.import.error.no_file', { ns : 'commons' }) %>");
				return;
			}

			return false;
		});

		// When submitting the add/edit SIMLET form
        $(document).on('submit','#session_form', function(event) {
			let errorbox = $('#session_form_error');
			let form = Utils.getFormData($(this));
			errorbox.text("");
			Utils.toggleSubmit();
			
			const selectedTagIds = Array.from(sessionTagsMultiSelectInstance.selectedOptions);

			// Creating new session
			if (form.editingSessionId == null || form.editingSessionId == "") {
				Simva.addSessionToSimlet(simletId, { session_name: form.sessionName, session_description: form.sessionDescription, 
					session_can_be_manually_activated: true, session_status: form.sessionStatus }, function(error, result) 
				{
					if (error) {
						Utils.toggleSubmit();
						errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
						return false;
					}
					
					const createSession = function(resultTags) {
						Utils.toggleSubmit();
						Utils.toggleFormInFloating();

						// Since the sesion needs to be created before adding the tags, add them manually to the result info
						if (resultTags != null) {
							result.tags = resultTags;
						}
						onCreateOrEditSession(result);
					}

					if (selectedTagIds.length === 0) {
						createSession();
					}
					else {
						syncSessionTags(simletId, result.session_id, [], selectedTagIds, function(syncError, resultTags) {
							if (syncError) {
								Utils.toggleSubmit();
								errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
								return false;
							}
							createSession(resultTags);	
						});
					
					}
				});	
			}
			// Editing session
			else {
				const sessionId = form.editingSessionId;
				
				// Compare the previous name and description with the updated ones (trimming the 
				// new ones before to check if they will be the same after processing the strings)
				const nameChanged = form.prevSessionName != Utils.trimString(form.sessionName);
				const descriptionChanged = form.prevSessionDescription != Utils.trimString(form.sessionDescription);
				
				const originalTagsIds = Array.from(originalSelectedTagsIds);
				const selectedTagIds = Array.from(sessionTagsMultiSelectInstance.selectedOptions);

				const tagsChanged = selectedTagIds.length !== originalTagsIds.length || selectedTagIds.some((tagId) => !originalTagsIds.includes(tagId));

				if (!nameChanged && !descriptionChanged && !tagsChanged) {
					Utils.toggleSubmit();
					errorbox.text("<%- t('forms.edit.error.no_changes', { ns : 'commons' }) %>");
					return false;
				}
				
				const updateSession = () => {
					Simva.updateSession(simletId, Number(sessionId), { session_name : form.sessionName, session_description : form.sessionDescription }, function(error, result) {
						Utils.toggleSubmit();
						if (error) {
							errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
							return false;
						}
						onCreateOrEditSession(result);
						Utils.toggleFormInFloating();
					});
				}

				// Update the tags first and then update the session so the result info contains the updated tags
				if (tagsChanged) {
					syncSessionTags(simletId, Number(sessionId), originalTagsIds, selectedTagIds, function(syncError) {
						if (syncError) {
							Utils.toggleSubmit();
							errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
							return false;
						}
						updateSession();
					});
				}
				else {
					updateSession();
				}
			}

			return false;
		});
    });

    const openSessionForm = function(sessionId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#session_name_desc_tab_button'), 'session_form','session_name_desc_tab');

		const session = getSessionFromId(sessionId);
		
		// Open form always
		Utils.toggleFormInFloating('session_form_menu');

		$('#session_form_error').text("");
		$('#session_tags_error').text("");
		$("#session_selected_tags").empty();
		
		$('#edit_session_id').val(sessionId);

		// Creating new session
		if (sessionId == null) {
			// Show the add new/import tabs
			$("#add_session_tabs").show();

			$("#session_form_title").text("<%- t('sessions.form.add.title', { ns : 'sessions' }) %>");
			$("#session_status_title").show();
			$("#session_status_selector").show();
			$("#session_submit").val("<%- t('sessions.new.submit', { ns : 'sessions' }) %>");
			$("#can_be_manually_activated").show();

			$('#prev_session_name').val("");
			$('#prev_session_description').val("");

			$('#session_name').val("");
			$('#session_description').val("");
			
			fillSessionFormTagsDropdown([]);
		}
		// Editing session
		else {
			// Hide the add new/import tabs (only the name/description/tags tab is needed when editing session)
			$("#add_session_tabs").hide();

			$("#session_form_title").text("<%- t('sessions.form.edit.title', { ns : 'sessions' }) %>");
			$("#session_status_title").hide();
			$("#session_status_selector").hide();
			$("#session_submit").val("<%- t('sessions.form.edit.submit', { ns : 'sessions' }) %>");
			$("#can_be_manually_activated").hide();

			$('#prev_session_name').val(session.session_name);
			$('#prev_session_description').val(session.session_description);

			// Must manually trigger the input event when changing input values programatically to update the remaining count
			$('#session_name').val(session.session_name);
			$('#session_description').val(session.session_description);
			
			fillSessionFormTagsDropdown(session.tags);
		}
	}

	
	const openSessionDownloadForm = function(sessionId) {
		Utils.toggleFormInFloating('download_data_menu');
		Utils.changeTab(null, 'download_data_form','download_session_data');
        
		showSessionDownloadFormButtons(sessionId);
		
		downloadSessionId = sessionId;
		const session = getSessionFromId(sessionId);

		if (session != null) {
			$("#downloadFormTitle").text(`<%- t('sessions.title.single', { ns : 'sessions' }) %>: ${session.session_name}`);
		}
	}

	const showSessionDownloadFormButtons = function(sessionId) {
		$("#download_session_loader").hide();
		$("#session_data_download").show();
		$(".iframe_floating_close").prop("disabled", false);
		
		// Show session download button based on participant status
		$("#session_test_data_download").hide();
		if (isUserIdInSession(sessionId, currentUser.user_id)) {
			$("#session_test_data_download").show();
		}
	}

	const showSessionDownloadFormLoader = function() {
		$("#download_session_loader").show();
		$("#session_data_download").hide();
		$("#session_test_data_download").hide();
		$(".iframe_floating_close").prop("disabled", true);
	}

    // Expand/hide session info
	const toggleSession = function(sessionId) {
		$(`#session_${sessionId} .sessionTop .expandButton`).toggleClass('collapsed');
		$(`#session_${sessionId} .tooltipLine.activitiesTitle`).toggle();
		$(`#session_${sessionId} .activities`).toggle();
	}
    
	// Show/hide inactive participants in the activities tables
	const toggleInactiveParticipants = function(sessionId) {
		$(`#session_${sessionId} .activities`).toggleClass('hideInactiveParticipants');
		$(`#session_${sessionId} .sessionTop .icon-show`).toggle();
		$(`#session_${sessionId} .sessionTop .icon-hide`).toggle();
	}

	// Sync add session and import session name input 
	$(document).on("input", $(`#session_form .${NAME_FIELD_CLASS}`), function(e) {
		$(`#session_form .${NAME_FIELD_CLASS}`).each(function() {
			if (this != e.target && $(e.target).is("input:text") && $(e.target).is(`.${NAME_FIELD_CLASS}`)) {
				$(this).val($(e.target).val());
			} 
		});
	});


	// Sessions buttons shared listeners using event delegation to ensure 
	// the handler works even if element is added after the document ready event
	
	$(document).on('click', ".sessionTop .expandButton", function(e) {
		const data = $(this).closest(".test").data();
		toggleSession(data[SESSION_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".sessionTop .icon-edit", function(e) {
		const data = $(this).closest(".test").data();
		openSessionForm(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-add", function(e) {
		const data = $(this).closest(".test").data();
		openActivityForm(data[SESSION_DATA_ID_KEY], null);
	});

	$(document).on('click', ".sessionTop .icon-export", function(e) {
		const data = $(this).closest(".test").data();
		exportSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-activate", function(e) {
		const data = $(this).closest(".test").data();
		changeSessionStatus(data[SESSION_DATA_ID_KEY], "active");
	});
	
	$(document).on('click', ".sessionTop .icon-pause", function(e) {
		const data = $(this).closest(".test").data();
		changeSessionStatus(data[SESSION_DATA_ID_KEY], "inactive");
	});

	$(document).on('click', ".sessionTop .icon-finish", function(e) {
		const data = $(this).closest(".test").data();
		const sessionName = data[SESSION_DATA_NAME_KEY] || '';
		if (confirm(`<%- t('sessions.finish.confirm', { ns : 'sessions', session: '${sessionName}' }) %>`)) {
			changeSessionStatus(data[SESSION_DATA_ID_KEY], "terminated");
		}
	});

	$(document).on('click', ".sessionTop .icon-delete", function(e) {
		const data = $(this).closest(".test").data();
		deleteSession(data[SESSION_DATA_ID_KEY], data[SESSION_DATA_NAME_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-tester", function(e) {
		const data = $(this).closest(".test").data();
		console.log("setting tester for session id:", data[SESSION_DATA_ID_KEY]);
		setTesterForSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-untester", function(e) {
		const data = $(this).closest(".test").data();
		unsetTesterForSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-reset-tester", function(e) {
		const data = $(this).closest(".test").data();
		resetTesterForSession(data[SESSION_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".sessionTop .icon-show, .sessionTop .icon-hide", function(e) {
		const data = $(this).closest(".test").data();
		toggleInactiveParticipants(data[SESSION_DATA_ID_KEY]);
	});


	$(document).on('click', ".sessionSummary .icon-download", function(e) {
		const data = $(this).closest(".test").data();
		openSessionDownloadForm(data[SESSION_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".sessionSummary .icon-play", function(e) {
		const data = $(this).closest(".test").data();
		Utils.toggleIframeInFloating(`/scheduler/${simlet.simlet_id}?testMode=true`)
	});
	

	// Functionality

	/**
	 * Check if a user is still allocated to the session: the users that aren't (they were moved
	 * to another session after participating here) are marked as off in the participants tables
	 * of the activities and aren't counted as completed in the session summary
	 * @param {object} sessionId - id of the session to check if the user is in
	 * @param {number} userId - id of the user to check
	 */
	const isUserIdInSession = function(sessionId, userId) {
		// If the user is a tester of any session, return if its sandbox group is allocated to the session
		if (sandboxGroupsByOwnerId.has(userId)) {
			const group = sandboxGroupsByOwnerId.get(userId);
			return group.allocations != null && Object.values(group.allocations).includes(sessionId);
		}
		
		// Otherwise, return if the participant belongs to the session
		const participant = getUserFromId(userId);
		return participant.session_id != null && participant.session_id == sessionId;
	}

	const isUsernameInSession = function(sessionId, username) {
		return isUserIdInSession(sessionId, getUserFromUsername(username).user_id);
	}
	
	const deleteSession = function(sessionId, sessionName) {
		if (confirm(`<%- t('sessions.delete.confirm', { ns : 'sessions', session : '${sessionName}', SIMLET : '${simlet.simlet_name}' }) %>`)) {
			Simva.deleteSession(simletId, sessionId, function(response) {
				if (response.status !== 200) {
					alert(response.responseJSON.message);
					return;
				}
				onDeleteSession(sessionId);
			});
		}
	}

	/**
	 * Change a session status
	 * @param {number} sessionId - id of the sesssion to change the status for
	 * @param {string} nextStatus - status the session will be changed to (active, inactive, terminated)
	 */
	const changeSessionStatus = function(sessionId, nextStatus) {
		Simva.activateSession(simletId, sessionId, { activate: nextStatus }, function(error, result) {
