    // Render + filtering + pagination

	const SESSIONS_SHOW_AT_ONCE = 4;
	let sessionsFilteringPagination = $("#<%= FILTERING_PAGINATION_ID %>").data()[FILTERS_PAGINATION_DATA_KEY];

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		sessionsFilteringPagination.showAtOnce = SESSIONS_SHOW_AT_ONCE;
		sessionsFilteringPagination.updateSearchCallback = onSessionSearch;
		sessionsFilteringPagination.checkLoadMore = () => {
			return $("#sessions_tab").is(".selected");
		};
		sessionsFilteringPagination.loadMoreCallback = loadSessionBatch;
	});


	/**
	 * When updating any filter parameter, remove all the painted sessions and load a new batch
	 * (called by updateSearch in filtering_pagination_commons)
	 */
	const onSessionSearch = function() {
		$('#sessions').empty();

		// Recalculate the total count of matching results
		Simva.getSimletSessionsCount(simletId, sessionsFilteringPagination.searchParams, function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				sessionsFilteringPagination.totalResults = result.count;
				sessionsFilteringPagination.updateSearchOptions();
				loadSessionBatch();
			}
		});
	}

	/**
	 * Load batch of max SESSIONS_SHOW_AT_ONCE sessions matching the search parameters and paint them 
	 * (called both when updating the search results and when loading the next page of results)
	 */
	const loadSessionBatch = function() {
		$("#sessions_loader").show();
		
		Simva.getSimletSessions(simletId, sessionsFilteringPagination.searchParams, function(error, result){
			if (!error) {
				paintSessionBatch(result);
				$("#sessions_loader").hide();

				// Once all results have loaded, allow the bottom reached check
				// just in case more results fit on the screen
				sessionsFilteringPagination.checkBottomReached = true;
				sessionsFilteringPagination.bottomReached();
			}
		});
	}

	/**
	 * Paint the cards for a batch of sessions
	 * @param {Array} batch - Array of objects containing the sessions info
	 */
	const paintSessionBatch = function(batch) {
		batch.forEach((session) => {
			// Provisionally store the incomplete info (which will be replaced later)  
			completeSessionsById.set(session.session_id, session);
			sessionsById.set(session.session_id, session);

			const elemId = `session_${session.session_id}`;
			let card = $(`#${elemId}`);

			// If the session card is not already painted, add it synchronously to ensure it appears in order
			if (card.length == 0) {
				card = $("#session_template .test").clone();
				$('#sessions').append(card);
				card.find(".kebab-dropdown").hide();
				card.find(".icon-show").hide();

				card.data(SESSION_DATA_ID_KEY, session.session_id);
				card.data(SESSION_DATA_NAME_KEY, session.session_name);
				card.attr("id", `session_${session.session_id}`);

				toggleSession(session.session_id);
			}
			
			paintSessionStatusAndPermissions(session, card);

			// Then, update and fill the card info asynchronously since the order of execution doesn't matter once it's been added
			Simva.getSimletSessionComplete(simletId, session.session_id, (error, result) => {
				if (error) return;

				session = result;
				completeSessionsById.set(session.session_id, session);
				// Store the complete activities info
				session.completeActivities.forEach((activity) => {
					completeActivitiesById.set(activity.activity_id, activity);
				})
				
				fillSessionCard(session, card);
			});
		
		});

		paintNoSessionsMessage();
		
		// Automatically expand the first session card
		if (batch.length > 0 && $("#sessions").length > 0) {
			const firstSessionCard = $("#sessions").children().first();
			if (firstSessionCard.find(".expandButton").hasClass("collapsed")) {
				toggleSession(firstSessionCard.data()[SESSION_DATA_ID_KEY]);
			}
		}
	}


	/**
	 * Update the session status tag and the buttons that get affected by the SIMLET and session status and permissions
	 * @param {object} session - object containing the session info
	 */
	const paintSessionStatusAndPermissions = async function(session, card) {
		// By default, hide every button that can modify the session info 
		card.find(".icon-edit").hide();
		card.find(".icon-add").hide();
		card.find(".icon-activate").hide();
		card.find(".icon-pause").hide();
		card.find(".icon-finish").hide();
		card.find(".icon-tester").hide();
		card.find(".icon-reset-tester").hide();
		card.find(".icon-untester").hide();
		card.find(".icon-delete").hide();
		card.find(".sessionTestLauch").hide();
		
		const isTester = isUserIdInSession(session.session_id, currentUser.user_id);
		currentUserTesterSessionId = isTester ? session.session_id : null;

		// If the current user is set as tester of the session, show the play button regardless of permissions
		if (isTester) {
			card.find(".sessionTestLauch").show();
		}

		let statusClass = session.session_status;
		let statusLabelText = "";

		// Determine the status label text (can't be done via string interpolation because the
		// i18n instance processes text before js runs, so passing '${statusClass}.title' as 
		// the translation key does nothing)
		if (statusClass === SESSION_ACTIVE_STATUS) {
			statusLabelText = `<%- t('sessions.status.active.title', { ns : 'sessions' }) %>`;
		} 
		else if (statusClass == SESSION_PAUSED_STATUS) {
			statusLabelText = `<%- t('sessions.status.paused.title', { ns : 'sessions' }) %>`;
		}
		else if (statusClass == SESSION_FINISHED_STATUS) {
			statusLabelText = `<%- t('sessions.status.finished.title', { ns : 'sessions' }) %>`;

			// Hide the play button regardless of permissions
			card.find(".sessionTestLauch").hide();
		}
		
		card.find(".sessionStatusLabel").removeClass(`${SESSION_ACTIVE_STATUS} ${SESSION_PAUSED_STATUS} ${SESSION_FINISHED_STATUS}`);
		card.find(".sessionStatusLabel").addClass(statusClass);
		card.find(".sessionStatusLabel").text(statusLabelText);

		// Only the users with permissions other than read can use the hidden buttons,
		if (simlet.current_user_permission !== "READ") { 
			card.find(".icon-edit").show();
			card.find(".icon-add").show();
			// Only show the delete button if the SIMLET is active
			if (!simlet.simlet_archived) {
				card.find(".icon-delete").show();
			}

			// Show/hide the tester buttons depending on the current user
			if (isTester) {
				card.find(".icon-tester").hide();
				card.find(".icon-reset-tester").show();
				card.find(".icon-untester").show();
			}
			else {
				card.find(".icon-tester").show();
				card.find(".icon-reset-tester").hide();
				card.find(".icon-untester").hide();
			}

			// When the session is active, show pause and finalize
			if (statusClass === SESSION_ACTIVE_STATUS) {
				card.find(".icon-activate").hide();
				card.find(".icon-pause").show();
				card.find(".icon-finish").show();
			}
			// When the session is paused, show activate and finalize
			else if (statusClass == SESSION_PAUSED_STATUS) {
				card.find(".icon-pause").hide();
				card.find(".icon-activate").show();
				card.find(".icon-finish").show();
			}
			// When the session is terminated, hide the add and tester buttons
			else {
				card.find(".icon-add").hide();
				card.find(".icon-tester").hide();
				card.find(".icon-reset-tester").hide();
				card.find(".icon-untester").hide();
			}
		}
	}

	/**
	 * Fill the session card info programatically to avoid XSS
	 * @param {object} session - object containing the session info
	 * @param {object} card - jquery object reference of the card element
	 */
	const fillSessionCard = async function(session, card) {
		card.find(".sessionTitle").text(session.session_name);
		card.find(".sessionDescription").text(session.session_description);
		card.find(".sessionCreateDate").text(getFormattedDate(session.createdAt, currentlanguageCode));
		
		const activities = session.completeActivities;
		card.find(".sessionActivities").text(activities.length);

		const participants = session.completeParticipants;
		let userCount = participants.length;
		card.find(".sessionUsers").text(userCount);

		// If the session has any activities and the last activity is not null, iterate 
		// over its data.completion property and get how many users have completed it.
		// The users that aren't allocated to this session anymore are skipped, as they still
		// have their completion data but don't belong to this session
		let completeUserCount = 0;
		if (activities.length > 0 && activities[activities.length - 1] != null) {
			for (const [userId, completed] of Object.entries(activities[activities.length - 1].data.completion)) {
				if (completed && isUserIdInSession(session, userId)) {
					completeUserCount++;
				}
			}
		}

		// If there are any users, calculate the percentage of users that have completed the last activity
		let lastActivityCompletion = 0;
		if (userCount > 0) {
			lastActivityCompletion = (completeUserCount / userCount) * 100;
		}
		lastActivityCompletion = lastActivityCompletion.toFixed(2);

		card.find(".sessionSummary .done").css('width', `${lastActivityCompletion}%`);
		card.find(".sessionSummary .completionPercentage").text(lastActivityCompletion);
		card.find(".sessionSummary .completedUsers").text(completeUserCount);
		card.find(".sessionSummary .completedTotalUsers").text(userCount);

		card.find(".sessionTags").empty();
		card.find(".sessionTags").append(createTagsList(session.tags));

		// Paint all the activities in this session (defined at simlet_activities)
		paintSessionActivities(session, activities, card);
	}

	/**
	 * Update the no sessions message depending on the search result
	 */
	const paintNoSessionsMessage = async function() {
		// No results
		if (sessionsFilteringPagination.totalResults == 0) {
			// No sessions
			if (simlet.sessions.length == 0) {
				$('#no_sessions_msg').text("<%- t('sessions.no_sessions.message', { ns : 'sessions' }) %>");
			}
			// There are sessions, but none of them matched the search parameters
			else {
				$('#no_sessions_msg').text("<%- t('filters.search.no_matches.message', { ns : 'commons' }) %>");
			}
		}
		else {
			$('#no_sessions_msg').text("");
		}
	}
	
	
	// Functions to call to avoid reloading the whole view when updating info of any session 

	const onCreateOrEditSession = function(newSessionInfo) {
		updateAssignedTags();

		const prevInfo = getSessionFromId(newSessionInfo.session_id);

		// Update the basic SIMLET info without repainting everything to get the new session and tags
		updateSimletInfo(false, () => {
			// Paint/repaint the session card (which also updates the sessionsById and completeSessionsById)
			paintSessionBatch([newSessionInfo]);

			// If the session is new, update the searching parameters
			if (prevInfo == null) {
				sessionsFilteringPagination.totalResults++;
				sessionsFilteringPagination.updateSearchOptions();
			}

			// If the session is new or its name changed, update it in the allocators dropdowns
			if (prevInfo == null || prevInfo.session_name != newSessionInfo.session_name) {
				allocatorsOnSessionsChanged(newSessionInfo.session_id);
			}

			// Determine the sort order callback
			let sortOrder = (a, b) => a.session_id - b.session_id;
			// From lower to higher
			if (sessionsFilteringPagination.searchParams.order.toLowerCase() == "asc") {
				if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "id") {
					sortOrder = (a, b) => a.session_id - b.session_id;
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "name") {
					sortOrder = (a, b) => a.session_name.localeCompare(b.session_name);
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "createdAt") {
					sortOrder = (a, b) => a.createdAt - b.createdAt;
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "updatedAt") {
					sortOrder = (a, b) => a.updatedAt - b.updatedAt;
				} 
			}
			// From higher to lower
			else {
				if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "id") {
					sortOrder = (a, b) => b.session_id - a.session_id;
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "name") {
					sortOrder = (a, b) => b.session_name.localeCompare(a.session_name);
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "createdAt") {
					sortOrder = (a, b) => b.createdAt - a.createdAt;
				}
				else if (sessionsFilteringPagination.searchParams.orderBy.toLowerCase() == "updatedAt") {
					sortOrder = (a, b) => b.updatedAt - a.updatedAt;
				} 
			}

			// Sort sessionsById and get an array of only the sorted ids
			const sorted = Array.from(sessionsById.values()).sort(sortOrder);
			const sortedIds = sorted.map(obj => obj.session_id);

			// Determine what position will take the new card 
			const cardPosition = sortedIds.indexOf(newSessionInfo.session_id);
			const currentMaxVisible = sessionsFilteringPagination.searchParams.limit;

			// If the card should be visible after being added/edited
			if (cardPosition < currentMaxVisible) {
				// If all the cards that should be visible are painted, remove the last one
				if ($("#sessions").children().length == currentMaxVisible) {
					$("#sessions").children().last().remove();
				}

				// If the new card should take the first place, move it before the first card of the list
				if (cardPosition == 0) {
					$("#sessions").children().first().before($(`#session_${newSessionInfo.session_id}`));
				}
				// Otherwise, move it after the card that goes before 
				else if (cardPosition < currentMaxVisible) {
					const prevId = sortedIds[cardPosition - 1];
					$(`#session_${prevId}`).after($(`#session_${newSessionInfo.session_id}`));
				}
			}
			// Otherwise, remove it 
			else {
				$(`#session_${newSessionInfo.session_id}`).remove();
			}
		});
	}

	const onDeleteSession = function(sessionId) {
		// Delete the session from the stored sessions
		if (sessionsById.delete(sessionId)) {
			completeSessionsById.delete(sessionId);

			// Update the pagination parameters
			sessionsFilteringPagination.totalResults--;
			sessionsFilteringPagination.updateSearchOptions();

			updateSimletInfo(false, () => {
				// If the session card was painted, remove it and potentially paint the one that will take the free space or the no sessions message
				const card = $(`#session_${sessionId}`);
				if (card.length > 0) {
					card.remove();

					const currentMaxVisible = sessionsFilteringPagination.searchParams.limit;

					// If there could be more cards painted after removing the session AND there are at least enough total results to fill the maximum, 
					// load a new batch of sessions (the page will be the same as the current one, but the already painted sessions will be omitted and 
					// only the new ones will be added to the page)
					if ($("#sessions").find(".test").length < currentMaxVisible && sessionsFilteringPagination.totalResults >= currentMaxVisible) {
						loadSessionBatch();
					}
					// Otherwise, the already existing cards will just move to take the removed one position

					paintNoSessionsMessage();
				}
				
				// Update the allocators to remove the session from the dropdowns
				allocatorsOnSessionsChanged(sessionId);
			});
		}
	}

	const updateEntireSession = function(sessionId) {
		// Repaint the entire session if it exists
		const session = getSessionFromId(sessionId); 
		if (session != null) {
			onCreateOrEditSession(session);
		}
	}

	const onEditSessionActivities = function(sessionId) {
		const card = $(`#session_${sessionId}`);
		card.find(".activities").empty();
		card.find(".activities_loader").show();
		
		updateEntireSession(sessionId);
	}
	
	const onSessionUsersChange = function(sessionId) {
		onEditSessionActivities(sessionId);
	}

</script>


<!-- TAGS -->
<div id="tags_buttons_template" style="display: none;">
	<div class="tagsButtons">
		<img src="/images/icons/pencil.png" class="editTagButton" title="<%= t('tags.edit.title', { ns : 'sessions' }) %>">
		<img src="/images/icons/trash-bin.png" class="deleteTagButton" title="<%= t('tags.delete.title', { ns : 'sessions' }) %>">
	</div>
</div>

<script type="text/javascript">

	class SessionFormTagsMultiSelectDropdown extends TagsMultiSelectDropdown {
		constructor($rootElem) {
			super($rootElem);

			this.$noOptionsMessage.text("<%- t('tags.search.no_tags.message', { ns : 'sessions' }) %>");
			this.$allMatchingMessage.text("<%- t('tags.search.all_matches', { ns : 'sessions' }) %>");
		}
		
		createOption(tagId) {
			const listOption = super.createOption(tagId);
			listOption.append($("#tags_buttons_template div").clone());
			return listOption;
		}

		onOptionClick($listElem) {
            super.onOptionClick($listElem);
        }
	}
	
    // Store the tags multi select dropdown instance instance using the original form as root object
	let sessionTagsMultiSelect = $("#session_form").find(".multiSelect");
	const sessionTagsMultiSelectInstance = new SessionFormTagsMultiSelectDropdown(sessionTagsMultiSelect);
	sessionTagsMultiSelectInstance.updateSelectorPlaceholder();

    // Change the search bar placeholder text
	sessionTagsMultiSelect.find(".searchBar").attr("placeholder", "<%- t('filters.tags.search_bar.placeholder', { ns : 'commons' }) %>");
	

	let originalSelectedTagsIds = new Set();

	const fillSessionFormTagsDropdown = function(tags) {
		originalSelectedTagsIds.clear();

		// Update the tags just in case the fetched tags were only the ones
		// that were assigned to the SIMLETs instead of all existing tags
		Simva.getTags((error, result) => {
			onTagsUpdate(error, result);
			
			// Reassign the root object of the tags multi select dropdown instance
			sessionTagsMultiSelect = $("#session_form").find(".multiSelect");
			sessionTagsMultiSelectInstance.assignElems(sessionTagsMultiSelect);

			// Update the multi select dropdown instance instance to select the tags passed in the parameters
			sessionTagsMultiSelectInstance.selectedOptions.clear();
			tags.forEach((tag) => {
				// Store the currently selected tags ids
				originalSelectedTagsIds.add(tag.tag_id);
				sessionTagsMultiSelectInstance.selectedOptions.add(tag.tag_id);
			});

			sessionTagsMultiSelectInstance.updateTotalOptions(Array.from(result.map(tag => tag.tag_id)));

			sessionTagsMultiSelectInstance.updateSelectorPlaceholder();
		});
	}


	const TAG_NAME_FIELD_CLASS = "tag_name_field";
	const MAX_TAG_NAME_LENGTH = 20;
	
	$(document).ready(function() {
		// Add counter to all tag name fields (defined in the simlet_commons partial)
		addInputCharCountToClass(TAG_NAME_FIELD_CLASS, MAX_TAG_NAME_LENGTH);
	});

	$(document).on('input', `.${TAG_NAME_FIELD_CLASS}`, function(e) {
		processAllowedCharacters(e);
	});	
	

	// Menus
	
	$(document).on("click", ".tagsButtons", (e) => {
		e.stopPropagation();
	});

	$(document).on("click", ".tagsButtons .editTagButton", (e) => {
		const tagData = $(e.target).closest(".searchTag").data();
		$(".multiSelectDropdown:visible").fadeOut(100);
		openTagForm(tagData[LIST_ELEM_DATA_ID_KEY]);
	});

	$(document).on("click", ".tagsButtons .deleteTagButton", (e) => {
		const tagData = $(e.target).closest(".searchTag").data();
		deleteTag(tagData[LIST_ELEM_DATA_ID_KEY], tagsById.get(tagData[LIST_ELEM_DATA_ID_KEY]).tag_name);
	});

	const openTagForm = function(editingTagId = null) {
		$("#session_tag_form").show();
		$("#session_tags_error").text("");

		// Reset al previous form values
		$("#edit_tag_id").val("");
		$("#prev_tag_name").val("");
		$("#prev_tag_color").val("#3b82f6");

		$("#tag_name_field").val("");
		$("#tag_color_field").val("#3b82f6");

		// Creating new tag
		if (editingTagId == null) {
			$("#tag_create_button").show();
			$("#tag_edit_button").hide();
		}
		// Editing tag
		else {
			$("#tag_create_button").hide();
			$("#tag_edit_button").show();

			const tag = tagsById.get(editingTagId);
			$("#edit_tag_id").val(tag.tag_id);
			$("#prev_tag_name").val(tag.tag_name);
			$("#prev_tag_color").val(tag.tag_color);

			$("#tag_name_field").val(tag.tag_name);
			$("#tag_color_field").val(tag.tag_color);
		}
	}

	const closeTagForm = function() {
		$("#session_tag_form").hide();
	}


	// Functionality

	const createAndSelectTag = function() {
		const tagName = $("#tag_name_field").val().trim();
		const tagColor = $("#tag_color_field").val();
		const errorBox = $('#session_tags_error');
		errorBox.text("");
		Utils.toggleSubmit();

		if (!tagName) {
			Utils.toggleSubmit();
			errorBox.text("<%- t('tags.error.required_name', { ns : 'sessions' }) %>");
			return;
		}

		Simva.createTag({ tag_name: tagName, tag_color: tagColor }, function(error, createdTag) {
			Utils.toggleSubmit();
			if (error) {
				errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}

			closeTagForm();
			// Update all the existing tags and add the created tag to 
			// the multi select dropdown and render all the options again
			Simva.getTags((error, result) => {
				onTagsUpdate(error, result);

				sessionTagsMultiSelectInstance.selectedOptions.add(createdTag.tag_id);
				sessionTagsMultiSelectInstance.updateSelectorPlaceholder();
				sessionTagsMultiSelectInstance.showMatchingResults();
			});
		});
	}

	const editTag = function() {
		const tagId = $("#edit_tag_id").val();
		const tagName = $("#tag_name_field").val();
		const tagColor = $("#tag_color_field").val();

		const nameChanged = $("#prev_tag_name").val() != Utils.trimString(tagName);
		const colorChanged = $("#prev_tag_color").val() != tagColor;

		const errorBox = $("#session_tags_error");
		errorBox.text("");
		Utils.toggleSubmit();

		if (!nameChanged && !colorChanged) {
			Utils.toggleSubmit();
			errorBox.text("<%- t('forms.edit.error.no_changes', { ns : 'commons' }) %>");
			return;
		}
		else if ($("#tag_name_field").val() == "" || $("#tag_name_field").val() == null) {
			Utils.toggleSubmit();
			errorBox.text("<%- t('tags.error.required_name', { ns : 'sessions' }) %>");
			return;
		}
		else {
			Simva.updateTag(tagId, { tag_name: tagName, tag_color: tagColor }, function(error) {
				Utils.toggleSubmit();
				
				if (error) {
					errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				closeTagForm();

				// Update all the existing tags and render all the options again
				Simva.getTags((error, result) => {
					onTagsUpdate(error, result);
					sessionTagsMultiSelectInstance.showMatchingResults();
				});
			});
		}
	}
	
	const deleteTag = function(tagId, tagName) {
		const errorBox = $("#session_tags_error");
		errorBox.text("");

		// If the tag is being used by other SIMLET or session, show an alert and do nothing
		if (assignedTagsIds.has(tagId)) {
			alert(`<%- t('tags.delete.error.other_using', { ns : 'sessions', tagName : '${tagName}' }) %>`)
			return;
		}

		if (confirm(`<%- t('tags.delete.confirm', { ns : 'sessions', tagName : '${tagName}' }) %>`)) {
			Simva.deleteTag(tagId, function(error, result) {
				if (error) {
					// TODO: show error correctly when tag cant be deleted due to being used in other session
					// (only error has content but it shows [object Object])
					errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}

				// Update all the existing tags, delete the deleted tag from 
				// the multi select dropdown and render all the options again
				Simva.getTags((error, result) => {
					onTagsUpdate(error, result);
					sessionTagsMultiSelectInstance.unselectedOptions.delete(tagId);
					sessionTagsMultiSelectInstance.selectedOptions.delete(tagId);
					sessionTagsMultiSelectInstance.showMatchingResults();
				});
			});
		}
	}
	
	const syncSessionTags = function(simletId, sessionId, originalTagIds, targetTagIds, callback) {
		const toAdd = targetTagIds.filter((tagId) => !originalTagIds.includes(tagId));
		const toDelete = originalTagIds.filter((tagId) => !targetTagIds.includes(tagId));

		Promise.all([
			...toAdd.map((tagId) => new Promise((resolve, reject) => {
				Simva.addTagToSession(simletId, sessionId, tagId, function(error, result) {
					if (error) {
						reject(error);
						return;
					}
					resolve(result);
				});
			})),
			...toDelete.map((tagId) => new Promise((resolve, reject) => {
				Simva.deleteTagFromSession(simletId, sessionId, tagId, function(error, result) {
					if (error) {
						reject(error);
						return;
					}
					resolve(result);
				});
			})),
		])
			.then((result) => callback(null, result))
			.catch((error) => callback(error));
	}

</script>
