<!-- Elements of the sessions tab in the SIMLET view (not including the activities) -->

<!-- Section where all sessions will be painted -->
<div id="study">
	<div class="card">
		<div class="top">
			<div class="tooltipLine">
				<h2><%- t('title', { ns : 'sessions' }) %></h2>
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%= t('session.description', { ns : 'about' }) %>
					</span>
				</div>
			</div>
        </div>
		
		<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'sessions' }); %>
		<%- include('filtering_pagination_commons', { id:"sessions", searchBarPlaceholderText: searchBarPlaceholder }) %>

		<!-- Container for all the session cards -->
		<div id="tests" class="tests">
			
        </div>

		<div id="sessions_loader" class="loader" style="margin-bottom: 20px;"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></div>
		
    </div>
</div>

<!-- Template for each element of the sessions list -->
<div id="session_template" style="display: none;">
	<div class="test">
		<div class="sessionTop" >
			<h2 class="sessionTitle">	</h2>
			<div class="tooltipLine">
				<div class="tooltip">
					&#x1F6C8;
					<span class="tooltiptext">
						<%- t('status.description', { ns : 'sessions' }) %>
						<ul>
							<li><%- t('active.description', { ns : 'sessions' }) %></li>
							<li><%- t('paused.description', { ns : 'sessions' }) %></li>
							<li><%- t('finished.description', { ns : 'sessions' }) %></li>
						</ul>
					</span>
				</div>
				<div class="sessionStatusLabel">	</div>
			</div>
			<div class="expandButton"></div>
			<div class="kebab">
				<ul class="kebab-dropdown">
                    <li class="text-with-icon icon-edit" title="<%- t('settings.edit.title', { ns : 'sessions' }) %>">
                        <%- t('settings.edit.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-add" title=" <%- t('settings.add_activity.title', { ns : 'sessions' }) %>">
                        <%- t('settings.add_activity.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-export" title="<%- t('settings.export.title', { ns : 'sessions' }) %>">
                        <%- t('settings.export.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-activate" title="<%- t('settings.activate.title', { ns : 'sessions' }) %>">
                        <%- t('settings.activate.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-pause" title="<%- t('settings.pause.title', { ns : 'sessions' }) %>">
                        <%- t('settings.pause.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-finish" title="<%- t('settings.finish.title', { ns : 'sessions' }) %>">
                        <%- t('settings.finish.title', { ns : 'sessions' }) %>
                    </li>
                    <li class="text-with-icon icon-delete" title="<%- t('settings.delete.title', { ns : 'sessions' }) %>">
                        <%- t('settings.delete.title', { ns : 'sessions' }) %>
                    </li>
					<li class="text-with-icon icon-tester" title="<%- t('set_tester.title', { ns : 'sessions' }) %>">
						<%- t('set_tester.title', { ns : 'sessions' }) %>
					</li>
					<li class="text-with-icon icon-reset-tester" title="<%- t('reset_tester.title', { ns : 'sessions' }) %>">
						<%- t('reset_tester.title', { ns : 'sessions' }) %>
					</li>
					<li class="text-with-icon icon-untester" title="<%- t('unset_tester.title', { ns : 'sessions' }) %>">
						<%- t('unset_tester.title', { ns : 'sessions' }) %>
					</li>
                </ul>
            </div>
        </div>
        <div class="sessionDescription" style="padding:10px;">	 </div>
        <div class="sessionSummary">
            <div class="sessionInfo">
                <strong class="sessionCreateDate"><%- t('createdAt', { ns : 'sessions' }) %>: 	</strong>
                <br>
                <strong class="sessionActivities"><%- t('activities', { ns : 'sessions' }) %>:	</strong>  &nbsp; <strong class="sessionUsers"><%- t('users', { ns : 'sessions' }) %>:	</strong>
            </div>
            <div class="activityProgress sessionProgress progress">
                <div class="done">	</div>
                <span>
                    <%- t('completed.title', { ns : 'activities' }) %>: 
                    <done class="completionPercentage">		</done>% [ <doneres class="completedUsers">		</doneres> / <total class="completedTotalUsers">		</total> ]
                </span>
            </div>
			<div class="text-with-icon icon-play sessionTestLauch" onclick="Utils.toggleIframeInFloating(`/scheduler/${simlet.simlet_id}?testMode=true`)" title="<%- t('play.description', { ns : 'SIMLETs' }) %>">
				<b><%- t('play', { ns : 'sessions' }) %></b>
			</div>
            <div class="text-with-icon icon-download sessionDownload" title="<%- t('download.description', { ns : 'sessions' }) %>">
                <b><%- t('download.title', { ns : 'sessions' }) %></b>
            </div>
        </div>
        <div class="sessionTags" style="margin-top: 8px;">	</div>
		<div class="tooltipLine activitiesTitle">
			<h3><%- t('title', { ns : 'activities' }) %></h3>
			<div class="tooltip">
				&#x1F6C8;
				<span class="tooltiptext">
					<p><%= t('activity.description', { ns : 'about' }) %></p>
					<p><%= t('dashboard.description', { ns : 'about' }) %></p>
				</span>
			</div>
		</div>
        <div class="activities">
            <div class="loader" style="margin-bottom: 20px;"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></div>
        </div>
    </div>
</div>

<!-- Add/edit session menu -->
<div id ="session_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="session_form_form">
			<h1 id="session_form_title"></h1>
			<div class="tabs" id="add_session_tabs">
				<span id="session_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'session_form_form','session_name_desc_tab')"><%- t('add.new.tab', { ns : 'sessions' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'session_form_form','import_session_tab')"><%- t('import.tab', { ns : 'sessions' }) %></span>
			</div>

			<!-- Create/edit session -->
			<div id="session_name_desc_tab" class="subform selected">
				<form id="session_form">
					<input hidden type="text" name="editingSessionId" id="edit_session_id">
					<input hidden type="text" name="prevSessionName" id="prev_session_name">
					<input hidden type="text" name="prevSessionDescription" id="prev_session_description">

					<h3 class="session_form_field session_form_name"><%- t('name.title', { ns : 'sessions' }) %></h3>
					<input class="session_form_field session_form_name name_field" type="text" name="sessionName" id="session_name" placeholder="<%- t('name.placeholder', { ns : 'sessions' }) %>" required>
					<h3 class="session_form_field" id="session_description_label"><%- t('description.title', { ns : 'SIMLETs' }) %></h3>
					<textarea class="session_form_field description_field" type="text" name="sessionDescription" id="session_description" placeholder="<%- t('description.placeholder', { ns : 'sessions' }) %>"></textarea>
					<h3 class="session_form_field" id="session_status_title"><%- t('status.title', { ns : 'sessions' }) %></h3>
					<select id="session_status_selector" name="sessionStatus">
						<option value="active"><%- t('active.title', { ns : 'sessions' }) %></option>
						<option value="inactive"><%- t('paused.title', { ns : 'sessions' }) %></option>
					</select>
					<h3 class="session_form_field"><%- t('tags.title', { ns : 'sessions' }) %></h3>
					<div class="session_form_field" id="session_tags_area" style="margin-top: 5px;">
						<div class="tagPickerArea">
							<div class="tagPickerRow">
								<div class="tagPickerInputWrap"  >
									<div id="session_selected_tags" class="tagSelectedChips"></div>
									<input
										type="text"
										id="session_tag_search"
										class="tagSearchInput"
										placeholder="<%- t('tags.input.placeholder', { ns : 'sessions' }) %>"
										onfocus="openTagDropdown()"
										oninput="renderAvailableTags()"
									>
									<div id="session_tag_dropdown" class="tagDropdown" style="display:none;" tabindex="-1">

									</div>
								</div>
								<button type="button" class="tagPlusButton" onclick="toggleTagCreator()">+</button>
							</div>
						</div>
						<div id="session_tag_creator" class="tagCreator" style="display:none;">
							<input type="text" class="tag_name_field" id="session_new_tag_name" placeholder="<%- t('tags.create.placeholder', { ns : 'sessions' }) %>" style="flex: 1;">
							<input type="color" id="session_new_tag_color" value="#3b82f6" style="width: 44px; padding: 0;">
							<button type="button" onclick="createAndSelectTag()"><%- t('tags.create', { ns : 'sessions' }) %></button>
							<button type="button" onclick="closeTagCreator()"><%- t('tags.create.cancel', { ns : 'sessions' }) %></button>
						</div>
						<div id="session_tag_editor" class="tagEditor" style="display:none;">
							<input hidden type="text" id="edit_tag_id">
							<input hidden type="text" id="prev_tag_name">
							<input hidden type="color" id="prev_tag_color">

							<input type="text" class="tag_name_field" id="session_edit_tag_name" placeholder="<%- t('tags.edit.placeholder', { ns : 'sessions' }) %>" style="flex: 1;">
							<input type="color" id="session_edit_tag_color" value="#3b82f6" style="width: 44px; padding: 0;">
							<button type="button" onclick="saveEditingTag()"><%- t('tags.edit.save', { ns : 'sessions' }) %></button>
							<button type="button" onclick="closeTagEditor()"><%- t('tags.edit.cancel', { ns : 'sessions' }) %></button>
						</div>
						<span class="error" id="session_tags_error"></span>
					</div>

					<!--
					<div class="session_form_field" id="can_be_manually_activated" >
						<h3><%- t('can_be_manually_activated', { ns : 'sessions' }) %></h3>
						<input type="checkbox" name="can_be_manually_activated" checked>
					</div>
					-->
					<br class="session_form_field">
					<input class="session_form_field" type="submit" id="session_submit" value="">
				</form>
			</div>

			<!-- Import session -->
			<div id="import_session_tab" class="subform" style="display: none;">
				<form id="import_session_form">
					<h3 class="import_session_form_field session_form_name"><%- t('name.title', { ns : 'sessions' }) %></h3>
					<input class="import_session_form_field import_session_form_name name_field" type="text" name="sessionName" id="import_session_name" placeholder="<%- t('name.placeholder', { ns : 'sessions' }) %>" required>
					<h3><%- t('import.input', { ns : 'sessions' }) %></h3>
					<input type="file" name="jsonFile" accept=".json" required>
					<input class="import_session_form_field" type="submit" id="import_session_submit" value="<%- t('import.submit', { ns : 'sessions' }) %>">
				</form>
			</div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="session_form_error"></span>
		</div>
	</div>
</div>

<!-- Add session floating button -->
<div class="floating_buttons">
    <div unselectable="on" class="basic" onclick="openSessionForm()">
		<img src="../icon/study.png" style="filter: invert(100%);">
		<span>+</span>
	</div>
</div>


<script type="text/javascript">
	// Values of the sessions status on the database
    const SESSION_ACTIVE_STATUS = "active";
    const SESSION_PAUSED_STATUS = "inactive";
    const SESSION_FINISHED_STATUS = "terminated";

	// Ids for the data-* attributes of each session card
	const SESSION_DATA_ID_KEY = "sessionId"
	const SESSION_DATA_NAME_KEY = "sessionName"
	
	// Id of the session that opened the download session data menu
	let downloadSessionId = null;

	
    // Menus

    $(document).ready(function() {
		
		// When submitting the import session form
		$(document).on('submit','#import_session_form', function(event) {
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			let errorbox = $('#session_form_error');
			// Check for file
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				let reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						// Always extract base64 payload from data URL
						raw = raw.substr(raw.indexOf(',') + 1);
						const newTest = raw;
						Simva.importSession(simletId, {file: newTest, session_name: form.sessionName}, function(importError, result) {
							Utils.toggleSubmit();
							if (importError) {
								errorbox.text(importError.responseJSON ? importError.responseJSON.message : importError.message || importError);
								return;
							}
							Utils.toggleFormInFloating('session_form_menu');
							reloadSimlet();
						});
					} catch (parseError) {
						console.error('Import error:', parseError);
						Utils.toggleSubmit();
						errorbox.text("<%- t('import.error.invalid_file', { ns : 'sessions' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			} else {
				errorbox.text("<%- t('import.upload.error', { ns : 'sessions' }) %>");
				Utils.toggleSubmit();
			}
			return false;
		});

		// When submitting the add/edit SIMLET form
        $(document).on('submit','#session_form', function(event) {
			let errorbox = $('#session_form_error');
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			
			const selectedTagIds = selectedTags.map((tag) => Number(tag.tag_id));

			// Creating new session
			if (form.editingSessionId == null || form.editingSessionId == "") {
				Simva.addSessionToSimlet(simletId, { session_name: form.sessionName, session_description: form.sessionDescription, session_can_be_manually_activated: true, session_status: form.sessionStatus }, function(error, result) {
					if (error && error.responseJSON) {
						Utils.toggleSubmit();
						errorbox.text(error.responseJSON.message);
					}
					else if (error) {
						Utils.toggleSubmit();
						errorbox.text(error.message || error);
					}
					else {
						const newSessionId = result && result.session_id ? Number(result.session_id) : null;
						if (!newSessionId || selectedTagIds.length === 0) {
							Utils.toggleSubmit();
							Utils.toggleFormInFloating('session_form_menu');
							reloadSimlet();
							return;
						}

						syncSessionTags(simletId, newSessionId, [], selectedTagIds, function(syncError) {
							Utils.toggleSubmit();
							if (syncError) {
								errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
								return;
							}
							Utils.toggleFormInFloating('session_form_menu');
							reloadSimlet();
						});
					}
				});	
			}
			// Editing session
			else {
				const sessionId = form.editingSessionId;

				const nameChanged = form.prevSessionName != form.sessionName;
				const descriptionChanged = form.prevSessionDescription != form.sessionDescription;
				const tagsChanged = selectedTagIds.length !== originalTagsIds.length || selectedTagIds.some((tagId) => !originalTagsIds.includes(tagId));

				if (!nameChanged && !descriptionChanged && !tagsChanged) {
					errorbox.text("<%- t('edit.no_changes.message', { ns : 'SIMLETs' }) %>");
					Utils.toggleSubmit();
				}
				else {
					errorbox.text("");

					const finishSync = function() {
						syncSessionTags(simletId, Number(sessionId), originalTagsIds, selectedTagIds, function(syncError) {
							Utils.toggleSubmit();
							if (syncError) {
								errorbox.text(syncError.responseJSON ? syncError.responseJSON.message : syncError.message || syncError);
								return;
							}
							Utils.toggleFormInFloating('session_form_menu');
							reloadSimlet();
						});
					}
					
					if (nameChanged || descriptionChanged) {
						Simva.updateSession("<%= study %>", Number(sessionId), { session_name : form.sessionName, session_description : form.sessionDescription }, function(error) {
							if (error) {
								Utils.toggleSubmit();
								errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
								return;
							}
							finishSync();
						});
					} 
					else {
						finishSync();
					}
				}
			}
			return false;
		});
    });

    const openSessionForm = function(sessionId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#session_name_desc_tab_button'), 'session_form_form','session_name_desc_tab');

		const session = getSessionFromId(sessionId);
		
		// Open form always
		Utils.toggleFormInFloating('session_form_menu');

		$('#session_form_error').text("");
		$('#session_tags_error').text("");
		$("#session_selected_tags").empty();
		
		$('#edit_session_id').val(sessionId);

		// Creating new session
		if (sessionId == null) {
			// Show the add new/import tabs
			$("#add_session_tabs").show();

			$("#session_form_title").text("<%- t('add.title', { ns : 'sessions' }) %>");
			$("#session_status_title").show();
			$("#session_status_selector").show();
			$("#session_submit").val("<%- t('add.submit', { ns : 'sessions' }) %>");
			$("#can_be_manually_activated").show();

			$('#prev_session_name').val("");
			$('#prev_session_description').val("");

			$('#session_name').val("");
			$('#session_description').val("");
			
			selectedTags = [];
			originalTagsIds = [];
		}
		// Editing session
		else {
			// Show the add new/import tabs (only the name/description/tags tab is needed when editing session)
			$("#add_session_tabs").hide();

			$("#session_form_title").text("<%- t('edit.title', { ns : 'sessions' }) %>");
			$("#session_status_title").hide();
			$("#session_status_selector").hide();
			$("#session_submit").val("<%- t('edit.submit', { ns : 'sessions' }) %>");
			$("#can_be_manually_activated").hide();

			$('#prev_session_name').val(session.session_name);
			$('#prev_session_description').val(session.session_description);

			// Must manually trigger the input event when changing input values programatically to update the remaining count
			$('#session_name').val(session.session_name);
			$('#session_description').val(session.session_description);
			
			const currentTags = Array.isArray(session.tags) ? session.tags.map(normalizeTag).filter((tag) => tag !== null) : [];
			selectedTags = currentTags;
			originalTagsIds = currentTags.map((tag) => Number(tag.tag_id));
		}

		closeTagCreator();
		closeTagDropdown();
		closeTagEditor();

		updateAndRenderCurrentTags(function(loadError) {
			if (loadError) {
				$('#session_form_error').text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
				return;
			}
		});
	}

	const exportSession = function(sessionId) {
		Simva.exportSession(simletId, sessionId, function(error, result) {
			if(!error) {
				const content = JSON.stringify(result, null, 2);
				const filename = `simlet-${simlet.simlet_name}-session-${sessionId}-export.json`;
				Utils.download(filename, content);
			}
		})
	}
	
	// Expand/hide session info
	const toggleSession = function(sessionId) {
		$(`#test_${sessionId}`).find('.tooltipLine.activitiesTitle ').toggleClass('collapsed');
		$(`#test_${sessionId}`).find('.activities').toggleClass('collapsed');
		$(`#test_${sessionId}`).find('.expandButton').toggleClass('collapsed');
	}
	
	const openSessionDownloadForm = function(sessionId) {
		Utils.toggleFormInFloating('download_data_menu');
		Utils.changeTab(null, 'download_data_form','download_session_data');
		
        downloadSessionId = sessionId;
		const session = getSessionFromId(sessionId);

		if (session != null) {
			$("#downloadFormTitle").text(`<%- t('single.title', { ns : 'sessions' }) %>: ${session.session_name}`);
	
			// Show session download button based on participant status
			$("#session_test_data_download").hide();
			if (isCurrentUserParticipant(session.completeParticipants)) {
				$("#session_test_data_download").show();
			}
		}
	}
    

	// Sessions buttons shared listeners using event delegation to ensure 
	// the handler works even if element is added after the document ready event
	
	$(document).on('click', ".sessionTop .expandButton", function(e) {
		const data = $(this).closest(".test").data();
		toggleSession(data[SESSION_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".sessionTop .icon-edit", function(e) {
		const data = $(this).closest(".test").data();
		openSessionForm(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-add", function(e) {
		const data = $(this).closest(".test").data();
		openActivityForm(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-export", function(e) {
		const data = $(this).closest(".test").data();
		exportSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-activate", function(e) {
		const data = $(this).closest(".test").data();
		changeSessionStatus(data[SESSION_DATA_ID_KEY], "active");
	});
	
	$(document).on('click', ".sessionTop .icon-pause", function(e) {
		const data = $(this).closest(".test").data();
		changeSessionStatus(data[SESSION_DATA_ID_KEY], "inactive");
	});

	$(document).on('click', ".sessionTop .icon-finish", function(e) {
		const data = $(this).closest(".test").data();
		const sessionName = data[SESSION_DATA_NAME_KEY] || '';
		const confirmMsg = `<%- t('finish.confirm', { ns : 'sessions' }) %>${sessionName ? ' (' + sessionName + ')' : ''}`;
		if (confirm(confirmMsg)) {
			changeSessionStatus(data[SESSION_DATA_ID_KEY], "terminated");
		}
	});

	$(document).on('click', ".sessionTop .icon-delete", function(e) {
		const data = $(this).closest(".test").data();
		deleteSession(data[SESSION_DATA_ID_KEY], data[SESSION_DATA_NAME_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-untester", function(e) {
		const data = $(this).closest(".test").data();
		unsetTesterForSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-reset-tester", function(e) {
		const data = $(this).closest(".test").data();
		resetTesterForSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionTop .icon-tester", function(e) {
		const data = $(this).closest(".test").data();
		console.log("setting tester for session id:", data[SESSION_DATA_ID_KEY]);
		setTesterForSession(data[SESSION_DATA_ID_KEY]);
	});

	$(document).on('click', ".sessionSummary .icon-download", function(e) {
		const data = $(this).closest(".test").data();
		openSessionDownloadForm(data[SESSION_DATA_ID_KEY]);
	});
	
	
	// Functionality

	/**
	 * Check if the current user is a participant of a session based on its participants array
	 * @param {Array} participants - array of objects where each object is the participant data with the property user_id
	 * @returns {boolean} - true if the current user is in the session participants, false otherwise
	 */
	const isCurrentUserParticipant = function(participants) {
		return currentUser.user_id !== null && participants.some(function(p) {
			return p.user_id === currentUser.user_id || String(p.user_id) === String(currentUser.user_id);
		});
	}

	const deleteSession = function(sessionId, sessionName) {
		if (confirm(`<%- t('delete.confirm', { ns : 'sessions', session : '${sessionName}', SIMLET : '${simlet.simlet_name}' }) %>`)) {
			Simva.deleteSession(simletId, sessionId, function(error, result) {
				reloadSimlet();
			});
		}
	}


	/**
	 * Change a session status
	 * @param {number} sessionId - id of the sesssion
	 * @param {string} nextStatus - status the session will be changed to (active, inactive, terminated)
	 */
	const changeSessionStatus = function(sessionId, nextStatus) {
		Simva.activateSession(simletId, sessionId, { activate: nextStatus }, function(error, result) {
			if (!error) {
				reloadSimlet();
			}
		})
	}
	
	const downloadSessionData = function() {
		console.log("downloading data for session id:", downloadSessionId);
		Simva.getSessionLRSData(simletId, downloadSessionId, function(error, result){
			if(error) {
				$.toast({
					heading: 'Session data error',
					text: error.responseJSON ? error.responseJSON.message : error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
				return;
			}
			const content = result.data;
			const filename = `simva-${simlet.simlet_name}-session-${downloadSessionId}-data.json`;
			Utils.downloadContent(content, filename, 'Session data error');
		});
	}

	const downloadSessionTestData = function() {
		console.log("downloading test data for session id:", downloadSessionId);
		Simva.getSessionTestLRSData(simletId, downloadSessionId, function(error, result){
			if(error) {
				$.toast({
					heading: 'Session test data error',
					text: error.responseJSON ? error.responseJSON.message : error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
				return;
			}
			const content = result.data;
			const filename = `simva-${simlet.simlet_name}-session-${downloadSessionId}-test-data.json`;
			Utils.downloadContent(content, filename, 'Session test data error');
		});
	}

	const setTesterForSession = function (sessionId) {
        Simva.setTesterForSession(simletId, sessionId, function(error, result) {
            if (error) {
                $.toast({ heading: 'Error', text: 'Failed to set tester.', position: 'top-right', icon: 'error', stack: false });
            } else {
                $.toast({ heading: 'Tester set', text: 'You are now a tester in this session.', position: 'top-right', icon: 'success', stack: false });
				reloadSimlet();
            }
        });
    }

	/**
	 * Remove current user as tester (participant) from the session
	 */
	const unsetTesterForSession = function(sessionId) {
		Simva.unsetTesterForSession(simletId, sessionId, function(error, result) {
			if (error) {
				$.toast({ heading: 'Error', text: 'Failed to unset tester.', position: 'top-right', icon: 'error', stack: false });
			} else {
				$.toast({ heading: 'Tester unset', text: 'You are no longer a tester in this session.', position: 'top-right', icon: 'success', stack: false });
				reloadSimlet();
			}
		});
	}

	const resetTesterForSession = function(sessionId) {
		Simva.resetTesterForSession(simletId, sessionId, function(error, result) {
			if (error) {
				$.toast({ heading: 'Error', text: 'Failed to reset tester.', position: 'top-right', icon: 'error', stack: false });
			} else {
				$.toast({ heading: 'Tester reset', text: 'Your tester data has been reset for this session.', position: 'top-right', icon: 'success', stack: false });
				reloadSimlet();
			}
		});
	}


    // Render + filtering + pagination

	const SESSIONS_SHOW_AT_ONCE = 4;
	let sessionsFilteringPaginationData = $("#sessions_filtering").data();

	$(document).ready(function() {
		// Set properties of filtering_pagination_commons partial
		sessionsFilteringPaginationData["showAtOnce"] = SESSIONS_SHOW_AT_ONCE;
		sessionsFilteringPaginationData["updateSearchCallback"] = onSessionSearch;
		sessionsFilteringPaginationData["checkLoadMore"] = () => {
			return $("#sessions_tab").is(".selected");
		};
		sessionsFilteringPaginationData["loadMoreCallback"] = loadSessionBatch;
	});


	/**
	 * When updating any filter parameter, remove all the painted sessions and load a new batch
	 * (called by updateSearch in filtering_pagination_commons)
	 */
	const onSessionSearch = function() {
		$('#tests').empty();

		// Recalculate the total count of matching results
		Simva.getSimletSessionsCount(simletId, sessionsFilteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				sessionsFilteringPaginationData["totalResults"] = result.count;
				sessionsFilteringPaginationData["updateSearchOptions"]();

				loadSessionBatch();
			}
		});
	}

	/**
	 * Load batch of max SESSIONS_SHOW_AT_ONCE sessions matching the search parameters and paint them 
	 * (called both when updating the search results and when loading the next page of results)
	 */
	const loadSessionBatch = function() {
		$("#sessions_loader").show();
		
		Simva.getSimletSessions(simletId, sessionsFilteringPaginationData["searchParams"], function(error, result){
			if (!error) {
				paintSessionBatch(result);
				$("#sessions_loader").hide();

				// Once all results have loaded, allow the bottom reached check
				// just in case more results fit on the screen
				sessionsFilteringPaginationData["checkBottomReached"] = true;
				sessionsFilteringPaginationData["bottomReached"]();
			}
		});
	}

	/**
	 * Paint the cards for a batch of sessions
	 * @param {Array} batch - Array of objects containing the sessions info
	 */
	const paintSessionBatch = function(batch) {
		batch.forEach((session) => {
			// Add the session card synchronously to ensure they appear in order
			const card = $("#session_template .test").clone();
			$('#tests').append(card);
			card.find(".kebab-dropdown").fadeOut(0);

			card.data(SESSION_DATA_ID_KEY, session.session_id);
			card.data(SESSION_DATA_NAME_KEY, session.session_name);
			card.attr("id", `test_${session.session_id}`);

			// Then, fill its details asynchronously since the order of execution doesn't matter once the card has been added
			fillSessionCard(session, card);
		});
		
		// No results
		if (batch.length == 0) {
			// No sessions
			if (simlet.sessions.length == 0) {
				$('#tests').append("<p><%- t('no_sessions.message', { ns : 'sessions' }) %></p>");
			}
			// There are sessions, but none of them matched the search parameters
			else {
				$('#tests').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
		// There's only one result
		else if (batch.length == 1) {
			// Automatically expand the card to show its activities
			toggleSession(batch[0].session_id);
		}
	}

	/**
	 * Fill the session card info programatically to avoid XSS
	 * @param {object} session - object containing the session info
	 * @param {object} card - jquery object reference of the card element
	 */
	const fillSessionCard = async function(session, card) {
		card.find(".icon-tester").show();
		card.find(".icon-reset-tester").hide();
		card.find(".icon-untester").hide();
		card.find(".sessionTestLauch").hide();
		
		// Callback to set the summary completion bar progress and other info that depends on the number of activities or users
		// (called after fetching the complete session info from either the previously stored sessions info or from the database)
		const fillCompleteFields = function(completeSession) {
			const sessionParticipants = Array.isArray(completeSession.completeParticipants) ? completeSession.completeParticipants : [];
			let userCount = sessionParticipants.length;
			
			card.find(".sessionUsers").after(userCount);

			let completeUserCount = 0;
			let lastActivityCompletion = 0;
			
			// If the session has any activities
			const activities = completeSession.completeActivities;
			if (activities.length > 0 && activities[activities.length - 1] != null) {
				for (const [userId, completed] of Object.entries(activities[activities.length - 1].data.completion)) {
					if (completed) {
						completeUserCount++;
					}
				}
			}

			// Store the activities for faster access 
			activities.forEach((activity) => {
				completeActivitiesById.set(activity.activity_id, activity);
			})

			// If there are any users, calculate the percentage of users that have completed the last activity
			if (userCount > 0) {
				lastActivityCompletion = (completeUserCount / userCount) * 100;
			}
			lastActivityCompletion = lastActivityCompletion.toFixed(2);
			card.find(".done").css('width', `${lastActivityCompletion}%`);
			card.find(".completionPercentage").append(lastActivityCompletion);
			card.find(".completedUsers").append(completeUserCount);
			card.find(".completedTotalUsers").append(userCount);

			// Show/hide tester menu items based on participant status
			if (isCurrentUserParticipant(sessionParticipants)) {
				card.find(".icon-tester").hide();
				card.find(".icon-reset-tester").show();
				card.find(".icon-untester").show();
				card.find(".sessionTestLauch").show();
			} else {
				card.find(".icon-tester").show();
				card.find(".icon-reset-tester").hide();
				card.find(".icon-untester").hide();
				card.find(".sessionTestLauch").hide();
			}

			// Paint all the activities in this session (defined at simlet_activities)
			paintSessionActivities(completeSession, completeSession.completeActivities, sessionParticipants);
		}
		
		// Get the complete session info and fill the card fields that depend on that info
		if (completeSessionsById.has(session.session_id)) {
			fillCompleteFields(completeSessionsById.get(session.session_id));
		}
		// If the complete info hasn't been stored yet, fetch it and store it for faster access
		else {
			Simva.getSimletSessionComplete(simletId, session.session_id, function(error, result) {
				if(!error) {
					completeSessionsById.set(session.session_id, result);
					fillCompleteFields(result);
				}
			})
		}
		
		let sessionClass = session.session_status;
		let sessionStatusLabel = "";
		
		// Show/hide action buttons based on session status
		if (sessionClass === SESSION_ACTIVE_STATUS) {
			// Only show pause and finalize
			card.find(".icon-activate").hide();
			card.find(".icon-pause").show();
			card.find(".icon-finish").show();
			if (sessionStatusLabel == "") {
				sessionStatusLabel = `<%- t('active.title', { ns : 'sessions' }) %>`;
			}
		} else if (sessionClass == SESSION_PAUSED_STATUS) {
			// Only show activate and finalize
			card.find(".icon-pause").hide();
			card.find(".icon-activate").show();
			card.find(".icon-finish").show();
			if (sessionStatusLabel == "") {
				sessionStatusLabel = `<%- t('paused.title', { ns : 'sessions' }) %>`;
			}
		} else if (sessionClass == SESSION_FINISHED_STATUS) {
			// Hide all action, add, and tester buttons
			card.find(".icon-activate").hide();
			card.find(".icon-pause").hide();
			card.find(".icon-finish").hide();
			card.find(".icon-add").hide();
			card.find(".icon-tester").hide();
			card.find(".icon-reset-tester").hide();
			card.find(".icon-untester").hide();
			if (sessionStatusLabel == "") {
				sessionStatusLabel = `<%- t('finished.title', { ns : 'sessions' }) %>`;
			}
		}
		
		// Block the session from being deleted if the SIMLET is archived
		if (simlet.simlet_archived) {
			card.find(".icon-delete").hide();
		}

		card.find(".sessionTitle").text(session.session_name);
		card.find(".sessionStatusLabel").addClass(sessionClass).attr("title", sessionStatusLabel).text(sessionStatusLabel);
		card.find(".sessionDescription").text(session.session_description);
		card.find(".sessionCreateDate").after(getFormattedDate(session.createdAt, currentlanguageCode));
		
		card.find(".sessionTags").append(renderTags(session));

		toggleSession(session.session_id);
	}

</script>

<!-- TAGS -->
<script type="text/javascript">
	let availableTags = [];
	let selectedTags = [];
	let originalTagsIds = [];
	
	const tagNameFieldClass = "tag_name_field";
	const MAX_TAG_NAME_LENGTH = 20;

	// Menus

	$(document).ready(function() {
		// Add counter to all tag name fields (defined in the simlet_commons partial)
		addInputCharCountToClass(tagNameFieldClass, MAX_TAG_NAME_LENGTH);

		
		$(document).on('click', function (e) {
			if (!$(e.target).closest('#session_tag_search').length && !$(e.target).closest('#session_tag_dropdown').length
				&& !$(e.target).closest('#session_selected_tags').length) {
				closeTagDropdown();
			}
		});
	});

	
	const toggleTagCreator = function() {
		$("#session_tag_creator").toggle();
		$("#session_tags_error").text("");
		
		if ($("#session_tag_creator").is(":visible")) {
			closeTagEditor();
		}
	}
	const closeTagCreator = function() {
		$("#session_tag_creator").hide();
		$("#session_tags_error").text("");
	}

	const openTagDropdown = function() {
		$("#session_tag_dropdown").show();
	}
	const closeTagDropdown = function() {
		$("#session_tag_dropdown").hide();
	}

	const openTagEditor = function(tagId) {
		$("#session_tag_editor").show();
		closeTagDropdown();
		closeTagCreator();
		
		const tag = getTagFromTagId(tagId);
		$("#edit_tag_id").val(tag.tag_id);
		$("#prev_tag_name").val(tag.tag_name);
		$("#prev_tag_color").val(tag.tag_color);
		
		$("#session_edit_tag_name").val(tag.tag_name);
		$("#session_edit_tag_color").val(tag.tag_color);
	}
	const closeTagEditor = function() {
		$("#session_tag_editor").hide();
		$("#session_tags_error").text("");
	}


	// Functionality

	const getTagFromTagId = function(tagId) {
		const normalizedTagId = Number(tagId);

		for (let i = 0; i < availableTags.length; i++) {
			let tag = availableTags[i];
			if (tag.tag_id === normalizedTagId) {
				return tag;
			}
		}
		return null;
	}

	const normalizeTag = function(tag) {
		if (!tag) {
			return null;
		}
		return {
			tag_id: Number(tag.tag_id),
			tag_name: tag.tag_name,
			tag_color: tag.tag_color || "#3b82f6"
		};
	}

	const addTagToSessionAsync = function(simletId, sessionId, tagId) {
		return new Promise((resolve, reject) => {
			Simva.addTagToSession(simletId, sessionId, tagId, function(error, result) {
				if (error) {
					reject(error);
					return;
				}
				resolve(result);
			});
		});
	}

	const deleteTagFromSessionAsync = function(simletId, sessionId, tagId) {
		return new Promise((resolve, reject) => {
			Simva.deleteTagFromSession(simletId, sessionId, tagId, function(error, result) {
				if (error) {
					reject(error);
					return;
				}
				resolve(result);
			});
		});
	}

	const syncSessionTags = function(simletId, sessionId, originalTagIds, targetTagIds, callback) {
		const toAdd = targetTagIds.filter((tagId) => !originalTagIds.includes(tagId));
		const toDelete = originalTagIds.filter((tagId) => !targetTagIds.includes(tagId));

		Promise.all([
			...toAdd.map((tagId) => addTagToSessionAsync(simletId, sessionId, tagId)),
			...toDelete.map((tagId) => deleteTagFromSessionAsync(simletId, sessionId, tagId))
		])
			.then(() => callback())
			.catch((error) => callback(error));
	}


	const selectTag = function(tagId) {
		const tag = getTagFromTagId(tagId);

		if (!selectedTags.includes(tagId)) {
			selectedTags.push(tag);
			updateAndRenderCurrentTags();
		}
		$("#session_new_tag_name").val("");
		$("session_tag_search").val("");
		closeTagCreator();
	}
	
	const unselectTag = function(tagId) {
		const tagToUnselect = getTagFromTagId(tagId);
		if (selectedTags.includes(tagToUnselect)) {
			selectedTags = selectedTags.filter((tag) => tag != tagToUnselect);
			updateAndRenderCurrentTags();
		}
	}

	const createAndSelectTag = function() {
		let tagName = $("#session_new_tag_name").val().trim();
		let tagColor = $("#session_new_tag_color").val();
		let errorBox = $('#session_tags_error');
		errorBox.text("");

		if (!tagName) {
			errorBox.text('Tag name is required');
			return;
		}

		Simva.createTag({ tag_name: tagName, tag_color: tagColor }, function(error, createdTag) {
			if (error) {
				errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}

			const created = normalizeTag(createdTag);
			if (created) {
				availableTags.push(createdTag);
				selectTag(created.tag_id);
			}
		});
	}

	const deleteTag = function(tagId) {
		Simva.deleteTag(tagId, function(error, result) {
			if (error) {
				// TODO: show error correctly when tag cant be deleted due to being used in other session
				// (only error has content but it shows [object Object])
				$('#session_tags_error').text(error.responseJSON ? error.responseJSON.message : error.message || error);
				return;
			}
			updateAndRenderCurrentTags();
		});
	}

	const saveEditingTag = function() {
		const tagId = $("#edit_tag_id").val();
		const tagName = $("#session_edit_tag_name").val();
		const tagColor = $("#session_edit_tag_color").val();

		const nameChanged = $("#prev_tag_name").val() != tagName;
		const colorChanged = $("#prev_tag_color").val() != tagColor;

		const errorBox = $("#session_tags_error");

		if (!nameChanged && !colorChanged) {
			errorBox.text("<%- t('edit.no_changes.message', { ns : 'SIMLETs' }) %>");
		}
		else if ($("#session_edit_tag_name").val() == "" || $("#session_edit_tag_name").val() == null) {
			errorBox.text('Tag name is required');
		}
		else {
			Simva.updateTag(tagId, { tag_name: tagName, tag_color: tagColor }, function(error) {
				if (error) {
					errorBox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
					return;
				}
				closeTagEditor();

				updateAndRenderCurrentTags(function(loadError) {
					if (loadError) {
						errorBox.text(loadError.responseJSON ? loadError.responseJSON.message : loadError.message || loadError);
						return;
					}
					openTagDropdown();
				});
			});
		}
	}


	const filterAvailableTagsBySearch = function() {
		const query = $("#session_tag_search").val().trim().toLowerCase();
		if (!query) {
			return availableTags;
		}

		return availableTags.filter((tag) => {
			const name = (tag.tag_name || '').toLowerCase();
			return name.includes(query);
		});
	}


	// Render

	const renderAvailableTags = function() {
		const container = $("#session_tag_dropdown");
		container.empty();
		const selectedIds = selectedTags.map((tag) => Number(tag.tag_id));
		const filteredTags = filterAvailableTagsBySearch();
		const addableTags = filteredTags.filter((tag) => !selectedIds.includes(Number(tag.tag_id)));

		if (availableTags.length === 0) {
			container.append(`<div class="tagDropdownEmpty"><%- t('tags.dropdown.no_tags', { ns : 'sessions' }) %></div>`);
			return;
		}

		if (filteredTags.length === 0) {
			container.append(`<div class="tagDropdownEmpty"><%- t('search.no_matches', { ns : 'SIMLETs' }) %></div>`);
			return;
		}

		if (addableTags.length === 0) {
			container.append(`<div class="tagDropdownEmpty"><%- t('tags.dropdown.all_matches', { ns : 'sessions' }) %></div>`);
			return;
		}

		for (let i = 0; i < addableTags.length; i++) {
			const tag = addableTags[i];
			const isSelected = selectedIds.includes(Number(tag.tag_id));
			container.append(`
				<div class="tagDropdownOption">
					<button type="button" class="tagDropdownPick" onclick="selectTag(${tag.tag_id})">
						<span class="tagPickerColor" style="background:${tag.tag_color};"></span>
						<span class="tagDropdownLabel">${tag.tag_name}</span>
					</button>
					<button type="button" class="tagDropdownEdit" onclick="openTagEditor(${tag.tag_id})">Edit</button>
					<button type="button" class="tagDropdownEdit" onclick="deleteTag(${tag.tag_id})">Delete</button>
				</div>
			`);
		}
	}

	const renderSelectedSessionTags = function() {
		const container = $("#session_selected_tags");
		container.empty();

		for (let i = 0; i < selectedTags.length; i++) {
			const tag = selectedTags[i];
			container.append(`
				<span class="tagSelectedChip">
					<span class="tagPickerColor" style="background:${tag.tag_color};"></span>
					<span class="tagSelectedName">${tag.tag_name}</span>
					<button type="button" class="tagSelectedRemove" onclick="unselectTag(${tag.tag_id})">x</button>
				</span>
			`);
		}
	}

	const updateAndRenderCurrentTags = function(callback) {
		Simva.getTags(function(error, tags) {
			if (error && callback) {
				callback(error);
				return;
			}
			
			availableTags = (Array.isArray(tags) ? tags : [])
				.map(normalizeTag)
				.filter((tag) => tag !== null)
				.filter((tag, index, arr) => arr.findIndex((current) => Number(current.tag_id) === Number(tag.tag_id)) === index)
				.sort((a, b) => a.tag_name.localeCompare(b.tag_name));
			
			selectedTags = selectedTags
				.map((tag) => getTagFromTagId(tag.tag_id) || tag)
				.filter((tag, index, arr) => arr.findIndex((current) => current.tag_id === tag.tag_id) === index);
			

			if (callback) {
				callback(null, availableTags);
			}

			renderSelectedSessionTags();
			renderAvailableTags();
		});
	}

</script>
