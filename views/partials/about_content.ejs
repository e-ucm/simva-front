<%
function getLocaleText(key, ns) {
	const value = t(key, { ns, defaultValue: key });
	if (value === key) {
		return '';
	}
	return value;
}

// Core sections in order
const coreSection = {
	id: 'simva',
	title: getLocaleText('simva.title', 'about'),
	description: getLocaleText('simva.description', 'about'),
	subsections: [
		{
			id: 'simva-frontend',
			title: getLocaleText('simva.frontend.title', 'about'),
			description: getLocaleText('simva.frontend.description', 'about'),
		},
		{
			id: 'simva-roles',
			title: getLocaleText('simva.roles.title', 'about'),
			description: getLocaleText('simva.roles.description', 'about'),
		},
	]
};

const simletSection = {
	id: 'simlet',
	title: getLocaleText('simlet.title', 'about'),
	description: getLocaleText('simlet.description', 'about'),
	subsections: [
		{
			id: 'archived-simlet',
			title: getLocaleText('archived_simlet.title', 'about'),
			description: getLocaleText('archived_simlet.description', 'about'),
		},
	]
};

const sessionSection = {
	id: 'session',
	title: getLocaleText('session.title', 'about'),
	description: getLocaleText('session.description', 'about'),
};

const isAuthenticated = typeof user !== 'undefined' && !!user;

const headerTutorialSection = {
	id: 'tutorial-header',
	title: isAuthenticated ? getLocaleText('header.login.title', 'about') : getLocaleText('header.logout.title', 'about'),
	description: isAuthenticated ? getLocaleText('header.login.description', 'about') : getLocaleText('header.logout.description', 'about'),
	note: isAuthenticated ? getLocaleText('header.login.note', 'about') : getLocaleText('header.logout.note', 'about'),
	steps: isAuthenticated ? [
		{
			id: 'tutorial-login-language',
			title: getLocaleText('header.login.language.title', 'about'),
			description: getLocaleText('header.login.language.description', 'about'),
		},
		{
			id: 'tutorial-login-account',
			title: getLocaleText('header.login.account.title', 'about'),
			description: getLocaleText('header.login.account.description', 'about'),
		},
		{
			id: 'tutorial-login-logout',
			title: getLocaleText('header.login.logout.title', 'about'),
			description: getLocaleText('header.login.logout.description', 'about'),
		},
	] : [
		{
			id: 'tutorial-logout-language',
			title: getLocaleText('header.logout.language.title', 'about'),
			description: getLocaleText('header.logout.language.description', 'about'),
		},
		{
			id: 'tutorial-logout-about',
			title: getLocaleText('header.logout.about.title', 'about'),
			description: getLocaleText('header.logout.about.description', 'about'),
		},
		{
			id: 'tutorial-logout-research',
			title: getLocaleText('header.logout.research.title', 'about'),
			description: getLocaleText('header.logout.research.description', 'about'),
		},
		{
			id: 'tutorial-logout-contact',
			title: getLocaleText('header.logout.contact.title', 'about'),
			description: getLocaleText('header.logout.contact.description', 'about'),
		},
		{
			id: 'tutorial-logout-login',
			title: getLocaleText('header.logout.login.title', 'about'),
			description: getLocaleText('header.logout.login.description', 'about'),
		},
	]
};

const menuTutorialSection = {
	id: 'tutorial-menu',
	title: getLocaleText('menu.title', 'about'),
	description: getLocaleText('menu.description', 'about'),
	note: getLocaleText('menu.note', 'about'),
	steps: [
		{
			id: 'tutorial-menu-home',
			title: getLocaleText('menu.home.title', 'about'),
			description: getLocaleText('menu.home.description', 'about'),
		},
		{
			id: 'tutorial-menu-play',
			title: getLocaleText('menu.play.title', 'about'),
			description: getLocaleText('menu.play.description', 'about'),
		},
		{
			id: 'tutorial-menu-simlets',
			title: getLocaleText('menu.simlets.title', 'about'),
			description: getLocaleText('menu.simlets.description', 'about'),
		},
		{
			id: 'tutorial-menu-groups',
			title: getLocaleText('menu.groups.title', 'about'),
			description: getLocaleText('menu.groups.description', 'about'),
		},
		{
			id: 'tutorial-menu-archived',
			title: getLocaleText('menu.archived.title', 'about'),
			description: getLocaleText('menu.archived.description', 'about'),
		},
		{
			id: 'tutorial-menu-about',
			title: getLocaleText('menu.about.title', 'about'),
			description: getLocaleText('menu.about.description', 'about'),
		},
	]
};

const tutorialSections = isAuthenticated ? [headerTutorialSection, menuTutorialSection] : [headerTutorialSection];

const rolesSection = {
	id: 'roles',
	title: 'Roles and Permissions',
	subsections: [
		{
			id: 'supervisor',
			title: getLocaleText('supervisor.title', 'about'),
			description: getLocaleText('supervisor.description', 'about'),
		},
		{
			id: 'coordinator',
			title: getLocaleText('coordinator.title', 'about'),
			description: getLocaleText('coordinator.description', 'about'),
		},
		{
			id: 'participant',
			title: getLocaleText('participant.title', 'about'),
			description: getLocaleText('participant.description', 'about'),
		},
	]
};

const gameSection = {
	id: 'games',
	title: 'Games Integration',
	subsections: [
		{
			id: 'gameclient',
			title: getLocaleText('gameclient.title', 'about'),
			description: getLocaleText('gameclient.description', 'about'),
		},
	]
};

const activitySection = {
	id: 'activity',
	title: getLocaleText('activity.title', 'about'),
	description: getLocaleText('activity.description', 'about'),
	typesTitle: getLocaleText('activity.types.title', 'about'),
	subsections: [
		{
			id: 'limesurvey',
			title: getLocaleText('limesurvey.title', 'about'),
			description: getLocaleText('limesurvey.description', 'about'),
		},
		{
			id: 'gameplay',
			title: getLocaleText('gameplay.title', 'about'),
			description: getLocaleText('gameplay.description', 'about'),
		},
		{
			id: 'manual',
			title: getLocaleText('manual.title', 'about'),
			description: getLocaleText('manual.description', 'about'),
		},
	]
};

const templateSection = {
	id: 'templates',
	title: 'Activity Definitions',
	subsections: [
		{
			id: 'activitytemplate',
			title: getLocaleText('activitytemplate.title', 'about'),
			description: getLocaleText('activitytemplate.description', 'about'),
		},
		{
			id: 'activityinstance',
			title: getLocaleText('activityinstance.title', 'about'),
			description: getLocaleText('activityinstance.description', 'about'),
		},
	]
};

const managementSection = {
	id: 'management',
	title: 'Session Management',
	subsections: [
		{
			id: 'manualcompletion',
			title: getLocaleText('manualcompletion.title', 'about'),
			description: getLocaleText('manualcompletion.description', 'about'),
		},
		{
			id: 'dashboard',
			title: getLocaleText('dashboard.title', 'about'),
			description: getLocaleText('dashboard.description', 'about'),
		},
	]
};

const usersSection = {
	id: 'users',
	title: getLocaleText('users.title', 'about'),
	description: getLocaleText('users.description', 'about'),
};

const groupSection = {
	id: 'group',
	title: getLocaleText('group.title', 'about'),
	description: getLocaleText('group.description', 'about'),
};

// Build main sections with filters
const mainSections = [...tutorialSections, coreSection, simletSection, sessionSection, activitySection, groupSection, rolesSection, gameSection, managementSection ] //usersSection, templateSection]
	.filter((section) => section.title || (section.subsections && section.subsections.some(s => s.title && s.description)));

const otherSections = [];
%>

<div class="aboutSections">
<h1><%= t('title', { ns : 'about'}) %></h1>
	<% mainSections.forEach((section) => { %>
		<section id="<%= section.id %>" class="aboutSection">
			<% if (section.title) { %>
				<h2><%= section.title %></h2>
			<% } %>
			<% if (section.description) { %>
				<p><%= section.description %></p>
			<% } %>
			<% if (section.steps && section.steps.length > 0) { %>
				<ol class="aboutTutorialSteps">
					<% section.steps.forEach((step) => { %>
						<% if (step.title && step.description) { %>
							<li id="<%= step.id %>">
								<p><a href="<%= step.href %>"><%= step.title %></a></p>
								<p><%= step.description %></p>
							</li>
						<% } %>
					<% }) %>
				</ol>
				<% if (section.note) { %>
					<p><%= section.note %></p>
				<% } %>
			<% } %>
			<% if (section.subsections && section.subsections.length > 0) { %>
				<% if (section.typesTitle) { %>
					<h3><%= section.typesTitle %></h3>
				<% } %>
				<% section.subsections.forEach((subsection) => { %>
					<% if (subsection.title && subsection.description) { %>
						<section id="<%= subsection.id %>" class="aboutSubSection">
							<h4><%= subsection.title %></h4>
							<p><%= subsection.description %></p>
						</section>
					<% } %>
				<% }) %>
			<% } %>
		</section>
	<% }) %>

	<% if (otherSections.length > 0) { %>
		<% otherSections.forEach((section) => { %>
			<section id="<%= section.id %>" class="aboutSection">
				<h2><%= section.title %></h2>
				<p><%= section.description %></p>
			</section>
		<% }) %>
	<% } %>
</div>