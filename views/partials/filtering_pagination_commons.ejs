<%# views/partials/filtering_pagination_commons.ejs %>

<!-- Elements that are common for all views that include a search bar + filters for filtering and pagination -->

<% 
const INCLUDE_SESSIONS_STATUS = typeof id !== 'undefined' && (id.toLowerCase()).includes("sessions");
const INCLUDE_TAGS_FILTERING = typeof id !== 'undefined' && ((id.toLowerCase()).includes("simlets") || INCLUDE_SESSIONS_STATUS);
let nestedPartialsResources = partialsResources;
%>

<div id="<%= id %>" class="filtering">
	<input type="text" class="filteringSearchBar" placeholder="<%= searchBarPlaceholderText %>">
    
	<div class="filters">
		<span><%= t('filters.sort_by.title', { ns : 'commons' }) %></span>
		<select class="filteringSortBy">
			<option value="id" data-order="asc" ><%= t('filters.sort_by.id', { ns : 'commons' }) %></option>
			<option value="name" data-order="asc"><%= t('filters.sort_by.name.asc', { ns : 'commons' }) %></option>
			<option value="name" data-order="desc"><%= t('filters.sort_by.name.desc', { ns : 'commons' }) %></option>
			<option value="createdAt" data-order="desc"><%= t('filters.sort_by.created_at.desc', { ns : 'commons' }) %></option>
			<option value="createdAt" data-order="asc"><%= t('filters.sort_by.created_at.asc', { ns : 'commons' }) %></option>
			<option value="updatedAt" data-order="desc"><%= t('filters.sort_by.updated_at.desc', { ns : 'commons' }) %></option>
			<option value="updatedAt" data-order="asc"><%= t('filters.sort_by.updated_at.asc', { ns : 'commons' }) %></option>
		</select>
	</div>

<!-- Session status filtering -->
<% if (INCLUDE_SESSIONS_STATUS) { %>
    <div class="filters">
		<span><%= t('sessions.status.title', { ns : 'sessions' }) %></span>
		<select class="filteringStatus">
			<option value=""><%= t('filters.status.all', { ns : 'sessions' }) %></option>
			<option value="active"><%= t('sessions.status.active.title', { ns : 'sessions' }) %></option>
			<option value="inactive"><%= t('sessions.status.paused.title', { ns : 'sessions' }) %></option>
			<option value="terminated"><%= t('sessions.status.finished.title', { ns : 'sessions' }) %></option>
		</select>
	</div>
<% } %>

<!-- Tags filtering -->
<% if (INCLUDE_TAGS_FILTERING) { %>
    <%- include('dropdowns/base_multi_select_dropdown', { partialsResources: nestedPartialsResources }) %>
<% } %>

</div>

<!-- Ensure the filteringPagination script only gets included once, that the FILTERS_PAGINATION_DATA_KEY variable only get 
declared once, and that the document event delegate that blurs the select elements focus only gets registered once -->
<% if (nestedPartialsResources !== 'undefined' && !nestedPartialsResources["filteringPagination.js"]) { %>

<script type="text/javascript" src="/src/filteringPagination.js"></script>
<% nestedPartialsResources["filteringPagination.js"] = true; %>

<script type="text/javascript">

    const FILTERS_PAGINATION_DATA_KEY = "filteringPagination";

    $(document).on("click", function(e) {
        // Force select elements of the filtering options to lose focus when clicking anywhere, 
        // since they don't automatically lose focus after clicking anywhere else and they 
        // don't detect hovering until clicking outside again
        $(".filtering select").blur();
    });
    
</script>
<% } %>


<script type="text/javascript">
    
    // Assign a new FilteringPagination instance to the root object
    $("#<%= id %>").data(FILTERS_PAGINATION_DATA_KEY, new FilteringPagination($("#<%- id %>")));
    
</script>


<!-- Tags dropdown -->
<% if (INCLUDE_TAGS_FILTERING) { %>
<%- include('dropdowns/tags_multi_select_dropdown', { partialsResources: nestedPartialsResources }) %>

<script type="text/javascript">
    const tagsMultiSelect = $("#<%- id %>").find(".multiSelect");

    // Add the class and title for the filtering and pagination dropdown
    tagsMultiSelect.addClass("filters filtersTags");
    tagsMultiSelect.prepend($("<span>", { text: "<%- t('filters.tags.title', { ns : 'commons' }) %>" }));

    // Change the selected option and the search bar placeholder text
    tagsMultiSelect.find(".multiSelectSelector option").text("<%- t('filters.tags.selected.title', { ns : 'commons', count: 0 }) %>")
    tagsMultiSelect.find(".searchBar").attr("placeholder", "<%- t('filters.tags.search_bar.placeholder', { ns : 'commons' }) %>");

    class FiltersTagsMultiSelectDropdown extends TagsMultiSelectDropdown {
        constructor($rootElem) {
            super($rootElem);
            this.filteringPagination = $rootElem.closest(".filtering").data()[FILTERS_PAGINATION_DATA_KEY];
        }
        
        onOptionClick($listElem) {
            super.onOptionClick($listElem);
            this.$selectorPlaceholder.text(`<%- t('filters.tags.selected.title', { ns : 'commons', count: '${this.selectedOptions.size}' }) %>`);
            this.filteringPagination.searchParams.searchTags = Array.from(this.selectedOptions);
            this.filteringPagination.resetSearchTimer();
        }
    }

    // Assign a new FiltersTagsMultiSelectDropdown instance to the root object
    tagsMultiSelect.data(MULTI_SELECT_DROPDOWN_DATA_KEY, new FiltersTagsMultiSelectDropdown(tagsMultiSelect));
    
</script>
    
<% } %>
