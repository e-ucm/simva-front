<!-- Elements that are common for all views that include a search bar + filters for filtering and pagination -->

<div id="<%= id %>_filtering" class="filtering">
	<input type="text" id="<%= id %>_search_bar" placeholder="<%= searchBarPlaceholderText %>">
    
	<div class="filters">
		<span><%- t('filters.sortBy.title', { ns : 'SIMLETs' }) %></span>
		<select id="<%= id %>_sort_by">
			<option value="id" data-order="asc" ><%- t('filters.sortBy.id', { ns : 'SIMLETs' }) %></option>
			<option value="name" data-order="asc"><%- t('filters.sortBy.name.asc', { ns : 'SIMLETs' }) %></option>
			<option value="name" data-order="desc"><%- t('filters.sortBy.name.desc', { ns : 'SIMLETs' }) %></option>
			<option value="createdAt" data-order="desc"><%- t('filters.sortBy.createdAt.desc', { ns : 'SIMLETs' }) %></option>
			<option value="createdAt" data-order="asc"><%- t('filters.sortBy.createdAt.asc', { ns : 'SIMLETs' }) %></option>
			<option value="updatedAt" data-order="desc"><%- t('filters.sortBy.updatedAt.desc', { ns : 'SIMLETs' }) %></option>
			<option value="updatedAt" data-order="asc"><%- t('filters.sortBy.updatedAt.asc', { ns : 'SIMLETs' }) %></option>
		</select>
	</div>

<!-- Session status filtering -->
<% if (typeof id !== 'undefined' && id == "sessions" ) { %>
    <div class="filters">
		<span><%- t('filters.status.title', { ns : 'sessions' }) %></span>
		<select id="<%= id %>_status">
			<option value=""><%- t('filters.status.all', { ns : 'sessions' }) %></option>
			<option value="active"><%- t('active.title', { ns : 'sessions' }) %></option>
			<option value="inactive"><%- t('paused.title', { ns : 'sessions' }) %></option>
			<option value="terminated"><%- t('finished.title', { ns : 'sessions' }) %></option>
		</select>
	</div>
<% } %>

<!-- Tags filtering -->
<% if (typeof id !== 'undefined' && (id == "simlets" || id == "sessions") ) { %>
    <div class="filters filtersTags">
        <span><%- t('filters.tags.title', { ns : 'SIMLETs' }) %></span>

        <select id="<%= id %>_tags_selector">
            <!-- Default option to show a value in the dropdown -->
            <option id="<%= id %>_selected_tags_amount" value="" selected disabled hidden></option>
        </select>
        
        <!-- Fake select dropdown that will appear instead of the default one -->
        <div id="<%= id %>_tags_dropdown" class="filtersTagsDropdown">
            <input type="text" id="<%= id %>_tags_search_bar" placeholder="<%- t('filters.tags.searchBar.placeholder', { ns : 'SIMLETs' }) %>">
            <ul id="<%= id %>_tags_list" class="filtersTagsList">
                
            </ul>
            
        </div>
	</div>

    <!-- Template for each element of the tags list -->
    <div id="search_tag_template" style="display: none;">
        <li class="searchTag">
            <input type="checkbox">
                <span class="sessionTagChip">
                    <span class="sessionTagColor"></span>
                    <span class="sessionTagName"></span>
                </span>
            </input>
        </li>
    </div>
<% } %>

</div>

<script type="text/javascript">
    // Variables and functions need to be stored in the div data to avoid declaration
    // conflicts when including the partial multiple times in the same view

    $("#<%= id %>_filtering").data()["lastScrollTop"] = 0;

    $("#<%= id %>_filtering").data()["showAtOnce"] = 1;     // Maximum amount of results that will be returned on each search
    $("#<%= id %>_filtering").data()["currentPage"] = 1;    // "Page" from where the search will take the results (used to calculate skip and limit)
    $("#<%= id %>_filtering").data()["totalResults"] = 1;   // Amount of results available for the search

    // Default callbacks. To change their behavior, a function needs to be asigned as their value
    $("#<%= id %>_filtering").data()["updateSearchCallback"] = () => {};            // Called when updating a search to get new results
    $("#<%= id %>_filtering").data()["checkLoadMore"] = () => { return true; };     // Called to check extra conditions to know when to load more results
    $("#<%= id %>_filtering").data()["loadMoreCallback"] = () => {};                // Called to load more results in the current search

    // Object that defines the parameters that will be passed to the api calls as a query
    // The default parameters common all calls are:
    // - skip (pagination)
    // - limit (pagination)
    // - searchString (filtering)
    // - orderBy (filtering)
    // - order (filtering)
    // Other parameters that are exclusive to certain calls are searchTags or status
    // When calling the /count endpoints, only searchString and the exclusive parameters will be taken into account
    $("#<%= id %>_filtering").data()["searchParams"] = { };

    
    // Update the search parameters
    $("#<%= id %>_filtering").data()["updateSearchOptions"] = function() {
        let data = $("#<%= id %>_filtering").data();
        
        data["totalPages"] = Math.ceil(data["totalResults"] / data["showAtOnce"]);

        // Set each parameter individually instead of setting the entire data["searchParams"]
        // object to allow extra parameters to be added from anywhere else
        data["searchParams"].skip = (data["currentPage"] - 1) * data["showAtOnce"];
        data["searchParams"].limit = (data["currentPage"]) * data["showAtOnce"];
        data["searchParams"].searchString = $("#<%= id %>_search_bar").val().trim().toLowerCase() || "";
        data["searchParams"].orderBy = $("#<%= id %>_sort_by").val() || "id";
        data["searchParams"].order = $("#<%= id %>_sort_by").find("option:selected").data("order") || "desc";

        if ($("#<%= id %>_status").length) {
            data["searchParams"].status = $("#<%= id %>_status").val() || "";
        }
    }
    
    // Update the search parameters and call the update function
    $("#<%= id %>_filtering").data()["updateSearch"] = function() {
        let data = $("#<%= id %>_filtering").data();
        data["currentPage"] = 1;

        data["updateSearchOptions"]();
        data["updateSearchCallback"]();
    }

    
    // Shared listeners 
    
    $(window).scroll(function(e) {
        let data = $("#<%= id %>_filtering").data();

        const currentScrollTop = $(window).scrollTop();
        const scrollDelta = currentScrollTop - data["lastScrollTop"];

        // When scrolling to the bottom of the window, if the scroll is positive 
        // (to ignore when the window scroll event gets triggered when the window
        // gets smaller for dynamically removing/shrinking elements)
        if ($(window).scrollTop() == $(document).height() - $(window).height() && scrollDelta > 0 ) {
            // If there are still pages to load, update the current page and load more
            if (data["currentPage"] < data["totalPages"] && data["checkLoadMore"]()) {
                data["currentPage"]++;

                data["updateSearchOptions"]();
                data["loadMoreCallback"]();
            }
        }

        data["lastScrollTop"] = currentScrollTop;
    });
    
    // Search bar
    $("#<%= id %>_search_bar").on("input", function () {
        $("#<%= id %>_filtering").data()["updateSearch"]();
    });

    // Sort by dropdown
    $("#<%= id %>_sort_by").on("change", function () {
        $("#<%= id %>_filtering").data()["updateSearch"]();
    });

    // Sort order dropdown
    $("#<%= id %>_sort_order").on("change", function () {
        $("#<%= id %>_filtering").data()["updateSearch"]();
    });

    
    $(document).on("click", function(e) {
        // Force select elements of the filtering options to lose focus when clicking outside of them
        // (they don't lose focus even after clicking outside, so by default they don't detect they're 
        // getting hovered until clicking outside again) 
        $(".filtering select").blur();
    });

</script>


<% if (typeof id !== 'undefined' && (id == "simlets" || id == "sessions") ) { %>

<script type="text/javascript">
    // Since this part will never be included multiple times in the same view, variables 
    // and functions can be declared normally instead of storing them in the div data
    
    $("#<%= id %>_tags_dropdown").hide();
    let selectedTagsIds = new Set();

    // Place the tags dropdown to the left or to the right bellow the select depending on its position
    $(window).on("resize", function() {
        const tagsSelector = $(".filtersTags");
        const tagsDropdown = $(".filtersTags .filtersTagsDropdown");

        if (tagsSelector[0].getBoundingClientRect().left > $(window).width() / 2) {
            tagsDropdown.css({
                right: 0,
                left: "auto"
            });
        }
        else {
            tagsDropdown.css({
                lef: 0,
                right: "auto"
            });
        }
    });

    $(document).ready(function() {
        // Trigger the resize window event to adjust the tags dropdown for the first time
        window.dispatchEvent(new Event("resize"));
        
        // Reset the tags selection
        $("#<%= id %>_selected_tags_amount").text("<%- t('filters.tags.selected.title', { ns : 'SIMLETs', count: 0 }) %>");
        $("#<%= id %>_search_bar").val("");
	});
    

    // Shared listeners 
    
    // Hide the filtersTagsDropdown since it doesn't behave as the regular select dropdown, so it doesn't
    // hide automatically after clicking outside of it or when pressing another select element
    $(document).on("click", function(e) {
        hideTagsDropdown(e);
    });

    $("select").on('mousedown', function (e) {
        hideTagsDropdown(e);
    });
    

    $("#<%= id %>_tags_selector").on("mousedown", function (e) {
        // Prevent the default select dropdown to open
        e.preventDefault();
        
        const $dropdown = $("#<%= id %>_tags_dropdown");
        $dropdown.fadeToggle(100);

        if ($dropdown.is(":visible")) {
            $("#<%= id %>_tags_search_bar").val("");
            $("#<%= id %>_tags_search_bar").focus();
            renderMatchingTags();
        }
    });
    
    $(document).on("click", ".searchTag", function (e) {
        const data = $(this).data();
        $(this).find("input[type='checkbox']").prop("checked", function(i, val) { 
            // If it's checked, it will get unchecked, so remove it from the selected tags
            if (val) {
                selectedTagsIds.delete(data["id"]);
            }
            // Otherwise, it will get checked, so add it
            else {
                selectedTagsIds.add(data["id"]);
            }
            return !val; 
        });
        
        $("#<%= id %>_selected_tags_amount").text(`<%- t('filters.tags.selected.title', { ns : 'SIMLETs', count: '${selectedTagsIds.size}' }) %>`);
        $("#<%= id %>_filtering").data()["searchParams"].searchTags = Array.from(selectedTagsIds);
        $("#<%= id %>_filtering").data()["updateSearch"]();
    });


    // Tags search bar
    $("#<%= id %>_tags_search_bar").on("input", function () {
        renderMatchingTags();
    });


    const hideTagsDropdown = function(e) {
        const dropdown = $("#<%= id %>_tags_dropdown");
        // Hide if the dropdown is visible and the interacted element is other than the select or the dropdown
        if (dropdown.is(":visible") && !$(e.target).closest("#<%= id %>_tags_selector").length && !$(e.target).closest(dropdown).length ) {
            e.preventDefault();
            dropdown.fadeOut(100);
        }
    }

    const renderMatchingTags = function () {
        $('#<%= id %>_tags_list').empty();

        if (allTags.size == 0) {
            $('#<%= id %>_tags_list').append($("#no_tags_template .sessionTagList").clone());
            return;
        }
        
        let searchValue = $("#<%= id %>_tags_search_bar").val().trim().toLowerCase() || "";


        const searchResult = searchTagsByName(searchValue);
        searchResult.forEach(tag => {
            const tagObj = $("#search_tag_template .searchTag").clone();
            tagObj.data("id", tag.tag_id);

            $(tagObj).find("input[type='checkbox']").prop("checked", selectedTagsIds.has(tag.tag_id));

            tagObj.find(".sessionTagColor").css({
                background: tag.tag_color
            });
            tagObj.find(".sessionTagName").text(tag.tag_name);

            $('#<%= id %>_tags_list').append(tagObj);
        });
        if (searchResult.length == 0) {
            $('#<%= id %>_tags_list').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
        }
    }

</script>

<% } %>

<% if (typeof id !== 'undefined' && id == "sessions") { %>

<script type="text/javascript">

    $("#<%= id %>_status").on("change", function () {
        $("#<%= id %>_filtering").data()["updateSearch"]();
    });

</script>

<% } %>
