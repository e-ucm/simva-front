<div class="filtering">
	<!-- TODO: Add localization -->
	<input
		type="text"
		id="<%= id %>_search_bar"
		placeholder="<%- t('searchBar.placeholder', { ns : 'SIMLETs' }) %>"
		oninput="updateFiltersAndPagination()"
	>
	<div class="filters">
		<span><%- t('filters.sortBy.title', { ns : 'SIMLETs' }) %></span>
		<select id="<%= id %>_sortBy" onchange="updateFiltersAndPagination()">
			<option value="id"><%- t('filters.sortBy.id', { ns : 'SIMLETs' }) %></option>
			<option value="name"><%- t('filters.sortBy.name', { ns : 'SIMLETs' }) %></option>
			<option value="createdAt"><%- t('filters.sortBy.createdAt', { ns : 'SIMLETs' }) %></option>
			<option value="updatedAt"><%- t('filters.sortBy.updatedAt', { ns : 'SIMLETs' }) %></option>
		</select>
	</div>
    <div class="filters">
		<span><%- t('filters.sortOrder.title', { ns : 'SIMLETs' }) %></span>
		<select id="<%= id %>_sortOrder" onchange="updateFiltersAndPagination()">
			<option value="asc"><%- t('filters.sortOrder.asc', { ns : 'SIMLETs' }) %></option>
			<option value="desc"><%- t('filters.sortOrder.desc', { ns : 'SIMLETs' }) %></option>
		</select>
	</div>
</div>


<script type="text/javascript">
    let showAtOnce = 1;
    let currentPage = 1;
    
    let totalResults = 0;
    let totalPages = 0;
    let updateCallback = () => {}
    let loadMoreCallback = () => {}

    let searchBarOptions = { }

    // Window scroll events
    $(window).scroll(function() {

        // When scrolling to the bottom of the windows
        if ($(window).scrollTop() == $(document).height() - $(window).height()) {
            // If there are still pages to load, update the current page and load more
            if (currentPage < totalPages) {
                currentPage++;
                updateSearchOptions();

                loadMoreCallback();
            }
        }
    });
    
    const updateSearchOptions = function() {
        totalPages = Math.floor(totalResults / showAtOnce) + 1;
        searchBarOptions = {
            skip: (currentPage - 1) * showAtOnce,
            limit: (currentPage) * showAtOnce,
            searchString: $("#<%= id %>_search_bar").val().trim().toLowerCase() || "",
            orderBy: $("#<%= id %>_sortBy").val() || "id",
            order: $("#<%= id %>_sortOrder").val() || "desc"
        }
    }
    
    const updateFiltersAndPagination = function() {
        currentPage = 1;
        updateSearchOptions();
        updateCallback();
    }

</script>