<% const schedulerMode = typeof isScheduler !== 'undefined' && isScheduler; %>
<% const schedulerTestMode = typeof testMode !== 'undefined' && testMode; %>
<div class="header<%= schedulerMode ? ' black' : '' %>">
	<div class="left">
		<%- include('header_language_selector') %>
		<img class="logo" src="/images/logo.png">
		<span style="margin-left: 10px;"><%= schedulerMode ? t('scheduler.current', { ns : 'SIMLETs' }) : t('title') %></span>
		<% if (schedulerMode) { %><span id="current_activity_name" style="margin-left: 5px;"></span><% } %>
	</div>
	<div class="right">
		<ul>
		<% if (schedulerMode) { %>
			<li>
				<a id="refresh" style="cursor: pointer;" onclick="location.reload()">
					<img src="/images/icons/undo.png" style="filter: invert(100%);"> <%= t('scheduler.refresh', { ns : 'SIMLETs' }) %>
				</a>
			</li>
			
			<li id="complete_activity" style="display: none">
				<a style="cursor: pointer;" onclick="completeActivity()">
					<img src="/images/icons/check.png" style="filter: invert(100%);"> <%= t('scheduler.complete', { ns : 'SIMLETs' }) %>
				</a>
			</li>
			<li>
				<a>
					<img src="/images/icons/user.png" style="filter: invert(100%);"> <span id="username" style="padding: 0px;">
				</a>
			</li>
			
			<% if(!schedulerTestMode) { %>
				<li>
					<a href="/scheduler/">
						<img src="/images/icons/back.png" style="filter: invert(100%);"> <%= t('scheduler.exit', { ns : 'SIMLETs' }) %></span>
					</a>
				</li>
			<% } %>
			
		<% } else { %>
			<li>
				<a id="account_username" href="<%= config.sso.accountUrl%>">
					<img src="/images/icons/user.png"> <span id="username" style="padding: 0px;">
				</a>
			</li>
		<% } %>

		<% if(!schedulerTestMode) { %>
			<li>
				<a class="logout" href="/users/logout">
					<img src="/images/icons/power-button-off.png" style="filter: invert(100%);"> <%= t('logout.title') %>
				</a>
			</li>
		<% } %>
		</ul>
		
	</div>
</div>
