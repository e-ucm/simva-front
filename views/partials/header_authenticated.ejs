<% const schedulerMode = typeof isScheduler !== 'undefined' && isScheduler; %>
<div class="header<%= schedulerMode ? ' black' : '' %>">
	<div class="left">
		<%- include('header_language_selector') %>
		<span class="logo"><img src="/logo.png"></span>
		<span class="title"><%= schedulerMode ? t('scheduler.current', { ns : 'SIMLETs' }) : t('title') %></span>
		<% if (schedulerMode) { %><span id="current_activity_name"></span><% } %>
	</div>
	<div class="right">
		<% if (schedulerMode) { %>
			<span id="refresh"><a style="cursor: pointer;" onclick="location.reload()"><img src="/icon/refresh.png"> <span><%= t('scheduler.refresh', { ns : 'SIMLETs' }) %></span></a></span>
			<span id="complete_activity" style="display: none"><a style="cursor: pointer;" onclick="completeActivity()"><img src="/icon/check.png"> <span><%= t('scheduler.complete', { ns : 'SIMLETs' }) %></span></a></span>
			<span><a><img src="/icon/user_white.png"> <span id="username"></span></a></span>
			<span><a class="logout" href="/simlets/"><img src="/icon/back.png"> <span><%= t('scheduler.exit', { ns : 'SIMLETs' }) %></span></a></span>
		<% } else { %>
			<span><a id="account_username" href="<%= config.sso.accountUrl%>"><img src="/icon/user.png"> <span id="username"></span></a></span>
		<% } %>
		<span><a class="logout" href="/users/logout"><img src="/icon/power.png"> <span><%= t('logout.title') %></span></a></span>
	</div>
</div>
