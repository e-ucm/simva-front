<!-- Elements that are common both the SIMLETs/archived SIMLETs list view and the individual SIMLET view -->

<!-- Add/edit SIMLET form -->
<div id ="simlet_form_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="simlet_form">
			<h1 id="simlet_form_title">	</h1>
			
			<% if (typeof archived !== 'undefined' && !archived) { %>
			<div class="tabs" id="add_simlet_tabs">
				<span id="simlet_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'simlet_form','simlet_name_desc_tab')"><%- t('new.tab', { ns : 'SIMLETs' }) %></span>
				<span id="simlet_import_tab_button" class="tab" onclick="Utils.changeTab(this, 'simlet_form','import_simlet_tab')"><%- t('import.tab', { ns : 'SIMLETs' }) %></span>
			</div>
			<% } %>

			<!-- Create/edit SIMLET -->
			<div id="simlet_name_desc_tab" class="subform selected">
				<form id="simlet_name_desc_form">
					<input hidden type="text" name="editingSimletId" id="edit_simlet_id">
					<input hidden type="text" name="prevSimletName" id="prev_simlet_name">
					<input hidden type="text" name="prevSimletDescription" id="prev_simlet_description">
					<h3><%- t('name.title', { ns : 'SIMLETs' }) %></h3>
					<input type="text" id="simlet_name" class="name_field" name="simletName" placeholder="<%- t('name.placeholder', { ns : 'SIMLETs' }) %>" required>
					<h3><%- t('description.title', { ns : 'SIMLETs' }) %></h3>
					<textarea id="simlet_description" class="description_field" name="simletDescription" placeholder="<%- t('description.placeholder', { ns : 'SIMLETs' }) %>"></textarea>
					<input type="submit" id="simlet_name_desc_submit" value="">
				</form>
			</div>

			<!-- Import SIMLET -->
			<div hidden id="import_simlet_tab" class="subform" style="display: none;">
				<form id="simlet_import_form">
					<h3><%- t('name.title', { ns : 'SIMLETs' }) %></h3>
					<input type="text" class="name_field" name="simletName" placeholder="<%- t('name.placeholder', { ns : 'SIMLETs' }) %>" required>
					<h3><%- t('import.input', { ns : 'SIMLETs' }) %></h3>
					<input type="file" name="jsonFile" accept=".json" required>
					<input type="submit" value="<%- t('import.submit', { ns : 'SIMLETs' }) %>">
				</form>
			</div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="simlet_form_error"></span>
		</div>
	</div>
</div>

<!-- Manage SIMLET URL form -->
<div id="simlet_url_settings" class="new_element floating">
	<div class="floater">
		<div class="form">
			<h1 class="formSimletTitle">		</h1>
			<div id="edit_url_tab" class="subform selected">
				<input type="button" id="generate_shlink_url" class="blue" value="<%- t('scheduler.shlink.generate.title', { ns : 'SIMLETs' }) %>" onclick="openGenerateLinkForm()">
				<input type="button" id="shlink_url_short" class="green" onclick="copyShortURL()" style="white-space: normal; word-wrap: break-word;">
				<input type="button" id="delete_shlink_url" class="red" value="<%- t('scheduler.shlink.delete.title', { ns : 'SIMLETs' }) %>" onclick="deleteShLink()">
			</div>
		</div>
	</div>
</div>

<!-- Genrate SIMLET URL form -->
<div id="generate_simlet_link_menu" class="new_element floating">
	<div class="floater">
		<div class="form" id="generate_simlet_link_form">
			<h2><%- t('scheduler.shlink.generate.title', { ns : 'SIMLETs' }) %></h2>
			<div class="tabs">
				<span id="generate_link_length_tab_button" class="tab selected" type="hidden" onclick="Utils.changeTab(this, 'generate_simlet_link_form','generate_simlet_link_length_tab')"><%- t('scheduler.shlink.generate.randomly_length.title', { ns : 'SIMLETs' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'generate_simlet_link_form','generate_simlet_custom_slug_link_tab')"><%- t('scheduler.shlink.generate.custom_slug.title', { ns : 'SIMLETs' }) %></span>
			</div>

			<div id="generate_simlet_link_length_tab" class="subform selected">
				<form id="generate_simlet_link_length_form">
					<h3><%- t('scheduler.shlink.generate.randomly_length.title', { ns : 'SIMLETs' }) %></h3>
					<p><%- t('scheduler.shlink.generate.randomly_length.message', { ns : 'SIMLETs' }) %></p>
					<input type="number" step=1 min=4 name="link_length_shlink" id="link_length_shlink" onchange="this.value = Math.max(4, parseInt(this.value));" value=4 required>
					<input type="submit" value="<%- t('scheduler.shlink.generate.submit', { ns : 'SIMLETs' }) %>">
				</form>
			</div>

			<div id="generate_simlet_custom_slug_link_tab" class="subform" style="display: none;">
				<form id="generate_simlet_custom_slug_link_form">
					<h3><%- t('scheduler.shlink.generate.custom_slug.title', { ns : 'SIMLETs' }) %></h3>
					<input type="text" name="custom_slug" id="custom_slug_shlink" placeholder="<%- t('scheduler.shlink.custom_slug.placeholder', { ns : 'SIMLETs' }) %>" required>
					<input type="submit" value="<%- t('scheduler.shlink.generate.submit', { ns : 'SIMLETs' }) %>">
				</form>
			</div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
            <span class="error" id="generate_link_error"></span>
		</div>
	</div>
</div>

<!-- Download SIMLET config form -->
<!-- Template for the 3-dot menu of an entire SIMLET  -->
<div id="kebab_template" style="display: none;">
	<ul class="kebab-dropdown" style="display: none;">
		<li class="text-with-icon icon-edit" title="<%- t('settings.edit.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.edit.title', { ns : 'SIMLETs' }) %>
		</li>
		<li class="text-with-icon icon-url" title="<%- t('settings.url.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.url.title', { ns : 'SIMLETs' }) %>
		</li>
		<li class="text-with-icon icon-download" title="<%- t('settings.export.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.export.title', { ns : 'SIMLETs' }) %>
		</li>
		<li class="text-with-icon icon-archive" title="<%- t('settings.archive.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.archive.title', { ns : 'SIMLETs' }) %>
		</li>
		<li class="text-with-icon icon-dearchive" title="<%- t('settings.dearchive.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.dearchive.title', { ns : 'SIMLETs' }) %>
		</li>
		<li class="text-with-icon icon-delete" title="<%- t('settings.delete.title', { ns : 'SIMLETs' }) %>">
			<%- t('settings.delete.title', { ns : 'SIMLETs' }) %>
		</li>
	</ul>
</div>

<!-- Template for the character count of all the text input fields in forms -->
<div id="char_count_template" style="display: none;">
	<span class="char-count"></span>
</div>

<!-- Template for the no tags element of the tags list -->
<div id="no_tags_template" style="display: none;">
	<div class="sessionTagList">
		<span class="sessionTagEmpty"><%- t('tags.no_tags', { ns : 'sessions' }) %></span>
	</div>
</div>


<script type="text/javascript" src="/src/kebabs.js"></script>
<script type="text/javascript" src="/src/tooltips.js"></script>

<script type="text/javascript">
	const NAME_FIELD_CLASS = "name_field";					// Class of the input fields that will be used to write names 
	const DESCRIPTION_DIELD_CLASS = "description_field";	// Class of the input fields that will be used to write descriptions
	let classesWithCharCount = new Set();					// Classes of elements that will have character counts	
	let classesWithCharCountStr = "";						// classesWithCharCount converted to jquery selector format

	const MAX_NAME_LENGTH = 40;								// Max length of the name input fields
	const MAX_DESC_LENGTH = 100;							// Max length of the description input fields
	const START_WARNING_PERCENTAGE = 30;	// When the caracter count has this % of character remaining, its color changes to warn the user 

	let currSimletId = null;	// Id of the SIMLET that is currently being edited
    let shlink = null;
	
	// Functions to call to avoid reloading the whole view when updating info of any SIMLET 
	let onCreateSimlet = null;
	let onEditSimlet = null;
	let onArchiveSimlet = null;
	let onDeleteSimlet = null;
	let onEditShlink = null;

	
	// --- UTILITIEs --- 
	
	/**
	 * Format the raw date to show it in YYYY/MM/DD format on the user's timezone
	 * @param {number} rawDate - date epoch
	 * @returns {string} - string with the formatted date
	 */
	const getFormattedDate = function(rawDate) {
		const date = new Date(rawDate);
		const yyyy = String(date.getFullYear()).slice(-4).padStart(4, '0');
		const mm = String(date.getMonth() + 1).padStart(2, '0');
		const dd = String(date.getDate()).padStart(2, '0');
		return `${yyyy}/${mm}/${dd}`;
	}

	/**
	 * Adds the character counter to all elements of the same class
	 * @param {string} className  - name of the class of the elements that will get the counter added
	 * @param {number} maxLength - max number of characters
	 */
	const addInputCharCountToClass = function(className, maxLength) {
		// Store the class and update the string with all the classes that must be checked when updating input value
		classesWithCharCount.add(`.${className}`);
		classesWithCharCountStr = Array.from(classesWithCharCount).join(", ");

		// Shared listener. Will be triggered when text changes
		$(document).on('input', `.${className}`, function() {
			updateCharCount($(this).next(".char-count"), $(this).val().length, maxLength);
		});

		// Add a character counter after every instance of the class
		$(`.${className}`).each(function(index) {
			const counter = $("#char_count_template .char-count").clone();

			// Add the input element classes to the counter so it can appear in floating forms
			counter.addClass($(this).attr("class"));
			// Remove the className so the counter doesn't get added to the current iteration
			counter.removeClass(className);

			// Add the counter after the element and set its text to 0/maxLength
			$(this).after(counter);
			$(counter).text(`${0}/${maxLength}`);
		});

		// Set the max length of every form instance of the class
		$(`.${className}`).prop("maxLength", maxLength);

	}
	
	// When changing an input value programatically, the 'input' event must be triggered manually with .trigger('input')
	// To avoid having to do this every time an input field with a character counter changes its value programatically,
	// the input elements setter is defined via $.valHooks (however the setter will change for all the elements of the same type) 
	$.valHooks.input = {
		set: function(elem, value) {
			checkAndUpdateCharCount(elem, value);
			// Return undefined for default behavior
			return undefined;
		}
	};
	$.valHooks.textarea = {
		set: function(elem, value) {
			checkAndUpdateCharCount(elem, value);
			// Return undefined for default behavior
			return undefined;
		}
	};


	/**
	 * Checks if the element has any of the classes with a character count and updates the count if it does
	 * @param {object} elem - jquery object reference of the element that will be checked
	 * @param {number} value - current number of characters
	 */
	const checkAndUpdateCharCount = function(elem, value) {
		if ($(elem).is(classesWithCharCountStr)) {
			updateCharCount($(elem).next(".char-count"), value.length, $(elem).prop("maxLength"));
		}
	}
	/**
	 * Updates the character count of an element
	 * @param {object} countTextElem - jquery object reference of the element that will be updated
	 * @param {number} count - current number of characters
	 * @param {number} maxLength - max number of characters
	 */
	const updateCharCount = function(countTextElem, count, maxLength) {
		$(countTextElem).text(`${count}/${maxLength}`);

		// Show the text in red if there are no characters left 
		if (maxLength - count == 0) {
			$(countTextElem).addClass("full");
		}
		// Show the text in orange if there are more than 0 but less than the START_WARNING_PERCENTAGE of characters left 
		else if ((maxLength - count) <= maxLength * (START_WARNING_PERCENTAGE / 100)) {
			$(countTextElem).removeClass("full");
			$(countTextElem).addClass("warn");
		}
		// Show the text normally
		else {
			$(countTextElem).removeClass("full");
			$(countTextElem).removeClass("warn");
		}
	}


	// --- MENUS ---
	
    $(document).ready(function() {
		// Add counter to all name and description fields (must be done after
		// loading everything to ensure all elements get their counter added)
		addInputCharCountToClass(NAME_FIELD_CLASS, MAX_NAME_LENGTH);
		addInputCharCountToClass(DESCRIPTION_DIELD_CLASS, MAX_DESC_LENGTH);

		// When submitting the add/edit SIMLET form
		$(document).on('submit', "#simlet_name_desc_tab", function(event) {
			let currentform = this;
			let form = Utils.getFormData($("#simlet_name_desc_form"));
			Utils.toggleSubmit();

			// Creating new SIMLET
			if (form.editingSimletId == null || form.editingSimletId == "") {
				Simva.addSimlet({ simlet_name : form.simletName, simlet_description : form.simletDescription }, function(error, result) {
					if (error && error.responseJSON) {
						Utils.toggleSubmit();
						$("#simlet_form_error").text(error.responseJSON.message);
					}
					else {
						Utils.toggleSubmit();
						Utils.toggleFormInFloating('simlet_form_menu');
						$("#simlet_form_error").text("");
						if (onCreateSimlet != null && typeof onCreateSimlet === "function") {
							onCreateSimlet(result);
						}
					}
				});
			}
			// Editing SIMLET
			else {
				if (form.prevSimletName == form.simletName && form.prevSimletDescription == form.simletDescription) {
					$('#simlet_form_error').text("<%- t('edit.no_changes.message', { ns : 'SIMLETs' }) %>");
					Utils.toggleSubmit();
				}
				else {
					$('#simlet_form_error').text("");
					Simva.updateSimlet(form.editingSimletId, { simlet_name : form.simletName, simlet_description : form.simletDescription }, function(error, result) {
						Utils.toggleSubmit();
						Utils.toggleFormInFloating('simlet_form_menu');

						if (onEditSimlet != null && typeof onEditSimlet === "function") {
							onEditSimlet(result);
						}
					});
				}
			}

			return false;
		});

		// When submitting the generate custom shlink form
        $(document).on('submit',"#generate_simlet_custom_slug_link_form", function(event) {
            event.preventDefault();
            let currentform = this;
            let custom_slug = null;
            let form = Utils.getFormData($(this));
            custom_slug = form.custom_slug;
            Utils.toggleSubmit();
            
            Simva.generateShlink(currSimletId, custom_slug, null, (error, result) => {
                if (!error) {
                    shlink = result;
                    let shortUrl=shlink.shortUrl;
                    // Copy the text inside the text field
                    navigator.clipboard.writeText(shortUrl);
                    // Alert Short URL
                    alert(shortUrl);
                    Utils.toggleFormInFloating('generate_simlet_link_menu');
                    $('#generate_link_error').text("");
					if (onEditShlink != null && typeof onEditShlink === "function") {
						onEditShlink();
					}
                } 
                else {
                    $('#generate_link_error').text(error.message);
                }
                Utils.toggleSubmit();
            });

            return false;
        });
    
		// When submitting the generate random shlink form
		$(document).on('submit',"#generate_simlet_link_length_form", function(event) {
        	event.preventDefault();
        	let currentform = this;
        	let length = null;
       		form = Utils.getFormData($(this));
        	if (form.link_length_shlink != "") {
            	length = form.link_length_shlink;
        	}
        	Utils.toggleSubmit();
            
            Simva.generateShlink(currSimletId, null, length, (error, result) => {
                if (!error) {
                    shlink = result;
                    let shortUrl=shlink.shortUrl;
                    // Copy the text inside the text field
                    navigator.clipboard.writeText(shortUrl);
                    // Alert Short URL
                    alert(shortUrl);
                    Utils.toggleFormInFloating('generate_simlet_link_menu');
                    $('#generate_link_error').text("");
					if (onEditShlink != null && typeof onEditShlink === "function") {
						onEditShlink();
					}
                } 
                else {
                    $('#generate_link_error').text(error.message);
                }
                Utils.toggleSubmit();
            });
            return false;
        });
	});


    // --- URL FORM ---

    const openUrlSettingsForm = function(simletId, simletName) {
		// Always open form in the generate random link with length tab
		Utils.changeTab($('#generate_link_length_tab_button'), 'generate_simlet_link_form','generate_simlet_link_length_tab');

		$(".formSimletTitle").text(`<%- t('single.title', { ns : 'SIMLETs' }) %>: ${simletName}`);

        currSimletId = simletId;

		shlink = null;
		$("#generate_shlink_url").show();
		$("#shlink_url_short").hide();
		$("#delete_shlink_url").hide();

		Simva.getShLink(simletId, (error, result) => {
			Utils.toggleFormInFloating('simlet_url_settings');
			if (!error) {
				shlink = result;
				$("#generate_shlink_url").hide();
				$("#shlink_url_short").show();
				$('#shlink_url_short').val(`<%- t('scheduler.shlink.message', { ns : 'SIMLETs', shlink : '${shlink.shortUrl}' }) %>`);
				$("#delete_shlink_url").show();
			}
		});
	}

    const openGenerateLinkForm = function() {
        Utils.toggleFormInFloating('simlet_url_settings');
        Utils.toggleFormInFloating('generate_simlet_link_menu');
        $('#generate_link_error').text("");
        $('#custom_slug_shlink').val("");
        $('#link_length_shlink').val($('#link_length_shlink').prop("min"));
	}

	const copyShortURL = function() {
		// Copy the text inside the text field
		navigator.clipboard.writeText(shlink.shortUrl);
		// Alert Short URL
		alert(shlink.shortUrl);
	}

    const deleteShLink = function() {
		Utils.toggleSubmit($("#generate_simlet_link_menu"));
        Simva.getSimlet(currSimletId, (error, result) => {
			if (!error) {
				let shortCode = shlink.shortCode;
				if (confirm(`<%- t('scheduler.shlink.delete.confirm', { ns : 'SIMLETs', shlink : '${shortCode}', SIMLET : '${result.simlet_name}' }) %>`)) {
					Simva.deleteShLink(currSimletId, (error, result) => {
						if (!error) {
							shlink = null;
							Utils.toggleFormInFloating('simlet_url_settings');
							if (onEditShlink != null && typeof onEditShlink === "function") {
								onEditShlink();
							}
						}
						Utils.toggleSubmit($("#generate_simlet_link_menu"));
					});
				}
			}
		});
	}


	// --- EXPORT ---

	const exportSimlet = function(simletId) {
		Simva.exportSimlet(simletId, function(error, result) {
			if (!error) {
				const content = JSON.stringify(result, null, 2);
				const filename = `simlet_${result.simlet_name}-export.json`;
				Utils.download(filename, content);
			}
		})
	}

	// --- ARCHIVE/DELETE ---
	
	const archiveSimlet = function(simletId, simletName, archive = true) {
		if(confirm(`<%- t('archive.confirm', { ns : 'SIMLETs', SIMLET : '${simletName}' }) %>`)){
			Simva.updateSimlet(simletId, { simlet_archived: archive }, function(error, result) {
				if (!error  && onArchiveSimlet != null && typeof onArchiveSimlet === "function") {
					onArchiveSimlet(result);
				}
			});
		}
		
	}

	const deleteSimlet = function(simletId, simletName){
		if(confirm(`<%- t('delete.confirm', { ns : 'SIMLETs', SIMLET : '${simletName}' }) %>`)){
			Simva.deleteSimlet(simletId, function(response) {
				if(response.status !== 200) {
					// Muestra el error real para depuración
					alert(response);
				} else if(onDeleteSimlet != null && typeof onDeleteSimlet === "function") {
					onDeleteSimlet(simletId);
				}
			});
		}
	}


	// --- TAGS --- 

	let allTags =  new Set();
	let tagsById = new Map();
	let tagsByName = new Map(); 

	let remainingTags =  new Set();

	// Get all the existing tags and store them in allTags, tagsById, tagsByName and remainingTags
	Simva.getTagsForSimlets(function(error, result) {
		result.forEach(tag => {
			if (!tagsById.has(tag.tag_id)) {
				allTags.add(tag);
				remainingTags.add(tag);
			}
			tagsById.set(tag.tag_id, tag);
			tagsByName.set(tag.tag_name, tag);
		});
	});

	/**
	 * Get all the tags matching (partially or completely) the name
	 * @param {string} tagName  - name of the tags to retrieve
	 * @returns {Array} - array of objects with the info of the matching tags
	*/
	const searchTagsByName = function(tagName) {
		if (!tagName) {
			return remainingTags;
		}

		return Array.from(remainingTags).filter((tag) => {
			const name = (tag.tag_name || '').toLowerCase();
			return name.includes(tagName);
		});
	}

	
	/**
	 * Create the html element containing all the tags
	 * @param {object} taggedElem - SIMLET or session to get the tags from
	 * @returns {string} - string with the html elements needed to render the tags
	*/
	const renderTags = function(taggedElem) {
		const tags = Array.isArray(taggedElem.tags) ? taggedElem.tags : [];
		
		if (tags.length === 0) {
			return $("#no_tags_template .sessionTagList").html();
		}
		let tagsHtml = '<div class="sessionTagList">';
		for (let i = 0; i < tags.length; i++) {
			const tag = tags[i] || {};
			// const tagName = tag.tag_name || 'Tag';
			// const tagColor = tag.tag_color || '#3b82f6';
			const tagName = tag && tag.tag_name ? tag.tag_name : 'Tag';
			const tagColor = tag && tag.tag_color ? tag.tag_color : '#3b82f6';
			tagsHtml += `
				<span class="sessionTagChip">
					<span class="sessionTagColor" style="background:${tagColor};"></span>
					<span class="sessionTagName">${tagName}</span>
				</span>
			`;
		}
		tagsHtml += '</div>';
		return tagsHtml;
	}
	
</script>