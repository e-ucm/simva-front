
<%# views/partials/allocators/default_allocator.ejs %>

<!-- Elements and class for default allocator -->

<div id="default_allocator_template" style="display: none;">
    <!-- td needs to be contained inside a table, otherwise the 
    browser will delete it and won't be able to be cloned -->
    <table>
        <tr>
            <th class="defaultAllocatorCol">
                <%= t('sessions.title.single', { ns : 'sessions' }) %>
            </th>
        </tr>
        <tr>
            <td class="defaultAllocatorCol">
                <select>
                </select>
            </td>
        </tr>
    </table>
</div>


<script type="text/javascript">

    class DefaultAllocator extends BaseAllocator {
        constructor() {
            super();

            this.supportedType = "default";
            this.name = "<%- t('allocators.default_allocator.title', { ns : 'groups' }) %>";
            this.description = "<%- t('allocators.default_allocator.description', { ns : 'groups' }) %>";
        }

        paintInGroup(group) {
            super.paintInGroup(group);
            
            const table = $(`#group_${group.group_id} .participants`);
			let row = $(table.find("thead tr")).first();
			row.find('th:last').before($("#default_allocator_template th").clone());
            
            const participants = group.participants;
            for (let i = 0; i < participants.length; i++) {
                const participant = getUserFromId(participants[i]);
                
                const content = $("#default_allocator_template td").clone();
                const dropdown = content.find("select");
                dropdown.attr("id", `allocation_${group.group_id}_${participant.user_id}`);
                
                fillSessionsDropdown(dropdown);
                selectAllocatedSession(dropdown, participant.session_id || NO_SESSION_ID);
                
                row = $(table.find("tbody tr")).eq(i);
                row.find('td:last').before(content);
            }
        }
    }
    
    $(document).on('change', ".test .participants td select", function(e) {
        const groupData = $(this).closest(".test").data();
		const userData = $(this).closest("tr").data();
        allocateToSession(groupData[GROUP_DATA_ID_KEY], Number($(this).val()), userData[USER_DATA_ID_KEY]);
	});
    
</script>