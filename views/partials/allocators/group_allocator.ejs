<%# views/partials/allocators/group_allocator.ejs %>

<!-- Elements and class for group allocator -->

<!-- Template for the allocator dropdown -->
<div id="group_allocator_template" style="display: none;">
    <p>
        <%= t('sessions.title.single', { ns : 'sessions' }) %>: 
        <select>
        </select>
    </p>
</div>


<script type="text/javascript">
    // MUST BE INCLUDED IN THE HTML AFTER BaseAllocator 
    
    class GroupAllocator extends BaseAllocator {
        constructor() {
            super();

            this.supportedType = "group";
            this.name = "<%- t('allocators.group_allocator.title', { ns : 'groups' }) %>";
            this.description = "<%- t('allocators.group_allocator.description', { ns : 'groups' }) %>";
        }

        paintInGroup(group) {
            super.paintInGroup(group);
            
            // Add the allocator dropdown to the group
            const content = $("#group_allocator_template p").clone();
            const dropdown = content.find("select");
            dropdown.attr("id", `allocation_group_${group.group_id}`);
            
            fillSessionsDropdown(dropdown);
            selectAllocatedSession(dropdown, group.allocations[group.group_id]);

            $(`#allocator_content_${group.group_id}`).append(content);
        }

    }

    $(document).on('change', ".test .allocatorContent select", function(e) {
		const data = $(this).closest(".test").data();
		const userData = $(this).closest("tr").data();
        allocateToSession(data[GROUP_DATA_ID_KEY], Number($(this).val()));
	});

</script>