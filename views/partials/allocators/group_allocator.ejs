<!-- Elements and class for group allocator -->

<!-- Template for the allocator dropdown -->
<div id="group_allocator_template" style="display: none;">
    <p>
        <%= t('allocator.sessions.title', { ns : 'groups' }) %>: 
        <select>
        </select>
    </p>
</div>


<script type="text/javascript">

    class GroupAllocator extends BaseAllocator {
        constructor() {
            super();

            this.supportedType = "group";
            this.name = "<%= t('allocator.group.title', { ns : 'groups' }) %>";
            this.description = "<%= t('allocator.group.description', { ns : 'groups' }) %>";
        }

        getCurrentAllocation(group, participant = null) { 
            if (group == null) return null;
            // If the group has the allocations property and the property has the group 
            // id, return the session id stored for the group id. Otherwise return null
            return (group.allocations != null && group.allocations[group.group_id] != null) ? Number(group.allocations[group.group_id]) : null;
        }

        paintInGroup(group) {
            super.paintInGroup(group);
            
            // Add the allocator dropdown to the group
            const content = $("#group_allocator_template p").clone();
            const dropdown = content.find("select");
            dropdown.attr("id", `allocation_group_${group.group_id}`);

            // Add all the sessions to the dropdown
            sessionsById.forEach((session, id) => {
                dropdown.append($("<option>", {
                    value: id,
                    text: session.session_name,
                }));
            });

            // Determine the session the group is allocated to and select the option in the dropdown
            dropdown.val(this.getCurrentAllocation(group));

            $(`#allocator_content_${group.group_id}`).append(content);
        }

    }

    $(document).on('change', ".test .allocatorContent select", function(e) {
		const data = $(this).closest(".test").data();
		const userData = $(this).closest("tr").data();
        allocateToSession(data[GROUP_DATA_ID_KEY], Number($(this).val()));
	});

</script>