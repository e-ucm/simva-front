<div class="header" id="logout_header">
	<div class="left">
		<%- include('header_language_selector') %>
		<img class="logo" src="/images/logo.png">
		<span style="margin: 10px; white-space: nowrap;"><%= t('title') %></span>
	</div>
	<div class="right">
		<ul>
			<li>
				<a href="/about">
					<img src="/images/icons/information.png"> <%= t('title', { ns : 'about'}) %>
				</a>
			</li>
			<li>
				<a href="https://www.e-ucm.es/es/people/" target="_blank" rel="noopener noreferrer">
					<img src="/images/icons/eucm_icon.ico"> <%= t('contact.title') %>
				</a>
			</li>
			<li>
				<a class="login" href="/users/login">
					<img src="/images/icons/power-button-off.png" style="filter: invert(100%);"> <%= t('login.title') %>
				</a>
			</li>
		</ul>
	</div>
</div>