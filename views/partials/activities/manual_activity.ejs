
<!-- Elements and class for manual activities -->

<!-- Template for the 3-dot menu of the activity  -->
<div id="manual_extra_kebab_template" style="display: none;">
    <li class="text-with-icon icon-activate" title="<%= t('completed.all.set', { ns : 'activities' }) %>"><%= t('completed.all.set', { ns : 'activities' }) %></li>
    <li class="text-with-icon icon-pause" title="<%= t('completed.all.unset', { ns : 'activities' }) %>"><%= t('completed.all.unset', { ns : 'activities' }) %></li>
</div>

<!-- Template for the meta section of the activity -->
<div id="manual_meta_template" style="display: none;">
    <div class="manualMeta">
        <i class="text-with-icon icon-url" style="margin-top: 5px;">   </i>
        <ul>
            <li class="storage"><%= t('storage.title', { ns : 'activities' }) %><input type="checkbox" style="pointer-events: none;"></li> 
            <li class="complete"><%= t('manual.student_complete.ok', { ns : 'activities' }) %><input type="checkbox" style="pointer-events: none;"></li> 
        </ul>
    </div>
</div>

<!-- Template for the extra add/edit form of the activity -->
<div id="manual_extra_form" style="display: none;">
    <div class="activitySettingsCheckboxes">
        <div class="activitySettigsCheckbox">
            <input type="checkbox" id="manual_user_managed" name="user_managed">
            <div class="tooltipLine">
                <label for="manual_user_managed"><b><%= t('manual.student_complete.title', { ns : 'activities' }) %></b></label>
                <div class="tooltip">
                    &#x1F6C8;
                    <span class="tooltiptext">
                        <%= t('manual.student_complete.description', { ns : 'activities' }) %>
                    </span>
                </div>
            </div>
        </div>
        
        <div class="activitySettigsCheckbox">
            <input type="checkbox" id="manual_restarted" name="restarted">
            <div class="tooltipLine">
                <label for="manual_restarted"><b><%= t('manual.restarted.title', { ns : 'activities' }) %></b></label>
                <div class="tooltip">
                    &#x1F6C8;
                    <span class="tooltiptext">
                        <%= t('manual.restarted.description', { ns : 'activities' }) %>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="tooltipLine">
        <h3><%= t('manual.platform.title', { ns : 'activities' }) %></h3>
        <div class="tooltip">
            &#x1F6C8;
            <span class="tooltiptext">
                <ul>
                    <li><b><%= t('manual.web.title', { ns : 'activities' }) %></b>: <%= t('manual.web.description', { ns : 'activities' }) %></li>
                    <li><b><%= t('manual.external.title', { ns : 'activities' }) %></b>: <%= t('manual.external.description', { ns : 'activities' }) %></li>
                </ul>
            </span>
        </div>
    </div>
    
    <div class="tabs">
        <span class="tab selected text-with-icon icon-gameplay-web" id="manual_web_tab_button" method="WEB" onclick="Utils.changeTab(this, 'manual_extra_form','manual_web')">
            <%= t('manual.web.title', { ns : 'activities' }) %>
        </span>
        <span class="tab text-with-icon icon-manual-external" id="manual_external_tab_button" method="EXTERNAL" onclick="Utils.changeTab(this, 'manual_extra_form','manual_external')">
            <%= t('manual.external.title', { ns : 'activities' }) %>
        </span>
    </div>
    
    <div id="manual_web" class="subform selected">
        <div class="tooltipLine">
            <h3><%= t('manual.uri.title', { ns : 'activities' }) %></h3>
            <div class="tooltip">
                &#x1F6C8;
                <span class="tooltiptext">
                    <%= t('manual.uri.description', { ns : 'activities' }) %>
                </span>
            </div>
        </div>
        <input id="manual_uri" type="text" name="uri">
    </div>
    <div id="manual_external" class="subform" style="display: none;">
    </div>
</div>


<script type="text/javascript">
    // MUST BE INCLUDED IN THE HTML AFTER BaseActivityPainter 

    class ManualPainter extends BaseActivityPainter {
        constructor() {
            super();
            
            this.supportedType = "manual";
        	this.simple_name = "<%= t('manual.name', { ns : 'activities' }) %>";
            this.description = "<%= t('manual.description', { ns : 'activities' }) %>";
            this.resultFilePrefix = "<%= t('manual.result.file.prefix', { ns : 'activities' }) %>";
        }


        // Menus

        paintExtraForm(activity) { 
            $('#activity_extras').append($("#manual_extra_form").clone());

            Utils.changeTab("manual_web_tab_button", 'manual_extra_form','manual_web');
            $("#manual_extra_form").show();

            // When editing an existing activity, update the form fields with the activity info 
            if (activity != null) {
                $("#manual_user_managed").prop("checked", Boolean(activity.manual_user_managed));
                $("#manual_restarted").prop("checked", Boolean(activity.activity_can_be_restarted));
                
                $("#manual_uri").val(activity.manual_ressource_url || "");

                if (activity.manual_ressource_type === 'EXTERNAL') {
                    Utils.changeTab("manual_external_tab_button", 'manual_extra_form','manual_external');

                } else {
                    Utils.changeTab("manual_web_tab_button", 'manual_extra_form','manual_web');
                }
            }
        }

        getActivityInfoFromForm(form) {
            let activity = super.getActivityInfoFromForm(form);

            const method = $('#manual_extra_form .tab.selected').attr('method');

            activity.manual_user_managed = form.user_managed === "on" ? true : false;
            activity.activity_trace_storage = true;     // Storage is always enabled for manual activities
            activity.activity_can_be_restarted = form.restarted === "on" ? true : false;

            activity.manual_ressource_type = method;
            activity.manual_ressource_url = method == "EXTERNAL" ? "" : (form.uri || "");

            return activity;
        }
        

        // Functionality
        

        // Render
        
        async fillActivityCard(activity, participants, card) {
            // Add the extra buttons to the 3-dot menu after the Tmon button
            const extraKebab = $("#manual_extra_kebab_template li").clone();
            card.find(".kebab-dropdown").find(".icon-url").after(extraKebab);

            // Add the meta section and update the checkboxes based on the activity settings
            const meta = $("#manual_meta_template .manualMeta").clone();
            card.find(".activity-meta").append(meta);
            meta.find(".storage input[type='checkbox']").attr("checked", activity.activity_trace_storage);
            meta.find(".complete input[type='checkbox']").attr("checked", activity.manual_user_managed);

            // Determine the type icon and subtitle based on the activity type
            let iconClass = ""
            let prevSimpleName = this.simple_name;
            
            if (activity.manual_ressource_type === 'WEB') {
                iconClass = "icon-gameplay-web"
                this.simple_name += " - <%= t('manual.web.title', { ns : 'activities' }) %>"
                this.description = "<%= t('manual.web.description', { ns : 'activities' }) %>";
                meta.find("i").text(activity.manual_ressource_url || "-");
            }
            else {
                iconClass = "icon-manual-external"
                this.simple_name += " - <%= t('manual.external.title', { ns : 'activities' }) %>"
                this.description = "<%= t('manual.external.description', { ns : 'activities' }) %>";
                meta.find(".icon-url").removeClass("icon-url");
            }

            // Add the type icon next to the activity name
            card.find(".activityName").addClass("text-with-icon").addClass(iconClass);

            super.fillActivityCard(activity, participants, card);
            this.simple_name = prevSimpleName;
        }

        fillParticipantsTable(card, activity, participants, checkbox = false, progress = true, result = true) {
            super.fillParticipantsTable(card, activity, participants, true, false, false);
        }
        
    }

</script>