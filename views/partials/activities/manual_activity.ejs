<%# views/partials/activities/manual_activity.ejs %>

<!-- Elements and class for manual activities -->

<!-- Template for the 3-dot menu of the activity  -->
<div id="manual_extra_kebab_template" style="display: none;">
    <li class="text-with-icon icon-activate"><%= t('activities.kebab.set_completion.title', { ns : 'activities' }) %></li>
    <li class="text-with-icon icon-pause"><%= t('activities.kebab.unset_completion.title', { ns : 'activities' }) %></li>
</div>

<!-- Template for the meta section of the activity -->
<div id="manual_meta_template" style="display: none;">
    <div class="manualMeta">
        <i class="text-with-icon icon-url" style="margin-top: 5px;">   </i>
        <ul>
            <li class="storage"><%= t('activities.manual_activity.storage.title', { ns : 'activities' }) %><input type="checkbox" style="pointer-events: none;"></li> 
            <li class="complete"><%= t('activities.manual_activity.completable.title', { ns : 'activities' }) %><input type="checkbox" style="pointer-events: none;"></li> 
            <li class="restarted"><%= t('activities.manual_activity.restarted.title', { ns : 'activities' }) %><input type="checkbox" style="pointer-events: none;"></li> 

        </ul>
    </div>
</div>

<!-- Template for the extra add/edit form of the activity -->
<div id="manual_extra_form" style="display: none;">
    <div class="activitySettingsCheckboxes">
        <div class="activitySettigsCheckbox">
            <input type="checkbox" id="manual_user_managed" name="user_managed">
            <div class="tooltipLine">
                <label for="manual_user_managed"><b><%= t('activities.manual_activity.completable.title', { ns : 'activities' }) %></b></label>
                <div class="tooltip">
                    &#x1F6C8;
                    <span class="tooltiptext">
                        <%= t('activities.manual_activity.completable.description', { ns : 'activities' }) %>
                    </span>
                </div>
            </div>
        </div>
        
        <div class="activitySettigsCheckbox">
            <input type="checkbox" id="manual_restarted" name="restarted">
            <div class="tooltipLine">
                <label for="manual_restarted"><b><%= t('activities.manual_activity.restarted.title', { ns : 'activities' }) %></b></label>
                <div class="tooltip">
                    &#x1F6C8;
                    <span class="tooltiptext">
                        <%= t('activities.manual_activity.restarted.description', { ns : 'activities' }) %>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="tooltipLine">
        <h3><%= t('activities.manual_activity.platform.title', { ns : 'activities' }) %></h3>
        <div class="tooltip">
            &#x1F6C8;
            <span class="tooltiptext">
                <ul>
                    <li><b><%= t('activities.manual_activity.platform.web.title', { ns : 'activities' }) %></b>: <%= t('activities.manual_activity.platform.web.description', { ns : 'activities' }) %></li>
                    <li><b><%= t('activities.manual_activity.platform.external.title', { ns : 'activities' }) %></b>: <%= t('activities.manual_activity.platform.external.description', { ns : 'activities' }) %></li>
                </ul>
            </span>
        </div>
    </div>
    
    <div class="tabs">
        <span class="tab selected text-with-icon icon-gameplay-web" id="manual_web_tab_button" method="WEB" onclick="Utils.changeTab(this, 'manual_extra_form','manual_web')">
            <%= t('activities.manual_activity.platform.web.title', { ns : 'activities' }) %>
        </span>
        <span class="tab text-with-icon icon-manual-external" id="manual_external_tab_button" method="EXTERNAL" onclick="Utils.changeTab(this, 'manual_extra_form','manual_external')">
            <%= t('activities.manual_activity.platform.external.title', { ns : 'activities' }) %>
        </span>
    </div>
    
    <div id="manual_web" class="subform selected">
        <div class="tooltipLine">
            <h3><%= t('activities.manual_activity.platform.web.uri.title', { ns : 'activities' }) %></h3>
            <div class="tooltip">
                &#x1F6C8;
                <span class="tooltiptext">
                    <%= t('activities.manual_activity.platform.web.uri.description', { ns : 'activities' }) %>
                </span>
            </div>
        </div>
        <input id="manual_uri" type="text" name="uri">
    </div>
    <div id="manual_external" class="subform" style="display: none;">
    </div>
</div>


<script type="text/javascript">
    // MUST BE INCLUDED IN THE HTML AFTER BaseActivityPainter 

    class ManualPainter extends BaseActivityPainter {
        constructor() {
            super();
            
            this.supportedType = "manual";
        	this.simple_name = "<%- t('activities.manual_activity.name', { ns : 'activities' }) %>";
            this.description = "<%- t('about.activity_types.manual.description', { ns : 'about' }) %>";
        }


        // Menus

        paintExtraForm(activity) { 
            $('#activity_extras').append($("#manual_extra_form").clone());

            Utils.changeTab("manual_web_tab_button", 'manual_extra_form','manual_web');
            $("#manual_extra_form").show();

            // When editing an existing activity, update the form fields with the activity info 
            if (activity != null) {
                $("#manual_user_managed").prop("checked", Boolean(activity.manual_user_managed));
                $("#manual_restarted").prop("checked", Boolean(activity.activity_can_be_restarted));
                
                $("#manual_uri").val(activity.manual_ressource_url || "");

                if (activity.manual_ressource_type === 'EXTERNAL') {
                    Utils.changeTab("manual_external_tab_button", 'manual_extra_form','manual_external');
                } else {
                    Utils.changeTab("manual_web_tab_button", 'manual_extra_form','manual_web');
                }
            }
        }

        getActivityInfoFromForm(form) {
            let activity = super.getActivityInfoFromForm(form);

            const method = $('#manual_extra_form .tab.selected').attr('method');

            activity.manual_user_managed = form.user_managed === "on" ? true : false;
            activity.activity_trace_storage = true;     // Storage is always enabled for manual activities
            activity.activity_can_be_restarted = form.restarted === "on" ? true : false;

            activity.manual_ressource_type = method;
            activity.manual_ressource_url = method == "EXTERNAL" ? "" : (form.uri || "");

            return activity;
        }
        

        // Functionality
        

        // Render

        // Basic activity card rendering

        async fillActivityCard(session, activity, card) {
            // Add the extra buttons to the 3-dot menu after the Tmon button
            const extraKebab = $("#manual_extra_kebab_template li").clone();
            card.find(".kebab-dropdown").find(".icon-url").after(extraKebab);

            // Add the meta section and update the checkboxes based on the activity settings
            const meta = $("#manual_meta_template .manualMeta").clone();
            card.find(".activity-meta").append(meta);
            meta.find(".storage input[type='checkbox']").attr("checked", activity.activity_trace_storage);
            meta.find(".complete input[type='checkbox']").attr("checked", activity.manual_user_managed);
            meta.find(".restarted input[type='checkbox']").attr("checked", activity.activity_can_be_restarted);

            // Determine the type icon and subtitle based on the activity type
            let iconClass = "";
            let prevSimpleName = this.simple_name;
            
            if (activity.manual_ressource_type === 'WEB') {
                iconClass = "icon-gameplay-web";
                this.simple_name += " - <%- t('activities.manual_activity.platform.web.title', { ns : 'activities' }) %>"
                this.description = "<%- t('activities.manual_activity.platform.web.description', { ns : 'activities' }) %>";
                meta.find("i").text(activity.manual_ressource_url || "-");
            }
            else {
                iconClass = "icon-manual-external";
                this.simple_name += " - <%- t('activities.manual_activity.platform.external.title', { ns : 'activities' }) %>"
                this.description = "<%- t('activities.manual_activity.platform.external.description', { ns : 'activities' }) %>";
                meta.find(".icon-url").removeClass("icon-url");
            }

            // Add the type icon next to the activity name
            card.find(".activityName").addClass("text-with-icon").addClass(iconClass);

            super.fillActivityCard(session, activity, card);
            this.simple_name = prevSimpleName;
        }

        fillParticipantsTable(card, activity, participants, checkbox = false, progress = true, result = true) {
            super.fillParticipantsTable(card, activity, participants, true, false, false);
        }
        
        async paintActivitySessionStatusAndPermissions(session, card) {
            super.paintActivitySessionStatusAndPermissions(session, card);

    		// By default, hide every button that can modify the activity info 
		    card.find(".icon-activate").hide();
		    card.find(".icon-pause").hide();

            // Only the users with permissions other than read can use the hidden buttons,
            if (simlet.current_user_permission !== "READ") { 
                // The activity completion only be changed if the session isn't finished
                if (session.session_status != SESSION_FINISHED_STATUS) {
                    card.find(".icon-activate").show();
                    card.find(".icon-pause").show();
                }
            }

            // Disable the checkboxes if the activity is finished or if the user has read only permissions
            card.find("table input:checkbox").prop("disabled", session.session_status === SESSION_FINISHED_STATUS || simlet.current_user_permission === "READ");
        }
    }

</script>