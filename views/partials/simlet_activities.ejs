<%# views/partials/simlet_activities.ejs %>

<!-- Elements for the activities on the sessions tab in the SIMLET view -->

<!-- Add/edit activity menu -->
<div id="activity_form_menu" class="new_element floating">
	<div class="floater">
        <div class="form" id="activity_form">
			<h1 id="activity_form_title">	</h1>

			<div class="tabs" id="add_activity_tabs">
				<span id="activity_name_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'activity_form','activity_name_ab')"><%= t('activities.new.tab', { ns : 'activities' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'activity_form','import_activity_tab')"><%= t('activities.import.tab', { ns : 'activities' }) %></span>
			</div>

			<div id="activity_name_ab" class="subform selected">
				<form id="activity_name_form">
					<input hidden type="text" name="editingActivityId" id="edit_activity_id">

					<h3 class="activity_form_name"><%= t('forms.name.title', { ns : 'commons' }) %></h3>
					<input type="text" class="name_field" name="activityName" id="activity_name" placeholder="<%= t('activities.name.placeholder', { ns : 'activities' }) %>" required>
					
					<div id="activity_type" style="display: flex; align-items: center; gap: 10px;">
						<div class="tooltipLine">
							<h3><%= t('activities.type.title', { ns : 'activities' }) %></h3>
							<div class="tooltip">
								&#x1F6C8;
								<span class="tooltiptext">
									<ul>
										<li><b><%= t('activities.gameplay_activity.name', { ns : 'activities' }) %></b>: <%= t('about.activity_types.gameplay.description', { ns : 'about' }) %></li>
										<li><b><%= t('activities.limeSurvey_activity.name', { ns : 'activities' }) %></b>: <%= t('about.activity_types.limeSurvey.description', { ns : 'about' }) %></li>
										<li><b><%= t('activities.manual_activity.name', { ns : 'activities' }) %></b>: <%= t('about.activity_types.manual.description', { ns : 'about' }) %></li>
									</ul>
								</span>
							</div>
						</div>
						
						<select class="activityTypeSelector" name="type" id="activity_type_field" onchange="selectActivityType()" required>
							<!-- Default 'no selected' option -->
							<option selected disabled hidden value=""><%= t('activities.type.placeholder', { ns : 'activities' }) %>
	                    </select>
					</div>
                    <fieldset id="activity_extras">

                    </fieldset>
					<input type="submit" id="activity_submit" value="">

				</form>
			</div>

			<div id="import_activity_tab" class="subform" style="display: none;">
                <form id="import_activity_form">
					<h3><%= t('forms.name.title', { ns : 'commons' }) %></h3>
                    <input type="text" class="name_field" name="activityName" placeholder="<%= t('activities.name.placeholder', { ns : 'activities' }) %>" required>
                    <h3><%= t('activities.import.input', { ns : 'activities' }) %></h3>
					<input name="jsonFile" type="file" accept=".json" required>
                    <input type="submit" value="<%= t('activities.import.submit', { ns : 'activities' }) %>">
                </form>
            </div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="activity_form_error"></span>
		</div>
	</div>
</div>


<!-- <script type="text/javascript" src="/src/activities/rageanalyticspainter.js"></script>
<script type="text/javascript" src="/src/activities/miniopainter.js"></script>
<script type="text/javascript" src="/src/activities/rageminiopainter.js"></script>
<script type="text/javascript" src="/src/activities/ltitoolpainter.js"></script>
<script type="text/javascript" src="/src/activities/imspackagepainter.js"></script> -->

<%- include('activities/base_activity') %>
<%- include('activities/limeSurvey_activity') %>
<%- include('activities/gameplay_activity') %>
<%- include('activities/manual_activity') %>


<script type="text/javascript">
	let painters = new Map();  

	const addPainter = function(painter) {
        painters.set(painter.supportedType, painter);
    }

	addPainter(new BaseActivityPainter());
    addPainter(new LimeSurveyPainter());
    addPainter(new GameplayPainter());
    addPainter(new ManualPainter());

	const getActivityPainterByType = function(activityType) {
		if (painters.has(activityType)) {
			return painters.get(activityType);
		}
		return null;
	}

	
	// Ids for the data-* attributes of each activity card
	const ACTIVITY_DATA_ID_KEY = "activityId"
	const ACTIVITY_DATA_NAME_KEY = "activityName"

	// Id of the session that opened the activity menu
	let currSessionId = null;
	let downloadActivityId = null;

	let prevActivityInfo = null;

	// Menus

    $(document).ready(function() {
		$('#activity_extras').empty();

		// Get all the available activity types, complete the extra info for the 
		// valid activity painters, and add them as options in the add activity form
		Simva.getActivityTypes(function(error, result) {
			if (error) return;
			
			result.forEach((activityTypeInfo) => {
				const painter = getActivityPainterByType(activityTypeInfo.activity_type);
				if (painter != null) {
					painter.setupAfterCreation(activityTypeInfo);

					$('#activity_type_field').append($("<option>", {
						value: activityTypeInfo.activity_type,
						text: painter.simple_name
					}));
				}
			});
		});

		// When submitting the add/edit activity form
        $(document).on('submit','#activity_name_form', function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $('#activity_form_error');
			errorbox.text("");
			Utils.toggleSubmit();
			
			const painter = getActivityPainterByType(form.type);

			// If the activity type is invalid (shouldn't happen unless the html gets altered since the
			// selectable options are only added if their names match with the existing painters supportedType)
			if (painter == null) {
				Utils.toggleSubmit();
				errorbox.text("<%- t('activities.type.error.invalid_type', { ns : 'activities' }) %>");
				return false;
			}
			
			let activityInfo = painter.getActivityInfoFromForm(form);
			const submitForm = () => {
				// Creating new activity
				if (form.editingActivityId == null || form.editingActivityId == "") {
					const addActivity = function() {
						Simva.addActivityToSession(simletId, currSessionId, activityInfo, function(error, result) {
							Utils.toggleSubmit();
							if (error) {
								errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
								return false;
							}
							Utils.toggleFormInFloating();
							onEditSessionActivities(currSessionId);
						});
					}

					// If the activity is a web activity with no url, show a message asking confirmation
					const closestWebTab = $(this).find("[method='WEB']");
					if (closestWebTab.length > 0 && closestWebTab.is(".selected") && (
						(form.game_uri == "" || form.game_uri == null) && (form.uri == "" || form.uri == null))
					) {
						if (confirm(`<%- t('activities.new.web.no_url_message', { ns : 'activities' }) %>`)) {
							addActivity();
						}
					}
					else {
						addActivity();
					}
				}
				// Editing activity
				else {
					// Compare the previous activity info with the updated one (trimming the new activity 
					// name before to check if the name will be the same after processing the string)
					activityInfo.activity_name = Utils.trimString(activityInfo.activity_name);
					if (JSON.stringify(prevActivityInfo) === JSON.stringify(activityInfo)) {
						Utils.toggleSubmit();
						errorbox.text("<%- t('forms.edit.error.no_changes', { ns : 'commons' }) %>");
						return false;
					}

					Utils.toggleSubmit();
					Simva.updateActivity(simletId, currSessionId, form.editingActivityId, activityInfo, function(error, result) {
						Utils.toggleSubmit();
						if (error) {
							errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
							return false;
						}
						Utils.toggleFormInFloating();
						onEditSessionActivities(currSessionId);
					});
				}
			}

			// If the activity info returns a promise, wait for it to complete before submitting the info 
			if (typeof activityInfo.then === 'function') {
				activityInfo.then((activity) => {
					activityInfo = activity;
					submitForm();
				});
			}
			else {
				submitForm();
			}
			
			return false;
		});

		// When submitting the import activity form
		$(document).on('submit', "#import_activity_form", function(event) {
			let form = Utils.getFormData($(this));
			let errorbox = $('#activity_form_error');
			errorbox.text("");
			Utils.toggleSubmit();

			// Only process the input if a file has been uploaded
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				let reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						raw = raw.substr(raw.indexOf(',') + 1);
						const newActivity = raw;
						Simva.importActivity(simletId, currSessionId, {file: newActivity, activity_name: form.activityName}, function(error, result) {
							Utils.toggleSubmit();
							if (error) {
								errorbox.text(error.responseJSON ? error.responseJSON.message : error.message || error);
								return false;
							}
							Utils.toggleFormInFloating();
							onEditSessionActivities(currSessionId);
						});
					} catch (parseError) {
						Utils.toggleSubmit();
						console.error('Import error:', parseError);
						errorbox.text("<%- t('activities.import.error.invalid_file', { ns : 'activities' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
						return false;
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			}
			// If no file has been uploaded (shouldn't happen unless the html gets altered since the file field has the required attribute)
			else {
				Utils.toggleSubmit();
				errorbox.text("<%- t('forms.import.error.no_file', { ns : 'commons' }) %>");
				return false;
			}

			return false;
		});

    });


    const openActivityForm = function(sessionId, activityId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#activity_name_tab_button'), 'activity_form','activity_name_ab');

		Utils.toggleFormInFloating('activity_form_menu');

		$('#activity_form_error').text("");

		$('#edit_activity_id').val(activityId);
		currSessionId = sessionId;

		// Creating new activity
		if (activityId == null) {
			// Show the add new/import tabs and unlock the activity type selector
			$("#add_activity_tabs").show();
			$("#activity_type option:not(:selected)").prop("disabled", false);

			$("#activity_form_title").text("<%- t('activities.form.add.title', { ns : 'activities' }) %>");
			$("#activity_submit").val("<%- t('activities.new.submit', { ns : 'activities' }) %>");

			$('#prev_activity_name').val("");
			$('#prev_activity_type').val("");
			$('#activity_name').val("");

			// Select the placeholder option
			$("#activity_type_field option").eq(0).prop("selected", true);
			selectActivityType();
		}
		// Editing activity
		else {
			const activity = getActivityFromId(activityId);

			// Hide the add new/import tabs (only the name/description/tags tab is needed when editing session)
			$("#add_activity_tabs").hide();

			$("#activity_form_title").text("<%- t('activities.form.edit.title', { ns : 'activities' }) %>");
			$("#activity_submit").val("<%- t('activities.form.edit.submit', { ns : 'activities' }) %>");

			$('#prev_activity_name').val(activity.activity_name);
			$('#prev_activity_type').val(activity.activity_type);
			
			$('#activity_name').val(activity.activity_name);
			$('#activity_type_field').val(activity.activity_type);

			// Paint the extra form depending on the activity type
			selectActivityType(activity);

			// Lock the activity type selector once the extra form has been updated to avoid changing the activity type
			$("#activity_type option:not(:selected)").prop("disabled", true);

			// Save the activity info before editing to compare it with the info after submitting the form
			const painter = getActivityPainterByType(activity.activity_type);
			if (painter != null) {
				prevActivityInfo = painter.getActivityInfoFromForm(Utils.getFormData($("#activity_name_form")));
			}
		}
	}

	const openActivityDownloadForm = function(activityId) {
		Utils.toggleFormInFloating('download_data_menu');
		Utils.changeTab(null, 'download_data_form','download_activity_data');

		showActivityDownloadFormButtons(activityId);

        downloadActivityId = activityId;
		const activity = getActivityFromId(activityId);

		$("#downloadFormTitle").text(`<%- t('activities.title.single', { ns : 'activities' }) %>: ${activity.activity_name}`);
	}

	const showActivityDownloadFormButtons = function(activityId) {
		$("#download_activity_loader").hide();
		$("#activity_data_download").show();
		$("#activity_test_data_download").hide();
		$("#global_backup_download").show();
		$("#backup_download").show();

		// Show test download button only if the current user is participant of the session
		$("#session_test_data_download").hide();

		$("#global_backup_download").val("");
		
		const activity = getActivityFromId(activityId);
		if (activity == null) {
			return;
		}

		const painter = getActivityPainterByType(activity.activity_type);
		if (painter != null) {
			$("#global_backup_download").val(painter.backupDownloadText);
		}
		
		if (isUserIdInSession(activity.session_id, currentUser.user_id)) {
			$("#activity_test_data_download").show();
		}
		$(".iframe_floating_close").prop("disabled", false);
	}

	const showActivityDownloadFormLoader = function() {
		$("#download_activity_loader").show();
		$("#activity_data_download").hide();
		$("#activity_test_data_download").hide();
		$("#global_backup_download").hide();
		$("#backup_download").hide();
		$(".iframe_floating_close").prop("disabled", true);
	}
	
	// Expand/hide activity participants table
	const toggleActivityTable = function(activityId) {
		$(`#activity_${activityId} .activityTopActions .expandButton`).toggleClass('collapsed');
		$(`#activity_${activityId} table`).toggle();
	}

	// Sync add activity and import activity name input 
	$(document).on("input", $(`#activity_form .${NAME_FIELD_CLASS}`), function(e) {
		$(`#activity_form .${NAME_FIELD_CLASS}`).each(function() {
			if (this != e.target && $(e.target).is("input:text") && $(e.target).is(`.${NAME_FIELD_CLASS}`)) {
				$(this).val($(e.target).val());
			} 
		});
	});

	// Activities buttons shared listeners using event delegation to ensure 
	// the handler works even if element is added after the document ready event

	$(document).on('click', ".activityTopActions .activityDownload", function(e) {
		const data = $(this).closest(".activity").data();
		openActivityDownloadForm(data[ACTIVITY_DATA_ID_KEY])
	});

    $(document).on('click', ".activityTopActions .expandButton", function(e) {
		const data = $(this).closest(".activity").data();
		toggleActivityTable(data[ACTIVITY_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".activityTopActions .icon-edit", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		openActivityForm(sessionData[SESSION_DATA_ID_KEY], data[ACTIVITY_DATA_ID_KEY]);
	});

	$(document).on('click', ".activityTopActions .icon-export", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		exportActivity(data[ACTIVITY_DATA_ID_KEY]);
	});

	// Open a floating window with the Tmon page of the selected activity
	$(document).on('click', ".activityTopActions .icon-url", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		const url = `${Simva.tmonUrl}/${simletId}/${sessionData[SESSION_DATA_ID_KEY]}/${data[ACTIVITY_DATA_ID_KEY]}/${Simva.TMonFile}/dashboard/`;
       	Utils.toggleIframeInFloating(url); 
	});

	// Set completion for all participants
	$(document).on('click', ".activityTopActions .icon-activate", function(e) {
		const data = $(this).closest(".activity").data();
		setCompletionForAllParticipants(data[ACTIVITY_DATA_ID_KEY], true);
	});
	
	// Unset completion for all participants
	$(document).on('click', ".activityTopActions .icon-pause", function(e) {
		const data = $(this).closest(".activity").data();
		setCompletionForAllParticipants(data[ACTIVITY_DATA_ID_KEY], false);
	});

	$(document).on('click', ".activityTopActions .icon-delete", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		deleteActivity(data[ACTIVITY_DATA_ID_KEY], data[ACTIVITY_DATA_NAME_KEY], sessionData[SESSION_DATA_ID_KEY])
	});
	
	// Checkbox to set/unset completion for user
	$(document).on('change', ".compProgress input[type='checkbox']", function (e) {
        const data = $(this).closest("tr").data();
        const activityData = $(this).closest(".activity").data();
		Simva.setActivityCompletion(activityData[ACTIVITY_DATA_ID_KEY], data[USER_DATA_ID_KEY], $(this).is(":checked"), function() {
			console.log('saved');
		});
    });
	
	// Open results of user in floating menu 
	$(document).on('click', ".activity table .showResult", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.showBackupData(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});

	// Download results for user
	$(document).on('click', ".activity table .downloadResult", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadBackupData(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});

	// Open the LRS data of user in floating menu
	$(document).on('click', ".activity table .showLRSData", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.showLRSData(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});

	// Download the LRS data for user
	$(document).on('click', ".activity table .downloadLRSData", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadLRSData(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});


	// Functionality
	
    const deleteActivity = function(activityId, activityName, sessionId) {
		let session = getSessionFromId(sessionId);
		let sessionName = session && session.session_name ? session.session_name : sessionId;
		if (confirm(`<%- t('activities.delete.confirm', { ns : 'activities', activity : '${activityName}', session: '${sessionName}' , SIMLET : '${simlet.simlet_name}' }) %>`)) {
			Simva.deleteActivity(simletId, sessionId, activityId, function(error, result) {
				if (!error) {
					onEditSessionActivities(sessionId);
				}
			});
		}
	}

	const getActivityFilenamePrefix = function(session, activity) {
		return `simlet_${simlet.simlet_name}-session_${session.session_name}-activity_${activity.activity_name}`;
	}
	
	const exportActivity = function(activityId) {
		Simva.exportActivity(activityId, true, (error, result) => {
			if (error) {
				$.toast({
					heading: "<%- t('export.error_toast.heading', { ns : 'commons' }) %>",
					text: error.responseJSON ? error.responseJSON.message : error.message || error,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
				return;
			}

			const session = getSessionFromId(result.session_id);
			const filename = `${getActivityFilenamePrefix(session, result)}-export.json`;
			Utils.downloadContent(JSON.stringify(result, null, 2), filename);
		});
	}

	const downloadActivityData = function () {
		showActivityDownloadFormLoader();
		
		const activity = getActivityFromId(downloadActivityId);
		Simva.getActivityLRSData(downloadActivityId, null, { simletId: simletId, sessionId: activity.session_id }, (error, result) => {
			showActivityDownloadFormButtons(downloadActivityId);

            let errorMsg = "<%- t('activities.download.data.error_toast.heading', { ns : 'activities' }) %>";
			if(error){
				$.toast({
					heading: errorMsg,
					text: error.responseJSON ? error.responseJSON.message : error.message || error,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
				return;
			}

			const session = getSessionFromId(activity.session_id);
			const filename = `${getActivityFilenamePrefix(session, activity)}-full_xapi_data_.ndjson`;
			Utils.downloadContent(result.data, filename, errorMsg);
		});
	}

	const downloadActivityTestData = function() {
		showActivityDownloadFormLoader();

		Simva.getActivityTestLRSData(downloadActivityId, (error, result) => {
			showActivityDownloadFormButtons(downloadActivityId);

            let errorMsg = "<%- t('activities.download.test_data.error_toast.heading', { ns : 'activities' }) %>";
			if(error){
				$.toast({
					heading: errorMsg,
					text: error.responseJSON ? error.responseJSON.message : error.message || error,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
				return;
			}

			const activity = getActivityFromId(downloadActivityId);
			const session = getSessionFromId(activity.session_id);
			const filename = `${getActivityFilenamePrefix(session, activity)}-test_xapi_data_.ndjson`;
			Utils.downloadContent(result.data, filename, errorMsg);
		});
	}

	const downloadGlobalActivityBackup = function() {
		const act = getActivityFromId(downloadActivityId);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadGlobalActivityBackup(downloadActivityId);
			}
		}
	}

	const downloadUsersActivityBackup = function() {
		const act = getActivityFromId(downloadActivityId);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadUsersBackupZip(downloadActivityId);
			}
		}
	}

	const setCompletionForAllParticipants = function(activityId, status) {
		Simva.setMultiActivityCompletion(activityId, status, (error, result) => {
			if (error) {
				$.toast({
					heading: "<%- t('activities.set_completion.error_toast.heading', { ns : 'activities' }) %>",
					text: error.responseJSON ? error.responseJSON.message : error.message || error,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			}
		})
	}


	// Render

	/**
	 * Paint all the activities cards of a session
	 * @param {object} sesion - object containing the session info
	 * @param {Array} activities - Array of objects containing the activities info
	 * @param {object} sessionCard - jquery object reference of the session card element
	 */
    const paintSessionActivities = async function(session, activities, sessionCard) {
		sessionCard.find(".activities").empty();
		sessionCard.find(".activities_loader").show();

		if (activities.length === 0) {
			$(`#session_${session.session_id} .activities`).text("<%- t('activities.no_activities.message', { ns : 'activities' }) %>");
			sessionCard.find(".activities_loader").hide();
		} 
		else {
			activities.forEach((activity) => {
				const painter = getActivityPainterByType(activity.activity_type);
				if (painter != null) {
                    painter.addActivityCard(session, activity, sessionCard);
                }
			});
			sessionCard.find(".activities_loader").hide();
		}
	}

	
	/**
	 * Paint the extra form corresponding to the selected activity type
	 * @param {object} activity - object containing the activity info
	 */
	const selectActivityType = function(activity) {
		$('#activity_extras').empty();
		const painter = getActivityPainterByType($("#activity_type_field").val());
		if (painter != null) {
			painter.paintExtraForm(activity);
		}
	}
	
</script>

