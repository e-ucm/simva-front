<!-- Elements for the activities on the sessions tab in the SIMLET view -->

<!-- Add/edit activity menu -->
<div id="activity_form_menu" class="new_element floating">
	<div class="floater">
        <div class="form" id="activity_form_form">
			<h1 id="activity_form_title">	</h1>

			<div class="tabs" id="add_activity_tabs">
				<span id="activity_name_desc_tab_button" class="tab selected" onclick="Utils.changeTab(this, 'activity_form_form','activity_name_desc_tab')"><%- t('add.new.tab', { ns : 'activities' }) %></span>
				<span class="tab" onclick="Utils.changeTab(this, 'activity_form_form','import_activity_tab')"><%- t('import.tab', { ns : 'activities' }) %></span>
			</div>

			<div id="activity_name_desc_tab" class="subform selected">
				<form id="activity_form">
					<input hidden type="text" name="editingActivityId" id="edit_activity_id">

					<h3 class="activity_form_name"><%- t('name.title', { ns : 'activities' }) %></h3>
					<input type="text" class="name_field" name="activityName" id="activity_name" placeholder="<%- t('name.placeholder', { ns : 'activities' }) %>" required>
					
					<div id="activity_type" style="display: flex; align-items: center; gap: 10px;">
						<div class="tooltipLine">
							<h3><%- t('activity.type.title', { ns : 'activities' }) %></h3>
							<div class="tooltip">
								&#x1F6C8;
								<span class="tooltiptext">
									<ul>
										<li><b><%- t('gameplay.name', { ns : 'activities' }) %></b>: <%- t('gameplay.description', { ns : 'activities' }) %></li>
										<li><b><%- t('limesurvey.name', { ns : 'activities' }) %></b>: <%- t('limesurvey.description', { ns : 'activities' }) %></li>
										<li><b><%- t('manual.name', { ns : 'activities' }) %></b>: <%- t('manual.description', { ns : 'activities' }) %></li>
									</ul>
								</span>
							</div>
						</div>
						
						<select class="activityTypeSelector" name="type" id="activity_type_field" onchange="selectActivityType()" required>
							<!-- Default 'no selected' option -->
							<option selected disabled hidden><%- t('activity.type.select', { ns : 'activities' }) %>
	                    </select>
					</div>
                    <fieldset id="activity_extras">

                    </fieldset>
					<input type="submit" id="activity_submit" value="">

				</form>
			</div>

			<div id="import_activity_tab" class="subform" style="display: none;">
                <form id="import_activity_form">
					<h3><%- t('name.placeholder', { ns : 'activities' }) %></h3>
                    <input type="text" class="name_field" name="activityName" placeholder="<%- t('name.placeholder', { ns : 'activities' }) %>" required>
                    <h3><%- t('import.message', { ns : 'activities' }) %></h3>
					<input name="jsonFile" type="file" accept=".json" required>
                    <input type="submit" value="<%- t('import.tab', { ns : 'activities' }) %>">
                </form>
            </div>

			<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
			<span class="error" id="activity_form_error"></span>
		</div>
	</div>
</div>


<!-- <script type="text/javascript" src="/activities/rageanalyticspainter.js"></script>
<script type="text/javascript" src="/activities/miniopainter.js"></script>
<script type="text/javascript" src="/activities/rageminiopainter.js"></script>
<script type="text/javascript" src="/activities/gameplaypainter.js"></script>
<script type="text/javascript" src="/activities/ltitoolpainter.js"></script>
<script type="text/javascript" src="/activities/imspackagepainter.js"></script> -->

<%- include('activities/base_activity') %>
<%- include('activities/limeSurvey_activity') %>
<%- include('activities/gameplay_activity') %>
<%- include('activities/manual_activity') %>


<script type="text/javascript">
	let painters = new Map();  

	const addPainter = function(painter) {
        painters.set(painter.supportedType, painter);
    }

	addPainter(new BaseActivityPainter());
    addPainter(new LimeSurveyPainter());
    addPainter(new GameplayPainter());
    addPainter(new ManualPainter());

	const getActivityPainterByType = function(activityType) {
		if (painters.has(activityType)) {
			return painters.get(activityType);
		}
		return null;
	}

	
	// Ids for the data-* attributes of each activity card
	const ACTIVITY_DATA_ID_KEY = "activityId"
	const ACTIVITY_DATA_NAME_KEY = "activityName"

	// Id of the session that opened the activity menu
	let currSessionId = null;
	let downloadActivityId = null;

	let prevActivityInfo = null;

	// Menus

    $(document).ready(function() {
		$('#activity_extras').empty();

		// Get all the available activity types and store extra info in the activityPainters
		Simva.getActivityTypes(function(error, result) {
			result.forEach((activityTypeInfo) => {
				const painter = getActivityPainterByType(activityTypeInfo.activity_type);
				if (painter != null) {
					if (activityTypeInfo.activity_utils.newurl) {
						newLimesurveyUrl = activityTypeInfo.activity_utils.newurl;
					}
					if (activityTypeInfo.activity_utils.editurl) {
						editLimesurveyUrl = activityTypeInfo.activity_utils.editurl;
					}

					$('#activity_type_field').append($("<option>", {
						value: activityTypeInfo.activity_type,
						text: painter.simple_name
					}));
				}
			});
		});

		// When submitting the add/edit activity form
        $(document).on('submit','#activity_form', function(event) {
			let errorbox = $('#activity_form_error');
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			
			// Require the user to select a type
			if (!form.type) {
				errorbox.text("<%- t('activity.type.select_required', { ns : 'activities' }) %>");
				Utils.toggleSubmit();
				return false;
			}

			const painter = getActivityPainterByType(form.type);
			if (painter == null) {
				errorbox.text("<%- t('activity.type.select_required', { ns : 'activities' }) %>");
				Utils.toggleSubmit();
				return false;
			}

			const activityInfo = painter.getActivityInfoFromForm(form);

			// Creating new activity
			if (form.editingActivityId == null || form.editingActivityId == "") {
			   const addActivity = function() {
					Simva.addActivityToSession(simletId, currSessionId, activityInfo, function(error, result) {
						Utils.toggleSubmit();
						if (error && error.responseJSON) {
							errorbox.text(error.responseJSON.message);
							return false;
						} else {
							Utils.toggleFormInFloating('activity_form_menu');
							reloadSimlet();
						}
					});
			   }

			   // If the activity is a web activity with no url, show a message asking confirmation
			   const closestWebTab = $(this).find("[method='WEB']");
				if (closestWebTab.length > 0 && closestWebTab.is(".selected") && (form.game_uri == "" || form.game_uri == null || form.uri == "" || form.uri == null)) 
				{
					if (confirm(`<%- t('add.new.web.no_url_message', { ns : 'activities' }) %>`)) {
						addActivity();
					}
					else {
						Utils.toggleSubmit();
					}
				}
				else {
					addActivity();
				}
			}
			// Editing activity
			else {
				let activity = getActivityFromId(form.editingActivityId);
				if (activity == null) {
					errorbox.text("Activity not found");
					Utils.toggleSubmit();
					return false;
				}

				// Compare the previous activity info with the updated one
				if (JSON.stringify(prevActivityInfo) === JSON.stringify(activityInfo)) {
					errorbox.text("<%- t('edit.no_changes.message', { ns : 'SIMLETs' }) %>");
					Utils.toggleSubmit();
					return false;
				}
				else {
					Simva.updateActivity(simletId, currSessionId, form.editingActivityId, activityInfo, function(error, result) {
						Utils.toggleSubmit();
						if (error && error.responseJSON) {
							errorbox.text(error.responseJSON.message);
						} else {
							Utils.toggleFormInFloating('activity_form_menu');
							reloadSimlet();
						}
					});
				}
			}

			return false;
		});

		// When submitting the import activity form
		$(document).on('submit', "#import_activity_form", function(event) {
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit();
			let errorbox = $('#activity_form_error');
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				let reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						raw = raw.substr(raw.indexOf(',') + 1);
						const newActivity = raw;

						Simva.importActivity(simletId, currSessionId, {file: newActivity, activity_name: form.activityName}, function(importError, result) {
							Utils.toggleSubmit();
							if (importError) {
								errorbox.text(importError.responseJSON ? importError.responseJSON.message : importError.message || importError);
								return;
							} else {
								reloadSimlet();
								Utils.toggleFormInFloating('activity_form_menu');
							}
						});
					} catch (parseError) {
						console.error('Import error:', parseError);
						Utils.toggleSubmit();
						errorbox.text("<%- t('import.error.invalid_file', { ns : 'activities' }) %> " + (parseError.message ? (': ' + parseError.message) : ''));
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			} else {
				errorbox.text("<%- t('import.upload.error', { ns : 'activities' }) %>");
				Utils.toggleSubmit();
			}
			return false;
		});

    });


    const openActivityForm = function(sessionId, activityId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#activity_name_desc_tab_button'), 'activity_form_form','activity_name_desc_tab');

		Utils.toggleFormInFloating('activity_form_menu');

		$('#activity_form_error').text("");

		$('#edit_activity_id').val(activityId);
		currSessionId = sessionId;

		// Creating new activity
		if (activityId == null) {
			// Show the add new/import tabs and unlock the activity type selector
			$("#add_activity_tabs").show();
			$("#activity_type option:not(:selected)").prop("disabled", false);

			$("#activity_form_title").text("<%- t('add.title', { ns : 'activities' }) %>");
			$("#activity_submit").val("<%- t('add.submit', { ns : 'activities' }) %>");

			$('#prev_activity_name').val("");
			$('#prev_activity_type').val("");
			$('#activity_name').val("");

			// Select the placeholder option
			$("#activity_type_field option").eq(0).prop("selected", true);
			selectActivityType();
		}
		// Editing activity
		else {
			const activity = getActivityFromId(activityId);

			// Hide the add new/import tabs (only the name/description/tags tab is needed when editing session)
			$("#add_activity_tabs").hide();

			$("#activity_form_title").text("<%- t('edit.title', { ns : 'activities' }) %>");
			$("#activity_submit").val("<%- t('edit.submit', { ns : 'activities' }) %>");

			$('#prev_activity_name').val(activity.activity_name);
			$('#prev_activity_type').val(activity.activity_type);
			
			$('#activity_name').val(activity.activity_name);
			$('#activity_type_field').val(activity.activity_type);

			// Paint the extra form depending on the activity type
			selectActivityType(activity);

			// Lock the activity type selector once the extra form has been updated to avoid changing the activity type
			$("#activity_type option:not(:selected)").prop("disabled", true);

			// Save the activity info before editing to compare it with the info after submitting the form
			const painter = getActivityPainterByType(activity.activity_type);
			if (painter != null) {
				prevActivityInfo = painter.getActivityInfoFromForm(Utils.getFormData($("#activity_form")));
			}
		}
	}

	const openActivityDownloadForm = function(activityId) {
		Utils.toggleFormInFloating('download_data_menu');
		Utils.changeTab(null, 'download_data_form','download_activity_data');

        downloadActivityId = activityId;
		const activity = getActivityFromId(activityId);

		$("#downloadFormTitle").text(`<%- t('single.title', { ns : 'activities' }) %>: ${activity.activity_name}`);

		const session = getSessionFromId(activity.session_id);

		// Show test download button only if the current user is participant of the session
		$("#activity_test_data_download").hide();
		if (isCurrentUserParticipant(session.completeParticipants)) {
			$("#activity_test_data_download").show();
		}

		// Show xasu download button only if the activity is a desktop gameplay activity
		$("#xasu_download").hide();
		if (activity.activity_type == "gameplay") {
			if (activity.game_type != "WEB" && activity.activity_trace_storage) {
				$("#xasu_download").show();
			}
		}
	}

	// Expand/hide activity participants table
	const toggleActivityTable = function(activityId) {
		$(`#activity_${activityId}`).find('.expandButton').toggleClass('collapsed');
		$(`#activity_${activityId}`).find('table').toggle();
	}


	// Activities buttons shared listeners using event delegation to ensure 
	// the handler works even if element is added after the document ready event

	$(document).on('click', ".activityTopActions .activityDownload", function(e) {
		const data = $(this).closest(".activity").data();
		openActivityDownloadForm(data[ACTIVITY_DATA_ID_KEY])
	});

    $(document).on('click', ".activityTopActions .expandButton", function(e) {
		const data = $(this).closest(".activity").data();
		toggleActivityTable(data[ACTIVITY_DATA_ID_KEY]);
	});
	
	$(document).on('click', ".activityTopActions .icon-edit", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		openActivityForm(sessionData[SESSION_DATA_ID_KEY], data[ACTIVITY_DATA_ID_KEY]);
	});

	$(document).on('click', ".activityTopActions .icon-export", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		exportActivity(data[ACTIVITY_DATA_ID_KEY]);
	});

	// Open a floating window with the Tmon page of the selected activity
	$(document).on('click', ".activityTopActions .icon-url", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		const url = `${Simva.tmonUrl}/${simletId}/${sessionData[SESSION_DATA_ID_KEY]}/${data[ACTIVITY_DATA_ID_KEY]}/${Simva.TMonFile}/dashboard/`;
       	Utils.toggleIframeInFloating(url); 
	});

	// Set completion for all participants
	$(document).on('click', ".activityTopActions .icon-activate", function(e) {
		const data = $(this).closest(".activity").data();
		setCompletionForAllParticipant(data[ACTIVITY_DATA_ID_KEY], true);
	});
	
	// Unset completion for all participants
	$(document).on('click', ".activityTopActions .icon-pause", function(e) {
		const data = $(this).closest(".activity").data();
		setCompletionForAllParticipant(data[ACTIVITY_DATA_ID_KEY], false);
	});

	$(document).on('click', ".activityTopActions .icon-delete", function(e) {
		const data = $(this).closest(".activity").data();
		const sessionData = $(this).closest(".test").data();
		deleteActivity(data[ACTIVITY_DATA_ID_KEY], data[ACTIVITY_DATA_NAME_KEY], sessionData[SESSION_DATA_ID_KEY])
	});
	// Checkbox to set/unset completion for user
	$(document).on('change', ".compProgress input[type='checkbox']", function (e) {
        const data = $(this).closest("tr").data();
        const activityData = $(this).closest(".activity").data();
		Simva.setActivityCompletion(activityData[ACTIVITY_DATA_ID_KEY], data[USER_DATA_ID_KEY], $(this).is(":checked"), function() {
			console.log('saved');
		});
    });
	
	// Open results of user in floating menu 
	$(document).on('click', ".activity table .showResult", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.openResults(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});

	// Download results for user
	$(document).on('click', ".activity table .downloadResult", function(e) {
		const data = $(this).closest("tr").data();
		const activityData = $(this).closest(".activity").data();

		const act = getActivityFromId(activityData[ACTIVITY_DATA_ID_KEY]);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadResults(act.activity_id, data[USER_DATA_ID_KEY]);
			}
		}
	});



	// Functionality
	
	const downloadActivityData = function () {
		Simva.getActivityLRSData(downloadActivityId, (error, result) => {
            let errorMsg = "<%= t('result.error.downloading', { ns : 'activities' }) %>";
			if(error){
				$.toast({
					heading: errorMsg,
					text: error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			} else {
				Utils.downloadContent(result.data, `full_xapi_data_${downloadActivityId}.json`, errorMsg);
			}
		});
	}

	const downloadActivityTestData = function() {
		Simva.getActivityTestLRSData(downloadActivityId, (error, result) => {
            let errorMsg = "<%= t('result.error.downloading', { ns : 'activities' }) %>";
			if(error){
				$.toast({
					heading: errorMsg,
					text: error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			} else {
				Utils.downloadContent(result.data, `test_xapi_data_${downloadActivityId}.json`, errorMsg);
			}
		});
	}

	const downloadGlobalActivityBackup = function() {
		const act = getActivityFromId(downloadActivityId);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadGlobalActivityBackup(downloadActivityId);
			}
		}
	}

	const downloadUsersActivityBackup = function() {
		const act = getActivityFromId(downloadActivityId);
		if (act != null) {
			const painter = getActivityPainterByType(act.activity_type);
			if (painter != null) {
				painter.downloadBackup(downloadActivityId);
			}
		}
	}
    
	const exportActivity = function(activityId) {
		Simva.exportActivity(activityId, true, (error, result) => {
			if(error){
				$.toast({
					heading: error.message,
					text: error.message,
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			} 
			else {
				Utils.downloadContent(JSON.stringify(result, null, 2), `activity_export_${activityId}.json`);
			}
		});
	}

	const setCompletionForAllParticipant = function(activityId, status) {
		Simva.setMultiActivityCompletion(activityId, status, (error, result) => {
			if (error){
				$.toast({
					heading: error.message,
					text: "<%- t('completed.error.message', { ns : 'activities' }) %>",
					position: 'top-right',
					icon: 'error',
					stack: false
				});
			}
		})
	}

    const deleteActivity = function(activityId, activityName, sessionId) {
		let test = getSessionFromId(sessionId);
		let testName = test && test.session_name ? test.session_name : sessionId;
		if (confirm(`<%- t('delete.confirm', { ns : 'activities', activity : '${activityName}', session: '${testName}' , SIMLET : '${simlet.simlet_name}' }) %>`)) {
			Simva.deleteActivity(simletId, sessionId, activityId, function(error, result) {
				reloadSimlet();
			});
		}
	}


	// Render

	/**
	 * Paint all the activities cards of a session
	 * @param {object} sesion - object containing the session info
	 * @param {Array} activities - Array of objects containing the activities info
	 * @param {Array} participants - Array of objects containing the session participants info
	 * @param {object} sessionCard - jquery object reference of the session card element
	 */
    const paintSessionActivities = async function(session, activities, participants, sessionCard) {
		$(`#test_${session.session_id} .activities`).empty();

		if (activities.length === 0) {
			$(`#test_${session.session_id} .activities`).text("<%- t('no_activities.message', { ns : 'activities' }) %>");
		} 
		else {
			activities.forEach((activity) => {
				const painter = getActivityPainterByType(activity.activity_type);
				if (painter != null) {
                    painter.addActivityCard(simletId, activity, participants, sessionCard);
                }
			});
		}

		// Block activity changes when session is finished
		if (session.session_status == SESSION_FINISHED_STATUS) {
			$(".activityTopActions").find(".kebab-dropdown").find(".icon-delete").hide();
			$(".activityTopActions").find(".kebab-dropdown").find(".icon-activate").hide();
			$(".activityTopActions").find(".kebab-dropdown").find(".icon-pause").hide();

			$($(".activity").find("table")).find("input:checkbox").prop("disabled", true);
		}
	}

	
	/**
	 * Paint the extra form corresponding to the selected activity type
	 * @param {object} activity - object containing the activity info
	 */
	const selectActivityType = function(activity) {
		$('#activity_extras').empty();
		const painter = getActivityPainterByType($("#activity_type_field").val());
		if (painter != null) {
			painter.paintExtraForm(activity);
		}
	}

</script>

