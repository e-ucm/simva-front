<%# views/group_view.ejs %>
 
<% extend('layout_with_menu') %>

<!--<div id="roller" style="width: 100%; text-align: center; padding: 200px;">
	<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
</div>-->
<div id="group_view">
	<h1><%= t('single.title' , { ns : 'groups' }) %>: <span id="group_name"></span></h1><input class="yellow" type="button" value="<%= t('name.edit.title', { ns : 'groups' }) %>" onclick="openEditGroupForm('<%= group %>')">
	<div class="left">
		<div class="graybox owners">
			<h2><%= t('owners.title' , { ns : 'groups' }) %></h2>
			<p></p>
			<table id="owners">
			</table>
			<input class="violet" type="button" value="<%= t('owners.add.title' , { ns : 'groups' }) %>"  onclick="Utils.toggleAddForm('add_owner')">
		</div>
	</div>
	<div class="card" id="study">
		<div class="top">
			<h2><%= t('participants.title' , { ns : 'groups' }) %></h2>
			<input class="violet" type="button" value="<%= t('participants.add.title' , { ns : 'groups' }) %>" onclick="Utils.toggleAddForm('add_participant')">
		</div>
		
		<div class="participants" id="participants_list">
			<table id="participants">
			</table>
		</div>
	</div>
	<div id="add_owner" class="new_element floating">
		<div class="floater">
			<div class="form">
				<div id="existing_owner_tab" class="subform selected">
					<h2><%= t('owners.add.title' , { ns : 'groups' }) %></h2>
					<form id="existing_owner_form">
						<input type="text" name="name" placeholder="<%= t('owners.add.username.placeholder' , { ns : 'groups' }) %>" required>
						<input type="submit" value="<%= t('owners.add.title' , { ns : 'groups' }) %>">
						<span class="error"></span>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div id="edit_group" class="new_element floating">
		<div class="floater">
			<div class="form">
				<div id="edit_group_tab" class="subform selected">
					<h2><%= t('name.edit.title' , { ns : 'groups' }) %></h2>
					<form id="edit_group_form">
						<input hidden type="text" name="group">
						<input hidden type="text" name="groupName">
						<input type="text" name="name" id="edit_group_name" placeholder="<%= t('name.placeholder' , { ns : 'groups' }) %>" required>
						<input type="submit" value="<%= t('name.edit.title' , { ns : 'groups' }) %>">
						<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
						<span class="error" id="edit_group_error"></span>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div id="add_participant" class="new_element floating">
		<div class="floater">
			<div class="form">
				<div class="tabs">
					<span class="tab selected" onclick="changeTab(this, 'add_participant','existing_participant_tab')"><%= t('participants.add.existing.title' , { ns : 'groups' }) %></span>
					<span class="tab" onclick="changeTab(this, 'add_participant','new_participant_tab')"><%= t('participants.add.new.title' , { ns : 'groups' }) %></span>
					<span class="tab" onclick="changeTab(this, 'add_participant','batch_participant_tab')"><%= t('participants.add.batch.title' , { ns : 'groups' }) %></span>
				</div>
				<div id="existing_participant_tab" class="subform selected">
					<form id="existing_participant_form">
						<input type="text" name="name" placeholder="<%= t('participants.add.username.placeholder', { ns : 'groups' }) %>" required>
						<input type="submit" value="<%= t('participants.add.existing.title' , { ns : 'groups' }) %>">
						<span class="error"></span>
					</form>
				</div>
				<div id="new_participant_tab" class="subform">
					<form id="new_participant_form">
						<input type="text" name="username" placeholder="<%= t('participants.add.username.placeholder', { ns : 'groups' }) %>" value="" required>
						<input type="email" name="email" placeholder="<%= t('participants.add.email.placeholder', { ns : 'groups' }) %>" value="" required>
						<input type="password" name="password" placeholder="<%= t('participants.add.password.placeholder', { ns : 'groups' }) %>" required>
						<div class="role_selector">
							<input id="teacher_role" type="radio" name="role" value="teacher"><label for="teacher_role"><%= t('teacher' , { ns : 'roles' }) %></label>
							<input id="student_role" type="radio" name="role" value="student" checked><label for="student_role"><%= t('student' , { ns : 'roles' }) %></label>
						</div>
						<input type="submit" value="<%= t('participants.add.new.title' , { ns : 'groups' }) %>">
						<span class="error"></span>
					</form>
				</div>
				<div id="batch_participant_tab" class="subform">
					<form id="batch_participant_form">
						<p><%= t('participants.add.batch.number.title' , { ns : 'groups' }) %></p>
						<input type="number" step="1" min='1' max="100" name="amount" value="1">
						<p><%= t('participants.add.batch.algorithFormat' , { ns : 'groups' }) %></p>
						<select name="algorithm">
							<option value="letters"><%= t('participants.add.batch.algorithFormat.letters' , { ns : 'groups' }) %></option>
							<option value="alphanumeric"><%= t('participants.add.batch.algorithFormat.alphanumeric' , { ns : 'groups' }) %></option>
							<option value="base58"><%= t('participants.add.batch.algorithFormat.base58' , { ns : 'groups' }) %></option>
						</select>
						<p><%= t('participants.add.batch.length.title' , { ns : 'groups' }) %></p>
						<input type="number" step="1" min='4' max="10" name="length" value="4">
						<input type="submit" value="<%= t('participants.add.batch.title' , { ns : 'groups' }) %>">
						<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
						<span class="error"></span>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

<div id="pdf_printable">
	<table id="pdf_printable_table">
	</table>
</div>

<div class="floating_buttons">
	<a unselectable="on" class="pdf" onclick="window.print();">PDF</a>
</div>
<script type="text/javascript">
	if(true)  {
		// Create an instance of SSEClientManager
		Simva.getGroupEventsPresignedUrl('<%= group %>', function(error, result){
			if(!error) {
				const presignedUrl = result.url;
				const sseClient = new SSEClientManager(presignedUrl);

				// Listen for general messages (default "message" event)
				sseClient.on('message', (data) => {
					console.debug('New message from server:', data);
					// Update UI or process data here
				});

				// Listen for connection open event
				sseClient.on('open', () => {
					console.log('Connection to SSE server established.');
				});

				sseClient.triggerEvent('ping');
				sseClient.on('ping', (data) => {
					console.debug('ping:', data);
				});

				// Close the SSE connection when it's no longer needed
				window.addEventListener('beforeunload', () => {
					if (sseClient) {
						sseClient.closeConnection(); // Call closeConnection method
					}
				});
			}
		});
	}
</script>
<script type="text/javascript">
	let group = {};
	let groupid = "<%= group %>";
	let loaded=false;

	window.addEventListener('DOMContentLoaded', async() => {
		const url = new URL(window.location.href);
		
		// Check if URL ends with /print
		if (url.pathname.endsWith('/print')) {
			// Trigger the print dialog
			while(!loaded) {
				 // Wait for 1 second (1000 milliseconds)
				 await new Promise(resolve => setTimeout(resolve, 1000));
			}
			window.print();
			// Optional: Remove /print from the URL
			const newPath = url.pathname.replace(/\/print$/, '');
    		window.history.replaceState({}, '', newPath);
		}
	});

	$(document).ready(function() {
		$("#existing_owner_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#existing_owner_form"));
			let errorbox = $(this).find('.error');

			for (var i = 0; i < group.owners.length; i++) {
				if(group.owners[i] == form.name){
					errorbox.text('The owner is already in the group.');
					return false;
				}
			}

			group.owners.push(form.name);

			Simva.updateGroup(group, function(error, result){
				reloadGroup();

				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					Utils.toggleAddForm('add_owner');
				}
			});

			return false;
		});

		$("#edit_group_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#edit_group_form"));
			Utils.toggleSubmit(currentform);
			let errorbox = $(this).find('.error');
			if(form.name == form.groupName) {
				errorbox.text("<%= t('name.edit.nochange', { ns : 'groups' }) %>");
				Utils.toggleSubmit(currentform);
			} else {
				Simva.getGroup(form.group, function(error, group){
					if(!error){
						group.name = form.name;
						Simva.updateGroup(group, function(error, result){
							if(!error){
								Utils.toggleSubmit(currentform);
								Utils.toggleAddForm('edit_group');
								reloadGroup();
							}
						});
					}
				});
			}
			return false;
		});

		$("#existing_participant_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#existing_participant_form"));
			let errorbox = $(this).find('.error');

			for (var i = 0; i < group.participants.length; i++) {
				if(group.participants[i] == form.name){
					errorbox.text(`t("participants.errormessage.alreadyInGroup", { ns : "groups", group : "${group.name}", participant : "${form.name}" }) %>`); 
					return false;
				}
			}

			group.participants.push(form.name);

			Simva.updateGroup(group, function(error, result){
				reloadGroup();

				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					Utils.toggleAddForm('add_participant');
				}
			});

			return false;
		});

		$("#new_participant_form").on('submit', function(event){
			event.preventDefault();
			let form = Utils.getFormData($("#new_participant_form"));
			let errorbox = $(this).find('.error');

			Simva.register(groupid, form.username.toLowerCase(), form.email, form.password, form.role, false, false, function(error, result){
				if(error && error.responseJSON){
					errorbox.text(error.responseJSON.message);
				}else{
					group.participants.push(form.username);

					Simva.updateGroup(group, function(error, result){
						reloadGroup();

						if(error && error.responseJSON){
							errorbox.text(error.responseJSON.message);
						}else{
							Utils.toggleAddForm('add_participant');
						}
					});
				}
			});

			return false;
		});

		$("#batch_participant_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			Utils.toggleSubmit(currentform);
			let form = Utils.getFormData($("#batch_participant_form"));
			let errorbox = $(this).find('.error');

			Simva.generateAndRegister(groupid, form.algorithm, form.length, form.amount, false, (error, generated) => {
				if(!error) { 
					group.participants = group.participants.concat(generated);
					Simva.updateGroup(group, function(error, result){
						Utils.toggleSubmit(currentform);
						reloadGroup();
						if(error && error.responseJSON){
							errorbox.text(error.responseJSON.message);
						}else{
							Utils.toggleAddForm('add_participant');
						}
					});
				}
			});

			return false;
		});

		reloadGroup();
	});

	let openEditGroupForm = function(groupId){
		Simva.getGroup(groupId, function(error, group) {
			document.getElementById("edit_group_error").innerHTML = "";
			var inputElement = document.getElementById('edit_group_name');
			inputElement.value = group.name;
			$('#edit_group input[name="group"]').val(group._id);
			$('#edit_group span[class="error"]').val("");
			$('#edit_group input[name="groupName"]').val(group.name);
			Utils.toggleAddForm('edit_group');
		});
	}

	let reloadGroup = function(){
		Simva.getGroup(groupid, function(error, result){
			if(!error){
				group=result;
				paintGroup(group, group.completeParticipants);
				delete group.completeParticipants;
				loaded=true;
			} else {
				window.location.href="/groups";
			}
		});
	}

	let removeParticipant = function(participant){
		if(confirm(`<%- t('participants.remove.confirm', { ns: 'groups',  participant : '${participant}', group : '${group.name}' }) %>`)){
			let toremove = -1;
			for (var i = 0; i < group.participants.length; i++) {
				if(group.participants[i] === participant){
					toremove = i;
					break;
				}
			}

			group.participants.splice(i, 1);

			Simva.updateGroup(group, function(error, result){
				reloadGroup();
			});
		}
	}

	let deleteOwner = function(owner){
		if(confirm(`<%- t('owners.remove.confirm', { ns: 'groups', owner : '${owner}', group : '${group.name}' }) %>`)){
			let toremove = -1;
			for (var i = 0; i < group.owners.length; i++) {
				if(group.owners[i] === owner){
					toremove = i;
					break;
				}
			}

			group.owners.splice(i, 1);

			Simva.updateGroup(group, function(error, result){
				reloadGroup();
			});
		}
	}

	let paintGroup = function(group, participants){
		$('#group_name').text(group.name);

		$('#owners').html('');
		for (var i = 0; i < group.owners.length; i++) {
			$('#owners').append(ownerRow(group.owners[i]));
		}
		$('#participants').empty();
		$('#pdf_printable_table').empty();
		if(group.participants.length == 0){
			$('#participants').append('<p><%= t("participants.errormessage.zeroInGroup.title", { ns : "groups" }) %><%= t("participants.errormessage.zeroInGroup.message", { ns : "groups" }) %></p>');
			$('#pdf_printable_table').append(groupHeaderNoParticipantsPDF(group));
			$('#pdf_printable_table').append('<p><%= t("participants.errormessage.zeroInGroup.title", { ns : "groups" }) %></p>');
		}else{
			$('#participants').append(participantHeader());
			$('#pdf_printable_table').append(headerRowPDF(group));
			for (var i = 0; i < participants.length; i++) {
				$('#participants').append(participantRow(participants[i]));
				$('#pdf_printable_table').append(participantRowPDF(participants[i], i+1));
			}
		}
	}

	let ownerRow = function(owner){
		let toret = `<tr><td>${owner}</td><td><input class="red" type="button" value="<%= t("owners.remove.title", { ns : "groups" }) %>"`;
		if(owner == '<%= user.data.username %>'){
			toret += ' disabled="disabled"';
		}else{
			toret += ` onclick="deleteOwner('${owner}')"`
		}

		toret += '></td></tr>';
		return toret;
	}

	let groupHeaderNoParticipantsPDF = function(groupname) {
		return `<thead><tr><th colspan="6"><%= t("single.title", { ns : "groups" }) %>: ${group.name}</th></tr></thead>`;
	}

	let participantHeader = function(){
		return `<tr><th></th><th><%= t("participants.username.title", { ns : "groups" }) %></th><th><%= t("participants.email.title", { ns : "groups" }) %></th><th><%= t("participants.role.title", { ns : "groups" }) %></th><th></th></tr>`;
	}

	let participantRow = function(participant){
		let role="";
		switch(participant.role) {
			case "student":
				role = `<%= t("student", { ns : "roles" }) %>`;
				break;
			case "teacher":
				role = `<%= t("teacher", { ns : "roles" }) %>`;
				break;
			default:
				role = `<%= t("participants.role.notdefined", { ns : "groups" }) %>`;
		}
		return `<tr><td><img src="/icon/user.png"></td>
			<td>${participant.username}</td>
			<td><a href="${participant.email}">${participant.email}</a></td>
			<td>${role}</td>
			<td><input class="red" type="button" value="<%= t("participants.remove.title", { ns : "groups" }) %>" onclick="removeParticipant('${participant.username}')"></td>`;
	}

	let headerRowPDF = function(group){
		return `<thead><tr><th colspan="6"><%= t("single.title", { ns : "groups" }) %>: ${group.name}</th></tr><tr><td width="5%"><%= t("participants.pdf.no.title", { ns : "groups" }) %></td><td width="45%"><%= t("participants.pdf.name.title", { ns : "groups" }) %></td><td width="40%" colspan="4"><%= t("participants.pdf.code.title", { ns : "groups" }) %></td></tr></thead>`;
	}

	let participantRowPDF = function(participant, position){
		let username = participant.username;
		if(participant.isToken == "true") {
			username = participant.token;
		}
		return `<tr><td>${position}</td><td></td><td>${username}</td><td>${username}</td><td>${username}</td><td>${username}</td></tr>`;
	}

	let changeTab = function(tab, form, subform){
		$(`#${form} .tab`).removeClass('selected');
		$(`#${form} .subform`).removeClass('selected');
		$(tab).toggleClass('selected');
		$(`#${subform}`).toggleClass('selected');
	}
</script>