<%# views/study_view.ejs %>
 
<% extend('layout_with_menu') %>

<!-- Top part of the view, which includes the SIMLET name and the 3-dot menu button -->
<div class="simletTop">
	<h1 title="<%- t('single.description', { ns : 'SIMLETs' }) %>"><%- t('single.title', { ns : 'SIMLETs' }) %>: <span id="simlet_name"></span></h1>
	<div class="simletSettings">
		<div class="kebab">
			
		</div>
	</div>
</div>

<!-- The SIMLET tags list will be inserted here after the SIMLET has loaded -->

<!-- Needs to be added before other partials to allow them to use
the elements and scripts defined in the simlet_commons partial -->
<%- include('partials/simlet_commons') %>

<!-- Sessions/groups tabs -->
<div id="study_tabs">
	<div class="tabs studyTabsButtons">
		<input id="sessions_tab_button" class="tab yellow selected" type="button" title="<%- t('sessions.tab.description', { ns : 'SIMLETs' }) %>" onclick="openSessionsTab()" value="<%- t('sessions.tab.title', { ns : 'SIMLETs' }) %>">
		<input id="users_tab_button" class="tab yellow" type="button" title="<%- t('users.tab.description', { ns : 'SIMLETs' }) %>" onclick="openUsersTab()" value="<%- t('users.tab.title', { ns : 'SIMLETs' }) %>">
	</div>
	
	<div id="sessions_tab" class="subform studyTab selected">
		
		<%- include('partials/simlet_sessions') %>
		<%- include('partials/simlet_activities') %>
		
		<!-- Common menu for downloading both sessions and activities data  -->
		<div id="download_data_menu" class="new_element floating">
			<div class="floater">
				<div class="form" id="download_data_form">
					<h1 id="downloadFormTitle">		</h1>

					<div id="download_session_data" class="subform selected">
						<!-- onClick functions defined on the simlet_sessions partial -->
						<input class="yellow" type="button" value="<%- t('download.session.title', { ns : 'sessions' }) %>" onclick="downloadSessionData()">
						<input class="yellow" id="session_test_data_download" type="button" title="<%- t('download.test.description', { ns : 'sessions' }) %>" value="<%- t('download.test.title', { ns : 'sessions' }) %>" onclick="downloadSessionTestData()">
					</div>

					<div id="download_activity_data" class="subform">
						<!-- onClick functions defined on the simlet_activities partial (except downloadActivityXasuConfig, which is defined on the gameplay_activity partial) -->
						<input class="yellow" type="button" value="<%- t('download.activity.title', { ns : 'activities' }) %>" onclick="downloadActivityData()">
						<input class="yellow" id="global_backup_download" type="button" value="<%- t('download.backup.global.title', { ns : 'activities' }) %>" onclick="downloadGlobalActivityBackup()">
						<input class="yellow" id="activity_test_data_download" type="button" value="<%- t('download.test.title', { ns : 'sessions' }) %>" onclick="downloadActivityTestData()">
						<input class="yellow" id="xasu_download" type="button" value="<%- t('download.xasu.title', { ns : 'activities' }) %>" onclick="downloadActivityXasuConfig()">
						<input class="yellow" id="backup_download" type="button" value="<%- t('download.backup.user.title', { ns : 'activities' }) %>" onclick="downloadUsersActivityBackup()">
					</div>
				</div>
			</div>
		</div>
	</div>

	<div id="users_tab" class="subform studyTab" style="display: none;">
		
		<%- include('partials/simlet_users') %>
		
	</div>
</div>

<!-- Invisible table that gets filled when exporting a group as PDF. Needs to
 be included in this view to ensure it correctly renders on the print window-->
<div id="pdf_printable">
	<h3 id="printable_group_name">	</h3>
	<table id="printable_table">
		<thead>
			<th style="width: 6%;"><%- t('print_table.number_col.title', { ns : 'groups' }) %></th>
			<th style="width: 46%;"><%- t('print_table.name_col.title', { ns : 'groups' }) %></th>
			<th style="width: 46%;" colspan="4"><%- t('print_table.code_col.title', { ns : 'groups' }) %></th>
		</thead>
		<tbody>

		</tbody>
	</table>
</div>


<script type="text/javascript">
	let simletId = "<%= study %>";
	let currentUser = null;
	let simlet = null;

	// Needs to contain all the sessions from the start to show them as options in the group allocator
	let sessionsById = new Map();	// Defined when loading the SIMLET or on paintAllocator in the simlet_users partial (whichever loads first)
	
	// Stored to avoid having to fetch them every time the search parameters change 
	// They don't need to contain all the data from the start since they're only neeeded
	// when they're getting painted and when interacting with the elements they're painted on
	let completeSessionsById = new Map();		// Defined on fillSessionCard in the simlet_sessions partial 
	let	completeActivitiesById = new Map();		// Defined on fillSessionCard in the simlet_sessions partial
	let completeGroupsById = new Map();			// Defined on paintAllocator in the simlet_users partial
	let participantsById = new Map();			// Defined on paintAllocator in the simlet_users partial
	let participantsByUsername = new Map();		// Defined on paintAllocator in the simlet_users partial
	
	// TODO: Declare platforms

	
	// Menus

	// Add the floating class to the content element to add space at the bottom 
	// of the page so the floating button doesnt cover any other element
	$(".content").addClass("floating");
	
	$(document).ready(function() {
		// Create the SIMLET 3-dot button from the template 
		const kebab = $("#kebab_template .kebab-dropdown").clone();
		$(".simletSettings .kebab").append(kebab);
		kebab.find(".icon-edit").on("click", () => { openSimletForm(simletId) });
		kebab.find(".icon-url").on("click", () => { openUrlSettingsForm(simletId, simlet.simlet_name) });
		kebab.find(".icon-download").on("click", () => { openConfigDownloadForm(simletId, simlet.simlet_name) });
		kebab.find(".icon-export").on("click", () => { exportSimlet(simletId) });
		kebab.find(".icon-delete").on("click", () => { deleteSimlet(simletId, simlet.simlet_name); });
		kebab.find(".icon-archive").on("click", (e) => { 
			if($(e.target).hasClass("li-disabled") || simlet == null) {
				return;
			}
			archiveSimlet(simlet.simlet_id, simlet.simlet_name, true);
		});
		kebab.find(".icon-dearchive").on("click", () => {
			if (simlet == null) {
				return;
			}
			archiveSimlet(simlet.simlet_id, simlet.simlet_name, false);
		});

		// Delete the add and import SIMLET tabs from the name/description menu
		$("#add_study_tabs").remove();
		$("#import_study_tab").remove();
		
		// Get the current user, store it, and paint the rest of the SIMLET
		Simva.getCurrentUser((error, user) => {
			if (!error) {
				currentUser = user;
				Simva.getUser(user.username, function(error, result) {
					participantsById.set(user.user_id, result);
					participantsByUsername.set(user.username, result);
					
					updateSimletInfo(true);
				});
			} else {
				console.error("Error fetching current user:", error);
				currentUser = null;
				// Optionally, display an error message to the user
				alert("Error fetching user information. Some features may not work properly.");
			}
		});
	});

	const openSessionsTab = function() {
		Utils.changeTab("sessions_tab_button", 'study_tabs','sessions_tab');

		// Check if the bottom has been reached just in case more results fit on the screen,
		// since the check is based on the current tab height, it can be different when
		// changing tabs, so the check needs to be done manually to ensure correct loading
		sessionsFilteringPaginationData["bottomReached"]();
	}

	const openUsersTab = function() {
		Utils.changeTab("users_tab_button", 'study_tabs','users_tab');

		// Check if the bottom has been reached just in case more results fit on the screen,
		// since the check is based on the current tab height, it can be different when
		// changing tabs, so the check needs to be done manually to ensure correct loading
		groupsFilteringPaginationData["bottomReached"]();
	}
	
	const openSimletForm = function() {
		Utils.toggleFormInFloating('study_form');

		$('#study_form_error').text("");
		$('#edit_study_id').val(simletId);
		
		$("#study_form_title").text("<%- t('edit.title', { ns : 'SIMLETs' }) %>");
		$("#study_name_desc_submit").val("<%- t('edit.submit', { ns : 'SIMLETs' }) %>");

		$('#prev_study_name').val(simlet.simlet_name);
		$('#prev_study_description').val(simlet.simlet_description);
		
		$('#study_name').val(simlet.simlet_name);
		$('#study_description').val(simlet.simlet_description);
	}
	

	// Declared on the simlet_commons partial
	onEditSimlet = function(newSimletInfo) {
		simlet = newSimletInfo;
		$('#simlet_name').text(newSimletInfo.simlet_name);
	}

	// Declared on the simlet_commons partial
	onDeleteSimlet = function(simletId) {
		window.location.href="/simlets";
	}
	
	// Declared on the simlet_commons partial
	onArchiveSimlet = function(newSimletInfo) {
		simlet = newSimletInfo;
		paintArchived();
	}
	
	
	// Functionality

	/**
	 * Update the basic SIMLET info (name, description, and sessions, groups and tags ids)
	 * @param {boolean} paintAll - true to paint all the SIMLET info by performing a search with no parameters, false to not paint it
	 * @returns {function} callback - function to call after the info has been updated 
	 */
	const updateSimletInfo = function(paintAll = false, callback = null) {
		// Get the SIMLET essential parameters such as the name or its status and paint the different 
		// independent sections of the SIMLET asynchronously since the order of execution doesn't matter
		Simva.getSimlet(simletId, function(error, result) {
			if (!error) {
				simlet = result;

				$('#simlet_name').text(simlet.simlet_name);
				$("#simlet_tags").remove();
				$(".simletTop").after($(renderTags(simlet)).attr("id", "simlet_tags"));

				if (paintAll) {
					// Update all the sessions search parameters and calls its onSearch to paint them
					// No need to paint the activities here as they will be painted when painting the sessions
					// Defined in the simlet_sessions partial
					sessionsFilteringPaginationData["checkBottomReached"] = false;
					sessionsFilteringPaginationData["updateSearch"]();

					paintCoordinators();

					// Update all the groups search parameters and calls its onSearch to paint them
					// Defined in the simlet_groups partial
					groupsFilteringPaginationData["checkBottomReached"] = false;
					groupsFilteringPaginationData["updateSearch"]();

					// TODO: Store platforms
				}

				// Try fetching the sessions and groups before paintAllocator in the simlet_users partial
				// to potentially avoid fetching them multiple times, since the first paintAllocator calls
				// run asynchronously and practically at the same time 
				if (sessionsById.size != simlet.sessions.length) {
					Simva.getSimletSessions(simletId, function(error, result) {
						if (!error) {
							sessionsById = new Map(result.map(obj => [obj.session_id, obj]));
						}
					});
				}
			
				paintArchived();
			} 
			else {
				console.error(error);
			}

			if (callback != null && typeof callback === "function") {
				callback();
			}
		});
	}

		
	const getSessionFromId = function(sessionId) {
		if (completeSessionsById.has(Number(sessionId))) {
			return completeSessionsById.get(Number(sessionId));
		}
		return null;
	}

	const getActivityFromId = function(activityId) {
		if (completeActivitiesById.has(Number(activityId))) {
			return completeActivitiesById.get(Number(activityId));
		}
		return null;
	}

	const getGroupFromId = function (groupId) {
		if (completeGroupsById.has(Number(groupId))) {
			return completeGroupsById.get(Number(groupId));
		}
		return null;
	}

	const getParticipantFromId = function(participantId) {
		if (participantsById.has(Number(participantId))) {
			return participantsById.get(Number(participantId));
		}
		return null;
	}

	const getLatestCreatedSession = function() {
		const sorted = Array.from(sessionsById.values()).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
		return sorted[0];
	}
	
	const getLatestUpdatedSession = function() {
		const sorted = Array.from(sessionsById.values()).sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
		return sorted[0];
	}


	// Render
	
	/**
	 * Paint the corresponding archivation button depending of the SIMLET status (active/archived) 
	 * and activate/deactivate it depending on all the sessions status  
	 */
	const paintArchived = async function() {
		const active = !simlet.simlet_archived;

		const archiveButton = $(".icon-archive");
		const dearchiveButton = $(".icon-dearchive");
		
		archiveButton.hide();
		dearchiveButton.hide();
		archiveButton.addClass("li-disabled");

		// If the SIMLET is active
		if (active == null || active) {
			// Show the add session/users floating buttons
			$(".basic").show();

			archiveButton.show();
			
			const checkAllSessionsFinished = () => {
				// Check if all sessions are finished
				let allSessionsFinished = true;

				sessionsById.forEach((session, id) => {
																					// Defined in the simlet_sessions partial
					allSessionsFinished = allSessionsFinished && session.session_status == SESSION_FINISHED_STATUS;
				});

				// If all sessions are finished, enable the archive button
				if (allSessionsFinished) {
					archiveButton.removeClass("li-disabled");
				}
			}

			// If all sessions have already been fetched, call the callback directly
			if (sessionsById.size == simlet.sessions.length) {
				checkAllSessionsFinished();
			}
			// Otherwise, fetch them from the database, store them, and call the callback once it's done
			else {
				Simva.getSimletSessions(simletId, function(error, result) {
					if (!error) {
						sessionsById = new Map(result.map(obj => [obj.session_id, obj]));
						checkAllSessionsFinished();
					}
				});
			}
		}
		// If the SIMLET is archived
		else {
			// Hide the add session/users floating buttons
			$(".basic").hide();

			// TEST: Uncomment to allow dearchivation
			dearchiveButton.show();
		}
		
		paintAllArchived();
	}

	const paintAllArchived = function() {
		paintSessionsArchived();
		paintCoordinatorsArchived();
		paintGroupsArchived();
		paintParticipantsArchived();
	}
	
	// Hide the delete button from the sessions 3-dot menus
	const paintSessionsArchived = function() {
		if (simlet.simlet_archived) {
			$("#sessions .test .sessionTop .kebab .icon-delete").hide();
		}
		else {
			$("#sessions .test .sessionTop .kebab .icon-delete").show();
		}
	}

	// Disable the delete button from the coordinators table
	const paintCoordinatorsArchived = function() {
		$("#coordinators .red").prop("disabled", simlet.simlet_archived);
		$(`#coordinators .username:contains("${currentUser.username}")`).parent().find(".red").prop("disabled", true);
	}

	// Hide the groups 3-dot menus buttons that allow modifying the group users 
	// and disable the unselected options from the allocator dropdowns
	const paintGroupsArchived = function() {
		if (simlet.simlet_archived) {
			$("#groups .test .groupTop .kebab .icon-delete").hide();
			$("#groups .test .groupTop .kebab .icon-add").hide();
			$("#groups .test .groupTop .kebab .icon-gear").hide();
		}
		else {
			$("#groups .test .groupTop .kebab .icon-delete").show();
			$("#groups .test .groupTop .kebab .icon-add").show();
			$("#groups .test .groupTop .kebab .icon-gear").show();
		}

		$("#groups .test select option:not(:selected)").prop("disabled", simlet.simlet_archived);
	}

	// Disable the delete button from the participants table
	const paintParticipantsArchived = function() {
		$(".participants .red").prop("disabled", simlet.simlet_archived);
	}

	

</script>


<!-- SSE -->
<script type="text/javascript">
	if (true)  {
		const resolveParticipantKey = (activityId, data) => {
			const candidates = [data.userId, data.user_id, data.participant_id, data.username, data.user]
				.filter((candidate) => candidate !== undefined && candidate !== null)
				.map((candidate) => String(candidate));

			for (const candidate of candidates) {
				if (
					document.getElementById(`progress_${activityId}_${candidate}`) ||
					document.getElementById(`completion_${activityId}_${candidate}`) ||
					document.getElementById(`result_${activityId}_${candidate}`) ||
					document.getElementById(`init_${activityId}_${candidate}`)
				) {
					return candidate;
				}
			}

			return candidates[0];
		};

		// Create an instance of SSEClientManager
		Simva.getSimletEventsPresignedUrl(simletId, function(error, result) {
			if (!error) {
				const sseClient = new SSEClientManager(result.url);

				// Listen for connection open event
				sseClient.on('open', () => {
					console.log('Connection to SSE server established.');
				});

				// Listen for general messages (default "message" event)
				sseClient.on('message', (data) => {
					console.debug('New message from server:', data);
					// Update UI or process data here
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_initialized" from the server
				sseClient.triggerEvent('activity_initialized');
				sseClient.on('activity_initialized', (data) => {
					const activityId = data.activity_id;
					const painter = getActivityPainterByType(data.activity_type);
					if (painter != null) {
						painter.updateActivityProgress(activityId, resolveParticipantKey(activityId, data), 0);
						
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_progressed" from the server
				sseClient.triggerEvent('activity_progressed');
				sseClient.on('activity_progressed', (data) => {
					const activityId = data.activity_id;
					const val = data.progress ?? data.value;
					const painter = getActivityPainterByType(data.activity_type);
					if (painter != null) {
						painter.updateActivityProgress(activityId, resolveParticipantKey(activityId, data), val);
					}
				});

				// Handle custom event types from the server (if applicable)
				// Example: You might send events like "activity_completed" from the server
				sseClient.triggerEvent('activity_completed');
				sseClient.on('activity_completed', (data) => {
					const activityId = data.activity_id;
					const status = data.status ?? data.value ?? true;
					const painter = getActivityPainterByType(data.activity_type);
					if (painter != null) {
						painter.updateActivityCompletion(activityId, resolveParticipantKey(activityId, data), status);
					}
				});

				sseClient.triggerEvent('ping');
				sseClient.on('ping', (data) => {
					console.debug('ping:', data);
				});

				sseClient.triggerEvent('refresh_auth');
				sseClient.on('refresh_auth', (data) => {
					console.debug('refresh_auth:', data);
					Simva.refreshAuth((error, data) => {
						if (error) {
							console.error(error);
						} else {
							console.debug(data);
						}
					});
				});

				// Close the SSE connection when it's no longer needed
				window.addEventListener('beforeunload', () => {
					if (sseClient) {
						sseClient.closeConnection(); // Call closeConnection method
					}
				});
			}
		});
	}
</script>

