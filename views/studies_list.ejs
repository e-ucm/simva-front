<%# views/studies_list.ejs %>

<% extend('layout_with_menu_and_sse') %>

<h1><%- t('title', { ns : 'SIMLETs' }) %></h1>
<div id="studies_list">
	<div style="width: 100%; text-align: center; padding: 200px;">
		<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
	</div>
</div>

<%- include('partials/simlet_commons') %>

<div id="simlet_card_template" style="display: none;">
	<a class="stopable">
		<div class="selectable card third">
			<div class="simletCardTitle">
				<h1></h1>
				<div class="kebab"></div>
			</div>
			<p class="cardDescription"> 	</p>
			<p class="cardCreationDate"><strong><%- t('sessions.creationDate', { ns : 'SIMLETs' }) %>: </strong> 		</p>
			<p class="cardUpdateDate"><strong><%- t('sessions.updateDate', { ns : 'SIMLETs' }) %>: </strong> 	</p>
			<p class="carrdSessions"><strong><%- t('sessions.title', { ns : 'SIMLETs' }) %>: </strong> 	</p>
			<p>
				<strong class="cardGroups"><%- t('groups.title', { ns : 'SIMLETs' }) %>: </strong>
				&nbsp; 
				<strong class="cardUsers"><%- t('sessions.usercount', { ns : 'SIMLETs' }) %>: </strong>
			</p>
			<div class="studyTagsRow">
				<strong><%- t('tags.title', { ns : 'SIMLETs' }) %>:</strong>
				
			</div>
		</div>
	</a>
</div>

<% if (typeof archived !== 'undefined' && !archived) { %>
	<div class="floating_buttons">
		<a unselectable="on" class="basic" onclick="openStudyForm()">+</a>
	</div>
<% } %>


<script type="text/javascript">
	const archived = "<%= archived %>" === "true";

	$(document).ready(function() {
		refreshFunc = refreshStudies;
		
		// TODO: Test
		$("#import_study_form").on('submit', function(event) {
			let currentform = this;
			let form = Utils.getFormData($("#import_study_form"));
			Utils.toggleSubmit(currentform);

			if($("#import_study_form").find('input[name="exportJson"]').get(0).files[0]){
				var reader = new FileReader();
				var input = event.target;
				reader.onload = function(){
					let raw = reader.result;
					raw = raw.substr(raw.indexOf(',') + 1);
					var newStudy = raw;
					Simva.importStudyConfig({file : newStudy}, function(error, result) {
						Utils.toggleSubmit(currentform);
						if(!error) {
							Utils.toggleAddForm('study_form');
							$('#studies_list').html(roller);
							Simva.getStudies(function(error, result){
								if(!error){
									paintStudies(result);
								}
							});
						}
						else {
							$("#study_form_error").text(error);
						}
					});
				};
				reader.readAsDataURL($("#import_study_form").find('input[name="exportJson"]').get(0).files[0]);
			}else{
				$("#study_form_error").text("<%- t('new.upload.errorMessage', { ns : 'SIMLETs' }) %>");
				Utils.toggleSubmit(currentform);
			}

			return false;
		});

		$('#studies_list').html(roller);
		refreshStudies();
	});

	let refreshStudies = function(){
		Simva.getStudies(function(error, result){
			if(!error){
				paintStudies(result);
			}
		});
	}

	let paintStudies = function(studies) {
		$('#studies_list').text('');
		let paintedStudies = 0;

		for (var i = 0; i < studies.length; i++) {
			let study = studies[i]
			if (study.simlet_archived == archived) {
				paintedStudies++;
				addSimletCard(study);
			}
		}
		if (paintedStudies == 0) {
			if (!archived) {
				$('#studies_list').text("<%- t('zero.message.title', { ns : 'SIMLETs' }) %>");
			}
			else {
				$('#studies_list').text("<%- t('zero.archived.title', { ns : 'SIMLETs' }) %>");
			}
		}
	}


	let openStudyForm = function(studyId) {
		Utils.changeTab($('#name_desc_tab_button'), 'study_form','name_desc_tab');

		$('#study_form_error').text("");
		$('#edit_study_id').val(studyId);

		// Creating new study
		if (studyId == null) {
			$("#study_form_title").text("<%- t('new.title', { ns : 'SIMLETs' }) %>");
			$("#add_study_tabs").show();
			$("#name_desc_submit").val("<%- t('new.submit', { ns : 'SIMLETs' }) %>");

			// Open form always
			$("#study_form").toggleClass("shown");

			$('#prev_study_name').val("");
			$('#prev_study_description').val("");

			$('#study_name').val("");
			$('#study_description').val("");
		}
		// Editing study
		else {
			$("#study_form_title").text("<%- t('edit.submit.title', { ns : 'SIMLETs' }) %>");
			$("#add_study_tabs").hide();
			$("#name_desc_submit").val("<%- t('edit.submit.title', { ns : 'SIMLETs' }) %>");

			Simva.getStudy(studyId, function(error, result){
				if(!error) {
					// Open form only if edit is possible
					$("#study_form").toggleClass("shown");

					$('#prev_study_name').val(result.simlet_name);
					$('#prev_study_description').val(result.simlet_description);

					$('#study_name').val(result.simlet_name);
					$('#study_description').val(result.simlet_description);
				}
			});
		}
	}

	let renderStudyTags = function(study) {
		const tags = Array.isArray(study.tags) ? study.tags : [];
		if(tags.length === 0) {
			return '<div class="sessionTagList"><span class="sessionTagEmpty">No tags</span></div>';
		}

		let tagsHtml = '<div class="sessionTagList">';
		for (let i = 0; i < tags.length; i++) {
			const tag = tags[i] || {};
			const tagName = tag.tag_name || 'Tag';
			const tagColor = tag.tag_color || '#3b82f6';
			tagsHtml += `
				<span class="sessionTagChip">
					<span class="sessionTagColor" style="background:${tagColor};"></span>
					<span class="sessionTagName">${tagName}</span>
				</span>
			`;
		}
		tagsHtml += '</div>';
		return tagsHtml;
	}

	addSimletCard = function(study, usercount) {
		const card = $("#simlet_card_template .stopable").clone();
		card.attr("href", `/simlets/${study.simlet_id}`);
				
		const kebab = $("#kebab_template .kebab-dropdown").clone();
		card.find(".kebab").append(kebab);
		kebab.find(".icon-edit").click(() => { openStudyForm(study.simlet_id) });
		kebab.find(".icon-url").click(() => { openUrlSettingsForm(study.simlet_id) });
		kebab.find(".icon-download").click(() => { openConfigDownloadForm(study.simlet_id) });
		if (!archived) {
			kebab.find(".icon-archive").click(() => { archiveStudy(study.simlet_id) });
		}
		else {
			kebab.find(".icon-archive").hide();
		}
		kebab.find(".icon-delete").click(() => { deleteStudy(study.simlet_id, study.simlet_name) });

		// Disable archive button if not all sessions are finished
		Simva.getStudy(study.simlet_id, function(error, result) {
			if (!error) {
				console.log(result.participants.length)
				card.find(".cardUsers").after(result.participants.length);

				if (!archived) {
					if(study.simlet_archived == archived) {
					const total = result.sessions.length;
						if (total > 0) {
							let completed = 0;
							let allSessionsFinished = true;
							result.sessions.forEach(testid => {
								Simva.getStudyTest(study.simlet_id, testid, function(error, result) {
									if (!error) {
										if (result != null) {
											let prev = allSessionsFinished;
											allSessionsFinished = allSessionsFinished && (result.session_status == "finished" || result.session_status == "inactive");
										}
									}
									completed++;
									if (completed == total && !allSessionsFinished) {
										kebab.find(".icon-archive").addClass('li-disabled').removeAttr('onclick');
									}
								});
							});
						}
					}
				}
			} 
		});

		card.find(".simletCardTitle h1").text(study.simlet_name);
		card.find(".cardDescription").text(study.simlet_description);
		card.find(".cardCreationDate").append(study.createdAt);
		card.find(".cardUpdateDate").append(study.updatedAt);
		card.find(".carrdSessions").append(study.sessions.length);
		card.find(".cardGroups").after(study.groups.length);
		card.find(".studyTagsRow").append(renderStudyTags(study));
		
		$('#studies_list').append(card);
	}
</script>