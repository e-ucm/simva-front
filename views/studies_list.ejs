<%# views/studies_list.ejs %>
 
<% extend('layout_with_menu_and_sse') %>

<h1><%- t('title', { ns : 'SIMLETs' }) %></h1>
<div id="studies_list">
	<div style="width: 100%; text-align: center; padding: 200px;">
		<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
	</div>
</div>

<% if (typeof archived !== 'undefined' && !archived) { %>

	<div id="new_study" class="new_element floating">
		<div class="floater">
			<div class="form">
				<h1><%- t('new.title', { ns : 'SIMLETs' }) %></h1>
				<div class="tabs">
					<span class="tab selected" onclick="changeTab(this, 'new_study','new_study_tab')"><%- t('new.title', { ns : 'SIMLETs' }) %></span>
					<span class="tab" onclick="changeTab(this, 'new_study','import_study_tab')"><%- t('new.upload.title', { ns : 'SIMLETs' }) %></span>
				</div>
				<div id="new_study_tab" class="subform selected">
					<form id="new_study_form">
						<br>
						<h3><%- t('name.edit.title', { ns : 'SIMLETs' }) %></h3>
						<input type="text" name="name" placeholder="<%- t('name.placeholder', { ns : 'SIMLETs' }) %>">
						<br>
						<h3><%- t('description.edit.title', { ns : 'SIMLETs' }) %></h3>
						<input type="text" name="description" placeholder="<%- t('description.placeholder', { ns : 'SIMLETs' }) %>" required>
						<br><br>
						<input type="submit" value="<%- t('new.submit', { ns : 'SIMLETs' }) %>">
					</form>
				</div>
				<div hidden id="import_study_tab" class="subform">
					<form id="import_study_form">
						<p><%- t('new.upload.message', { ns : 'SIMLETs' }) %></p>
						<input type="file" name="exportJson">
						<input type="submit" value="<%- t('new.submit', { ns : 'SIMLETs' }) %>">
					</form>
				</div>
			</div>	
		</div>
	</div>

	<div id="edit_study" class="new_element floating">
		<div class="floater">
			<div class="form">
				<div id="edit_study_tab" class="subform selected">
					<form id="edit_study_form">
						<input type="text" name="editingStudyId" id="edit_study_id" style="display: none;">
						<input type="text" name="prevStudyName" id="prev_study_name" style="display: none;">
						<input type="text" name="prevStudyDescription" id="prev_study_description" style="display: none;">

						<h3><%- t('name.edit.title', { ns : 'SIMLETs' }) %></h3>
						<input type="text" name="studyName" id="edit_study_name" placeholder="<%- t('name.placeholder', { ns : 'SIMLETs' }) %>" required>
						<br>
						<h3><%- t('description.edit.title', { ns : 'SIMLETs' }) %></h3>
						<input type="text" name="studyDescription" id="edit_study_description" placeholder="<%- t('description.placeholder', { ns : 'SIMLETs' }) %>" required>
						<br><br>
						<input type="submit" value="<%- t('edit.submit.title', { ns : 'SIMLETs' }) %>">
						<span class="loader" style="display: none"><div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div></span>
						<span class="error" id="edit_study_error"></span>
					</form>
				</div>
			</div>
		</div>
	</div>
	<div class="floating_buttons">
		<a unselectable="on" class="basic" onclick="Utils.toggleAddForm('new_study')">+</a>
	</div>

<% } %>



<script type="text/javascript">
	const archived = "<%= archived %>" === "true";

	$(document).ready(function() {
		$("#new_study_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#new_study_form"));
			Utils.toggleSubmit(currentform);
			let formData = new FormData();
			formData.append('simlet_name', form.name);
			formData.append('simlet_description', form.description);
			Simva.addStudy({ simlet_name : form.name, simlet_description : form.description }, function(error, result){
				if(error && error.responseJSON){
					Utils.toggleSubmit(currentform);
					$("#error").text(error.responseJSON.message);
				}else{
					Utils.toggleSubmit(currentform);
					Utils.toggleAddForm('new_study');
					$('#studies_list').html(roller);
					Simva.getStudies(function(error, result){
						if(!error){
							paintStudies(result);
						}
					});
				}
			});
			return false;
		});

		$("#import_study_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#import_study_form"));
			Utils.toggleSubmit(currentform);
			if($("#import_study_form").find('input[name="exportJson"]').get(0).files[0]){
				var reader = new FileReader();
				var input = event.target;
				reader.onload = function(){
					let raw = reader.result;
					raw = raw.substr(raw.indexOf(',') + 1);
					var newStudy = raw;
					Simva.importStudyConfig({file : newStudy}, function(error, result) {
						Utils.toggleSubmit(currentform);
						if(!error) {
							Utils.toggleAddForm('new_study');
							$('#studies_list').html(roller);
							Simva.getStudies(function(error, result){
								if(!error){
									paintStudies(result);
								}
							});
						} else {
							$("#error").text(error);
						}
					});
				};
				reader.readAsDataURL($("#import_study_form").find('input[name="exportJson"]').get(0).files[0]);
			}else{
				$("#error").text("<%- t('new.upload.errorMessage', { ns : 'SIMLETs' }) %>");
				Utils.toggleSubmit(currentform);
			}

			return false;
		});

		$("#edit_study_form").on('submit', function(event){
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($("#edit_study_form"));
			Utils.toggleSubmit(currentform);
			if(form.prevStudyName == form.studyName && form.prevStudyDescription == form.studyDescription) {
				$('#edit_study_error').text("<%- t('edit.no_change', { ns : 'SIMLETs' }) %>");
				Utils.toggleSubmit(currentform);
			} 
			else {
				$('#edit_study_error').text("");
				Simva.updateStudy(form.editingStudyId, { simlet_name : form.studyName, simlet_description : form.studyDescription }, function(error, result){
					Utils.toggleSubmit(currentform);
					Utils.toggleAddForm('edit_study');
					refreshStudies();
				});
			}
			return false;
		});

		$('#studies_list').html(roller);
		refreshStudies();
	});

	let refreshStudies = function(){
		Simva.getStudies(function(error, result){
			if(!error){
				paintStudies(result);
			}
		});
	}

	let paintStudies = function(studies) {
		$('#studies_list').text('');
		let paintedStudies = 0;
		
		for (var i = 0; i < studies.length; i++) {
			let study = studies[i]
			Simva.getStudyParticipants(study.simlet_id, function(error, result){ 
				if(!error && study.simlet_archived == archived){
					let card = $(toCard(study, result.length));
					$('#studies_list').append(card);
				}
			});
			if (study.simlet_archived == archived) {
				paintedStudies++;
			}
		}
		if (paintedStudies == 0) {
			if (!archived) {
				$('#studies_list').text("<%- t('zero.message.title', { ns : 'SIMLETs' }) %>");
			}
			else {
				$('#studies_list').text("<%- t('zero.archived.title', { ns : 'SIMLETs' }) %>");
			}
		}
	}

	let deleteStudy = function(studyid, studyname){
		event.preventDefault();
		event.stopPropagation();
		if(confirm(`<%- t('remove.confirm', { ns : 'SIMLETs', SIMLET : '${studyname}' }) %>`)){
			Simva.deleteStudy(studyid, function(error, result){
				if(!error){
					refreshStudies();
				}
			});
		}
	}

	let openEditStudyForm = function(studyId, studyName, studyDescription){
		$('#edit_study_id').val(studyId);
		$('#prev_study_name').val(studyName);
		$('#prev_study_description').val(studyDescription);
		
		$('#edit_study').toggleClass('shown');
		$('#edit_study_error').text("");
		$('#edit_study_name').val(studyName);
		$('#edit_study_description').val(studyDescription);
	}

	let renderStudyTags = function(study) {
		const tags = Array.isArray(study.tags) ? study.tags : [];
		if(tags.length === 0) {
			return '<div class="sessionTagList"><span class="sessionTagEmpty">No tags</span></div>';
		}

		let tagsHtml = '<div class="sessionTagList">';
		for (let i = 0; i < tags.length; i++) {
			const tag = tags[i] || {};
			const tagName = tag.tag_name || 'Tag';
			const tagColor = tag.tag_color || '#3b82f6';
			tagsHtml += `
				<span class="sessionTagChip">
					<span class="sessionTagColor" style="background:${tagColor};"></span>
					<span class="sessionTagName">${tagName}</span>
				</span>
			`;
		}
		tagsHtml += '</div>';
		return tagsHtml;
	}
	
	let toCard = function(study, userCount) {
		const tagsHtml = renderStudyTags(study);
		return `
		<a class="stopable" href="/simlets/${study.simlet_id}">
			<div class="selectable card third">
				<div class="simletCardTitle">
					<h1>${study.simlet_name}</h1>
					<div class="kebab">
						<ul class="kebab-dropdown" style="display: none;">
							<li class="kebab-icon icon-edit" onclick="openEditStudyForm('${study.simlet_id}', '${study.simlet_name}', '${study.simlet_description}')">
								<%- t('edit.title', { ns : 'SIMLETs' }) %>
							</li>
							<li class="kebab-icon icon-delete" onclick="deleteStudy('${study.simlet_id}', '${study.simlet_name}')">
								<%- t('delete.title', { ns : 'SIMLETs' }) %>
							</li>
						</ul>
					</div>
				</div>
				<p class="cardDescription">${study.simlet_description}</p>
				<p><strong><%- t('sessions.creationDate', { ns : 'SIMLETs' }) %>:</strong> ${study.createdAt}</p>
				<p><strong><%- t('sessions.updateDate', { ns : 'SIMLETs' }) %>:</strong> ${study.updatedAt}</p>
				<p><strong><%- t('sessions.title', { ns : 'SIMLETs' }) %>:</strong> ${study.sessions.length}</p>
				<p><strong><%- t('groups.title', { ns : 'SIMLETs' }) %>:</strong> ${study.groups.length} &nbsp; <strong><%- t('sessions.usercount', { ns : 'SIMLETs' }) %>:</strong> ${userCount}</p>
				<div class="studyTagsRow">
					<strong><%- t('tags.title', { ns : 'SIMLETs' }) %>:</strong>
					${tagsHtml}
				</div>
			</div>
		</a>
		`;
	}

	let changeTab = function(tab, form, subform){
		$(`#${form} .tab`).removeClass('selected');
		$(`#${form} .subform`).removeClass('selected');
		$(tab).toggleClass('selected');
		$(`#${subform}`).toggleClass('selected');
	}
</script>
<script type="text/javascript" src="/kebabs.js"></script>