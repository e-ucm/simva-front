<% extend('layout_with_menu_and_sse') %>

<div class="tooltipLine">
	<h1><%- t('title', { ns : 'SIMLETs' }) %></h1>
	<div class="tooltip">
		&#x1F6C8;
		<span class="tooltiptext">
			<% if (typeof archived !== 'undefined' && !archived) { %>
				<%= t('description', { ns : 'SIMLETs' }) %>
			<% } else { %>
				<%= t('archived_simlet.description', { ns : 'about' }) %>
			<% } %>
		</span>
	</div>
</div>

<!-- Needs to be added before other partials to allow them to use
the elements and scripts defined in the simlet_commons partial -->
<%- include('partials/simlet_commons') %>
<% const searchBarPlaceholder = t('searchBar.placeholder', { ns: 'SIMLETs' }); %>
<%- include('partials/filtering_pagination_commons', { id:"simlets", searchBarPlaceholderText: searchBarPlaceholder }) %>

<div id="simlets_list" class="simletsCardsList">
</div>

<div id="loader" class="loader">
	<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
</div>

<!-- Template for each card of the SIMLETs list -->
<div id="simlet_card_template" style="display: none;">
	<a class="cardColumn">
		<div class="selectable card">
			<div class="simletCardTitle">
				<h1 class="cardTitle"></h1>
				<div class="kebab"></div>
			</div>
			<p class="cardDescription"> 	</p>
			<p class="cardCreationDate"><strong><%- t('card.createdAt', { ns : 'SIMLETs' }) %>: </strong> 		</p>
			<p class="cardUpdateDate"><strong><%- t('card.updatedAt', { ns : 'SIMLETs' }) %>: </strong> 	</p>
			<p class="carrdSessions"><strong><%- t('card.sessions', { ns : 'SIMLETs' }) %>: </strong> 	</p>
			<p>
				<strong class="cardGroups"><%- t('card.groups', { ns : 'SIMLETs' }) %>: </strong>
				&nbsp; 
				<strong class="cardUsers"><%- t('card.users', { ns : 'SIMLETs' }) %>: </strong>
			</p>
			<div class="simletTagsRow">
				<strong><%- t('card.tags', { ns : 'SIMLETs' }) %>:</strong>
				
			</div>
		</div>
	</a>
</div>

<% if (typeof archived !== 'undefined' && !archived) { %>
	<div class="floating_buttons">
		<a unselectable="on" class="basic" onclick="openSimletForm()">+</a>
	</div>
<% } %>


<script type="text/javascript">
	const ARCHIVED = "<%= archived %>" === "true";

	const SIMLET_DATA_ID_KEY = "simletId"
	const SIMLET_DATA_NAME_KEY = "simletName"
	const SIMLET_DATA_DESCRIPTION_KEY = "simletDescription"

	let simletsById = new Map();
	
	// Assign properties and functions of filtering_pagination_commons partial
	const SHOW_AT_ONCE = 9;
	let filteringPaginationData = $("#simlets_filtering").data();
	
	// Add the floating class to the content element to add space at the bottom 
	// of the page so the floating button doesnt cover any other element
	$(".content").addClass("floating");

	
	$(document).ready(function() {
		// Set refresh function of the simlet_commons partial
		refreshFunc = refreshSimlets;

		// Assign properties and functions of filtering_pagination_commons partial
		filteringPaginationData["showAtOnce"] = SHOW_AT_ONCE;
		filteringPaginationData["searchParams"].status = ARCHIVED ? "archived" : "active";
		filteringPaginationData["updateSearchCallback"] = onSearch;
		filteringPaginationData["loadMoreCallback"] = loadSimletBatch;
		
		refreshSimlets();

		// When submitting the import SIMLET form
		$(document).on('submit', "#import_study_form", function(event) {
			event.preventDefault();
			let currentform = this;
			let form = Utils.getFormData($(this));
			Utils.toggleSubmit(currentform);
			let errorbox = $("#study_form_error");
			// Check for file presence
			const fileInput = $(this).find('input[name="jsonFile"]').get(0);
			if(fileInput && fileInput.files[0]){
				let reader = new FileReader();
				reader.onload = function(){
					try {
						let raw = reader.result;
						// Always extract base64 payload from data URL
						raw = raw.substr(raw.indexOf(',') + 1);
						const newStudy = raw;
						Simva.importStudyConfig({file: newStudy, simlet_name: form.studyName}, function(error, result) {
							Utils.toggleSubmit(currentform);
							if(!error) {
								Utils.toggleAddForm('study_form');
								$('#simlets_list').html(roller);
								refreshFunc();
							} else {
								$("#study_form_error").text(error);
							}
						});
					} catch (e) {
						Utils.toggleSubmit(currentform);
						$("#study_form_error").text(e.message);
					}
				};
				reader.readAsDataURL(fileInput.files[0]);
			}else{
				$("#study_form_error").text("<%- t('import.upload.error', { ns : 'SIMLETs' }) %>");
				Utils.toggleSubmit(currentform);
			}
			return false;
		});
		
	});

	const refreshSimlets = function() {
		// Updates all the search parameters and calls onSearch
		filteringPaginationData["updateSearch"]();

		// At the same time, asynchronously get all the SIMLETs in this section and store
		// them by id for faster access to its parameters when opening the edit menu
		Simva.getStudies({ status: filteringPaginationData["searchParams"].status }, function(error, result) {
			if (!error) {
				simletsById = new Map(
					result.map(obj => [obj.simlet_id, obj])
				);
			}
		});
	}

	/**
	 * When updating any filter parameter, remove all the painted SIMLETs and load a new batch
	 * (called by updateSearch in filtering_pagination_commons)
	 */
	const onSearch = function() {
		$('#simlets_list').empty();

		Simva.getStudiesCount(filteringPaginationData["searchParams"], function(error, result) {
			if (!error) {
				// Update the total results and recalculate the number of pages (but don't perform the search again)
				filteringPaginationData["totalResults"] = result.count;
				filteringPaginationData["updateSearchOptions"]();
				
				loadSimletBatch();
			}
		});

	}

	/**
	 * Load batch of max SHOW_AT_ONCE SIMLETs matching the search parameters and paint them
	 * (called both when updating the search results and when loading the next page of results)
	 */
	const loadSimletBatch = function() {
		$("#loader").show();
		
		Simva.getStudies(filteringPaginationData["searchParams"], function(error, result){
			if (!error) {
				paintSimletBatch(result);
				$("#loader").hide();
			}
		});
	}

	/**
	 * Paint the cards for a batch of SIMLETs
	 * 
	 * @param {Array} batch - Array of objects containing the SIMLETs info
	 */
	const paintSimletBatch = function(batch) {
		batch.forEach((simlet) => {
			// Add the SIMLET card synchronously to ensure they appear in order
			const card = $("#simlet_card_template a").clone();
			$('#simlets_list').append(card);

			card.data(SIMLET_DATA_ID_KEY, simlet.simlet_id);
			card.data(SIMLET_DATA_NAME_KEY, simlet.simlet_name);
			card.data(SIMLET_DATA_DESCRIPTION_KEY, simlet.simlet_description);

			// Then, fill its details asynchronously since the order of execution doesn't matter once the card has been added
			fillSimletCard(simlet, card);
		});

		if (batch.length == 0) {
			// There are no SIMLETs in the current section (active/archived)
			if (simletsById.size == 0) {
				if (!ARCHIVED) {
					$('#simlets_list').text("<%- t('no_simlets.message', { ns : 'SIMLETs' }) %>");
				}
				else {
					$('#simlets_list').text("<%- t('no_archived.message', { ns : 'SIMLETs' }) %>");
				}
			}
			// There are SIMLETs, but none of them matched the search parameters
			else {
				$('#simlets_list').text("<%- t('search.no_matches', { ns : 'SIMLETs' }) %>");
			}
		}
	}


	const openSimletForm = function(simletId) {
		// Always open form in the create/edit common tab
		Utils.changeTab($('#study_name_desc_tab_button'), 'study_form_form','study_name_desc_tab');

		$('#study_form_error').text("");

		// Creating new SIMLET
		if (simletId == null) {
			// Open form always and show the add new/import tabs
			Utils.toggleAddForm("study_form");
			$("#add_study_tabs").show();
			
			$("#study_form_title").text("<%- t('add.title', { ns : 'SIMLETs' }) %>");
			$("#study_name_desc_submit").val("<%- t('new.submit', { ns : 'SIMLETs' }) %>");

			$('#prev_study_name').val("");
			$('#prev_study_description').val("");

			$('#study_name').val("");
			$('#study_description').val("");
		}
		// Editing SIMLET
		else {
			const simlet = simletsById.get(simletId);
			if(simlet != null) {
				// Open form only if the SIMLET exists and hide the add new/import tabs (only the name/description tab is needed)
				Utils.toggleAddForm('study_form');
				$('#edit_study_id').val(simletId);

				$("#add_study_tabs").hide();

				$("#study_form_title").text("<%- t('edit.title', { ns : 'SIMLETs' }) %>");
				$("#study_name_desc_submit").val("<%- t('edit.submit', { ns : 'SIMLETs' }) %>");

				$('#prev_study_name').val(simlet.simlet_name);
				$('#prev_study_description').val(simlet.simlet_description);

				$('#study_name').val(simlet.simlet_name);
				$('#study_description').val(simlet.simlet_description);
			}
		}
	}

	
	/**
	 * Fill the SIMLET card info programatically to avoid XSS
	 * 
	 * @param {Object} simlet - object containing the SIMLET info
	 * @param {Object} card - jquery object of the card element
	 */
	const fillSimletCard = async function(simlet, card) {
		card.attr("href", `/simlets/${simlet.simlet_id}`);
				
		const kebab = $("#kebab_template .kebab-dropdown").clone();
		card.find(".kebab").append(kebab);
		if (ARCHIVED) {
			kebab.find(".icon-archive").hide();
		} else {
			// Disable archive button if not all sessions are finished
			const total = simlet.sessions.length;
			if (total > 0) {
				let completed = 0;
				let allSessionsFinished = true;
				simlet.sessions.forEach(sessionId => {
					Simva.getStudyTest(simlet.simlet_id, sessionId, function(error, result) {
						if (!error) {
							let prev = allSessionsFinished;
							allSessionsFinished = allSessionsFinished && (result.session_status == "terminated" || result.session_status == "inactive");
						}
						completed++;
						if (completed == total && !allSessionsFinished) {
							kebab.find(".icon-archive").addClass('li-disabled').removeAttr('onclick');
						} else if (completed == total && allSessionsFinished) {
							kebab.find(".icon-archive").removeClass('li-disabled');
						}
					});
				});
			} else {
				kebab.find(".icon-archive").removeClass('li-disabled');
			}
		}
		
		card.find(".simletCardTitle h1").text(simlet.simlet_name);
		card.find(".cardDescription").text(simlet.simlet_description);
		card.find(".cardCreationDate").append(getFormattedDate(simlet.createdAt, currentlanguageCode));
		card.find(".cardUpdateDate").append(getFormattedDate(simlet.updatedAt, currentlanguageCode));
		card.find(".carrdSessions").append(simlet.sessions.length);
		card.find(".cardGroups").after(simlet.groups.length);
		card.find(".simletTagsRow").append(renderTags(simlet));
		
		Simva.getStudyGroupsParticipantsCount(simlet.simlet_id, function(error, result) {
			if (!error) {
				let total = 0;
				Object.entries(result).forEach(([group, count]) => {
					total += count;
				});
				card.find(".cardUsers").after(total);
			}
		});
	}


	// 3-dot menus buttons shared listeners using event delegation to ensure 
	// the handler works even if element is added after the document ready event

	$(document).on('click', ".simletCardTitle .icon-edit", function(e) {
		const data = $(this).closest("a").data();
		openSimletForm(data[SIMLET_DATA_ID_KEY])
	});

	$(document).on('click', ".simletCardTitle .icon-url", function(e) {
		const data = $(this).closest("a").data();
		// Defined in the simlet_commons partial
		openUrlSettingsForm(data[SIMLET_DATA_ID_KEY], data[SIMLET_DATA_NAME_KEY])
	});

	$(document).on('click', ".simletCardTitle .icon-download", function(e) {
		const data = $(this).closest("a").data();
		// Defined in the simlet_commons partial
		openConfigDownloadForm(data[SIMLET_DATA_ID_KEY], data[SIMLET_DATA_NAME_KEY])
	});

	$(document).on('click', ".simletCardTitle .icon-archive", function(e) {
		const data = $(this).closest("a").data();
		// Defined in the simlet_commons partial
		archiveSimlet(data[SIMLET_DATA_ID_KEY], data[SIMLET_DATA_NAME_KEY])
	});

	$(document).on('click', ".simletCardTitle .icon-delete", function(e) {
		const data = $(this).closest("a").data();
		// Defined in the simlet_commons partial
		deleteSimlet(data[SIMLET_DATA_ID_KEY], data[SIMLET_DATA_DESCRIPTION_KEY])
	});	
	
</script>