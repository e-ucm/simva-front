<%# views/layout.ejs %>

<% 
const loggedIn = typeof isLoggedIn !== 'undefined' && isLoggedIn;
const deviceAuth = typeof withDeviceAuth !== 'undefined' && withDeviceAuth;
const includeSSE = typeof withSSE !== 'undefined' && withSSE;
const includeMenu = typeof withMenu !== 'undefined' && withMenu;
%>

<!DOCTYPE html>
<html>
<head>
	<% 
		let layoutheadAssetsParams = { } 
		let layoutScriptParams = { } 
	%>

	<!-- Don't include the SSE in the layout_head_assets partial when logged out -->
	<% if (!loggedIn) { %>
		<% layoutheadAssetsParams.includeSSEManager = false; %>

	<!-- When logged in (Device auth, with sidebar, with sidebar and SSE) -->
	<% } else { %>
		<!-- Always include simvaBase in the layout_common_script partial -->
		<% layoutScriptParams.includeSimvaBase = true; %>

		<!-- When outside the device auth page (with sidebar, with sidebar and SSE) -->
		<% if (!deviceAuth) { %>
			<%
				// Always include userToken in the layout_common_script partial
				layoutScriptParams.includeUserToken = true;

				// Only if stated, include the SSE in the layout_head_assets partial and in the 
				// layout_common_script partial and the TMonApi in the layout_common_script partial
				layoutheadAssetsParams.includeSSEManager = includeSSE;
				layoutScriptParams.includeSSEManager = includeSSE;
				layoutScriptParams.includeTMonApi = includeSSE;
			%>
		<% } %>
	<% } %>

	<!-- Include the partials of the head assets and common scripts (the previous declared variables will be used inside these partials) -->
	<%- include('partials/layout_head_assets', layoutheadAssetsParams) %>
	<%- include('partials/layout_common_script', layoutScriptParams) %>
	
	<!-- Extra script for  the device auth page -->
	<% if (deviceAuth) { %>
		<script type="text/javascript">
			let studyId = "<%= study %>";
			let expectedUserCode = "<%= usercode %>";

			$(document).ready(function() {
				if (expectedUserCode) {
					console.log('Authorizing device for study ' + studyId + ' (requested code: ' + expectedUserCode + ')');
				}

				const iframe = document.getElementById('sso_device');
				iframe.addEventListener('load', () => {
					try {
						const currentUrl = iframe.contentWindow.location.href;
						console.log('SSO device flow completed, redirecting to:', currentUrl);
						window.location.href = currentUrl;
					} catch(e) {
						console.log('Cross-origin, cannot access URL');
					}
				});
			});
		</script>
	<% } %>
	
</head>

<!-- Add the black class only on the device auth page -->
<body <%= deviceAuth ? 'class="black"' : '' %>>
	<!-- Always include the header -->
	<%- include('partials/header', { isLoggedIn: loggedIn }) %>
	
	<!-- If not logged in, include the content and nothing else -->
	<% if (!loggedIn) { %>
		<%- content %>

	<!-- When logged in (Device auth, with sidebar, with sidebar and SSE) -->
	<% } else { %>
		<!-- On the device auth page, only include an iframe with the login page -->
		<% if (deviceAuth) { %>
			<div style="width:100%; height:100vh;">
				<iframe id="sso_device" class="content_filled" src="<%= config.sso.deviceUrl %>?user_code=<%= usercode %>"></iframe>
			</div>
		
		<!-- When outside the device auth page (with sidebar, with sidebar and SSE) -->
		<% } else { %>
			<!-- Always include the sidebar -->
			<%- include('partials/sidebar') %>

			<!-- If including the SSE, include an iframe outside of the content -->
			<% if (includeSSE) { %>
				<%- include('partials/iframe') %>
			<% } %>
		
			<main class="content">
				<%- include('partials/iframe') %>
				<%- content %>
			</main>
		<% } %>
	<% } %>
</body>
</html>
